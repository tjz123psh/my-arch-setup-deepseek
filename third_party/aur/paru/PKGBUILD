# Maintainer: Morgan <morganamilo@archlinux.org>
# Local fixed bootstrap recipe: pinned upstream source, built with cargo
# fetching dependencies from crates.io (no offline vendor archive needed).
# Aligned with the official AUR PKGBUILD: `cargo update alpm alpm-utils`
# upgrades the alpm binding to a version that supports the current libalpm
# before the frozen build.
#
# Local modification (2026-08-06): the alpm/alpm-utils bump is pinned into a
# committed Cargo.lock instead of done at build time, so the prepare step
# never needs crates.io access (offline physical install). Cargo.lock here
# carries alpm 4.0.4 / alpm-sys 4.0.5 (libalpm16-compatible).

pkgname=paru
pkgver=2.1.0
pkgrel=5
pkgdesc='Feature packed AUR helper'
url='https://github.com/Morganamilo/paru'
source=("$pkgname-$pkgver.tar.gz::https://github.com/Morganamilo/paru/archive/v$pkgver.tar.gz"
        "Cargo.lock")
backup=('etc/paru.conf')
arch=('x86_64')
license=('GPL-3.0-or-later')
makedepends=('cargo')
depends=('git' 'pacman' 'libalpm.so>=14')
optdepends=('bat: colored PKGBUILD printing' 'devtools: build in chroot and downloading PKGBUILDs')
sha256sums=('eea4dbb524db765d5316f540f9ee670c0bf81aae4827b5417eebb4c9b5651727'
            '683648e6dce7adb100a88cf53c7e7f5e1785e9c8f40a92973ac2ac5d713d0b63')
options=('!debug')

prepare() {
  cd "${srcdir}/paru-${pkgver}"
  # Use the committed, alpm-pinned Cargo.lock so the alpm binding version is
  # correct regardless of connectivity (no `cargo update` needed).
  cp -f "${srcdir}/Cargo.lock" Cargo.lock
  # Prefer an online fetch; fall back to the offline cache (CARGO_HOME set by
  # 06-aur when .aur-sources is present). Networked machines build without
  # any cache; offline machines use the pre-fetched registry.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's|host: ||p')" 2>/dev/null \
    || cargo fetch --locked --offline --target "$(rustc -vV | sed -n 's|host: ||p')"
}

build() {
  cd "${srcdir}/paru-${pkgver}" || return 1

  local -a feature_args=()
  if pacman -T pacman-git >/dev/null 2>&1; then
    feature_args=(--features git)
  fi

  cargo build --frozen "${feature_args[@]}" --release --target-dir target
  ./scripts/mkmo locale/
}

package() {
  cd "${srcdir}/paru-${pkgver}" || return 1

  install -Dm755 target/release/paru "${pkgdir}/usr/bin/paru"
  install -Dm644 paru.conf "${pkgdir}/etc/paru.conf"
  install -Dm644 man/paru.8 "${pkgdir}/usr/share/man/man8/paru.8"
  install -Dm644 man/paru.conf.5 "${pkgdir}/usr/share/man/man5/paru.conf.5"
  install -Dm644 completions/bash "${pkgdir}/usr/share/bash-completion/completions/paru.bash"
  install -Dm644 completions/fish "${pkgdir}/usr/share/fish/vendor_completions.d/paru.fish"
  install -Dm644 completions/zsh "${pkgdir}/usr/share/zsh/site-functions/_paru"
  install -d "${pkgdir}/usr/share"
  cp -r locale "${pkgdir}/usr/share/"
}
