pkgname=fuzzel-ime-git
pkgver=1.14.1.r26.g302f228
pkgrel=1
pkgdesc="Fuzzel(a wayland launcher) with Input Method support."
arch=('x86_64')
url='https://codeberg.org/dnkl/fuzzel'
license=('MIT')
depends=('cairo' 'fcft' 'libxkbcommon' 'pixman' 'tllist' 'wayland' 'glibc')
makedepends=('meson' 'ninja' 'scdoc' 'wayland-protocols')
provides=("fuzzel=${pkgver}")
conflicts=('fuzzel' 'fuzzel-git')
_commit=302f228bb87d3c861a8debd39b9d8e4a0ea81037
# Local modification (2026-08-06): upstream AUR uses codeberg's
# /archive/<commit>.tar.gz, but that archive endpoint is unreachable from
# CN networks while the git smart-HTTP endpoint works fine. Clone via git
# instead (same pinned commit, same $srcdir/fuzzel layout, sha256 SKIP as
# is conventional for git sources).
source=("fuzzel::git+https://codeberg.org/dnkl/fuzzel.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  arch-meson fuzzel build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
  install -Dm644 fuzzel/LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
