# Maintainer: NekoLOvO <nekolyin@qq.com>
# Local x86_64-only fixed recipe derived from the reviewed obsidian split pkgbase.

pkgbase=obsidian
pkgname=obsidian-bin
pkgver=1.13.7
pkgrel=1
pkgdesc='A powerful knowledge base over a local folder of plain text Markdown files (official bundled-Electron binary)'
arch=('x86_64')
url='https://github.com/obsidianmd/obsidian-releases'
license=('custom')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux-libs' 'libsecret')
optdepends=('libappindicator: tray icon support')
conflicts=('obsidian')
provides=('obsidian')
options=('!strip')
install=obsidian-bin.install
source=(
  'obsidian-bin'
  "obsidian_${pkgver}_amd64.deb::${url}/releases/download/v${pkgver}/obsidian_${pkgver}_amd64.deb"
)
sha256sums=(
  'a94e20705d4b67501f225d74f4460b746a258e52aa6bc522aed1e26ac42dbef9'
  '17dc33b49cb3e785ecc27edd2ea0c79e40207798b554fd2886e36ebee7af9ae0'
)

package() {
  local data_archives=("${srcdir}"/data.tar.*)
  if (( ${#data_archives[@]} != 1 )) || [[ ! -f ${data_archives[0]} ]]; then
    error 'expected exactly one data.tar.* payload from the pinned Debian package'
    return 1
  fi
  bsdtar -xf "${data_archives[0]}" -C "${pkgdir}/"
  # The desktop-entry FILENAME is not stable across releases: 1.12.7 shipped
  # usr/share/applications/obsidian.desktop, 1.13.7 ships
  # md.obsidian.Obsidian.desktop. The offline VM round (2026-09-18) failed
  # here with "sed: ... obsidian.desktop: No such file or directory" and the
  # recipe was skipped. Patch every entry the payload provides instead of one
  # hardcoded name, and fail closed when the payload has none at all.
  local desktop found=0
  while IFS= read -r desktop; do
    sed -i 's|/opt/Obsidian/obsidian|obsidian|' "${desktop}"
    found=1
  done < <(find "${pkgdir}/usr/share/applications" -maxdepth 1 -name '*.desktop' -print 2>/dev/null)
  if (( found == 0 )); then
    error 'no .desktop entry found in the Debian payload (expected usr/share/applications/*.desktop)'
    return 1
  fi
  install -Dm755 "${srcdir}/obsidian-bin" "${pkgdir}/usr/bin/obsidian"
  install -Dm644 "${pkgdir}/opt/Obsidian/LICENSE.electron.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.electron.txt"
  install -Dm644 "${pkgdir}/opt/Obsidian/LICENSES.chromium.html" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.chromium.html"
}
