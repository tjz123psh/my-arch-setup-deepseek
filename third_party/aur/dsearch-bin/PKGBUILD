pkgname=dsearch-bin
_pkgname=dsearch
pkgver=1.6.0
pkgrel=1
pkgdesc='Fast filesystem search service'
arch=('x86_64')
url='https://github.com/AvengeMedia/danksearch'
license=('MIT')
provides=('dsearch')
conflicts=('dsearch')
options=('!strip' '!debug')
_upstream_commit=984f86e644a93d2a366d960e3c56233260a501de
_rawurl="https://raw.githubusercontent.com/AvengeMedia/danksearch/${_upstream_commit}"

source=(
  "LICENSE-${pkgver}::${_rawurl}/LICENSE"
  "README-${pkgver}.md::${_rawurl}/README.md"
  'dsearch.service'
)
source_x86_64=("dsearch-x86_64-${pkgver}.gz::${url}/releases/download/v${pkgver}/dsearch-linux-amd64.gz")
