# Maintainer: Reverier-Xu <reverier.xu@outlook.com>
# Local recipe: pinned from the reviewed AUR snapshot.
pkgname=fcitx5-skin-fluentdark-git
pkgver=v0.4.0.r7.g399699a
pkgrel=1
pkgdesc='A Fluent-Design dark theme with blur effect and shadow.'
arch=('x86_64')
url='https://github.com/Reverier-Xu/Fluent-fcitx5'
license=('MPL')
depends=('fcitx5')
_commit=399699ac7d366ed6c1952646ed71647e3c8f99b5
source=("Fluent-fcitx5-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('47793bd78207b0752903de093a7fc313ca8cf5ac4d5a28316704cc1160e1cf5f')

package() {
  local source_root="${srcdir}/Fluent-fcitx5-${_commit}"
  local theme file

  for theme in FluentDark FluentDark-solid; do
    for file in arrow.png back.png next.png panel.png radio.png theme.conf; do
      install -Dm644 "${source_root}/${theme}/${file}" \
        "${pkgdir}/usr/share/fcitx5/themes/${theme}/${file}"
    done
  done
}
