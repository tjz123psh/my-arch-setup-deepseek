[Unit]
Description=OpenAI OAuth proxy for ChatGPT K12 account
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/pang/.local/bin/openai-oauth --port 4141 --oauth-file %h/.codex/auth-k12.json --models "gpt-4o,gpt-4o-mini,gpt-4.1,gpt-4.1-mini,gpt-4.1-nano,o3,gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.3-codex,gpt-5.2,o4-mini,o4,o3-mini"
Restart=on-failure
RestartSec=6

[Install]
WantedBy=default.target
