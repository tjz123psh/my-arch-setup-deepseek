// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="^org\\.gnome\\."
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="^gnome-control-center$"
    match app-id="^pavucontrol$"
    match app-id="^nm-connection-editor$"
    open-floating false
    default-column-width { proportion 0.5; }
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^org\\.gnome\\.Calculator$"
    match app-id="^gnome-calculator$"
    match app-id="^galculator$"
    match app-id="^blueman-manager$"
    match app-id="^xdg-desktop-portal$"
    open-floating true
}

// @id=dms_rule_4 @name=
window-rule {
    match app-id="^steam$" title="^notificationtoasts_\\d+_desktop$"
    open-focused false
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// @id=dms_rule_5 @name=
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}

// @id=dms_rule_6 @name=
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}

// @id=dms_rule_7 @name=
window-rule {
    match app-id="niri-keys"
    open-floating true
    default-column-width { fixed 700; }
}

// @id=dms_rule_8 @name=
window-rule {
    match app-id="niri-quit"
    open-floating true
    open-focused true
    default-column-width { fixed 820; }
    default-window-height { fixed 500; }
    draw-border-with-background false
}

// @id=dms_rule_9 @name=
window-rule {
    match app-id="term-menu"
    open-floating true
    default-column-width { fixed 1600; }
    default-window-height { fixed 1000; }
}

// @id=dms_rule_10 @name=
window-rule {
    match app-id="quickterminal"
    open-floating true
    default-column-width { fixed 800; }
}

// @id=dms_rule_11 @name=
window-rule {
    match app-id="org.quickshell$"
    match app-id="com.danklinux.dms$"
    open-floating true
}

// @id=dms_rule_12 @name=
window-rule {
    match app-id="ai.vellum.pin"
    open-floating true
    focus-ring { off; }
    draw-border-with-background false
}

// @id=dms_rule_13 @name=
window-rule {
    match app-id="ai.vellum.result"
    open-floating true
    default-column-width { fixed 560; }
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
