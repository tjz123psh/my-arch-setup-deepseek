{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:~/.config/opencode/docs/build-prompt.md}",
      "steps": 100
    }
  },
  "autoupdate": "notify",
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 60000,
    "prune": true,
    "reserved": 100000,
    "tail_turns": 10
  },
  "default_agent": "build",
  "disabled_providers": [
    "openai"
  ],
  "experimental": {
    "batch_tool": true,
    "mcp_timeout": 60000
  },
  "formatter": {
    "stylua": {
      "command": [
        "stylua",
        "$FILE"
      ],
      "extensions": [
        ".lua"
      ]
    }
  },
  "instructions": [
    "~/.config/opencode/docs/instructions.md"
  ],
  "lsp": {
    "astro": {
      "disabled": true
    },
    "bash": {
      "disabled": true
    },
    "biome": {
      "disabled": true
    },
    "clangd": {
      "command": [
        "clangd",
        "--background-index",
        "--clang-tidy"
      ]
    },
    "clojure-lsp": {
      "disabled": true
    },
    "csharp": {
      "disabled": true
    },
    "dart": {
      "disabled": true
    },
    "deno": {
      "disabled": true
    },
    "dockerfile": {
      "disabled": true
    },
    "elixir-ls": {
      "disabled": true
    },
    "eslint": {
      "disabled": true
    },
    "fsharp": {
      "disabled": true
    },
    "gleam": {
      "disabled": true
    },
    "gopls": {
      "disabled": true
    },
    "haskell-language-server": {
      "disabled": true
    },
    "jdtls": {
      "disabled": true
    },
    "julials": {
      "disabled": true
    },
    "kotlin-ls": {
      "disabled": true
    },
    "lua-ls": {
      "command": [
        "lua-language-server"
      ],
      "initialization": {
        "Lua": {
          "diagnostics": {
            "globals": [
              "vim",
              "jit"
            ]
          },
          "runtime": {
            "version": "LuaJIT"
          }
        }
      }
    },
    "nixd": {
      "disabled": true
    },
    "ocaml-lsp": {
      "disabled": true
    },
    "oxlint": {
      "disabled": true
    },
    "php intelephense": {
      "disabled": true
    },
    "prisma": {
      "disabled": true
    },
    "pyright": {
      "disabled": true
    },
    "razor": {
      "disabled": true
    },
    "ruby-lsp": {
      "disabled": true
    },
    "rust": {
      "command": [
        "rust-analyzer"
      ]
    },
    "sourcekit-lsp": {
      "disabled": true
    },
    "svelte": {
      "disabled": true
    },
    "terraform": {
      "disabled": true
    },
    "texlab": {
      "disabled": true
    },
    "tinymist": {
      "disabled": true
    },
    "ty": {
      "disabled": true
    },
    "typescript": {
      "disabled": true
    },
    "vue": {
      "disabled": true
    },
    "yaml-ls": {
      "disabled": true
    },
    "zls": {
      "disabled": true
    }
  },
  "mcp": {
    "context7": {
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@3.2.4"
      ],
      "enabled": true,
      "type": "local"
    },
    "gemini-assistant": {
      "command": [
        "node",
        "/home/pang/.config/opencode/mcp/gemini-assistant.mjs"
      ],
      "enabled": true,
      "environment": {
        "GEMINI_API_KEY": "{file:~/.local/share/opencode/secrets/google-api-key}",
        "GEMINI_ASSISTANT_FALLBACK_MODEL": "gemini-3.5-flash",
        "GEMINI_ASSISTANT_MODEL": "gemini-3.5-flash-lite"
      },
      "timeout": 300000,
      "type": "local"
    },
    "penpot": {
      "enabled": true,
      "type": "remote",
      "url": "http://localhost:4401/mcp"
    },
    "playwright": {
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.78",
        "--headless",
        "--isolated",
        "--image-responses",
        "omit",
        "--console-level",
        "warning",
        "--output-dir",
        "/tmp/opencode/playwright-mcp"
      ],
      "enabled": true,
      "type": "local",
      "timeout": 120000
    }
  },
  "model": "anthropic/claude-opus-4-8",
  "permission": {
    "bash": {
      "opencode debug config*": "deny"
    },
    "gemini-assistant_analyze_images": "ask",
    "gemini-assistant_brainstorm": "ask",
    "penpot_*": "ask",
    "penpot_export_shape": "ask",
    "penpot_high_level_overview": "allow",
    "penpot_penpot_api_info": "allow",
    "playwright_browser_*": "ask",
    "playwright_browser_console_messages": "allow",
    "playwright_browser_network_requests": "allow",
    "playwright_browser_snapshot": "allow",
    "playwright_browser_take_screenshot": "allow",
    "skill": {
      "grill-me": "deny"
    },
    "gemini-assistant_analyze_recent_screenshots": "ask",
    "gemini-assistant_analyze_videos": "ask",
    "gemini-assistant_analyze_recent_videos": "ask"
  },
  "plugin": [
    "opencode-pty@0.3.6",
    "@mohak34/opencode-notifier@0.2.8",
    "@tarquinen/opencode-dcp@3.1.14"
  ],
  "provider": {
    "anthropic": {
      "models": {
        "claude-opus-4-7": {
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "claude-opus-4-7"
        },
        "claude-opus-4-8": {
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "claude-opus-4-8"
        },
        "claude-opus-5": {
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "claude-opus-5"
        }
      },
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "{file:~/.local/share/opencode/secrets/anthropic-api-key}",
        "baseURL": "https://sub.100xlabs.space/v1"
      }
    },
    "cd": {
      "models": {
        "gpt-5.5": {
          "name": "gpt-5.5"
        },
        "gpt-5.6-terra": {
          "name": "gpt-5.6-terra"
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{file:~/.local/share/opencode/secrets/cd-api-key}",
        "baseURL": "http://191.96.25.96:8317/v1",
        "setCacheKey": true
      }
    },
    "google": {
      "models": {
        "gemini-3.1-flash-lite": {
          "attachment": true,
          "id": "gemini-3.1-flash-lite",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Gemini 3.1 Flash Lite"
        }
      },
      "npm": "@ai-sdk/google",
      "options": {
        "apiKey": "{file:~/.local/share/opencode/secrets/google-api-key}"
      }
    },
    "grok": {
      "models": {
        "grok-4.5": {
          "name": "grok-4.5"
        },
        "grok-imagine": {
          "name": "grok-imagine"
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{file:~/.local/share/opencode/secrets/grok-api-key}",
        "baseURL": "https://api.imai.us.ci/v1",
        "setCacheKey": true
      }
    },
    "linxi": {
      "models": {
        "claude-opus-4-7": {
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "claude-opus-4-7"
        },
        "claude-opus-4-8": {
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "claude-opus-4-8"
        },
        "claude-opus-5": {
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "claude-opus-5"
        }
      },
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "{file:~/.local/share/opencode/secrets/linxi-api-key}",
        "baseURL": "https://k40.shengqainbang.cn/v1",
        "setCacheKey": true
      }
    },
    "ly": {
      "models": {
        "claude-fable-5": {
          "name": "claude-fable-5"
        },
        "claude-opus-5": {
          "name": "claude-opus-5"
        },
        "gpt-5.5": {
          "name": "gpt-5.5"
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "reasoning": true,
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "gpt-5.6-terra": {
          "name": "gpt-5.6-terra"
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{file:~/.local/share/opencode/secrets/ly-api-key}",
        "baseURL": "https://free.lyclaude.site/v1",
        "setCacheKey": true
      }
    }
  },
  "references": {
    "linux-docs": {
      "description": "Use when Linux or system configuration work needs existing local notes.",
      "path": "~/md/linux"
    },
    "nvim-docs": {
      "description": "Use when Neovim configuration changes require documentation sync.",
      "path": "~/md/nvim"
    },
    "opencode-changelog": {
      "description": "Use when auditing recurring opencode configuration incidents or checking past fixes.",
      "path": "~/.config/opencode/docs/changelog.md"
    },
    "opencode-config": {
      "description": "Use when editing global opencode configuration, agents, skills, plugins, commands, or documentation.",
      "path": "~/.config/opencode"
    }
  },
  "share": "manual",
  "shell": "/usr/bin/bash",
  "skills": {
    "paths": [
      "~/.config/opencode/skills"
    ]
  },
  "small_model": "opencode/deepseek-v4-flash-free",
  "tool_output": {
    "max_bytes": 65536,
    "max_lines": 2000
  }
}
