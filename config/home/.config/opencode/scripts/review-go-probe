#!/usr/bin/env bash
# Read-only verification helper for the reviewer agent.
#
# Runs a reviewer-supplied Go test against a module under review WITHOUT
# writing anything into that module. The probe source arrives on stdin and is
# placed in a scratch module outside the repository, wired to the real package
# via a `replace` directive so the actual code under review is exercised.
#
# Usage:
#   review-go-probe <module-dir> [go-test-args...] <<'EOF'
#   package probe_test
#   import ( "testing"; "<module-path>/<pkg-under-review>" )
#   func TestX(t *testing.T) { ... }
#   EOF
#
# Defaults to `-race -count=10` when no go-test args are given, because
# single-run tests routinely miss check-then-act races.
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: review-go-probe <module-dir> [go-test-args...] < probe_test.go" >&2
  exit 64
fi

mod_dir=$(cd "$1" && pwd) || exit 64
shift

if [[ ! -f "$mod_dir/go.mod" ]]; then
  echo "error: no go.mod in $mod_dir" >&2
  exit 64
fi

mod_name=$(awk '$1=="module"{print $2; exit}' "$mod_dir/go.mod")
if [[ -z "$mod_name" ]]; then
  echo "error: could not read module name from $mod_dir/go.mod" >&2
  exit 64
fi

go_version=$(awk '$1=="go"{print $2; exit}' "$mod_dir/go.mod")
[[ -n "$go_version" ]] || go_version=1.21

probe_src=$(cat)
if [[ -z "${probe_src//[[:space:]]/}" ]]; then
  echo "error: empty probe source on stdin" >&2
  exit 64
fi

scratch=$(mktemp -d "${TMPDIR:-/tmp}/review-go-probe.XXXXXX")
trap 'rm -rf "$scratch"' EXIT

cat >"$scratch/go.mod" <<EOF
module reviewprobe

go $go_version

require $mod_name v0.0.0

replace $mod_name => $mod_dir
EOF

printf '%s\n' "$probe_src" >"$scratch/probe_test.go"

args=("$@")
if [[ ${#args[@]} -eq 0 ]]; then
  args=(-race -count=10)
fi

# GOFLAGS=-mod=mod lets the scratch module resolve the replace target without
# a go.sum entry. The module under review is never modified.
cd "$scratch"
GOFLAGS=-mod=mod timeout 180 go test "${args[@]}" ./... 2>&1
