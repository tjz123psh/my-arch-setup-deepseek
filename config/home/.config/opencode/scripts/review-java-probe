#!/usr/bin/env bash
# Read-only verification helper for the reviewer agent.
#
# Compiles the Java sources under review into a scratch directory and runs a
# reviewer-supplied jshell snippet against them. Nothing is written into the
# repository, and jshell always receives stdin plus an explicit exit so it can
# never block on its interactive prompt.
#
# Usage:
#   review-java-probe <source-root> <<'EOF'
#   var obj = new com.example.pkg.ClassUnderReview();
#   System.out.println(obj.methodUnderReview(args));
#   EOF
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: review-java-probe <source-root> < snippet.jsh" >&2
  exit 64
fi

src_root=$(cd "$1" && pwd) || exit 64
shift

snippet=$(cat)
if [[ -z "${snippet//[[:space:]]/}" ]]; then
  echo "error: empty snippet on stdin" >&2
  exit 64
fi

mapfile -t sources < <(find "$src_root" -name '*.java' -type f)
if [[ ${#sources[@]} -eq 0 ]]; then
  echo "error: no .java files under $src_root" >&2
  exit 64
fi

scratch=$(mktemp -d "${TMPDIR:-/tmp}/review-java-probe.XXXXXX")
trap 'rm -rf "$scratch"' EXIT

classes="$scratch/classes"
mkdir -p "$classes"

if ! timeout 120 javac -nowarn -d "$classes" "${sources[@]}" 2>&1; then
  echo "error: javac failed; cannot verify" >&2
  exit 65
fi

# The JVM reads user.home from /etc/passwd, not $HOME, so under a sandbox with a
# read-only real home it floods stderr with java.util.prefs warnings. Pointing
# user.home at $HOME keeps the probe output free of that noise.
#
# /exit guarantees termination even if the snippet leaves jshell mid-statement.
{
  printf '%s\n' "$snippet"
  printf '/exit\n'
} | timeout 120 jshell -q -J-Duser.home="$HOME" \
  --class-path "$classes" --execution local - 2>&1
