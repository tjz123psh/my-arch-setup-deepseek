#!/usr/bin/env bash
# Runs one verification command inside a bubblewrap sandbox.
#
# Purpose: verification channels (python -c, node -e, cargo test, go test,
# javac/jshell, lua, nvim -l) all execute code. Prompt text asking the reviewer
# to "stay read-only" is not an enforcement mechanism. This wrapper makes the
# read-only property structural: the reviewed tree and every toolchain cache is
# bind-mounted read-only, $HOME is not visible at all (so no credential file can
# be read or exfiltrated), and the network namespace is empty.
#
# Usage: review-run <verb> [args...]
#   verb must be one of the ALLOWED_VERBS below. Argument values are passed
#   through untouched; no shell re-parsing happens inside the sandbox.
#
# The two probe scripts are allowed as verbs. They need to compile
# reviewer-supplied source somewhere; their mktemp scratch lands on the
# sandbox's own /tmp tmpfs, so it is writable, invisible to the host, and gone
# when the command returns.
#
# Exit codes: 64 usage error, 65 rejected verb, 124 timeout, otherwise the
# child's status.
set -uo pipefail

readonly SCRIPT_DIR=/home/pang/.config/opencode/scripts

# Hard wall-clock ceiling. Every verb here executes code under review, so an
# infinite loop, a deadlock, or a command that waits on stdin would otherwise
# hang the calling session with no way to interrupt it. The two probe scripts
# impose their own tighter limits; this covers the bare verbs, which had none.
readonly TIMEOUT_SECONDS=180

# Bare tool names, plus the two probe wrappers by absolute path. The probes are
# shell scripts, but they are fixed, reviewed code -- not reviewer-supplied --
# so allowing them does not reintroduce arbitrary shell.
readonly ALLOWED_VERBS=(
  python python3 pytest node cargo go gofmt javac java jshell
  lua luac nvim stylua rustfmt
  "$SCRIPT_DIR/review-go-probe"
  "$SCRIPT_DIR/review-java-probe"
)

die() {
  printf 'review-run: %s\n' "$1" >&2
  exit "${2:-64}"
}

[ "$#" -ge 1 ] || die "usage: review-run <verb> [args...]"

verb=$1
shift

verb_ok=false
for allowed in "${ALLOWED_VERBS[@]}"; do
  if [ "$verb" = "$allowed" ]; then
    verb_ok=true
    break
  fi
done
if [ "$verb_ok" != true ]; then
  die "verb '$verb' is not permitted inside the sandbox (allowed: ${ALLOWED_VERBS[*]})" 65
fi

# Resolve to an absolute path on the host before we lose $PATH context.
verb_path=$(command -v -- "$verb") || die "verb '$verb' not found on this system" 65

# The tree under review. Bound read-only; cwd must stay inside it.
target=${PWD}
[ -d "$target" ] || die "current directory does not exist"

command -v bwrap >/dev/null 2>&1 || die "bwrap (bubblewrap) is required but not installed"

# jshell lives under the JDK, not /usr/bin, so it needs to be on PATH explicitly.
jvm_bin=""
for candidate in /usr/lib/jvm/default/bin /usr/lib/jvm/*/bin; do
  if [ -x "$candidate/jshell" ]; then
    jvm_bin=$candidate
    break
  fi
done

# Scratch space lives on a tmpfs inside the sandbox, so build output never
# reaches the reviewed tree and never survives the command.
bind_args=(
  --unshare-net
  --unshare-ipc
  --unshare-uts
  --unshare-pid
  --die-with-parent
  --new-session
  --ro-bind /usr /usr
  --symlink usr/bin /bin
  --symlink usr/bin /sbin
  --symlink usr/lib /lib
  --symlink usr/lib /lib64
  --ro-bind /etc/passwd /etc/passwd
  --ro-bind /etc/group /etc/group
  --ro-bind-try /etc/ssl /etc/ssl
  --ro-bind-try /etc/java-openjdk /etc/java-openjdk
  --ro-bind-try /etc/ld.so.cache /etc/ld.so.cache
  --proc /proc
  --dev /dev
  --tmpfs /tmp
  --tmpfs /scratch
  --dir /scratch/home
  # The JVM writes user prefs under $HOME and floods stderr with warnings if the
  # directory is missing, which would pollute the evidence a reviewer quotes.
  --dir /scratch/home/.java/.userPrefs
  --dir /scratch/home/.java/.systemPrefs
  # /home is a fresh tmpfs: nothing of the real home is visible except the
  # explicit binds below. It is remounted read-only afterwards so that a write
  # to some path under /home fails loudly instead of silently landing on
  # throwaway sandbox space and looking like it succeeded.
  --tmpfs /home
  --ro-bind "$target" "$target"
  # The probe wrappers themselves must be readable inside the sandbox.
  --ro-bind "$SCRIPT_DIR" "$SCRIPT_DIR"
  --chdir "$target"
)

# Toolchain state is read-only: the reviewer may consume the module/crate cache
# but cannot poison it for later real builds.
for cache in "$HOME/.cargo" "$HOME/.rustup" "$HOME/go/pkg/mod"; do
  [ -d "$cache" ] && bind_args+=(--ro-bind "$cache" "$cache")
done

# Must come after every bind that lands under /home.
bind_args+=(--remount-ro /home)

exec timeout --kill-after=10s "$TIMEOUT_SECONDS" \
  bwrap "${bind_args[@]}" \
  --setenv HOME /scratch/home \
  --setenv TMPDIR /tmp \
  --setenv PATH "/usr/bin:/usr/local/bin:$jvm_bin" \
  --setenv CARGO_TARGET_DIR /scratch/target \
  --setenv CARGO_HOME "$HOME/.cargo" \
  --setenv RUSTUP_HOME "$HOME/.rustup" \
  --setenv GOFLAGS -mod=mod \
  --setenv GOCACHE /scratch/go-build \
  --setenv GOMODCACHE "$HOME/go/pkg/mod" \
  --setenv GOPATH /scratch/go \
  --setenv GOTMPDIR /tmp \
  --setenv PYTHONDONTWRITEBYTECODE 1 \
  --setenv NO_COLOR 1 \
  -- "$verb_path" "$@"
