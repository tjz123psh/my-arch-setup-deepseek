#!/usr/bin/env bash
# 描述：预览和清理用户级缓存
# Description: Preview and clean user-level caches

set -euo pipefail

UI_LIB="$(dirname "$(readlink -f "$0")")/lib/ui.sh"
# shellcheck source=lib/ui.sh
. "$UI_LIB"
CONFIG_LIB="$(dirname "$UI_LIB")/config.sh"
# shellcheck source=lib/config.sh
. "$CONFIG_LIB"
maintenance_config_load || exit 2
THUMBNAIL_MAX_AGE_DAYS="$(maintenance_config_get THUMBNAIL_MAX_AGE_DAYS 30 CACHE_THUMBNAIL_MAX_AGE_DAYS)"

MODE_LIST=true
MODE_SAFE=false
MODE_DEV=false
MODE_CHROME=false
ASSUME_YES=false
CACHE_FAILED=0

usage() {
  cat <<'EOF'
Usage: cache-clean [options]

默认只预览缓存体积，不删除任何文件。

Options:
  --list             只列出缓存体积（默认）
  --safe             保守清理：go-build、pip、缩略图、opencode cache、paru-ui cache
  --dev              开发缓存：go-build、pip、npm cache
  --chrome           清理 Chrome HTTP/Code/GPU 缓存，不删除登录态、书签和历史
  --all-safe         等同于 --safe --dev --chrome
  -y, --yes          跳过确认
  -h, --help         显示帮助并退出

不处理：
  ~/.local/share/opencode/opencode.db
  ~/.local/share/nvim/mason
  ~/.rustup
  ~/.cargo
  ~/.config/google-chrome
EOF
}

die_usage() {
  printf '错误: %s\n' "$1" >&2
  usage >&2
  exit 2
}

require_deps() {
  local missing=()
  local cmd

  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done

  if (( ${#missing[@]} > 0 )); then
    printf '错误: 缺少依赖: %s\n' "${missing[*]}" >&2
    exit 127
  fi
}

info() { ui_info "%s" "$*"; }
ok()   { ui_ok   "%s" "$*"; }
warn() { ui_warn "%s" "$*"; }

# 目录字节数（无权限子目录会被 du 跳过，吞掉退出码；不存在按 0 计）
dir_bytes() {
  local path="$1"
  local out=''
  [[ -e "$path" ]] || { printf '0'; return; }
  out="$(du -sb -- "$path" 2>/dev/null | awk '{print $1; exit}')" || true
  printf '%s' "${out:-0}"
}

# 本次所选模式会清理的目录总字节，用于清理前后对比
# 多模式（如 --all-safe）会有重复目录，用关联数组去重，避免释放量虚高。
target_bytes() {
  local total=0 p
  local -A seen=()
  if [[ "$MODE_SAFE" == true ]]; then
    for p in "$HOME/.cache/go-build" "$HOME/.cache/pip" "$HOME/.cache/opencode" "$HOME/.cache/paru-ui" "$HOME/.cache/thumbnails"; do
      seen["$p"]=1
    done
  fi
  if [[ "$MODE_DEV" == true ]]; then
    for p in "$HOME/.cache/go-build" "$HOME/.cache/pip" "$HOME/.npm"; do
      seen["$p"]=1
    done
  fi
  if [[ "$MODE_CHROME" == true ]]; then
    for p in "$HOME/.cache/google-chrome" "$HOME/.config/google-chrome"; do
      seen["$p"]=1
    done
  fi
  for p in "${!seen[@]}"; do
    total=$(( total + $(dir_bytes "$p") ))
  done
  printf '%s' "$total"
}

# 字节 → 人类可读（B/K/M/G/T，保留一位小数）
fmt_bytes() {
  awk -v b="${1:-0}" 'BEGIN{
    split("B K M G T P", u, " ")
    i = 1
    while (b >= 1024 && i < 6) { b /= 1024; i++ }
    if (i == 1) printf "%d %s", b, u[i]
    else        printf "%.1f %s", b, u[i]
  }'
}

# 概览单行：标签(18显示列) + 右对齐体积 + 备注（备注可指定颜色）
cache_row() {
  local label="$1" path="$2" note="$3" note_color="${4:-$UI_DIM}"
  local size
  size="$(fmt_bytes "$(dir_bytes "$path")")"
  printf '  %s  %s%9s%s   %s%s%s\n' \
    "$(ui_pad "$label" 18)" \
    "$UI_C_TEXT" "$size" "$UI_RESET" \
    "$note_color" "$note" "$UI_RESET"
}

# 缓存概览：按“能不能被本工具清理”分三组，一眼看清清理范围。
show_list() {
  ui_section '可清理缓存'
  printf '  %s可安全重建，删了下次用会自动再生成%s\n\n' "$UI_DIM" "$UI_RESET"
  cache_row 'go build'      "$HOME/.cache/go-build"          '保守 · 开发' "$UI_C_GREEN"
  cache_row 'pip'           "$HOME/.cache/pip"               '保守 · 开发' "$UI_C_GREEN"
  cache_row 'npm'           "$HOME/.npm"                     '开发'        "$UI_C_GREEN"
  cache_row 'opencode 缓存' "$HOME/.cache/opencode"          '保守'        "$UI_C_GREEN"
  cache_row 'paru-ui'       "$HOME/.cache/paru-ui"           '保守'        "$UI_C_GREEN"
  cache_row '缩略图'        "$HOME/.cache/thumbnails"        '保守 · 30 天前' "$UI_C_GREEN"
  cache_row 'Chrome 缓存'   "$HOME/.cache/google-chrome"     'Chrome'      "$UI_C_GREEN"

  ui_section '系统级缓存'
  printf '  %s不在这里清，用「系统清理」里的常规/深度清理%s\n\n' "$UI_DIM" "$UI_RESET"
  cache_row 'pacman 包缓存' '/var/cache/pacman/pkg'          '降级要用到，谨慎清'

  ui_section '保留不动'
  printf '  %s状态数据和工具链，本工具永远不碰%s\n\n' "$UI_DIM" "$UI_RESET"
  cache_row 'nvim 缓存'     "$HOME/.cache/nvim"              '含 jdtls，重建慢'
  cache_row 'opencode 数据' "$HOME/.local/share/opencode"    '会话与数据库'
  cache_row 'nvim mason'    "$HOME/.local/share/nvim/mason"  'LSP/DAP 工具'
  cache_row 'rustup'        "$HOME/.rustup"                  'Rust 工具链'
  cache_row 'cargo'         "$HOME/.cargo"                   'registry / bin / git'
}

confirm() {
  local title="$1"

  if [[ "$ASSUME_YES" == true ]]; then
    return 0
  fi

  printf '\n'
  ui_confirm_word "$title" "yes"
}

remove_dir_contents() {
  local path="$1"

  [[ -d "$path" ]] || return 0
  find "$path" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
}

remove_old_files() {
  local path="$1"
  local days="$2"

  [[ -d "$path" ]] || return 0
  local failed=0
  find "$path" -type f -atime "+$days" -delete 2>/dev/null || failed=1
  find "$path" -type d -empty -delete 2>/dev/null || failed=1
  return "$failed"
}

clean_safe() {
  info '保守清理用户缓存'
  remove_dir_contents "$HOME/.cache/go-build" || { warn 'go build 缓存清理失败'; CACHE_FAILED=1; }
  remove_dir_contents "$HOME/.cache/pip" || { warn 'pip 缓存清理失败'; CACHE_FAILED=1; }
  remove_dir_contents "$HOME/.cache/opencode" || { warn 'opencode 缓存清理失败'; CACHE_FAILED=1; }
  remove_dir_contents "$HOME/.cache/paru-ui" || { warn 'paru-ui 缓存清理失败'; CACHE_FAILED=1; }
  remove_old_files "$HOME/.cache/thumbnails" "$THUMBNAIL_MAX_AGE_DAYS" \
    || { warn '缩略图缓存清理失败'; CACHE_FAILED=1; }
  [[ "$CACHE_FAILED" -ne 0 ]] || ok '保守缓存已清理'
}

clean_dev() {
  info '清理开发缓存'
  remove_dir_contents "$HOME/.cache/go-build" || { warn 'go build 缓存清理失败'; CACHE_FAILED=1; }
  remove_dir_contents "$HOME/.cache/pip" || { warn 'pip 缓存清理失败'; CACHE_FAILED=1; }

  if command -v npm >/dev/null 2>&1; then
    if ! npm cache clean --force >/dev/null 2>&1; then
      warn 'npm cache clean 失败，已跳过'
      CACHE_FAILED=1
    fi
  elif [[ -d "$HOME/.npm/_cacache" ]]; then
    remove_dir_contents "$HOME/.npm/_cacache" || { warn 'npm 缓存目录清理失败'; CACHE_FAILED=1; }
  fi

  [[ "$CACHE_FAILED" -ne 0 ]] || ok '开发缓存已清理'
}

clean_chrome_profile_cache() {
  local profile="$1"
  local item
  local rels=(
    'Cache'
    'Code Cache'
    'GPUCache'
    'DawnCache'
    'GrShaderCache'
    'ShaderCache'
    'Service Worker/CacheStorage'
    'Service Worker/ScriptCache'
  )

  [[ -d "$profile" ]] || return 0

  for item in "${rels[@]}"; do
    if [[ -d "$profile/$item" ]]; then
      remove_dir_contents "$profile/$item" || { warn "Chrome 缓存清理失败: $profile/$item"; CACHE_FAILED=1; }
    fi
  done
}

clean_chrome() {
  local chrome_cache="$HOME/.cache/google-chrome"
  local chrome_config="$HOME/.config/google-chrome"
  local profile

  info '清理 Chrome 缓存'
  remove_dir_contents "$chrome_cache" || { warn 'Chrome HTTP 缓存清理失败'; CACHE_FAILED=1; }

  if [[ -d "$chrome_config" ]]; then
    clean_chrome_profile_cache "$chrome_config/Default"
    while IFS= read -r -d '' profile; do
      clean_chrome_profile_cache "$profile"
    done < <(find "$chrome_config" -maxdepth 1 -type d -name 'Profile *' -print0 2>/dev/null)
  fi

  [[ "$CACHE_FAILED" -ne 0 ]] || ok 'Chrome 缓存已清理'
}

# 本次模式实际会碰的目录（用于清理前后对比与计划展示）。
# 输出每行一个路径，去重由调用方处理。
target_paths() {
  if [[ "$MODE_SAFE" == true ]]; then
    printf '%s\n' \
      "$HOME/.cache/go-build" \
      "$HOME/.cache/pip" \
      "$HOME/.cache/opencode" \
      "$HOME/.cache/paru-ui" \
      "$HOME/.cache/thumbnails"
  fi
  if [[ "$MODE_DEV" == true ]]; then
    printf '%s\n' \
      "$HOME/.cache/go-build" \
      "$HOME/.cache/pip" \
      "$HOME/.npm"
  fi
  if [[ "$MODE_CHROME" == true ]]; then
    printf '%s\n' "$HOME/.cache/google-chrome"
  fi
}

# 聚焦预览：只列出本次所选模式会清理的缓存及体积，不展示无关项。
#   概览(--list)才用 show_list 的全景三分组；清理模式用这个精简视图。
show_targets() {
  ui_section '将清理以下缓存'
  printf '  %s以下内容都可安全重建，删除后下次使用会自动生成%s\n' "$UI_DIM" "$UI_RESET"

  if [[ "$MODE_SAFE" == true ]]; then
    printf '\n'
    ui_subsection '保守清理'
    cache_row 'go build'      "$HOME/.cache/go-build"   'Go 编译缓存'        "$UI_C_GREEN"
    cache_row 'pip'           "$HOME/.cache/pip"        'pip 下载缓存'       "$UI_C_GREEN"
    cache_row 'opencode 缓存' "$HOME/.cache/opencode"   '临时缓存 · 不含数据库' "$UI_C_GREEN"
    cache_row 'paru-ui'       "$HOME/.cache/paru-ui"    'AUR 界面缓存'       "$UI_C_GREEN"
    cache_row '缩略图'        "$HOME/.cache/thumbnails" '仅删 30 天前的'     "$UI_C_GREEN"
  fi
  if [[ "$MODE_DEV" == true ]]; then
    printf '\n'
    ui_subsection '开发缓存'
    cache_row 'go build' "$HOME/.cache/go-build" 'Go 编译缓存'       "$UI_C_GREEN"
    cache_row 'pip'      "$HOME/.cache/pip"      'pip 下载缓存'      "$UI_C_GREEN"
    cache_row 'npm'      "$HOME/.npm"            '执行 npm cache clean' "$UI_C_GREEN"
  fi
  if [[ "$MODE_CHROME" == true ]]; then
    printf '\n'
    ui_subsection 'Chrome 缓存'
    cache_row 'Chrome 缓存' "$HOME/.cache/google-chrome" 'HTTP 缓存目录' "$UI_C_GREEN"
    printf '  %s  %s另清理配置目录内 Code / GPU / Service Worker 缓存（建议先关闭 Chrome）%s\n' \
      "$(ui_pad '' 18)" "$UI_DIM" "$UI_RESET"
  fi

  printf '\n  %s不会动：opencode 数据库 · nvim mason · Rust/Cargo · Chrome 登录态与历史%s\n' \
    "$UI_DIM" "$UI_RESET"
}

# --- 参数解析 ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    --list)
      MODE_LIST=true
      shift
      ;;
    --safe)
      MODE_LIST=false
      MODE_SAFE=true
      shift
      ;;
    --dev)
      MODE_LIST=false
      MODE_DEV=true
      shift
      ;;
    --chrome)
      MODE_LIST=false
      MODE_CHROME=true
      shift
      ;;
    --all-safe)
      MODE_LIST=false
      MODE_SAFE=true
      MODE_DEV=true
      MODE_CHROME=true
      shift
      ;;
    -y|--yes)
      ASSUME_YES=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die_usage "未知参数: $1"
      ;;
  esac
done

# --- 依赖检查 ---
require_deps du awk find rm

# --- 主逻辑 ---
ui_banner "用户缓存" "cache-clean · 预览与清理"

if [[ "$MODE_LIST" == true ]]; then
  show_list
  exit 0
fi

show_targets

if ! confirm '即将删除上述缓存。'; then
  warn '已取消'
  exit 0
fi

ui_maintenance_lock_acquire "用户缓存清理" || exit $?
before="$(target_bytes)"

[[ "$MODE_SAFE" == true ]] && clean_safe
[[ "$MODE_DEV" == true ]] && clean_dev
[[ "$MODE_CHROME" == true ]] && clean_chrome

after="$(target_bytes)"
freed=$(( before - after ))
(( freed < 0 )) && freed=0

ui_section '清理结果'
printf '  %s清理前%s  %s\n' "$UI_C_SUBTLE" "$UI_RESET" "$(fmt_bytes "$before")"
printf '  %s清理后%s  %s\n' "$UI_C_SUBTLE" "$UI_RESET" "$(fmt_bytes "$after")"
printf '  %s%s已释放 %s%s%s\n' \
  "$UI_BOLD" "$UI_C_GREEN" "$(fmt_bytes "$freed")" "$UI_RESET" ''

if [[ "$CACHE_FAILED" -ne 0 ]]; then
  warn '缓存清理已完成，但至少一个步骤失败。'
  exit 1
fi
