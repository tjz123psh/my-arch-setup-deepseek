#!/usr/bin/env bash
# shellcheck disable=SC2059
# 描述： 快速存档，创建快照
# Description: Quicksave btrfs snapshots
# quicksave - Btrfs Snapshot Quick Save Utility
# (Companion to quickload)
#

set -euo pipefail

UI_LIB="$(dirname "$(readlink -f "$0")")/lib/ui.sh"
# shellcheck source=lib/ui.sh
. "$UI_LIB"

# ==========================================
# 1. 文案（纯中文）
# ==========================================
MSG_HELP_DESC="快速创建或管理 Btrfs 快照 (无需 Root 权限即可运行)。"
MSG_HELP_OPT="选项:"
MSG_HELP_C="  -c, --config <配置名>     指定操作的快照配置 (默认: 检测到的所有配置)"
MSG_HELP_D="  -d, --description <描述>  指定快照描述 (默认: quicksave)"
MSG_HELP_LC="  -lc, --list-configs       列出系统中可用的快照配置"
MSG_HELP_L="  -l, --list                列出指定配置下的现有快照列表 (未指定 -c 时默认仅显示 root)"
MSG_HELP_DEL="  -del, --delete <ID|all>   删除指定 ID 的快照或全部删除 (建议配合 -c 使用，默认 root)"
MSG_HELP_Y="  -y, --yes                  删除时跳过确认（用于明确的非交互调用）"
MSG_HELP_X="  -x, --debug               开启调试模式"
MSG_HELP_H="  -h, --help                显示此帮助信息"

MSG_ERR_DEP="错误: 未找到依赖命令 '%s'，请确保已安装。\n"
MSG_ERR_NOCONF="错误: 未检测到任何 snapper 配置。"
MSG_ERR_BADCONF="错误: 找不到指定的快照配置 [%s]。"

MSG_FIX_PERM_BODY="配置 [%s] 无法由当前用户读取。"
MSG_FIX_PERM_FAIL="自动修复权限失败，请检查密码或手动配置。"

MSG_CLEAN_OK="旧快照清理完成"
MSG_SAVE_OK="存档成功"

MSG_DEL_OK="快照删除成功"
MSG_DEL_BODY="已删除配置 [%s] 中的快照 #%s"
MSG_DEL_ALL_BODY="已清空配置 [%s] 中的所有快照"
MSG_DEL_FAIL="快照删除失败"
MSG_DEL_EMPTY="配置 [%s] 中没有可供删除的快照"

print_help() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

${MSG_HELP_DESC}

${MSG_HELP_OPT}
${MSG_HELP_C}
${MSG_HELP_D}
${MSG_HELP_LC}
${MSG_HELP_L}
${MSG_HELP_DEL}
${MSG_HELP_Y}
${MSG_HELP_X}
${MSG_HELP_H}
EOF
}

# ==========================================
# 2. 通知与日志引擎
# ==========================================
notify_err() {
    local msg
    msg=$(printf "$@")
    ui_err "%s" "$msg"
    if [[ "${MAINTENANCE_NO_NOTIFY:-0}" != "1" ]] \
        && [[ ! -t 0 || ! -t 1 ]] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical -a "Quicksave" "错误" "$msg" 2>/dev/null || true
    fi
}

notify_ok() {
    local title="$1"
    local body="${2:-}"
    ui_ok "%s" "$title: $body"
    if [[ "${MAINTENANCE_NO_NOTIFY:-0}" != "1" ]] \
        && [[ ! -t 0 || ! -t 1 ]] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u normal -a "Quicksave" "$title" "$body" 2>/dev/null || true
    fi
}

# ==========================================
# 3. 参数解析
# ==========================================
OPT_CONFIG=""
OPT_DESC="quicksave"
OPT_LIST_CONFIGS=0
OPT_LIST=0
OPT_DELETE=()
OPT_DEBUG=0
OPT_YES=0

while [[ $# -gt 0 ]]; do
    case "${1:-}" in
        -c|--config)
            if [[ $# -lt 2 ]]; then notify_err "参数 %s 缺少取值" "$1"; exit 1; fi
            OPT_CONFIG="$2"; shift 2 ;;
        -d|--description)
            if [[ $# -lt 2 ]]; then notify_err "参数 %s 缺少取值" "$1"; exit 1; fi
            OPT_DESC="$2"; shift 2 ;;
        -del|--delete)
            if [[ $# -lt 2 ]]; then notify_err "参数 %s 缺少取值" "$1"; exit 1; fi
            OPT_DELETE+=("$2"); shift 2 ;;
        -y|--yes) OPT_YES=1; shift 1 ;;
        -lc|--list-configs) OPT_LIST_CONFIGS=1; shift 1 ;;
        -l|--list) OPT_LIST=1; shift 1 ;;
        -x|--debug) OPT_DEBUG=1; shift 1 ;;
        -h|--help) print_help; exit 0 ;;
        *) notify_err "未知参数: %s" "${1:-}"; exit 1 ;;
    esac
done

if [[ $OPT_DEBUG -eq 1 ]]; then
    set -x
    echo "=== 调试模式启动 ===" >&2
fi

# ==========================================
# 4. 依赖检查与配置发现
# ==========================================
for cmd in btrfs snapper awk; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        notify_err "$MSG_ERR_DEP" "$cmd"
        exit 1
    fi
done

declare -A CONFIG_MAP
CONFIG_COUNT=0
SNAP_SEP=$'\037'
CONFIG_ROWS=""

# 使用机器可读输出，避免本地化表头和 Unicode 边框改变解析结果。
if ! CONFIG_ROWS="$(snapper --csvout --separator "$SNAP_SEP" list-configs 2>/dev/null)"; then
    notify_err "Snapper 配置查询失败，无法继续。"
    exit 1
fi
while IFS="$SNAP_SEP" read -r conf subvol; do
    [[ "$conf" == "config" || -z "$conf" ]] && continue
    CONFIG_MAP["$conf"]="$subvol"
    CONFIG_COUNT=$((CONFIG_COUNT + 1))
done <<< "$CONFIG_ROWS"

if [[ $CONFIG_COUNT -eq 0 ]]; then
    notify_err "$MSG_ERR_NOCONF"
    exit 1
fi

if [[ $OPT_LIST_CONFIGS -eq 1 ]]; then
    for conf in "${!CONFIG_MAP[@]}"; do
        echo "$conf"
    done
    exit 0
fi

TARGETS=()
if [[ -n "$OPT_CONFIG" ]]; then
    if [[ -z "${CONFIG_MAP[$OPT_CONFIG]:-}" ]]; then
        notify_err "$MSG_ERR_BADCONF" "$OPT_CONFIG"
        exit 1
    fi
    TARGETS=("$OPT_CONFIG")
else
    [[ -n "${CONFIG_MAP[root]:-}" ]] && TARGETS+=("root")
    [[ -n "${CONFIG_MAP[home]:-}" ]] && TARGETS+=("home")
    while IFS= read -r conf; do
        [[ "$conf" == "root" || "$conf" == "home" ]] && continue
        TARGETS+=("$conf")
    done < <(printf '%s\n' "${!CONFIG_MAP[@]}" | sort)
fi

if [[ $OPT_LIST -ne 1 ]]; then
    ui_maintenance_lock_acquire "快照创建或删除" || exit $?
fi

# ==========================================
# 5. 权限校验与自动修复 (延迟提权)
# ==========================================
for conf in "${TARGETS[@]}"; do
    config_error=""
    if ! config_error="$(LC_ALL=C snapper -c "$conf" get-config 2>&1)"; then
        if ! grep -Eqi 'permission denied|access denied|not authorized|not permitted|not allowed|no ?permission|NoPermission|AccessDenied|authorization' \
            <<< "$config_error"; then
            notify_err "Snapper 配置 [%s] 查询失败，错误并非权限不足，已拒绝修改授权。\n%s" \
                "$conf" "${config_error:-无错误输出}"
            exit 1
        fi
        ui_warn "%s" "$(printf "$MSG_FIX_PERM_BODY" "$conf")"
        [[ -n "$config_error" ]] && ui_warn "Snapper 返回：%s" "$config_error"
        if ! ui_confirm "是否明确授权 wheel 组访问配置 [$conf]？" n; then
            notify_err "未修改 Snapper 权限。可检查配置后手动执行：sudo snapper -c %s set-config ALLOW_GROUPS=wheel SYNC_ACL=yes" "$conf"
            exit 1
        fi
        ui_maintenance_lock_acquire "Snapper 权限修改" || exit $?
        if ! command -v pkexec >/dev/null 2>&1 \
            || ! pkexec snapper -c "$conf" set-config ALLOW_GROUPS="wheel" SYNC_ACL="yes" \
            || ! snapper -c "$conf" get-config >/dev/null 2>&1; then
            notify_err "$MSG_FIX_PERM_FAIL"
            exit 1
        fi
    fi
done

# ==========================================
# 6. 处理特殊动作：列表与删除
# ==========================================
# 动作: 列出快照
if [[ $OPT_LIST -eq 1 ]]; then
    LIST_TARGETS=("${TARGETS[@]}")
    LIST_SUCCESS=1
    if [[ -z "$OPT_CONFIG" && -n "${CONFIG_MAP["root"]:-}" ]]; then
        LIST_TARGETS=("root")
    fi

    for conf in "${LIST_TARGETS[@]}"; do
        ui_panel_open "配置 [$conf] 的快照"
        list_output=""
        if list_output="$(snapper -c "$conf" list 2>&1)"; then
            printf '%s\n' "$list_output" | ui_panel_raw
        else
            ui_panel_stat err "快照列表查询失败：[$conf]"
            [[ -z "$list_output" ]] || printf '%s\n' "$list_output" | ui_panel_raw
            LIST_SUCCESS=0
        fi
        ui_panel_close
    done
    [[ "$LIST_SUCCESS" -eq 1 ]] && exit 0
    exit 1
fi

# 动作: 删除指定快照
if [[ ${#OPT_DELETE[@]} -gt 0 ]]; then
  DEL_TARGET="${OPT_CONFIG:-root}"
  DELETE_SUCCESS=1
    if [[ -z "${CONFIG_MAP[$DEL_TARGET]:-}" ]]; then
        notify_err "$MSG_ERR_BADCONF" "$DEL_TARGET"
        exit 1
    fi

    # 检查是否包含全选指令 all
    is_delete_all=0
    for id in "${OPT_DELETE[@]}"; do
        # 兼容大小写 (all, ALL, All)
        if [[ "${id,,}" == "all" ]]; then
            is_delete_all=1
            break
        fi
    done

    if [[ $is_delete_all -eq 1 ]]; then
        # 提取所有快照 ID（不包括表头和代表系统的 0 号）
        all_rows=""
        if ! all_rows="$(snapper --csvout --separator "$SNAP_SEP" -c "$DEL_TARGET" list --columns number 2>/dev/null)"; then
            notify_err "配置 [%s] 的快照列表查询失败，未执行删除。" "$DEL_TARGET"
            exit 1
        fi
        mapfile -t all_ids < <(
            awk -F "$SNAP_SEP" '$1 ~ /^[0-9]+$/ && $1 != "0" {print $1}' <<< "$all_rows"
        )

        if [[ ${#all_ids[@]} -gt 0 ]]; then
            if [[ $OPT_YES -ne 1 ]] && ! ui_confirm_word "将删除配置 [$DEL_TARGET] 的全部 ${#all_ids[@]} 个快照。" "delete"; then
                ui_warn "已取消删除"
                exit 0
            fi
            if snapper -c "$DEL_TARGET" delete "${all_ids[@]}"; then
                notify_ok "$MSG_DEL_OK" "$(printf "$MSG_DEL_ALL_BODY" "$DEL_TARGET")"
            else
                notify_err "%s（全部）" "$MSG_DEL_FAIL"
                DELETE_SUCCESS=0
            fi
        else
            printf "$MSG_DEL_EMPTY\n" "$DEL_TARGET"
        fi
    else
        for snap_id in "${OPT_DELETE[@]}"; do
            if [[ ! "$snap_id" =~ ^[1-9][0-9]*$ ]]; then
                notify_err "无效的快照 ID: %s" "$snap_id"
                exit 1
            fi
        done
        if [[ $OPT_YES -ne 1 ]] && ! ui_confirm_word "将删除配置 [$DEL_TARGET] 的快照：${OPT_DELETE[*]}。" "delete"; then
            ui_warn "已取消删除"
            exit 0
        fi
        # 逐个删除指定 ID
        for snap_id in "${OPT_DELETE[@]}"; do
            if snapper -c "$DEL_TARGET" delete "$snap_id"; then
                notify_ok "$MSG_DEL_OK" "$(printf "$MSG_DEL_BODY" "$DEL_TARGET" "$snap_id")"
            else
                notify_err "%s（ID: %s）" "$MSG_DEL_FAIL" "$snap_id"
                DELETE_SUCCESS=0
            fi
        done
    fi
    [[ $DELETE_SUCCESS -eq 1 ]] && exit 0
    exit 1
fi

# ==========================================
# 7. 核心动作：生成快照并清理
# ==========================================
ui_banner "创建快照" "quicksave · Btrfs / Snapper"

SAVE_SUCCESS=1
CLEAN_SUCCESS=1
SNAP_BATCH_ID="$(date -u '+%Y%m%dT%H%M%S.%N')-$$"
CREATED_CONFS=()
CREATED_IDS=()

for conf in "${TARGETS[@]}"; do
    snap_id=""
    if snap_id="$(snapper -c "$conf" create --print-number \
        --description "$OPT_DESC" \
        --cleanup-algorithm number \
        --userdata "maintenance_batch=$SNAP_BATCH_ID")" \
        && [[ "$snap_id" =~ ^[1-9][0-9]*$ ]]; then
        CREATED_CONFS+=("$conf")
        CREATED_IDS+=("$snap_id")
    else
        SAVE_SUCCESS=0
        break
    fi
done

if [[ $SAVE_SUCCESS -ne 1 ]]; then
    notify_err "创建配置 [%s] 的快照失败，正在回删本批次已创建项。" "$conf"
    rollback_failed=0
    for ((i = ${#CREATED_IDS[@]} - 1; i >= 0; i--)); do
        snapper -c "${CREATED_CONFS[$i]}" delete "${CREATED_IDS[$i]}" >/dev/null 2>&1 || rollback_failed=1
    done
    if [[ "$rollback_failed" -ne 0 ]]; then
        notify_err "本批次回删不完整，请按批次 ID 检查：%s" "$SNAP_BATCH_ID"
    fi
    exit 1
fi

for conf in "${TARGETS[@]}"; do
    if ! snapper -c "$conf" cleanup number >/dev/null 2>&1; then
        CLEAN_SUCCESS=0
    fi
done

notify_ok "$MSG_SAVE_OK" "[$OPT_DESC] 批次 $SNAP_BATCH_ID"

if [[ $CLEAN_SUCCESS -eq 1 ]]; then
    echo "$MSG_CLEAN_OK"
else
    ui_warn "快照已创建，但旧快照自动清理失败；可稍后运行 snapper cleanup 检查。"
fi
