#!/usr/bin/env bash
# terminal-tools — 将 bat、zoxide、git-delta 安全接入 Fish 与 Git。
#
# 这是用户级配置管理器：不会安装软件、不需要 sudo，也不会改动维护脚本。
# 所有写入都属于明确的 maintenance 标记块；--disable 会删除该块，并恢复启用前
# 记录的 Git 全局配置。状态文件仅含 Git 配置的旧值，权限为仅当前用户可读。
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/ui.sh
. "$SCRIPT_DIR/lib/ui.sh"

FISH_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/maintenance"
STATE_FILE="$STATE_DIR/terminal-tools-git-before.tsv"
BLOCK_BEGIN='# >>> maintenance terminal-tools >>>'
BLOCK_END='# <<< maintenance terminal-tools <<<'

GIT_KEYS=(
  core.pager
  interactive.diffFilter
  delta.navigate
  delta.side-by-side
  merge.conflictstyle
  diff.colorMoved
)
GIT_VALUES=(
  delta
  'delta --color-only'
  true
  true
  zdiff3
  default
)

have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'USAGE'
用法: terminal-tools [--status | --enable | --disable]

把三个终端效率工具以可回退方式接入当前用户：
  bat       带语法高亮的文件查看器；启用后交互 Fish 中 cat 会更易读，脚本不受影响。
  zoxide    记录常用目录；启用后可用 z 名称快速跳转，zi 用 fzf 交互选择目录。
  git-delta 美化 Git diff、log -p 与冲突标记，让改动更容易审核。

参数：
  --status   只读显示软件与集成状态（默认）。
  --enable   写入 maintenance 管理的 Fish 配置块和 Git 全局显示配置。
  --disable  移除该 Fish 配置块，并恢复 --enable 前保存的 Git 配置。
  -h, --help 显示本帮助。

--enable / --disable 都只影响当前用户，不需要 sudo。配置块位于
~/.config/fish/config.fish；启用前的 Git 旧值保存在
~/.local/state/maintenance/terminal-tools-git-before.tsv（仅当前用户可读）。
USAGE
}

print_intro() {
  ui_banner "终端效率工具"
  ui_info "这是可选的使用体验优化，不影响系统更新、快照、清理或任何维护任务。"
  ui_info "三个工具都只在你手动使用终端或 Git 时生效；可随时用 --disable 完整撤销本工具写入。"
}

fish_block_present() {
  [[ -f "$FISH_CONFIG" ]] && grep -Fxq "$BLOCK_BEGIN" "$FISH_CONFIG"
}

check_fish_block_integrity() {
  local begins ends
  [[ -e "$FISH_CONFIG" ]] || return 0
  begins="$(grep -Fxc "$BLOCK_BEGIN" "$FISH_CONFIG" || true)"
  ends="$(grep -Fxc "$BLOCK_END" "$FISH_CONFIG" || true)"
  [[ "$begins" == 0 && "$ends" == 0 ]] && return 0
  [[ "$begins" == 1 && "$ends" == 1 ]] && return 0
  ui_err "Fish 配置中的 maintenance 标记块不完整或重复；为保护你的配置，未写入任何内容。"
  ui_err "请检查: %s" "$FISH_CONFIG"
  return 1
}

rewrite_fish_config() {
  # $1: enable / disable。先去掉旧管理块，再按需追加规范块，最后原子替换文件。
  local mode="$1" config_dir tmp old_mode=644 awk_rc=0
  config_dir="$(dirname "$FISH_CONFIG")"
  mkdir -p "$config_dir"

  if [[ -e "$FISH_CONFIG" ]]; then
    check_fish_block_integrity || return 1
    old_mode="$(stat -c '%a' "$FISH_CONFIG")"
  fi

  tmp="$(mktemp "$config_dir/.config.fish.terminal-tools.XXXXXX")"
  if [[ -e "$FISH_CONFIG" ]]; then
    awk -v begin="$BLOCK_BEGIN" -v end="$BLOCK_END" '
      $0 == begin { inside=1; next }
      $0 == end { inside=0; next }
      !inside { print }
      END { if (inside) exit 2 }
    ' "$FISH_CONFIG" > "$tmp" || awk_rc=$?
  else
    : > "$tmp"
  fi
  if [[ "$awk_rc" -ne 0 ]]; then
    rm -f "$tmp"
    ui_err "无法安全解析现有 Fish 配置；未修改: %s" "$FISH_CONFIG"
    return 1
  fi

  if [[ "$mode" == enable ]]; then
    cat >> "$tmp" <<'BLOCK'

# >>> maintenance terminal-tools >>>
# 由 ~/scripts/maintenance/terminal-tools 管理；可用 terminal-tools --disable 撤销。
# 仅交互式 Fish 使用：脚本和非交互命令不会受到 cat 别名影响。
if status is-interactive
    if type -q zoxide
        zoxide init fish | source
    end

    # bat 提供语法高亮；--paging=never 避免在短输出和脚本复制时出现额外分页器。
    if type -q bat
        alias cat 'bat --paging=never --style=plain'
    end
end
# <<< maintenance terminal-tools <<<
BLOCK
  fi

  chmod "$old_mode" "$tmp"
  mv -f "$tmp" "$FISH_CONFIG"
}

validate_dependencies() {
  local missing=0 cmd
  for cmd in fish bat zoxide git delta base64; do
    if have "$cmd"; then
      ui_ok "已找到: %s" "$cmd"
    else
      ui_miss "缺少命令: %s" "$cmd"
      missing=1
    fi
  done
  if [[ "$missing" -ne 0 ]]; then
    ui_err "请先安装缺失工具，例如: sudo pacman -S --needed bat zoxide git-delta fish"
    return 1
  fi
}

git_global_readable() {
  if ! git config --global --list >/dev/null 2>&1; then
    ui_err "无法读取当前用户的 Git 全局配置；未修改 Git 设置。"
    return 1
  fi
}

git_key_is_managed() {
  local expected
  for expected in "${GIT_KEYS[@]}"; do
    [[ "$1" == "$expected" ]] && return 0
  done
  return 1
}

validate_git_state_file() {
  # 先完整验证状态文件，之后才允许 --disable 修改任何 Git 设置，避免损坏的
  # 回退文件导致“已经清掉一半旧值”的部分恢复。
  local header key encoded expected
  declare -A seen=()
  [[ -f "$STATE_FILE" ]] || return 2
  header="$(head -n 1 "$STATE_FILE")"
  if [[ "$header" != '# maintenance-terminal-tools-v1' ]]; then
    ui_err "Git 回退状态文件格式未知；为保护现有 Git 配置，未恢复。"
    return 1
  fi
  while IFS=$'\t' read -r key encoded; do
    if [[ -z "$key" ]] || ! git_key_is_managed "$key" || [[ -n "${seen[$key]:-}" ]]; then
      ui_err "Git 回退状态文件包含未知、空白或重复的配置项；未恢复。"
      return 1
    fi
    seen["$key"]=1
    if [[ -n "$encoded" ]] && ! printf '%s' "$encoded" | base64 -d >/dev/null 2>&1; then
      ui_err "Git 回退状态文件中的 %s 值无法解码；未恢复。" "$key"
      return 1
    fi
  done < <(tail -n +2 "$STATE_FILE")
  for expected in "${GIT_KEYS[@]}"; do
    if [[ -z "${seen[$expected]:-}" ]]; then
      ui_err "Git 回退状态文件缺少 %s；未恢复。" "$expected"
      return 1
    fi
  done
}

capture_git_state() {
  local tmp key values rc encoded
  if [[ -e "$STATE_FILE" ]]; then
    validate_git_state_file
    return $?
  fi
  git_global_readable || return 1
  mkdir -p "$STATE_DIR"
  tmp="$(mktemp "$STATE_DIR/.terminal-tools-git-before.XXXXXX")"
  chmod 600 "$tmp"
  printf '# maintenance-terminal-tools-v1\n' > "$tmp"

  for key in "${GIT_KEYS[@]}"; do
    values=''
    rc=0
    values="$(git config --global --get-all "$key")" || rc=$?
    if [[ "$rc" -ne 0 && "$rc" -ne 1 ]]; then
      rm -f "$tmp"
      ui_err "无法读取 Git 配置项 %s（退出码 %s）；未修改任何配置。" "$key" "$rc"
      return 1
    fi
    encoded=''
    if [[ -n "$values" ]]; then
      encoded="$(printf '%s' "$values" | base64 -w 0)"
    fi
    printf '%s\t%s\n' "$key" "$encoded" >> "$tmp"
  done
  mv -f "$tmp" "$STATE_FILE"
}

apply_git_settings() {
  local index key value
  git_global_readable || return 1
  for index in "${!GIT_KEYS[@]}"; do
    key="${GIT_KEYS[$index]}"
    value="${GIT_VALUES[$index]}"
    git config --global --replace-all "$key" "$value"
  done
}

restore_git_state() {
  local key encoded value rc=0
  [[ -e "$STATE_FILE" ]] || return 2
  validate_git_state_file || return $?
  git_global_readable || return 1
  while IFS=$'\t' read -r key encoded; do
    [[ -n "$key" ]] || continue
    if ! git config --global --unset-all "$key" >/dev/null 2>&1; then
      # 退出码 5 代表该键原本不存在；其它错误才算失败。
      rc=$?
      if [[ "$rc" -ne 5 ]]; then
        ui_err "无法清除 Git 配置项 %s（退出码 %s）。" "$key" "$rc"
        return 1
      fi
    fi
    if [[ -n "$encoded" ]]; then
      while IFS= read -r value || [[ -n "$value" ]]; do
        git config --global --add "$key" "$value"
      done < <(printf '%s' "$encoded" | base64 -d)
    fi
  done < <(tail -n +2 "$STATE_FILE")
  rm -f "$STATE_FILE"
}

show_git_value() {
  local key="$1" expected="$2" actual rc=0
  actual="$(git config --global --get-all "$key")" || rc=$?
  if [[ "$rc" -eq 1 ]]; then
    ui_panel_stat warn "$key 尚未由本工具配置"
    return
  fi
  if [[ "$rc" -ne 0 ]]; then
    ui_panel_stat warn "$key 查询失败（退出码 $rc）"
    return
  fi
  if [[ "$actual" == "$expected" ]]; then
    ui_panel_stat ok "$key = $actual"
  else
    ui_panel_stat info "$key = $actual（保留现有值）"
  fi
}

show_status() {
  local cmd index
  print_intro
  ui_tally_reset

  ui_panel_open "软件是否可用" ""
  for cmd in bat zoxide delta fish git; do
    if have "$cmd"; then
      ui_panel_stat ok "$cmd 已安装"
    else
      ui_panel_stat miss "$cmd 未安装"
    fi
  done
  ui_panel_close

  ui_panel_open "Fish（交互终端）" ""
  if fish_block_present; then
    ui_panel_stat ok "维护工具的 Fish 集成已启用"
    ui_panel_line "${UI_DIM}  新开一个终端后可用：cat 文件、z 目录关键词、zi（fzf 选目录）。${UI_RESET}"
  else
    ui_panel_stat info "尚未写入维护工具的 Fish 集成"
    ui_panel_line "${UI_DIM}  执行 terminal-tools --enable 后才会启用；不会影响脚本中的 cat。${UI_RESET}"
  fi
  ui_panel_kv "配置文件" "$FISH_CONFIG"
  ui_panel_close

  ui_panel_open "Git 改动阅读" ""
  if have git; then
    for index in "${!GIT_KEYS[@]}"; do
      show_git_value "${GIT_KEYS[$index]}" "${GIT_VALUES[$index]}"
    done
  else
    ui_panel_stat miss "缺少 git，无法查询 Git 显示配置"
  fi
  ui_panel_close

  ui_panel_open "如何使用" ""
  ui_panel_line "${UI_C_TEXT}bat 文件${UI_RESET}  手动以带语法高亮方式阅读文件；${UI_C_TEXT}cat 文件${UI_RESET} 在 Fish 中也会更易读。"
  ui_panel_line "${UI_C_TEXT}z maintenance${UI_RESET}  跳到常访问过且名称匹配 maintenance 的目录；第一次进入目录后它才会学习。"
  ui_panel_line "${UI_C_TEXT}zi${UI_RESET}  弹出 fzf 搜索已访问目录；输入关键词后回车跳转。"
  ui_panel_line "${UI_C_TEXT}git diff${UI_RESET} / ${UI_C_TEXT}git log -p${UI_RESET}  自动使用 delta，更清楚地显示改动与冲突。"
  ui_panel_line "${UI_DIM}撤销：terminal-tools --disable（只撤销本工具写入，并恢复启用前的 Git 值）。${UI_RESET}"
  ui_panel_close

  ui_tally_summary
}

enable() {
  print_intro
  validate_dependencies || return 1
  check_fish_block_integrity || return 1
  capture_git_state || return 1
  rewrite_fish_config enable || return 1
  if ! apply_git_settings; then
    ui_err "Git 配置写入失败。Fish 配置已写入；请运行 terminal-tools --disable 尝试回退。"
    return 1
  fi
  ui_ok "已启用终端效率集成：新开 Fish 终端后即可使用 z/zi、增强 cat 与 Git delta。"
  ui_info "若不喜欢效果，运行：terminal-tools --disable"
}

disable() {
  print_intro
  check_fish_block_integrity || return 1
  rewrite_fish_config disable || return 1
  case "$(restore_git_state; printf '%s' "$?")" in
    0)
      ui_ok "已移除 Fish 集成，并恢复启用前保存的 Git 全局配置。"
      ;;
    2)
      ui_warn "已移除 Fish 集成；未找到本工具的 Git 回退状态，因此没有改动现有 Git 配置。"
      ;;
    *)
      ui_err "Fish 集成已移除，但 Git 配置恢复失败；状态文件仍保留在: %s" "$STATE_FILE"
      return 1
      ;;
  esac
}

main() {
  if [[ $# -gt 1 ]]; then
    ui_err "参数过多；用法: terminal-tools [--status | --enable | --disable]"
    return 2
  fi
  case "${1:---status}" in
    --status) show_status ;;
    --enable) enable ;;
    --disable) disable ;;
    -h|--help) usage ;;
    *) ui_err "未知参数: %s" "$1"; return 2 ;;
  esac
}

main "$@"
