#!/usr/bin/env bash
set -euo pipefail

DEFAULT_BACKUP_DIR="$HOME/migration"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PACK_BACKUP_DIR=""
PACK_STAGING=""
PACK_OLD_DIR=""

UI_LIB="$(dirname "$SELF")/lib/ui.sh"
# shellcheck source=lib/ui.sh
. "$UI_LIB"

ok()   { ui_ok   "%s" "$*"; }
warn() { ui_warn "%s" "$*"; }
miss() { ui_miss "%s" "$*"; }
info() { ui_info "%s" "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

section() {
  ui_section "$1"
}

menu_return_code() {
  if [[ "${TERM_MENU_CHILD:-0}" == "1" ]]; then
    return 10
  fi
  return 0
}

fzf_colors() {
  ui_fzf_colors
}

_pv_name() {
  case "$1" in
    plan) printf '预览迁移配置档' ;;
    pack) printf '生成迁移包' ;;
    check) printf '检查迁移包' ;;
    exit) printf '退出迁移工具' ;;
    '') printf '无' ;;
    *) printf '%s' "$1" ;;
  esac
}

print_preview() {
  local action="${1:-}"

  printf '\033[1;36m%s\033[0m\n' "$(_pv_name "$action")"
  printf '\033[2m────────────────────────────────────────\033[0m\n'

  case "$action" in
    plan)
      printf '\033[36m说明\033[0m  只读预览 v2 迁移配置档\n\n'
      printf '显示会迁移、跳过及作为秘密引用记录的路径；不会写入文件。\n'
      printf '可先审查内建默认项，或创建 ~/.config/maintenance/migration-profile.conf 覆盖它。\n'
      printf '秘密默认不复制；系统级 /etc 仅记录审查范围，绝不自动恢复。\n'
      ;;
    pack)
      printf '\033[36m说明\033[0m  生成 v2 迁移包\n'
      printf '\033[36m输出\033[0m  %s\n\n' "$DEFAULT_BACKUP_DIR"
      printf '会写入软件包、服务、完整配置归档、路径清单、系统审查项和 SHA256SUMS。\n'
      printf '默认纳入整个 ~/.config、~/.ssh、Projects、Obsidian、指定图片、命令入口和 scripts。\n'
      printf '选定内容会原样归档；请仅复制到你信任且受保护的存储位置，完成后原子替换旧包。\n'
      ;;
    check)
      printf '\033[36m说明\033[0m  检查迁移包\n'
      printf '\033[36m读取\033[0m  %s\n\n' "$DEFAULT_BACKUP_DIR"
      printf '会检查迁移目录、压缩包、包清单、服务清单、secrets 和 SHA256SUMS 是否存在。\n'
      printf '会验证压缩包里是否包含 pkg-deps.html、scripts、md、fish、niri、opencode 等关键内容。\n'
      printf '还会对比当前系统缺哪些显式包和 AUR 包，适合新系统恢复后查漏补缺。\n'
      printf '检查只读，不会自动安装软件，也不会覆盖当前配置。\n'
      ;;
    exit)
      printf '\033[36m说明\033[0m  退出迁移工具\n\n'
      printf '从维护菜单进入时，退出会直接回到维护菜单。\n'
      printf '单独在终端运行 migration-pack 时，退出只结束这个脚本。\n'
      ;;
    *)
      printf '\033[36m说明\033[0m  选择要执行的迁移操作。\n'
      ;;
  esac
}

is_under() {
  local path="$1"
  local root="$2"
  [[ "$path" == "$root" || "$path" == "$root/"* ]]
}

guard_backup_dir() {
  local backup_dir="$1"
  local backup_real home_real packed_root

  backup_real="$(realpath -m "$backup_dir")"
  home_real="$(realpath "$HOME")"

  if [[ "$backup_real" == "/" || "$backup_real" == "$home_real" ]]; then
    printf '错误：输出目录不能是根目录或 HOME 本身: %s\n' "$backup_real" >&2
    exit 1
  fi

  for packed_root in \
    "$home_real/.config" \
    "$home_real/.local/share/fcitx5/rime" \
    "$home_real/scripts" \
    "$home_real/md"
  do
    if is_under "$backup_real" "$packed_root"; then
      printf '错误：输出目录不能放在会被打包的路径里: %s\n' "$packed_root" >&2
      printf '请改用 ~/migration 或 U 盘目录。\n' >&2
      exit 1
    fi
  done
}

# Migration package v2: declarative profile, structured artifacts, and no plaintext secrets.
V2_MARKER='migration-pack v2'
V2_FORMAT_FILE='format.json'
V2_PAYLOAD_ARCHIVE='payload/home-config.tar.zst'
V2_PROFILE_DEFAULT="${XDG_CONFIG_HOME:-$HOME/.config}/maintenance/migration-profile.conf"

PROFILE_INCLUDES=()
PROFILE_EXCLUDES=()
PROFILE_SECRETS=()
PROFILE_EXISTING=()
PROFILE_MISSING=()
PROFILE_SOURCE=''

profile_default_entries() {
  PROFILE_INCLUDES=(
    .config .ssh obsidian Projects Pictures/背景图片 Pictures/archlinux头像
    scripts md .local/bin .local/share/applications
  )
  PROFILE_EXCLUDES=()
  PROFILE_SECRETS=()
  PROFILE_SOURCE='内建默认配置档'
}

profile_path_is_safe() {
  local kind="$1" path="$2"
  [[ -n "$path" && "$path" != /* && "$path" != *$'\n'* ]] || return 1
  [[ "/$path/" != *'/../'* && "$path" != '..' ]] || return 1
  case "$kind" in
    include|secret) [[ "$path" != *'?'* && "$path" != *'*'* && "$path" != *'['* ]] ;;
    exclude) ;;
    *) return 1 ;;
  esac
}

profile_add_entry() {
  local kind="$1" path="$2"
  profile_path_is_safe "$kind" "$path" || {
    ui_err "迁移配置档包含不安全路径: %s" "$path"
    return 1
  }
  case "$kind" in
    include) PROFILE_INCLUDES+=("$path") ;;
    exclude) PROFILE_EXCLUDES+=("$path") ;;
    secret) PROFILE_SECRETS+=("$path") ;;
  esac
}

load_profile() {
  local requested="${1:-}" profile line_no=0 kind path extra stripped
  PROFILE_INCLUDES=()
  PROFILE_EXCLUDES=()
  PROFILE_SECRETS=()
  PROFILE_EXISTING=()
  PROFILE_MISSING=()

  if [[ -n "$requested" ]]; then
    profile="$requested"
  elif [[ -f "$V2_PROFILE_DEFAULT" ]]; then
    profile="$V2_PROFILE_DEFAULT"
  else
    profile_default_entries
    return 0
  fi
  [[ -f "$profile" && ! -L "$profile" ]] || {
    ui_err "迁移配置档不存在或不是普通文件: %s" "$profile"
    return 1
  }
  PROFILE_SOURCE="$(realpath "$profile")"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$((line_no + 1))
    stripped="${line#"${line%%[![:space:]]*}"}"
    [[ -z "${line//[[:space:]]/}" || "$stripped" == \#* ]] && continue
    IFS=$' \t' read -r kind path extra <<< "$line"
    if [[ -z "$kind" || -z "$path" || -n "$extra" ]]; then
      ui_err "迁移配置档第 %s 行格式无效；应为 include|exclude|secret <相对路径>" "$line_no"
      return 1
    fi
    case "$kind" in
      include|exclude|secret) ;;
      *)
        ui_err "迁移配置档第 %s 行类型无效: %s" "$line_no" "$kind"
        return 1
        ;;
    esac
    profile_add_entry "$kind" "$path" || return 1
  done < "$profile"
  ((${#PROFILE_INCLUDES[@]} > 0)) || {
    ui_err "迁移配置档没有 include 项: %s" "$profile"
    return 1
  }
}

profile_resolve_paths() {
  local source_root="$1" rel
  PROFILE_EXISTING=()
  PROFILE_MISSING=()
  for rel in "${PROFILE_INCLUDES[@]}"; do
    if [[ -e "$source_root/$rel" || -L "$source_root/$rel" ]]; then
      PROFILE_EXISTING+=("$rel")
    else
      PROFILE_MISSING+=("$rel")
    fi
  done
}

v2_source_root() {
  local requested="${1:-$HOME}" source
  source="$(realpath "$requested")" || {
    ui_err "无法解析 HOME 来源目录: %s" "$requested"
    return 1
  }
  [[ -d "$source" && -r "$source" ]] || {
    ui_err "HOME 来源目录不可读: %s" "$source"
    return 1
  }
  printf '%s\n' "$source"
}

v2_guard_output_dir() {
  local backup_dir="$1" source_root="$2" backup_real rel include_root
  backup_real="$(realpath -m "$backup_dir")"
  if [[ "$backup_real" == / || "$backup_real" == "$source_root" ]]; then
    ui_err "迁移包输出目录不能是根目录或来源 HOME 本身: %s" "$backup_real"
    return 1
  fi
  for rel in "${PROFILE_EXISTING[@]}"; do
    include_root="$(realpath -m "$source_root/$rel")"
    if is_under "$backup_real" "$include_root"; then
      ui_err "迁移包输出目录不能位于被配置档打包的路径内: %s" "$include_root"
      return 1
    fi
  done
}

v2_owned_package() {
  local dir="$1"
  [[ -f "$dir/.migration-pack-owned" ]] \
    && grep -Eqx 'migration-pack v(1|2)' "$dir/.migration-pack-owned" 2>/dev/null
}

v2_write_profile_snapshot() {
  local staging="$1" rel
  {
    printf '# migration profile source: %s\n' "$PROFILE_SOURCE"
    for rel in "${PROFILE_INCLUDES[@]}"; do printf 'include %s\n' "$rel"; done
    for rel in "${PROFILE_EXCLUDES[@]}"; do printf 'exclude %s\n' "$rel"; done
    for rel in "${PROFILE_SECRETS[@]}"; do printf 'secret %s\n' "$rel"; done
  } > "$staging/profile.conf"
}

v2_write_secret_references() {
  local staging="$1" source_root="$2" rel mode
  : > "$staging/secrets/references.tsv"
  for rel in "${PROFILE_SECRETS[@]}"; do
    if [[ -e "$source_root/$rel" || -L "$source_root/$rel" ]]; then
      mode="$(stat -c '%a' -- "$source_root/$rel" 2>/dev/null)" || {
        ui_err "无法读取秘密引用的权限信息: %s" "$rel"
        return 1
      }
      printf '%s\tpresent\tmode=%s\n' "$rel" "$mode" >> "$staging/secrets/references.tsv"
    else
      printf '%s\tabsent\t-\n' "$rel" >> "$staging/secrets/references.tsv"
    fi
  done
}

v2_write_system_inventory() {
  local staging="$1"
  cat > "$staging/system/review-only-paths.txt" <<'EOF_PATHS'
/etc/pacman.conf
/etc/pacman.d/mirrorlist
/etc/fstab
/etc/mkinitcpio.conf
/etc/default/grub
/etc/locale.conf
EOF_PATHS
  if command -v systemd-delta >/dev/null 2>&1; then
    if ! systemd-delta --type=extended > "$staging/system/systemd-delta.txt"; then
      ui_err "无法查询 systemd 本地覆盖，迁移包未发布"
      return 1
    fi
  else
    printf 'UNAVAILABLE\tsystemd-delta\n' > "$staging/system/systemd-delta.txt"
  fi
}

v2_create_payload_archive() {
  local staging="$1" archive="$2" error_file rc=0
  shift 2
  local tar_args=("$@")

  # Pre-create the archive as the invoking user.  If a protected container volume
  # requires the narrowly scoped privileged retry below, root only truncates this
  # user-owned file instead of leaving a root-owned migration package behind.
  : > "$archive"
  error_file="$(mktemp "$staging/payload/.tar-errors.XXXXXX")"
  LC_ALL=C tar "${tar_args[@]}" 2> "$error_file" || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    rm -f -- "$error_file"
    return 0
  fi

  if ! grep -Fq 'Permission denied' "$error_file"; then
    cat "$error_file" >&2
    rm -f -- "$error_file"
    return "$rc"
  fi

  if ! command -v sudo >/dev/null 2>&1; then
    ui_err "归档包含当前用户无权读取的路径，且终端 sudo 不可用。"
    cat "$error_file" >&2
    rm -f -- "$error_file"
    return "$rc"
  fi

  ui_info "检测到迁移内容读取权限不足；将仅为 tar 读取受限文件请求终端 sudo 认证。"
  rc=0
  sudo env LC_ALL=C tar "${tar_args[@]}" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    ui_err "受限迁移内容的特权读取失败（退出码 %s）；迁移包未发布。" "$rc"
    cat "$error_file" >&2
    rm -f -- "$error_file"
    return "$rc"
  fi
  rm -f -- "$error_file"
}

v2_build_payload() {
  local staging="$1" source_root="$2" metadata_only="${3:-0}" rel
  local archive="$staging/$V2_PAYLOAD_ARCHIVE"
  local tar_args=(--zstd -cf "$archive" -C "$source_root")

  : > "$staging/payload/include-paths.txt"
  if [[ "$metadata_only" -eq 1 ]]; then
    printf 'metadata-only\n' > "$staging/payload/mode"
    tar --zstd -cf "$archive" --files-from=/dev/null
    : > "$staging/payload/archive-paths.txt"
    : > "$staging/payload/manifest.tsv"
    return 0
  fi
  printf 'full\n' > "$staging/payload/mode"
  for rel in "${PROFILE_EXISTING[@]}"; do
    printf '%s\n' "$rel" >> "$staging/payload/include-paths.txt"
  done
  for rel in "${PROFILE_EXCLUDES[@]}"; do
    tar_args+=("--exclude=$rel" "--exclude=./$rel")
  done
  for rel in "${PROFILE_SECRETS[@]}"; do
    tar_args+=("--exclude=$rel" "--exclude=./$rel")
  done
  ((${#PROFILE_EXISTING[@]} > 0)) || {
    ui_err "迁移配置档没有任何存在的可打包路径"
    return 1
  }
  tar_args+=(-- "${PROFILE_EXISTING[@]}")
  v2_create_payload_archive "$staging" "$archive" "${tar_args[@]}"
  tar --zstd -tf "$archive" > "$staging/payload/archive-paths.txt"
  awk 'BEGIN {OFS="\t"} {print "archive-entry", $0}' \
    "$staging/payload/archive-paths.txt" > "$staging/payload/manifest.tsv"
}

v2_write_package_inventory() {
  local staging="$1"
  pacman -Qqe | sort > "$staging/packages/pacman-explicit.txt"
  query_allow_empty_status1 pacman -Qqm | sort > "$staging/packages/foreign.txt"
  if command -v flatpak >/dev/null 2>&1; then
    if ! flatpak list --app --columns=application > "$staging/packages/flatpak-applications.txt"; then
      ui_err "无法查询 Flatpak 应用，迁移包未发布"
      return 1
    fi
  else
    : > "$staging/packages/flatpak-applications.txt"
  fi
}

v2_write_service_inventory() {
  local staging="$1" source_root="$2"
  systemctl list-unit-files --state=enabled --no-legend --plain --no-pager \
    > "$staging/services/system-enabled.txt"
  systemctl --user list-unit-files --state=enabled --no-legend --plain --no-pager \
    > "$staging/services/user-enabled.txt"
  : > "$staging/services/local-unit-files.tsv"
  if [[ -d "$source_root/.config/systemd/user" ]]; then
    while IFS= read -r -d '' path; do
      printf '%s\tmode=%s\n' "${path#"$source_root/"}" "$(stat -c '%a' -- "$path")" \
        >> "$staging/services/local-unit-files.tsv"
    done < <(find "$source_root/.config/systemd/user" -type f -print0 | sort -z)
  fi
}

v2_write_format() {
  local staging="$1" source_root="$2"
  cat > "$staging/$V2_FORMAT_FILE" <<EOF_FORMAT
{"schema_version":2,"format":"maintenance-migration","payload_archive":"$V2_PAYLOAD_ARCHIVE"}
EOF_FORMAT
  {
    printf 'schema_version\t2\n'
    printf 'created_at\t%s\n' "$(date --iso-8601=seconds)"
    printf 'source_home\t%s\n' "$source_root"
    printf 'profile\t%s\n' "$PROFILE_SOURCE"
  } > "$staging/metadata.tsv"
}

v2_write_checksums() {
  local staging="$1"
  local checksum_files=()
  (
    cd "$staging"
    mapfile -t checksum_files < <(find . -type f ! -name SHA256SUMS -printf '%P\n' | LC_ALL=C sort)
    ((${#checksum_files[@]} > 0)) || return 1
    sha256sum "${checksum_files[@]}" > SHA256SUMS
  )
}

run_plan() {
  local requested_profile="${1:-}" requested_home="${2:-$HOME}" source_root rel
  source_root="$(v2_source_root "$requested_home")" || return 1
  load_profile "$requested_profile" || return 1
  profile_resolve_paths "$source_root"
  ui_banner "迁移配置档预览" "migration-pack · v2 · 只读"
  ui_panel_open "来源"
  ui_panel_kv "HOME 来源" "$source_root"
  ui_panel_kv "配置档" "$PROFILE_SOURCE"
  ui_panel_close
  ui_panel_open "将打包"
  for rel in "${PROFILE_EXISTING[@]}"; do ui_panel_line "$rel"; done
  ui_panel_close
  if ((${#PROFILE_MISSING[@]} > 0)); then
    ui_panel_open "不存在，跳过"
    for rel in "${PROFILE_MISSING[@]}"; do ui_panel_line "$rel"; done
    ui_panel_close
  fi
  ui_panel_open "排除规则"
  for rel in "${PROFILE_EXCLUDES[@]}"; do ui_panel_line "$rel"; done
  ui_panel_close
  ui_panel_open "秘密处理"
  if ((${#PROFILE_SECRETS[@]} == 0)); then
    ui_panel_line "默认不降级任何内容为引用；选定路径会原样归档。"
  else
    for rel in "${PROFILE_SECRETS[@]}"; do
      if [[ -e "$source_root/$rel" || -L "$source_root/$rel" ]]; then
        ui_panel_line "$rel · 仅记录引用"
      else
        ui_panel_line "$rel · 不存在"
      fi
    done
  fi
  ui_panel_close
  ui_info "--pack 会生成 v2 结构化迁移包；此预览未写入文件。"
}

run_pack() {
  local backup_dir="${1:-$DEFAULT_BACKUP_DIR}" requested_profile="${2:-}"
  local requested_home="${3:-$HOME}" metadata_only="${4:-0}" source_root parent base staging old_dir

  source_root="$(v2_source_root "$requested_home")" || return 1
  load_profile "$requested_profile" || return 1
  profile_resolve_paths "$source_root"
  ui_maintenance_lock_acquire "生成迁移包" || return $?
  v2_guard_output_dir "$backup_dir" "$source_root" || return 1
  if [[ -e "$backup_dir" || -L "$backup_dir" ]]; then
    if [[ -L "$backup_dir" || ! -d "$backup_dir" ]]; then
      ui_err "输出路径已经存在且不是目录: %s" "$backup_dir"
      return 1
    fi
    if [[ -n "$(find "$backup_dir" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]] \
        && ! v2_owned_package "$backup_dir"; then
      ui_err "输出目录非空且不属于 migration-pack: %s" "$backup_dir"
      return 1
    fi
  fi
  parent="$(dirname "$backup_dir")"
  base="$(basename "$backup_dir")"
  mkdir -p "$parent"
  staging="$(mktemp -d "$parent/.${base}.new.XXXXXX")"
  old_dir="$parent/.${base}.old.$$"
  PACK_BACKUP_DIR="$backup_dir"
  PACK_STAGING="$staging"
  PACK_OLD_DIR="$old_dir"

  # shellcheck disable=SC2329 # Called by the EXIT trap below.
  cleanup_pack() {
    trap - EXIT
    if [[ -n "${PACK_OLD_DIR:-}" ]] && { [[ -e "$PACK_OLD_DIR" ]] || [[ -L "$PACK_OLD_DIR" ]]; } \
        && [[ ! -e "$PACK_BACKUP_DIR" && ! -L "$PACK_BACKUP_DIR" ]]; then
      if mv -T -- "$PACK_OLD_DIR" "$PACK_BACKUP_DIR"; then PACK_OLD_DIR='';
      else warn "旧迁移包自动恢复失败，旧版本仍保留在：$PACK_OLD_DIR"; fi
    fi
    if [[ -n "${PACK_STAGING:-}" && -d "$PACK_STAGING" ]]; then
      rm -rf -- "$PACK_STAGING" || warn "迁移包暂存目录清理失败：$PACK_STAGING"
    fi
    return 0
  }
  trap cleanup_pack EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  trap 'exit 131' QUIT

  mkdir -p "$staging/payload" "$staging/packages" "$staging/services" "$staging/system" "$staging/secrets"
  printf '%s\n' "$V2_MARKER" > "$staging/.migration-pack-owned"
  ui_working "正在收集软件包、服务和系统清单"
  v2_write_format "$staging" "$source_root"
  v2_write_profile_snapshot "$staging"
  v2_write_package_inventory "$staging"
  v2_write_service_inventory "$staging" "$source_root"
  v2_write_system_inventory "$staging"
  v2_write_secret_references "$staging" "$source_root"
  ui_working "正在归档选定的迁移内容（文件较多时会花一些时间）"
  v2_build_payload "$staging" "$source_root" "$metadata_only"
  ui_working "正在计算迁移包 SHA256SUMS"
  v2_write_checksums "$staging"
  ui_working "正在复核新迁移包的归档与校验和"
  tar --zstd -tf "$staging/$V2_PAYLOAD_ARCHIVE" >/dev/null
  (cd "$staging" && sha256sum -c SHA256SUMS >/dev/null)

  if [[ -e "$backup_dir" || -L "$backup_dir" ]]; then mv -T -- "$backup_dir" "$old_dir"; fi
  mv -T -- "$staging" "$backup_dir"
  staging=''
  PACK_STAGING=''
  rm -rf -- "$old_dir"
  PACK_OLD_DIR=''
  PACK_BACKUP_DIR=''
  trap - EXIT INT TERM HUP QUIT
  ok "完成 v2 迁移包：$backup_dir"
  info "选定内容会原样归档；请把完整目录保存到仅你可访问的受保护位置。"
}

v2_validate_checksum_manifest() {
  local backup_dir="$1" line path failed=0
  local required=(
    .migration-pack-owned format.json metadata.tsv profile.conf
    payload/home-config.tar.zst payload/mode payload/include-paths.txt payload/archive-paths.txt payload/manifest.tsv
    packages/pacman-explicit.txt packages/foreign.txt packages/flatpak-applications.txt
    services/system-enabled.txt services/user-enabled.txt services/local-unit-files.tsv
    system/review-only-paths.txt system/systemd-delta.txt secrets/references.tsv
  )
  local names=() item
  while IFS= read -r line; do
    if [[ ! "$line" =~ ^[0-9A-Fa-f]{64}[[:space:]][\ *](.+)$ ]]; then
      ui_err "SHA256SUMS 含无效行"
      failed=1
      continue
    fi
    path="${BASH_REMATCH[1]}"
    if [[ "$path" == /* || "$path" == '..' || "$path" == ../* || "$path" == */../* ]]; then
      ui_err "SHA256SUMS 含越界路径: %s" "$path"
      failed=1
      continue
    fi
    names+=("$path")
  done < "$backup_dir/SHA256SUMS"
  for item in "${required[@]}"; do
    if ! printf '%s\n' "${names[@]}" | grep -Fxq -- "$item"; then
      ui_err "SHA256SUMS 未覆盖 v2 必需文件: %s" "$item"
      failed=1
    fi
  done
  [[ "$failed" -eq 0 ]] && (cd "$backup_dir" && sha256sum -c SHA256SUMS >/dev/null)
}

v2_check_payload() {
  local backup_dir="$1" rel failed=0 archive mode
  archive="$backup_dir/$V2_PAYLOAD_ARCHIVE"
  mode="$(< "$backup_dir/payload/mode")"
  [[ -s "$archive" ]] || { ui_err "缺少 v2 配置归档: %s" "$archive"; return 1; }
  tar --zstd -tf "$archive" >/dev/null || { ui_err "v2 配置归档无法读取"; return 1; }
  if [[ "$mode" == 'metadata-only' ]]; then
    [[ ! -s "$backup_dir/payload/include-paths.txt" && ! -s "$backup_dir/payload/archive-paths.txt" ]]       || { ui_err "metadata-only 迁移包意外包含配置路径"; return 1; }
    return 0
  fi
  [[ "$mode" == 'full' ]] || { ui_err "v2 配置归档模式无效: %s" "$mode"; return 1; }
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    if ! tar --zstd -tf "$archive" "$rel" >/dev/null 2>&1; then
      ui_err "v2 配置归档缺少声明路径: %s" "$rel"
      failed=1
    fi
  done < "$backup_dir/payload/include-paths.txt"
  return "$failed"
}

run_check_v2() {
  local backup_dir="$1" compare_system="${2:-1}"
  [[ -f "$backup_dir/$V2_FORMAT_FILE" ]] || return 1
  grep -Fxq "$V2_MARKER" "$backup_dir/.migration-pack-owned" \
    || { ui_err "v2 迁移包缺少有效所有权标记"; return 1; }
  grep -Fqx '{"schema_version":2,"format":"maintenance-migration","payload_archive":"payload/home-config.tar.zst"}' \
    "$backup_dir/$V2_FORMAT_FILE" || { ui_err "不支持的 v2 format.json"; return 1; }
  [[ -f "$backup_dir/SHA256SUMS" ]] || { ui_err "v2 迁移包缺少 SHA256SUMS"; return 1; }
  ui_working "正在校验迁移包的 SHA256SUMS"
  v2_validate_checksum_manifest "$backup_dir" || return 1
  ui_working "正在读取配置归档并核对清单"
  v2_check_payload "$backup_dir" || return 1
  if [[ "$compare_system" -eq 1 ]]; then
    ui_info "v2 迁移包校验通过；包和服务差异由 backup-restore 生成恢复计划。"
  fi
  ok "v2 迁移包结构与校验和有效"
}

run_check() {
  local backup_dir="${1:-$DEFAULT_BACKUP_DIR}" compare_system="${2:-1}"
  if [[ -f "$backup_dir/$V2_FORMAT_FILE" ]]; then
    run_check_v2 "$backup_dir" "$compare_system"
  else
    run_check_v1 "$backup_dir" "$compare_system"
  fi
}

query_allow_empty_status1() {
  local output_file error_file rc=0
  output_file="$(mktemp)"
  error_file="$(mktemp)"
  "$@" > "$output_file" 2> "$error_file" || rc=$?
  if [[ "$rc" -eq 0 ]] || { [[ "$rc" -eq 1 && ! -s "$output_file" && ! -s "$error_file" ]]; }; then
    cat "$output_file"
    rm -f -- "$output_file" "$error_file"
    return 0
  fi
  ui_err "命令查询失败（退出码 %s）: %s" "$rc" "$*"
  [[ ! -s "$error_file" ]] || cat "$error_file" >&2
  rm -f -- "$output_file" "$error_file"
  return "$rc"
}

check_file() {
  local path="$1"
  local label="${2:-$1}"
  local allow_empty="${3:-0}"

  if [[ -s "$path" ]]; then
    ok "$label"
    return 0
  elif [[ -e "$path" ]]; then
    if [[ "$allow_empty" == "1" ]]; then
      ok "$label（允许为空）"
      return 0
    fi
    warn "$label 存在但为空"
  else
    miss "$label"
  fi
  return 1
}

print_missing_packages() {
  local list="$1"
  local label="$2"
  local tmp_current missing

  [[ -f "$list" ]] || return 0
  tmp_current="$(mktemp)"
  if ! pacman -Qqe | sort > "$tmp_current"; then
    warn "无法查询当前显式安装包，跳过 $label 差异比较"
    rm -f "$tmp_current"
    return 1
  fi
  missing="$(comm -23 "$list" "$tmp_current" || true)"
  rm -f "$tmp_current"

  if [[ -z "$missing" ]]; then
    ok "$label 已对齐"
  else
    warn "$label 缺少以下包："
    printf '%s\n' "$missing" | sed 's/^/  /'
  fi
}

validate_checksum_manifest() {
  local backup_dir="$1"
  local checksum_file="$backup_dir/SHA256SUMS"
  local line path failed=0 required
  local names=()
  local required_files=(
    pang-arch-configs.tar.gz tar-manifest.txt pkglist-explicit.txt pkglist-foreign.txt
    system-enabled-units.txt user-enabled-units.txt
  )

  while IFS= read -r line; do
    if [[ ! "$line" =~ ^[0-9A-Fa-f]{64}[[:space:]][\ *](.+)$ ]]; then
      miss "SHA256SUMS 含无效行"
      failed=1
      continue
    fi
    path="${BASH_REMATCH[1]}"
    if [[ "$path" == /* || "$path" == ".." || "$path" == ../* || "$path" == */../* ]]; then
      miss "SHA256SUMS 含越界路径: $path"
      failed=1
      continue
    fi
    names+=("$path")
  done < "$checksum_file"

  while IFS= read -r path; do
    [[ -n "$path" ]] && required_files+=("$path")
  done < <(cd "$backup_dir" && find secrets -type f -print 2>/dev/null | sort)

  for required in "${required_files[@]}"; do
    if ! printf '%s\n' "${names[@]}" | grep -Fxq -- "$required"; then
      miss "SHA256SUMS 未覆盖必需文件: $required"
      failed=1
    fi
  done
  return "$failed"
}

check_archive_entry() {
  local archive="$1"
  local entry="$2"

  if tar -tzf "$archive" "$entry" >/dev/null 2>&1; then
    ok "压缩包包含 $entry"
  else
    warn "压缩包未包含 $entry"
  fi
}

check_manifest_entries() {
  local archive="$1" manifest="$2" rel
  local failed=0 count=0

  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    count=$((count + 1))
    if [[ "$rel" == /* || "$rel" == ".." || "$rel" == ../* || "$rel" == */../* ]]; then
      miss "tar-manifest.txt 含越界路径: $rel"
      failed=1
      continue
    fi
    if tar -tzf "$archive" "$rel" >/dev/null 2>&1; then
      ok "清单内容存在: $rel"
    else
      miss "清单声明但压缩包缺失: $rel"
      failed=1
    fi
  done < "$manifest"
  if [[ "$count" -eq 0 ]]; then
    miss "tar-manifest.txt 为空，迁移包没有配置内容"
    return 1
  fi
  return "$failed"
}

run_check_v1() {
  local backup_dir="${1:-$DEFAULT_BACKUP_DIR}"
  local compare_system="${2:-1}"
  local archive="$backup_dir/pang-arch-configs.tar.gz"
  local tmp_foreign missing_foreign rel
  local validation_failed=0

  section "迁移包目录"
  if [[ -d "$backup_dir" ]]; then
    ok "$backup_dir"
  else
    miss "$backup_dir 不存在"
    info '先选择"生成迁移包"，或运行: migration-pack --pack'
    exit 1
  fi

  check_file "$backup_dir/pkglist-explicit.txt" "pkglist-explicit.txt" || validation_failed=1
  check_file "$backup_dir/pkglist-foreign.txt" "pkglist-foreign.txt" 1 || validation_failed=1
  check_file "$backup_dir/system-enabled-units.txt" "system-enabled-units.txt" 1 || validation_failed=1
  check_file "$backup_dir/user-enabled-units.txt" "user-enabled-units.txt" 1 || validation_failed=1
  check_file "$backup_dir/tar-manifest.txt" "tar-manifest.txt" || validation_failed=1
  check_file "$archive" "pang-arch-configs.tar.gz" || validation_failed=1
  check_file "$backup_dir/SHA256SUMS" "SHA256SUMS" || validation_failed=1

  section "校验"
  if [[ -f "$backup_dir/SHA256SUMS" ]] && have sha256sum; then
    ui_working "正在校验迁移包的 SHA256SUMS"
    if validate_checksum_manifest "$backup_dir" \
        && (cd "$backup_dir" && sha256sum -c SHA256SUMS); then
      ok "SHA256SUMS 校验通过"
    else
      miss "SHA256SUMS 校验失败"
      validation_failed=1
    fi
  else
    warn "无法校验 SHA256SUMS"
    validation_failed=1
  fi

  section "压缩包关键内容"
  if [[ -f "$archive" ]]; then
    if ! tar -tzf "$archive" >/dev/null 2>&1; then
      miss "压缩包结构损坏，无法完整读取"
      validation_failed=1
    elif [[ -s "$backup_dir/tar-manifest.txt" ]]; then
      check_manifest_entries "$archive" "$backup_dir/tar-manifest.txt" || validation_failed=1
    fi
    check_archive_entry "$archive" "pkg-deps.html"
    check_archive_entry "$archive" "scripts/"
    check_archive_entry "$archive" "md/"
    check_archive_entry "$archive" ".config/fish/"
    check_archive_entry "$archive" ".config/niri/"
    check_archive_entry "$archive" ".config/opencode/"
  else
    warn "缺少压缩包，跳过内容检查"
  fi

  section "密钥文件"
  if [[ -d "$backup_dir/secrets" ]]; then
    ok "secrets 目录存在"
    # 私密文件只在来源系统实际配置过时才会被纳入包。不存在不是校验失败，
    # 不能用“缺失”徽章制造“最终成功但中间报错”的矛盾印象。
    if [[ -e "$backup_dir/secrets/secrets.fish" ]]; then
      check_file "$backup_dir/secrets/secrets.fish" "secrets/secrets.fish" || true
    else
      info "未包含 secrets/secrets.fish（来源系统未配置时属正常）"
    fi
    if [[ -e "$backup_dir/secrets/opencode.json" ]]; then
      check_file "$backup_dir/secrets/opencode.json" "secrets/opencode.json" || true
    else
      info "未包含 secrets/opencode.json（来源系统未配置时属正常）"
    fi
  else
    warn "secrets 目录不存在；如果没有私有密钥文件可以忽略"
  fi

  if [[ "$compare_system" -eq 1 ]]; then
    section "当前系统包差异"
    print_missing_packages "$backup_dir/pkglist-explicit.txt" "显式包" || validation_failed=1
    if [[ -s "$backup_dir/pkglist-foreign.txt" ]]; then
      tmp_foreign="$(mktemp)"
      if query_allow_empty_status1 pacman -Qqm | sort > "$tmp_foreign"; then
        missing_foreign="$(comm -23 "$backup_dir/pkglist-foreign.txt" "$tmp_foreign" || true)"
        if [[ -z "$missing_foreign" ]]; then
          ok "foreign/AUR 包已对齐"
        else
          warn "foreign/AUR 缺少以下包："
          printf '%s\n' "$missing_foreign" | sed 's/^/  /'
        fi
      else
        warn "无法查询当前 foreign/AUR 包"
        validation_failed=1
      fi
      rm -f "$tmp_foreign"
    else
      info "pkglist-foreign.txt 为空"
    fi

    section "当前 HOME 恢复状态"
    if [[ -f "$backup_dir/tar-manifest.txt" ]]; then
      while IFS= read -r rel; do
        [[ -n "$rel" ]] || continue
        if [[ -e "$HOME/$rel" ]]; then
          ok "$HOME/$rel"
        else
          warn "当前系统缺少 ~/$rel"
        fi
      done < "$backup_dir/tar-manifest.txt"
    else
      warn "缺少 tar-manifest.txt，无法检查恢复状态"
    fi
  fi

  printf '\n'
  if [[ "$validation_failed" -ne 0 ]]; then
    miss "迁移包校验未通过"
    return 1
  fi
  ok "迁移包结构与校验和有效"
  return 0
}

choose_action() {
  local options selected action

  options=$'1\t 预览迁移配置档\tplan\t只读，不写入文件\n2\t 生成迁移包\tpack\t写入 ~/migration\n3\t 检查迁移包\tcheck\t读取 ~/migration\n0\t 退出\texit\t不执行操作'

  if have fzf; then
    local footer
    footer="$(ui_status_line)"
    selected="$(
      printf '%s\n' "$options" |
        fzf \
          --delimiter=$'\t' \
          --with-nth=1,2 \
          --height=100% \
          --min-height=20 \
          --layout=reverse \
          --style=full \
          --border=rounded \
          --border-label="╢  迁移工具 ╟" \
          --border-label-pos=3 \
          --list-border=rounded \
          --list-label=' 功能选择 ' \
          --list-label-pos=3 \
          --input-border=rounded \
          --input-label=' 筛选 ' \
          --input-label-pos=3 \
          --header-border=rounded \
          --header-label=' 操作 ' \
          --header-first \
          --footer-border=rounded \
          --footer-label='   系统状态 ' \
          --footer="$footer" \
          --prompt='  ' \
          --pointer='▶' \
          --marker='✓' \
          --highlight-line \
          --cycle \
          --info=inline-right \
          --header='  Enter 执行     ↑↓ 循环移动     Esc 返回/退出' \
          --preview-window='right,56%,border-rounded,wrap' \
          --preview-label=' 功能说明 ' \
          --preview="bash '$SELF' --preview {3}" \
          --color="$(fzf_colors)"
    )" || menu_return_code
  else
    printf '%s\n' "$options" | awk -F '\t' '{printf "%s  %s - %s\n", $1, $2, $4}'
    printf '选择操作: '
    read -r action
    selected="$(printf '%s\n' "$options" | awk -F '\t' -v key="$action" '$1 == key {print; exit}')"
  fi

  [[ -n "${selected:-}" ]] || menu_return_code
  action="$(awk -F '\t' '{print $3}' <<< "$selected")"

  case "$action" in
    plan) run_plan ;;
    pack) run_pack "$DEFAULT_BACKUP_DIR" ;;
    check) run_check "$DEFAULT_BACKUP_DIR" ;;
    exit|"") menu_return_code ;;
    *) warn "未知操作: $action" ;;
  esac
}

parse_v2_options() {
  V2_OPTION_DEST="${1:-$DEFAULT_BACKUP_DIR}"
  V2_OPTION_PROFILE=''
  V2_OPTION_HOME="$HOME"
  V2_OPTION_ALLOW_DEST="${2:-1}"
  V2_OPTION_METADATA_ONLY=0
  shift 2 || true
  local positional_seen=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        [[ $# -ge 2 ]] || { ui_err "--profile 需要路径"; return 2; }
        V2_OPTION_PROFILE="$2"
        shift 2
        ;;
      --home-root)
        [[ $# -ge 2 ]] || { ui_err "--home-root 需要路径"; return 2; }
        V2_OPTION_HOME="$2"
        shift 2
        ;;
      --metadata-only)
        V2_OPTION_METADATA_ONLY=1
        shift
        ;;
      --*)
        ui_err "未知参数: %s" "$1"
        return 2
        ;;
      *)
        [[ "$V2_OPTION_ALLOW_DEST" -eq 1 && "$positional_seen" -eq 0 ]] || {
          ui_err "参数过多: %s" "$1"
          return 2
        }
        V2_OPTION_DEST="$1"
        positional_seen=1
        shift
        ;;
    esac
  done
}

main() {
  local command="${1:-}"
  case "$command" in
    --preview)
      [[ $# -eq 2 ]] || { printf '用法: migration-pack --preview <操作>\n' >&2; return 2; }
      print_preview "${2:-}"
      ;;
    --pack|pack)
      shift
      parse_v2_options "$DEFAULT_BACKUP_DIR" 1 "$@" || return $?
      run_pack "$V2_OPTION_DEST" "$V2_OPTION_PROFILE" "$V2_OPTION_HOME" "$V2_OPTION_METADATA_ONLY"
      ;;
    --plan|plan)
      shift
      parse_v2_options '' 0 "$@" || return $?
      [[ "$V2_OPTION_METADATA_ONLY" -eq 0 ]] || { ui_err "--metadata-only 只能与 --pack 一起使用"; return 2; }
      run_plan "$V2_OPTION_PROFILE" "$V2_OPTION_HOME"
      ;;
    --check|check)
      [[ $# -le 2 ]] || { printf '参数过多；用法: migration-pack --check [DIR]\n' >&2; return 2; }
      shift
      run_check "${1:-$DEFAULT_BACKUP_DIR}"
      ;;
    --verify|verify)
      [[ $# -le 2 ]] || { printf '参数过多；用法: migration-pack --verify [DIR]\n' >&2; return 2; }
      shift
      run_check "${1:-$DEFAULT_BACKUP_DIR}" 0
      ;;
    --help|-h)
      [[ $# -eq 1 ]] || { printf '参数过多；用法: migration-pack --help\n' >&2; return 2; }
      cat <<'EOF_HELP'
用法:
  migration-pack --plan [--profile FILE] [--home-root DIR]
      只读预览 v2 配置档会迁移的路径、跳过项和秘密引用。
  migration-pack --pack [DIR] [--profile FILE] [--home-root DIR] [--metadata-only]
      生成 v2 结构化迁移包；默认原样归档选定内容。--metadata-only 供异盘 HOME 备份去重。
  migration-pack --check [DIR]
      校验迁移包；兼容既有 v1 和新的 v2 格式。
  migration-pack --verify [DIR]
      只校验结构与校验和，不比较当前系统。
  migration-pack
      交互选择生成或检查。
EOF_HELP
      ;;
    '')
      choose_action
      ;;
    --*)
      printf '未知参数: %s\n' "$1" >&2
      return 2
      ;;
    *)
      [[ $# -eq 1 ]] || { printf '参数过多；用法: migration-pack --pack [DIR]\n' >&2; return 2; }
      run_pack "$1"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
