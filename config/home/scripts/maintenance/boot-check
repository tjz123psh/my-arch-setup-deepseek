#!/usr/bin/env bash
set -euo pipefail

UI_LIB="$(dirname "$(readlink -f "$0")")/lib/ui.sh"
# shellcheck source=lib/ui.sh
. "$UI_LIB"

ok()   { ui_panel_stat ok   "$*"; }
warn() { ui_panel_stat warn "$*"; }
miss() { ui_panel_stat miss "$*"; }
info() { ui_panel_stat info "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

SUDO_READ=()
BOOT_QUERY_FAILED=0
PACKAGE_ROWS=""

request_read_access() {
  [[ "$EUID" -eq 0 ]] && return 0
  [[ -t 0 && -t 1 ]] || return 0
  if ! have sudo; then
    ui_err "完整引导检查需要 sudo，但当前没有 sudo 命令"
    return 1
  fi
  ui_info "将请求管理员密码，仅用于读取受保护的 GRUB/EFI 状态，不会修改引导。"
  if ! sudo -v; then
    ui_err "管理员权限验证失败，已取消引导检查"
    return 1
  fi
  SUDO_READ=(sudo -n)
}

protected_file_state() {
  local path="$1"
  if ((${#SUDO_READ[@]} > 0)); then
    if "${SUDO_READ[@]}" test -f "$path" 2>/dev/null; then
      return 0
    fi
    "${SUDO_READ[@]}" true >/dev/null 2>&1 || return 2
    return 1
  fi
  [[ -f "$path" ]] && return 0
  if [[ "$EUID" -ne 0 && ! -x "$(dirname "$path")" ]]; then
    return 2
  fi
  return 1
}

_PANEL_OPEN=false
panel() {
  [[ "$_PANEL_OPEN" == true ]] && ui_panel_close
  ui_panel_open "$1" "${2:-}"
  _PANEL_OPEN=true
}
panel_end() {
  [[ "$_PANEL_OPEN" == true ]] && ui_panel_close
  _PANEL_OPEN=false
}

check_pkg() {
  local pkg="$1"
  local why="$2"

  if grep -Fxq -- "$pkg" <<< "$PACKAGE_ROWS"; then
    ok "$pkg — $why"
  else
    miss "$pkg — $why"
  fi
}

check_unit() {
  local unit="$1"
  local state enabled state_rc=0 enabled_rc=0

  state="$(systemctl is-active "$unit" 2>&1)" || state_rc=$?
  enabled="$(systemctl is-enabled "$unit" 2>&1)" || enabled_rc=$?
  case "$state" in
    active|reloading|inactive|failed|activating|deactivating|maintenance) ;;
    *) state="" ;;
  esac
  case "$enabled" in
    enabled|enabled-runtime|linked|linked-runtime|alias|masked|masked-runtime|static|indirect|generated|transient|disabled|not-found|bad) ;;
    *) enabled="" ;;
  esac
  if [[ -z "$state" || -z "$enabled" ]]; then
    warn "$unit 状态查询失败（active=$state_rc, enabled=$enabled_rc）"
    BOOT_QUERY_FAILED=1
    return
  fi

  case "$state/$enabled" in
    active/enabled|active/static) ok "$unit $state/$enabled" ;;
    not-found/*|*/not-found|/) miss "$unit not-found" ;;
    *) warn "$unit ${state:-unknown}/${enabled:-unknown}" ;;
  esac
}

main() {
  local strict=0 file_rc=0 query_output="" query_rc=0
  if (( $# > 1 )); then
    ui_err "参数过多；用法: boot-check [--strict]"
    return 2
  fi
  case "${1:-}" in
    --strict) strict=1 ;;
    -h|--help) printf '用法: boot-check [--strict]\n'; return 0 ;;
    "") ;;
    *) ui_err "未知参数: %s" "$1"; return 2 ;;
  esac
  ui_tally_reset
  ui_banner "引导检查" "boot-check · 只读诊断"
  request_read_access || return $?

  panel "这项检查做什么" ""
  ui_panel_line "核对 UEFI、GRUB 配置、EFI 启动项和 Btrfs 快照引导链路。"
  ui_panel_line "只读取状态，不会运行 grub-install、grub-mkconfig，也不会改启动顺序。"
  ui_panel_line "sudo 仅用于读取普通用户看不到的 /boot/grub 和固件启动信息。"

  panel "启动模式 / 挂载点" ""
  if [[ -d /sys/firmware/efi ]]; then
    ok "当前系统以 UEFI 模式启动"
  else
    miss "当前系统不是 UEFI 模式；双系统 GRUB/EFI 检查不可靠"
  fi

  if have findmnt; then
    query_output=""
    for mountpoint in / /home /boot /efi; do
      [[ -e "$mountpoint" ]] || continue
      mount_output=""
      query_rc=0
      mount_output="$(findmnt -no TARGET,SOURCE,FSTYPE --target "$mountpoint" 2>&1)" || query_rc=$?
      if [[ "$query_rc" -ne 0 ]]; then
        warn "findmnt 查询失败: $mountpoint（退出码 $query_rc）"
        BOOT_QUERY_FAILED=1
      elif [[ -n "$mount_output" ]]; then
        query_output+="$mount_output"$'\n'
      fi
    done
    [[ -z "$query_output" ]] || printf '%s' "$query_output" | awk '!seen[$0]++' | ui_panel_raw
  else
    miss "findmnt — 建议安装 util-linux"
    BOOT_QUERY_FAILED=1
  fi

  if have lsblk; then
    query_rc=0
    query_output="$(lsblk -f 2>&1)" || query_rc=$?
    if [[ "$query_rc" -eq 0 ]]; then
      printf '%s\n' "$query_output" | ui_panel_raw
    else
      warn "lsblk 查询失败（退出码 $query_rc）"
      [[ -z "$query_output" ]] || printf '%s\n' "$query_output" | ui_panel_raw
      BOOT_QUERY_FAILED=1
    fi
  else
    miss "lsblk — 建议安装 util-linux"
    BOOT_QUERY_FAILED=1
  fi

  panel "引导相关包" ""
  query_rc=0
  PACKAGE_ROWS="$(pacman -Qq 2>&1)" || query_rc=$?
  if [[ "$query_rc" -ne 0 ]]; then
    ui_panel_stat err "pacman 已安装包查询失败（退出码 $query_rc）"
    [[ -z "$PACKAGE_ROWS" ]] || printf '%s\n' "$PACKAGE_ROWS" | ui_panel_raw
    BOOT_QUERY_FAILED=1
  else
    check_pkg grub "GRUB 引导器"
    check_pkg efibootmgr "UEFI 启动项管理"
    check_pkg os-prober "探测 Windows 启动项"
    check_pkg grub-btrfs "把 Btrfs 快照加入 GRUB"
    check_pkg snapper "快照管理"
    check_pkg btrfs-progs "Btrfs 工具"
  fi

  panel "GRUB 文件 / os-prober" ""
  file_rc=0
  protected_file_state /boot/grub/grub.cfg || file_rc=$?
  case "$file_rc" in
    0) ok "/boot/grub/grub.cfg 存在" ;;
    1) miss "/boot/grub/grub.cfg 不存在" ;;
    *) warn "/boot/grub/grub.cfg 查询失败或无读取权限"; BOOT_QUERY_FAILED=1 ;;
  esac

  file_rc=0
  protected_file_state /boot/grub/grub-btrfs.cfg || file_rc=$?
  case "$file_rc" in
    0) ok "/boot/grub/grub-btrfs.cfg 存在" ;;
    1) warn "/boot/grub/grub-btrfs.cfg 不存在；可能还没有生成快照菜单" ;;
    *) warn "/boot/grub/grub-btrfs.cfg 查询失败或无读取权限"; BOOT_QUERY_FAILED=1 ;;
  esac

  file_rc=0
  protected_file_state /etc/default/grub || file_rc=$?
  if [[ "$file_rc" -eq 0 ]]; then
    query_rc=0
    "${SUDO_READ[@]}" grep -Eq '^[[:space:]]*GRUB_DISABLE_OS_PROBER[[:space:]]*=[[:space:]]*false' \
      /etc/default/grub || query_rc=$?
    if [[ "$query_rc" -eq 0 ]]; then
      ok "GRUB_DISABLE_OS_PROBER=false"
    elif [[ "$query_rc" -eq 1 ]]; then
      warn "未看到 GRUB_DISABLE_OS_PROBER=false；Windows 菜单可能不会自动出现"
    else
      warn "/etc/default/grub 读取失败（退出码 $query_rc）"
      BOOT_QUERY_FAILED=1
    fi
  elif [[ "$file_rc" -eq 1 ]]; then
    miss "/etc/default/grub 不存在"
  else
    warn "/etc/default/grub 查询失败或无读取权限"
    BOOT_QUERY_FAILED=1
  fi

  panel "EFI 启动项" ""
  if have efibootmgr; then
    local efi_out efi_rc=0
    efi_out="$("${SUDO_READ[@]}" efibootmgr 2>&1)" || efi_rc=$?
    if [[ "$efi_rc" -eq 0 && -n "$efi_out" ]]; then
      # efibootmgr 每个启动项用 Tab 分隔「标签」与「超长设备路径」，
      # 这里只保留 Tab 前的可读标签，隐藏几百字符的十六进制路径。
      printf '%s\n' "$efi_out" | awk -F '\t' '{print $1}' | ui_panel_raw
    else
      warn "efibootmgr 读取失败（退出码 $efi_rc）"
      [[ -z "$efi_out" ]] || printf '%s\n' "$efi_out" | sed -n '1,4p' | ui_panel_raw
      BOOT_QUERY_FAILED=1
    fi
  else
    miss "efibootmgr — 建议安装 efibootmgr"
  fi

  if have bootctl; then
    # bootctl status 的 Features 列表有几十行，全部堆进面板没意义，
    # 只挑关键字段：固件架构、安全启动、TPM2、当前引导器产品与版本。
    local bootctl_out bootctl_rc=0
    bootctl_out="$("${SUDO_READ[@]}" bootctl status 2>&1)" || bootctl_rc=$?
    if [[ "$bootctl_rc" -eq 0 && -n "$bootctl_out" ]]; then
      printf '%s\n' "$bootctl_out" \
        | grep -E 'Firmware Arch|Secure Boot|TPM2 Support|Product:' \
        | sed -E 's/^[[:space:]]+//' \
        | ui_panel_raw || true
    else
      warn "bootctl 状态查询失败（退出码 $bootctl_rc）"
      [[ -z "$bootctl_out" ]] || printf '%s\n' "$bootctl_out" | sed -n '1,4p' | ui_panel_raw
      BOOT_QUERY_FAILED=1
    fi
  fi

  panel "Btrfs / Snapper / grub-btrfs" ""
  if have findmnt; then
    local root_fstype
    query_rc=0
    root_fstype="$(findmnt -no FSTYPE / 2>&1)" || query_rc=$?
    if [[ "$query_rc" -ne 0 ]]; then
      warn "根文件系统类型查询失败（退出码 $query_rc）"
      BOOT_QUERY_FAILED=1
    elif [[ "$root_fstype" == "btrfs" ]]; then
      ok "/ 是 Btrfs"
    else
      warn "/ 不是 Btrfs: ${root_fstype:-unknown}"
    fi
  fi

  if have snapper; then
    query_rc=0
    query_output="$("${SUDO_READ[@]}" snapper list-configs 2>&1)" || query_rc=$?
    if [[ "$query_rc" -eq 0 ]]; then
      printf '%s\n' "$query_output" | ui_panel_raw
    else
      warn "snapper list-configs 读取失败（退出码 $query_rc）"
      [[ -z "$query_output" ]] || printf '%s\n' "$query_output" | ui_panel_raw
      BOOT_QUERY_FAILED=1
    fi
  else
    miss "snapper 命令不存在"
  fi

  check_unit grub-btrfsd.service
  check_unit snapper-timeline.timer
  check_unit snapper-cleanup.timer
  check_unit btrfs-scrub@-.timer

  panel "建议复核命令" ""
  info "刷新 GRUB: sudo grub-mkconfig -o /boot/grub/grub.cfg"
  info "查看快照菜单: ls /boot/grub/grub-btrfs.cfg"
  info "确认 Windows: sudo os-prober"

  panel_end
  ui_tally_summary
  [[ "$BOOT_QUERY_FAILED" -eq 0 ]] || return 1
  ui_tally_status "$strict"
}

main "$@"
