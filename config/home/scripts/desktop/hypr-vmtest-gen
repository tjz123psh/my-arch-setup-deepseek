#!/usr/bin/env bash
# hypr-vmtest-gen — 重新生成 VM 测试配置（~/.config/hypr/hyprland.lua.vmtest）
# 用途：改过 ~/.config/hypr/hyprland.lua.normal（比如新增快捷键）后运行一次，刷新测试配置副本。
# 测试配置 = 正常配置的副本，但：快捷键全部禁用（注释掉 conf.keybinds 的 require），
# 只保留开关键 Win+Shift+D。对应 niri 的 niri-vmtest-gen。
#
# 机制：hyprctl reload 只能重载当前配置路径，无法像 niri 那样 load-config-file --path，
# 故 hyprland.lua 是符号链接，指向 hyprland.lua.normal（正常）或 hyprland.lua.vmtest（测试），
# 由 hypr-vmtest-toggle 原子切换链接后 hyprctl reload 生效。
# 首次运行本脚本会完成迁移：
#   hyprland.lua（普通文件）→ hyprland.lua.normal + hyprland.lua -> normal 的符号链接
# 注意：迁移后请编辑 hyprland.lua.normal（在 hyprland.lua 上编辑会跟随链接写到同一文件）。
set -euo pipefail

CONFIG_DIR="$HOME/.config/hypr"
LIVE="$CONFIG_DIR/hyprland.lua"
NORMAL="$CONFIG_DIR/hyprland.lua.normal"
TEST="$CONFIG_DIR/hyprland.lua.vmtest"

# --- 首次迁移：普通文件 → normal 副本 + 符号链接 ---
if [[ -f "$LIVE" && ! -L "$LIVE" ]]; then
  if [[ -e "$NORMAL" ]]; then
    printf '错误: %s 是普通文件且 %s 已存在，无法自动迁移（请手动处理）\n' "$LIVE" "$NORMAL" >&2
    exit 1
  fi
  mv "$LIVE" "$NORMAL"
  ln -s "$(basename "$NORMAL")" "$LIVE"
  printf '已迁移: %s -> %s（%s 改为指向它的符号链接）\n' "$LIVE" "$NORMAL" "$LIVE"
fi

if [[ ! -f "$NORMAL" ]]; then
  printf '错误: 找不到正常配置 %s\n' "$NORMAL" >&2
  exit 1
fi

python3 - "$NORMAL" "$TEST" <<'PY'
import re, sys
src, dst = sys.argv[1], sys.argv[2]
s = open(src, encoding='utf-8').read()

# 1) 去掉正常配置里已有的「VM 测试模式开关」块，避免复制出指向自身的死绑定
s = re.sub(r'\n-- >>> VM 测试模式开关.*?-- <<< VM 测试模式开关 <<<\n?', '\n', s, flags=re.S)

# 2) 注释掉 conf.keybinds 的 require（全部快捷键失效）
s = s.replace('require("conf.keybinds")',
              '-- VM 测试模式：快捷键已禁用（原 require("conf.keybinds") 被注释）')

# 3) 追加唯一保留的开关键（切回正常配置，走 hypr-vmtest-toggle leave）
s += '\n-- >>> VM 测试模式唯一保留键 >>>\n' \
     '-- 由 hypr-vmtest-gen 管理：改动会被覆盖\n' \
     'hl.bind("SUPER + SHIFT + D", hl.dsp.exec_cmd("$HOME/scripts/desktop/hypr-vmtest-toggle leave"))\n' \
     '-- <<< VM 测试模式唯一保留键 <<<\n'

open(dst, 'w', encoding='utf-8').write(s)
print("已生成:", dst)
PY

# 4) 有 luac 时做纯语法检查（Hyprland 内嵌 Lua 5.4，语法层面一致；只查语法不执行，
#    不会因 hl 全局缺失而报错）。失败仅告警，不阻断——reload 阶段一还会兜底。
if command -v luac >/dev/null 2>&1; then
  if luac -p "$TEST" >/dev/null 2>&1; then
    printf '语法检查: %s OK\n' "$TEST"
  else
    printf '警告: %s 语法检查未通过，请检查生成结果\n' "$TEST" >&2
  fi
fi
