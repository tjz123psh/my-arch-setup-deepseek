#!/usr/bin/env bash
# 描述：SUDO_ASKPASS 助手，用 fuzzel 弹出密码输入框并把密码打印到 stdout。
# Description: SUDO_ASKPASS helper that prompts for a password via fuzzel and prints it to stdout.

set -euo pipefail

# sudo -A 会把提示语作为第一个参数传进来；没有时用默认提示。
# sudo -A passes the prompt as $1; fall back to a default prompt.
PROMPT="${1:-[sudo] password: }"

require_deps() {
  local missing=()
  local cmd

  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done

  if (( ${#missing[@]} > 0 )); then
    printf '错误: 缺少依赖: %s\n' "${missing[*]}" >&2
    exit 127
  fi
}

# --- 依赖检查 ---
require_deps fuzzel

# --- 主逻辑 ---
# --dmenu + --prompt-only：不等待 stdin，回车后把输入的文本打印到 stdout。
# --password：输入内容以 * 掩码显示，不回显明文。
# --lines=0：隐藏匹配列表，只保留输入行。
main() {
  local password

  # fuzzel 用户取消（Esc）时以非零码退出，这里透传给 sudo 让它中止。
  # --placeholder=''：覆盖全局 fuzzel.ini 里给应用启动器设的「搜索…」占位符，
  # 密码框空输入时不显示无关的搜索提示（提示语已由 --prompt-only 给出）。
  if ! password=$(
    fuzzel \
      --dmenu \
      --password \
      --lines=0 \
      --placeholder='' \
      --prompt-only="$PROMPT"
  ); then
    exit 1
  fi

  printf '%s\n' "$password"
}

main
