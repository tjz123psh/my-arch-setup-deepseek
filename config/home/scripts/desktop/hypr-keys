#!/usr/bin/env bash
# Hyprland 快捷键速查，默认用 kitty + fzf 交互搜索。
# 数据源是 ~/.config/hypr/keybinds.list（分类 + TAB 分隔的清单）。
# 对应 niri 的 niri-keys；niri 解析 KDL，Hyprland 配置是 Lua，故改为读独立清单文件。

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: hypr-keys [options]

Options:
  -p, --print    直接打印解析后的快捷键列表，不进入 fzf
  -h, --help     显示帮助并退出

默认行为:
  如果不在 kitty 中运行，会自动打开一个 kitty 窗口，再用 fzf 搜索快捷键。
数据源:
  ~/.config/hypr/keybinds.list（改键位后同步此文件）
EOF
}

PRINT_ONLY=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--print)
      PRINT_ONLY=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'hypr-keys: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

FILE="$HOME/.config/hypr/keybinds.list"

if [[ ! -f "$FILE" ]]; then
  printf '找不到 %s\n' "$FILE" >&2
  [[ -t 0 ]] && read -r -p "按回车关闭"
  exit 1
fi

if [[ "$PRINT_ONLY" == false && -z "${KITTY_WINDOW_ID:-}" ]]; then
  if command -v kitty >/dev/null 2>&1; then
    exec kitty --class=hypr-keys --override initial_window_width=700 --override initial_window_height=500 "$0" "$@"
  fi
fi

if [[ "$PRINT_ONLY" == false ]] && ! command -v fzf >/dev/null 2>&1; then
  printf '缺少依赖: fzf\n' >&2
  exit 127
fi

BOLD=$'\033[1m'
DIM=$'\033[2m'
LB=$'\033[94m'
CY=$'\033[36m'
RESET=$'\033[0m'

if [[ ! -t 1 || "$PRINT_ONLY" == true ]]; then
  BOLD=""; DIM=""; LB=""; CY=""; RESET=""
fi

# 解析 keybinds.list：
#   "# 分类" 行 → 分类标题
#   "<键><TAB><描述>" 行 → 一条快捷键
#   空行、纯 # 注释（数据区外的说明）忽略
# 输出制表符分隔的 <分类>\t<键>\t<描述>，交给 build_lines 渲染。
parse_keybinds() {
  awk -F'\t' '
    # 分类标题：以 # 开头且后面跟内容（不含 TAB 的说明块除外）
    /^#[[:space:]]/ {
      line=$0
      sub(/^#[[:space:]]*/, "", line)
      sec=line
      next
    }
    # 跳过空行和无 TAB 的行（文件头部说明块）
    /^[[:space:]]*$/ { next }
    NF < 2 { next }
    {
      key=$1
      # 描述取第 2 个字段（清单里键与描述之间是单个 TAB）
      desc=$2
      gsub(/^[[:space:]]+/, "", key)
      gsub(/[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+/, "", desc)
      if (sec != "" && key != "" && desc != "")
        print sec "\t" key "\t" desc
    }
  ' "$FILE"
}

rawdata="$(parse_keybinds)"
if [[ -z "$rawdata" ]]; then
  printf '没有找到快捷键数据\n' >&2
  [[ -t 0 ]] && read -r -p "按回车关闭"
  exit 1
fi

build_lines() {
  local lastcat="" cat key desc

  while IFS=$'\t' read -r cat key desc; do
    if [[ "$lastcat" != "$cat" ]]; then
      printf '\n%s%s── %s %s\n' "$BOLD" "$CY" "$cat" "$RESET"
      lastcat="$cat"
    fi
    printf '  %s%-28s%s %s\n' "$LB" "$key" "$RESET" "$desc"
  done <<< "$rawdata"
}

fzf_input="$(build_lines)"

if [[ "$PRINT_ONLY" == true ]]; then
  printf '%s\n' "$fzf_input"
  exit 0
fi

printf '\033[?25l'
trap 'printf "\033[?25h"; stty echo 2>/dev/null || true' EXIT

selected="$(printf '%s\n' "$fzf_input" | fzf --ansi --reverse \
  --prompt='搜索快捷键: ' \
  --info=inline \
  --border=none \
  --bind 'esc:abort,ctrl-c:abort')" || selected=""

if [[ -n "$selected" ]]; then
  printf '%s按回车关闭%s\n' "$DIM" "$RESET"
  read -r
fi
