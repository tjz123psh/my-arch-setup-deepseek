#!/usr/bin/env bash
# niri-vmtest-gen — 重新生成 VM 测试配置（~/.config/niri/config.kdl.vmtest）
# 用途：改过 ~/.config/niri/config.kdl（比如新增快捷键）后运行一次，刷新测试配置副本。
# 测试配置 = config.kdl 的副本，但：全部快捷键被禁用，只保留开关键 Win+Shift+D。
set -euo pipefail

NORMAL="$HOME/.config/niri/config.kdl"
TEST="$HOME/.config/niri/config.kdl.vmtest"

python3 - "$NORMAL" "$TEST" <<'PY'
import re, sys
src, dst = sys.argv[1], sys.argv[2]
s = open(src, encoding='utf-8').read()

# 1) 去掉 config 里已有的"VM 测试模式开关"块，避免复制出指向自身的死绑定
s = re.sub(r'\n// VM 测试模式开关：.*?\n\}\n?', '\n', s, flags=re.S)

# 2) 注释掉 keybinds include（全部快捷键失效）
s = s.replace('include "dms/keybinds.kdl"',
              '// VM 测试模式：快捷键已禁用（原 include 被注释）')

# 3) 清空 recent-windows 的 binds
s = re.sub(r'recent-windows \{\n    binds \{.*?\n    \}\n\}',
           'recent-windows {\n    // 快捷键已在 VM 测试模式禁用\n}', s, flags=re.S)

# 4) 追加唯一保留的开关键（指向正常配置，绝对路径）
s += '\n// VM 测试模式唯一保留键：Win+Shift+D 切回正常模式\nbinds {\n    Mod+Shift+D { spawn "niri" "msg" "action" "load-config-file" "--path" "%s"; }\n}\n' % src

open(dst, 'w', encoding='utf-8').write(s)
print("已生成:", dst)
PY
