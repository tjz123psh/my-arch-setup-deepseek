#!/usr/bin/env bash
# niri-vmtest-gen — 重新生成 VM 测试配置（~/.config/niri/config.kdl.vmtest）
# 用途：改过 ~/.config/niri/config.kdl（比如新增快捷键）后运行一次，刷新测试配置副本。
# 测试配置 = config.kdl 的副本，但：全部快捷键被禁用，只保留开关键 Win+Shift+D。
#
# 安全网：正常配置结构变了（找不到开关块 / include "dms/keybinds.kdl"）或
# `niri validate` 不通过就中止，并保留原测试配置，避免产出「测试模式仍加载全部
# host 快捷键」的假测试配置。
set -euo pipefail

# 配置目录可用环境变量覆盖，便于在不碰真实配置的前提下自测。
CONFIG_DIR="${NIRI_VMTEST_CONFIG_DIR:-$HOME/.config/niri}"
NORMAL="$CONFIG_DIR/config.kdl"
TEST="$CONFIG_DIR/config.kdl.vmtest"

if [[ ! -f "$NORMAL" ]]; then
  printf '错误: 找不到正常配置 %s\n' "$NORMAL" >&2
  exit 1
fi

# 先写临时文件（同目录，include 相对路径才能解析），通过全部检查后再原子替换。
TMP="$TEST.tmp.$$"
trap 'rm -f "$TMP"' EXIT

python3 - "$NORMAL" "$TMP" <<'PY'
import re, sys

src, dst = sys.argv[1], sys.argv[2]
s = open(src, encoding='utf-8').read()
problems = []

# 1) 去掉 config 里已有的"VM 测试模式开关"块，避免复制出指向自身的死绑定
s, n_switch = re.subn(r'\n// VM 测试模式开关：.*?\n\}\n?', '\n', s, flags=re.S)
if n_switch != 1:
    problems.append('未找到 // VM 测试模式开关：... 块（找到 %d 处）' % n_switch)

# 2) 注释掉 keybinds include（全部快捷键失效）
s, n_include = re.subn(r'include "dms/keybinds\.kdl"',
                       '// VM 测试模式：快捷键已禁用（原 include 被注释）', s)
if n_include != 1:
    problems.append('未找到 include "dms/keybinds.kdl"（找到 %d 处）' % n_include)

if problems:
    for p in problems:
        print('错误: ' + p, file=sys.stderr)
    print('错误: %s 结构与预期不符，已中止生成（原测试配置未改动）' % src, file=sys.stderr)
    sys.exit(1)

# 3) 清空 recent-windows 的 binds
s = re.sub(r'recent-windows \{\n    binds \{.*?\n    \}\n\}',
           'recent-windows {\n    // 快捷键已在 VM 测试模式禁用\n}', s, flags=re.S)

# 4) 追加唯一保留的开关键（指向正常配置，绝对路径）
s += '\n// VM 测试模式唯一保留键：Win+Shift+D 切回正常模式\nbinds {\n    Mod+Shift+D { spawn "niri" "msg" "action" "load-config-file" "--path" "%s"; }\n}\n' % src

open(dst, 'w', encoding='utf-8').write(s)

# 5) 事后自检：不得残留生效的 include，且必须含返回键
leftover = [l for l in s.splitlines()
            if 'include "dms/keybinds.kdl"' in l and not l.lstrip().startswith('//')]
if leftover or 'load-config-file' not in s:
    print('错误: 生成结果自检未通过（残留快捷键加载或缺少返回键）', file=sys.stderr)
    sys.exit(1)
PY

# 6) 有 niri 时先做配置校验，通过才安装——语法/语义坏的测试配置会让
#    Mod+Shift+D 切过去之后没有快捷键可用。
if command -v niri >/dev/null 2>&1; then
  if ! niri validate -c "$TMP" >/dev/null 2>&1; then
    printf '错误: 生成的测试配置校验未通过，已保留原配置 %s\n' "$TEST" >&2
    niri validate -c "$TMP" 2>&1 | tail -3 >&2
    exit 1
  fi
fi

mv -f "$TMP" "$TEST"
trap - EXIT
printf '已生成: %s\n' "$TEST"
if command -v niri >/dev/null 2>&1; then
  printf '配置校验: %s OK\n' "$TEST"
fi
