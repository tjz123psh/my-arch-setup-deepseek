// Dedicated VM regression configuration.  It deliberately contains no
// physical output name, ASUS device binding, personal autostart, or boot action.
config-notification {
    disable-failed
}

environment {
    XDG_CURRENT_DESKTOP "niri"
}

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 3
        active-color "#7aa2f7"
        inactive-color "#565f89"
    }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+D hotkey-overlay-title="Launcher" { spawn "fuzzel"; }
    Mod+Q hotkey-overlay-title="Close Window" { close-window; }
    Mod+Shift+E hotkey-overlay-title="Exit Niri" { quit; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Print { screenshot; }
}
