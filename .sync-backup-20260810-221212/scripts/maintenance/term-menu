show_snapshots() {
  local conf cols desc_width tmp line_count page_lines snapshot_status=0

  if ! command -v snapper >/dev/null 2>&1; then
    _leaf_stat "miss" "缺少依赖：snapper"
    return 1
  fi

  cols="$(tput cols 2>/dev/null || true)"
  if [[ ! "$cols" =~ ^[0-9]+$ ]]; then
    cols=80
  fi

  # 列宽（显示列）。对齐只依赖 ASCII(#ID/日期) 和纯 CJK(表头词)，
  # ui_dwidth 对两者都精确；当前/历史用颜色区分，不用宽度不定的图标。
  local W_ID=6 W_TIME=18 W_USER=8 W_CLEAN=10 W_IND=3
  desc_width=$((cols - W_IND - W_ID - W_TIME - W_USER - W_CLEAN - 4 - 2))
  if [ "$desc_width" -lt 12 ]; then
    desc_width=12
  elif [ "$desc_width" -gt 48 ]; then
    desc_width=48
  fi

  compact_text() {
    local text="$1"
    local max="$2"
    # 用显示列（非字节）截断，兼顾 CJK 描述
    if [ "$(ui_dwidth "$text")" -le "$max" ]; then
      printf '%s' "$text"
      return
    fi
    local out="" ch i w=0
    for ((i = 0; i < ${#text}; i++)); do
      ch="${text:i:1}"
      w=$((w + $(ui_dwidth "$ch")))
      [ "$w" -gt $((max - 1)) ] && break
      out+="$ch"
    done
    printf '%s…' "$out"
  }

  # 一行数据：缩进 + 各列按显示列右填充；ui_pad 会剥离 ANSI，故带色单元也对齐。
  _snap_row() {
    printf "%*s%s %s %s %s %s\n" "$W_IND" "" \
      "$(ui_pad "$1" "$W_ID")" \
      "$(ui_pad "$2" "$W_TIME")" \
      "$(ui_pad "$3" "$W_USER")" \
      "$(ui_pad "$4" "$W_CLEAN")" \
      "$5"
  }

  # 单个 snapper 配置的快照清单：分节标题 + 表头 + 分隔线 + 数据行。
  print_snapshot_list() {
    local conf="$1"
    local rows number date user cleanup desc
    local date_display desc_display idcell rule_w
    local sep=$'\037'
    local count=0 entries=""

    if ! rows="$(snapper --csvout --separator "$sep" --iso -c "$conf" list --columns number,date,user,cleanup,description 2>/dev/null)"; then
      ui_subsection "$conf 快照"
      _leaf_stat "warn" "配置不存在或无法读取：$conf"
      return 1
    fi

    while IFS="$sep" read -r number date user cleanup desc; do
      [ "$number" = "number" ] && continue
      [ -n "$number" ] || continue

      if [ -n "$date" ]; then
        date_display="${date%:*}"
        # 历史快照：ID 用青色
        idcell="${UI_C_SKY}#${number}${UI_RESET}"
      else
        date_display="${UI_C_GREEN}运行中${UI_RESET}"
        # 当前系统：ID 用绿色，一眼区分
        idcell="${UI_C_GREEN}#${number}${UI_RESET}"
      fi

      [ -n "$user" ] || user="—"
      [ -n "$cleanup" ] || cleanup="—"
      [ -n "$desc" ] || desc="—"
      desc_display="$(compact_text "$desc" "$desc_width")"
      count=$((count + 1))

      entries+="$(_snap_row \
        "$idcell" \
        "$date_display" \
        "${UI_C_SUBTLE}${user}${UI_RESET}" \
        "${UI_C_SUBTLE}${cleanup}${UI_RESET}" \
        "${UI_C_TEXT}${desc_display}${UI_RESET}")"
      entries+=$'\n'
    done <<< "$rows"

    ui_subsection "$conf 快照   ${UI_DIM}${count} 个条目${UI_RESET}"
    # 表头（与数据行同缩进、同列宽，全 CJK/ASCII 不含图标 → 精确对齐）
    _snap_row \
      "${UI_C_SUBTLE}ID${UI_RESET}" \
      "${UI_C_SUBTLE}时间${UI_RESET}" \
      "${UI_C_SUBTLE}用户${UI_RESET}" \
      "${UI_C_SUBTLE}清理${UI_RESET}" \
      "${UI_C_SUBTLE}描述${UI_RESET}"
    # 分隔线：与列区等宽
    rule_w=$((W_ID + W_TIME + W_USER + W_CLEAN + 4 + desc_width))
    printf "%*s${UI_DIM}" "$W_IND" ""
    local _i
    for ((_i = 0; _i < rule_w; _i++)); do printf '─'; done
    printf "${UI_RESET}\n"
    if [ -n "$entries" ]; then
      printf "%s" "$entries"
    else
      printf "%*s${UI_C_YELLOW}没有快照记录${UI_RESET}\n" "$W_IND" ""
    fi
  }

  tmp="$(mktemp)"
  {
    for conf in root home; do
      print_snapshot_list "$conf" || snapshot_status=1
    done

    printf "\n  ${UI_DIM}这里只查看快照；恢复用 quickload，删除用「删除快照」。${UI_RESET}\n"
  } > "$tmp"

  line_count="$(wc -l < "$tmp")"
  page_lines="$(tput lines 2>/dev/null || true)"
  if [[ ! "$page_lines" =~ ^[0-9]+$ ]]; then
    page_lines=24
  fi
  page_lines=$((page_lines - 4))

  if [ -t 1 ] && [ "$line_count" -gt "$page_lines" ]; then
    if command -v less >/dev/null 2>&1; then
      LESS=FRX less -R "$tmp"
    elif command -v more >/dev/null 2>&1; then
      more "$tmp"
    else
      cat "$tmp"
    fi
  else
    cat "$tmp"
  fi

  rm -f "$tmp"
  return "$snapshot_status"
}

split_snapshot_ids() {
  local input="$1"
  local ids=()

  read -r -a ids <<< "$input"
  printf '%s\n' "${ids[@]}"
}

run_snapshot_deletions() {
  local conf="$1"
  shift
  local snap_id status=0

  ui_maintenance_lock_acquire "批量删除快照" || return $?
  for snap_id in "$@"; do
    # 本层已完成关键词确认；子脚本继承锁，不会与当前批次自相冲突。
    quicksave -c "$conf" -del "$snap_id" --yes || status=1
  done
  ui_maintenance_lock_release
  return "$status"
}

delete_snapshot() {
  if ! command -v snapper >/dev/null 2>&1 || ! command -v quicksave >/dev/null 2>&1; then
    printf "${RED}缺少依赖:${NC} snapper 或 quicksave\n"
    return 1
  fi

  local conf snapshots selected snap_ids=() manual_ids=() snap_id snap_date snap_desc confirm
  local sep=$'\037'
  local config_rows config_name subvolume config_items index
  local snap_rows number date desc

  if ! config_rows="$(snapper --csvout --separator "$sep" list-configs 2>/dev/null)"; then
    printf "${RED}Snapper 配置查询失败${NC}\n"
    return 1
  fi
  config_items=""
  index=1

  while IFS="$sep" read -r config_name subvolume; do
    [ "$config_name" = "config" ] && continue
    [ -n "$config_name" ] || continue

    config_items+=$(printf "%02d\t%s\t%s\t删除 %s 下的快照" "$index" "$config_name" "$config_name" "${subvolume:-该配置}")
    config_items+=$'\n'
    index=$((index + 1))
  done <<< "$config_rows"

  if [ -z "$config_items" ]; then
    printf "${RED}未找到 Snapper 配置${NC}\n"
    return 1
  fi

  conf="$(choose_menu "选择快照配置" "$config_items")" || return 130
  IFS=$'\t' read -r _ _ conf _ <<< "$conf"
  [ -z "$conf" ] && return 130

  if ! snap_rows="$(snapper --csvout --separator "$sep" --iso -c "$conf" list --columns number,date,description 2>/dev/null)"; then
    printf "${RED}配置 [%s] 的快照列表查询失败${NC}\n" "$conf"
    return 1
  fi
  snapshots=""

  while IFS="$sep" read -r number date desc; do
    [ "$number" = "number" ] && continue
    [[ "$number" =~ ^[0-9]+$ ]] || continue
    [ "$number" != "0" ] || continue

    if [ -n "$date" ]; then
      date="${date%:*}"
    else
      date="当前"
    fi

    [ -n "$desc" ] || desc="(无描述)"
    desc="${desc//$'\t'/ }"
    snapshots+=$(printf "%s\t%s\t%s" "$number" "$date" "$desc")
    snapshots+=$'\n'
  done <<< "$snap_rows"

  if [ -z "$snapshots" ]; then
    printf "${YELLOW}配置 [%s] 没有可删除快照${NC}\n" "$conf"
    return 0
  fi

  if command -v fzf >/dev/null 2>&1; then
    selected=$(
      printf "%s\n" "$snapshots" |
        fzf \
          --delimiter=$'\t' \
          --with-nth=1,2,3 \
          --multi \
          --height=100% \
          --min-height=20 \
          --layout=reverse \
          --style=full \
          --border=rounded \
          --border-label="╢  删除快照 [$conf] ╟" \
          --border-label-pos=3 \
          --list-border=rounded \
          --list-label=' 快照列表 ' \
          --list-label-pos=3 \
          --input-border=rounded \
          --input-label=' 筛选 ' \
          --input-label-pos=3 \
          --header-border=rounded \
          --header-label=' 操作 ' \
          --header-first \
          --prompt='  ' \
          --pointer='▶' \
          --marker='✓' \
          --highlight-line \
          --cycle \
          --scroll-off=2 \
          --info=inline-right \
          --header='  ↑↓ 循环移动   Tab 多选   Shift+Tab 取消   Enter 确认   Esc 取消' \
          --preview='printf "\033[38;2;203;166;247m ID\033[0m    {1}\n\033[38;2;137;180;250m 时间\033[0m  {2}\n\033[38;2;245;194;231m 描述\033[0m  {3}\n"' \
          --preview-window='right,50%,border-rounded,wrap' \
          --preview-label=' 快照详情 ' \
          --color="$(fzf_colors)"
    ) || return 130
  else
    printf "%s\n" "$snapshots"
    printf "\n输入要删除的快照 ID，多个用空格分隔: "
    read -r snap_id
    mapfile -t manual_ids < <(split_snapshot_ids "$snap_id")
    selected="$(printf '%s\n' "${manual_ids[@]}")"
  fi

  [ -z "$selected" ] && return 130

  printf "${YELLOW}准备删除:${NC} 配置 [%s]\n" "$conf"
  while IFS= read -r line; do
    if [[ "$line" == *$'\t'* ]]; then
      IFS=$'\t' read -r snap_id snap_date snap_desc <<< "$line"
    else
      snap_id="$line"
      snap_date=""
      snap_desc=""
    fi

    if [[ ! "$snap_id" =~ ^[0-9]+$ ]]; then
      printf "${RED}无效快照 ID:${NC} %s\n" "$snap_id"
      return 1
    fi

    snap_ids+=("$snap_id")
    printf "  #%s" "$snap_id"
    [ -n "${snap_date:-}" ] && printf "  %s" "$snap_date"
    [ -n "${snap_desc:-}" ] && printf "  %s" "$snap_desc"
    printf "\n"
  done <<< "$selected"

  printf "\n输入 ${RED}delete${NC} 确认删除: "
  read -r confirm
  if [ "$confirm" != "delete" ]; then
    printf "已取消。\n"
    return 130
  fi

  run_snapshot_deletions "$conf" "${snap_ids[@]}"
}

