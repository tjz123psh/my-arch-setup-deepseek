# 结果页内的徽章行 / 键值行（缩进 2，不带左轨 │，以免与闭合框头脚冲突）。
# 通用组件，网络状态、查看快照等叶子内容体共用同一套视觉。
_leaf_stat() {
  local status="$1" text="${2:-}" icon color
  case "$status" in
    ok)   icon="$UI_ICON_OK";   color="$UI_C_GREEN" ;;
    warn) icon="$UI_ICON_WARN"; color="$UI_C_YELLOW" ;;
    miss) icon="$UI_ICON_MISS"; color="$UI_C_SUBTLE" ;;
    *)    icon="$UI_ICON_INFO"; color="$UI_C_SAPPHIRE" ;;
  esac
  printf "  ${color}%s${UI_RESET} %s\n" "$icon" "$text"
}
_leaf_kv() {
  printf "  ${UI_C_SKY}%s${UI_RESET}  %s\n" "$(ui_pad "$1" 12)" "$2"
}

show_network_status() {
  # 表格式重排，替代裸 nmcli 表格 / 裸 ip route，与查看快照同一套视觉。
  # 对齐锚点全用 ASCII(设备名/类型) 和纯 CJK(状态词)，状态用颜色区分而非
  # 宽度不定的 Nerd Font 图标，从根本上避免行间错位。
  local line dev typ state conn scolor sdesc
  local W_IND=3 W_DEV=16 W_TYPE=10 W_STATE=12

  # 一行数据：缩进 + 各列按显示列右填充（ui_pad 剥离 ANSI，带色单元也对齐）。
  _net_row() {
    printf "%*s%s %s %s %s\n" "$W_IND" "" \
      "$(ui_pad "$1" "$W_DEV")" \
      "$(ui_pad "$2" "$W_TYPE")" \
      "$(ui_pad "$3" "$W_STATE")" \
      "$4"
  }

  printf '\n'
  ui_subsection "网络设备"
  if command -v nmcli >/dev/null 2>&1; then
    # 表头（与数据行同缩进同列宽，纯 CJK/ASCII → 精确对齐）
    _net_row \
      "${UI_C_SUBTLE}设备${UI_RESET}" \
      "${UI_C_SUBTLE}类型${UI_RESET}" \
      "${UI_C_SUBTLE}状态${UI_RESET}" \
      "${UI_C_SUBTLE}连接${UI_RESET}"
    # 分隔线：与列区等宽
    local rule_w=$((W_DEV + W_TYPE + W_STATE + 3 + 18))
    printf "%*s${UI_DIM}" "$W_IND" ""
    local _i
    for ((_i = 0; _i < rule_w; _i++)); do printf '─'; done
    printf "${UI_RESET}\n"
    # terse 模式稳定可解析：DEVICE:TYPE:STATE:CONNECTION，字段内冒号已转义
    while IFS=: read -r dev typ state conn; do
      [ -n "$dev" ] || continue
      case "$state" in
        connected)              scolor="$UI_C_GREEN";   sdesc="已连接" ;;
        connected\ *)           scolor="$UI_C_SKY";     sdesc="外部接管" ;;
        connecting*)            scolor="$UI_C_SAPPHIRE"; sdesc="连接中" ;;
        disconnected)           scolor="$UI_C_YELLOW";  sdesc="已断开" ;;
        unavailable)            scolor="$UI_C_SUBTLE";  sdesc="不可用" ;;
        unmanaged)              scolor="$UI_C_SUBTLE";  sdesc="未托管" ;;
        *)                      scolor="$UI_C_SUBTLE";  sdesc="$state" ;;
      esac
      _net_row \
        "${UI_C_TEXT}${dev}${UI_RESET}" \
        "${UI_C_SUBTLE}${typ}${UI_RESET}" \
        "${scolor}${sdesc}${UI_RESET}" \
        "${UI_C_TEXT}${conn:-—}${UI_RESET}"
    done < <(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null || true)
  else
    printf "%*s${UI_C_YELLOW}缺少 nmcli，无法读取设备状态${UI_RESET}\n" "$W_IND" ""
  fi

  printf '\n'
  ui_subsection "默认路由"
  line="$(ip route show default 2>/dev/null | head -n1 || true)"
  if [ -n "$line" ]; then
    # 从 "default via GW dev IF proto P src SRC metric M" 提取关键字段
    local gw ifc src metric
    gw="$(printf '%s' "$line" | grep -oP 'via \K[0-9a-fA-F:.]+' || true)"
    ifc="$(printf '%s' "$line" | grep -oP 'dev \K[^ ]+' || true)"
    src="$(printf '%s' "$line" | grep -oP 'src \K[0-9a-fA-F:.]+' || true)"
    metric="$(printf '%s' "$line" | grep -oP 'metric \K[0-9]+' || true)"
    [ -n "$gw" ]     && _leaf_kv "网关" "${UI_C_YELLOW}${gw}${UI_RESET}"
    [ -n "$ifc" ]    && _leaf_kv "出口网卡" "$ifc"
    [ -n "$src" ]    && _leaf_kv "本机地址" "${UI_C_YELLOW}${src}${UI_RESET}"
    [ -n "$metric" ] && _leaf_kv "路由优先级" "${UI_DIM}${metric}${UI_RESET}"
  else
    _leaf_stat "warn" "没有默认路由（可能未联网）"
  fi
}

# 结果页脚：一条居中的圆角提示条，与 run_leaf 顶部标题条首尾呼应，
# 收束整屏输出并引导返回。用薰衣草主边框 + 粉色提示文字，
# 与主菜单 fzf 玻璃拟态同一套配色，替代旧的「只有顶边、右侧散开」残缺半框。
pause_for_menu() {
  ui_wait_key "按任意键返回菜单"
  show_cursor
}

# 结果页头：一条居中的圆角标题条，与 pause_for_menu 返回条首尾对称、同色系，
# 把整屏输出包成「标题条 → 内容 → 返回条」的完整卡片，替代旧的 ==> 粗糙前缀。
run_leaf_header() {
  local title="$1"
  local w head head_w pad i
  w=$(_ui_rule_width)
  head=$'\uf105  '"$title"
  head_w="$(ui_dwidth "$head")"

  # 顶边：╭──────────╮
  printf "\n${UI_C_LAVENDER}╭"
  for ((i = 0; i < w - 2; i++)); do printf '─'; done
  printf "╮${UI_RESET}\n"

  # 标题行居中：│      标题      │
  pad=$(( (w - 2 - head_w) / 2 ))
  (( pad < 0 )) && pad=0
  printf "${UI_C_LAVENDER}│${UI_RESET}"
  for ((i = 0; i < pad; i++)); do printf ' '; done
  printf "${UI_C_MAUVE}${UI_BOLD}%s${UI_RESET}" "$head"
  for ((i = 0; i < w - 2 - pad - head_w; i++)); do printf ' '; done
  printf "${UI_C_LAVENDER}│${UI_RESET}\n"

  # 底边：╰──────────╯
  printf "${UI_C_LAVENDER}╰"
  for ((i = 0; i < w - 2; i++)); do printf '─'; done
  printf "╯${UI_RESET}\n\n"
}

# 执行一个叶子动作（真正的功能命令，非子菜单）。
# 只负责跑命令；清屏与「任意键返回」的暂停由调用方（各级菜单循环）统一处理。
run_leaf() {
  local label="$1"
  local act="$2"

  clear_screen
  # 结果页头：圆角标题条，与页脚返回条首尾对称、同色系，形成完整视觉包裹。
  # 标题用友好中文名（_pv_name），不再暴露 network-status 之类内部动作名。
  run_leaf_header "$(_pv_name "$act")"

  case "$act" in
    clean-all) run_clean_all ;;
    cache-clean-safe) run_cache_clean_safe ;;
    cache-clean-dev) run_cache_clean_dev ;;
    cache-clean-chrome) run_cache_clean_chrome ;;
    delete-snapshot) delete_snapshot ;;
    view-snapshots) show_snapshots ;;
    network-status) show_network_status ;;
    migration-pack-plan) TERM_MENU_CHILD=1 migration-pack --plan ;;
    migration-pack-pack) TERM_MENU_CHILD=1 migration-pack --pack ;;
    migration-pack-check) TERM_MENU_CHILD=1 migration-pack --check ;;
    migration-pack-offsite) TERM_MENU_CHILD=1 offsite-backup ;;
    backup-restore) TERM_MENU_CHILD=1 backup-restore ;;
    backup-restore-apply) TERM_MENU_CHILD=1 backup-restore --apply-home ;;
    blueman-manager|blueberry)
      "$act" &
      printf "${GREEN}已启动:${NC} %s\n" "$label"
      sleep 1
      ;;
    *)
      run_command "$act"
      ;;
  esac
}

# 普通叶子动作成功或失败后保留输出并等待确认。子工具用 130 表示 Esc/取消，
# 用 10 表示主动返回父菜单；这两种导航状态都应立即重绘上一级菜单。
run_leaf_and_pause() {
  local label="$1"
  local act="$2"
  local status=0

  run_leaf "$label" "$act"
  status=$?

  if [ "$status" -eq 130 ] || [ "$status" -eq 10 ]; then
    return 0
  fi

  if [ "$status" -ne 0 ]; then
    printf '\n'
    ui_warn "该操作未成功完成（退出码：%s）。上方消息会保留到你返回菜单。" "$status"
  fi

  pause_for_menu
  return 0
}

# 主菜单：进入子菜单后返回本层，选叶子动作则执行后暂停再回本层，
# 只有选「退出」或按 Esc 才真正退出。
show_main_menu() {
  local selected key label act desc current_key="01"
  while true; do
    clear_screen
    selected="$(choose_menu "维护菜单" "$MAIN_ITEMS" "$current_key")" || exit_menu
    IFS=$'\t' read -r key label act desc <<< "$selected"
    current_key="$key"

    case "$act" in
      __exit) exit_menu ;;
      __update_menu) show_update_menu ;;
      __clean_menu) show_clean_menu ;;
      __snapshot_menu) show_snapshot_menu ;;
      __check_menu) show_check_menu ;;
      __migration_menu) show_migration_menu ;;
      __network_menu) show_network_menu ;;
      *)
        run_leaf_and_pause "$label" "$act"
        ;;
    esac
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  case "${1:-}" in
    -h|--help)
      [[ $# -eq 1 ]] || { ui_err "参数过多；用法: term-menu"; exit 2; }
      printf '用法: term-menu\n打开交互式系统维护菜单。\n'
      exit 0
      ;;
    "") ;;
    *) ui_err "未知参数: %s" "$1"; exit 2 ;;
  esac
  show_main_menu
fi
