fzf_colors() {
  ui_fzf_colors
}

menu_start_position() {
  local items="$1" wanted_key="${2:-}" position=""

  [[ -n "$wanted_key" ]] || { printf '1'; return 0; }
  position="$(awk -F $'\t' -v key="$wanted_key" '$1 == key {print NR; exit}' <<< "$items")"
  [[ "$position" =~ ^[1-9][0-9]*$ ]] || position=1
  printf '%s' "$position"
}

choose_menu() {
  local title="$1"
  local items="$2"
  local initial_key="${3:-}"
  local selected choice key label act desc status start_position

  # fzf 每次重新打开默认聚焦第一项。保留调用方上次确认的 key，
  # 让执行、取消或查看结果后仍回到刚才的功能，而非跳回菜单顶部。
  start_position="$(menu_start_position "$items" "$initial_key")"

  if command -v fzf >/dev/null 2>&1; then
    local footer
    footer="$(ui_status_line)"
    set +e
    selected="$(
      printf "%s\n" "$items" |
        fzf \
          --delimiter=$'\t' \
          --with-nth=1,2 \
          --height=100% \
          --min-height=24 \
          --layout=reverse \
          --style=full \
          --border=rounded \
          --border-label="╢  $title ╟" \
          --border-label-pos=3 \
          --list-border=rounded \
          --list-label=" 功能选择 " \
          --list-label-pos=3 \
          --input-border=rounded \
          --input-label=" 筛选 " \
          --input-label-pos=3 \
          --header-border=rounded \
          --header-label=" 操作 " \
          --header-first \
          --footer-border=rounded \
          --footer-label="   系统状态 " \
          --footer="$footer" \
          --prompt='  ' \
          --pointer='▶' \
          --marker='✓' \
          --highlight-line \
          --cycle \
          --scroll-off=2 \
          --gap=0 \
          --info=inline-right \
          --bind="load:pos($start_position),home:first,end:last,ctrl-p:up,ctrl-n:down" \
          --header='  Enter 执行   ↑↓/Ctrl+P/N 循环移动   Home/End 首末   Esc 返回' \
          --preview-window='right,58%,border-rounded,wrap' \
          --preview-label=' 功能说明 ' \
          --preview="bash '$SELF' --preview {3}" \
          --color="$(fzf_colors)"
    )"
    status=$?
    set -e
    [ "$status" -eq 0 ] || return 1
  else
    printf "${CYAN}%s${NC}\n" "$title"
    printf "${DIM}────────────────────────────────────────${NC}\n"
    while IFS=$'\t' read -r key label act desc; do
      [ -n "$key" ] || continue
      if [ "$act" = "__exit" ]; then
        printf "  ${CYAN}%s${NC}  %-12s ${DIM}%s${NC}\n" "$key" "$label" "$desc"
      else
        printf "  ${CYAN}%s${NC}  %-12s ${DIM}%-18s${NC} %s\n" "$key" "$label" "$act" "$desc"
      fi
    done <<< "$items"
    printf "${DIM}────────────────────────────────────────${NC}\n"
    read -rp "选择操作: " choice
    selected="$(printf "%s\n" "$items" | awk -F '\t' -v key="$choice" '$1 == key || $1 + 0 == key {print; exit}')"
    [ -n "$selected" ] || return 1
  fi

  printf '%s\n' "$selected"
}

run_command() {
  local act="$1"

  if command -v "$act" >/dev/null 2>&1; then
    # 子脚本据此知道结果页由 term-menu 统一暂停，避免内外连续按两次键。
    if TERM_MENU_CHILD=1 "$act"; then
      return 0
    else
      return $?
    fi
  else
    printf "${RED}命令不可用:${NC} %s\n" "$act"
    return 127
  fi
}

exit_menu() {
  if command -v niri >/dev/null 2>&1; then
    if niri msg -j focused-window 2>/dev/null | grep -q '"app_id":"term-menu"'; then
      niri msg action close-window >/dev/null 2>&1 || true
    fi
  fi

  exit 0
}

