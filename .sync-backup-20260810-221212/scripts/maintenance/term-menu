#!/usr/bin/env bash
# shellcheck disable=SC2059
# 这是长期运行的交互式菜单：叶子脚本返回非 0 时必须保留现场并回到菜单，
# 不能让 errexit 在 pause_for_menu 之前直接关掉整个窗口。
set -uo pipefail

export PATH="$HOME/.local/bin:$HOME/scripts/maintenance:$PATH"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

UI_LIB="$(dirname "$SELF")/lib/ui.sh"
# shellcheck source=lib/ui.sh
. "$UI_LIB"

NET_TOOL=""
BT_TOOL=""

show_cursor() {
  if [ -t 1 ]; then
    tput cnorm 2>/dev/null || true
  fi
}

# 彻底清屏：光标归位 + 清可视区 + 清 scrollback 回滚缓冲。
# 普通 clear/tput clear 只发 \E[H\E[2J（清可视屏），kitty 下上一次的
# 长输出仍留在回滚缓冲里，向上滚就露出来。追加 \E[3J 清回滚缓冲。
clear_screen() {
  if [ -t 1 ]; then
    printf '\033[H\033[2J\033[3J'
  else
    clear 2>/dev/null || true
  fi
}

trap show_cursor EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if systemctl is-active --quiet NetworkManager 2>/dev/null && command -v nmtui >/dev/null 2>&1; then
  NET_TOOL="nmtui"
fi

if [ -d /sys/class/bluetooth ] && [ -n "$(ls -A /sys/class/bluetooth 2>/dev/null)" ]; then
  if command -v bluetui >/dev/null 2>&1; then
    BT_TOOL="bluetui"
  elif command -v bluetuith >/dev/null 2>&1; then
    BT_TOOL="bluetuith"
  elif command -v blueman-manager >/dev/null 2>&1; then
    BT_TOOL="blueman-manager"
  elif command -v blueberry >/dev/null 2>&1; then
    BT_TOOL="blueberry"
  fi
fi

MAIN_ITEMS=$'01\t 系统更新\t__update_menu\t待更新包、系统更新、镜像源刷新\n02\t 系统清理\t__clean_menu\t系统清理、用户缓存预览/清理\n03\t 快照管理\t__snapshot_menu\t查看 root/home、创建、恢复、删除快照\n04\t 系统检查\t__check_menu\t硬件、存储、Scrub、更新后检查与日志\n05\t 迁移工具\t__migration_menu\t迁移包、异盘备份、定时任务与安全恢复\n06\t 联网工具\t__network_menu\t网络状态、NetworkManager、蓝牙工具\n00\t 退出\t__exit\t关闭维护菜单'

_pv_name() {
  # 内部动作名 → 友好中文标题，让 preview 顶部不再暴露 __xxx_menu 之类
  case "$1" in
    __update_menu) printf '系统更新' ;;
    __clean_menu) printf '系统清理' ;;
    __snapshot_menu) printf '快照管理' ;;
    __check_menu) printf '系统检查' ;;
    __migration_menu) printf '迁移工具' ;;
    __network_menu) printf '联网工具' ;;
    __back) printf '返回上一级' ;;
    __exit) printf '退出维护菜单' ;;
    clean) printf '普通清理' ;;
    clean-all) printf '深度清理' ;;
    cache-clean) printf '用户缓存预览' ;;
    cache-clean-safe) printf '用户缓存保守清理' ;;
    cache-clean-dev) printf '开发缓存清理' ;;
    cache-clean-chrome) printf 'Chrome 缓存清理' ;;
    view-snapshots) printf '查看快照' ;;
    quicksave) printf '创建快照' ;;
    quickload) printf '恢复快照' ;;
    delete-snapshot) printf '删除快照' ;;
    checkallupdates) printf '待更新包' ;;
    sysup) printf '系统升级' ;;
    mirror-update) printf '更新镜像源' ;;
    hw-doctor) printf '硬件检查' ;;
    gpu-check) printf 'GPU 检查' ;;
    check-battery) printf '电池检查' ;;
    boot-check) printf '引导检查' ;;
    recommend-check) printf '推荐补齐' ;;
    terminal-tools) printf '终端效率工具' ;;
    pacnew-check) printf 'pacnew 检查' ;;
    log-check) printf '日志报告' ;;
    post-update-check) printf '更新后检查' ;;
    storage-health) printf '存储健康' ;;
    btrfs-scrub) printf 'Btrfs Scrub' ;;
    migration-pack) printf '迁移工具' ;;
    migration-pack-plan) printf '预览迁移配置档' ;;
    migration-pack-pack) printf '生成迁移包' ;;
    migration-pack-check) printf '检查迁移包' ;;
    migration-pack-offsite) printf '异盘备份' ;;
    backup-restore) printf '恢复预览' ;;
    backup-restore-apply) printf '恢复 HOME' ;;
    offsite-backup-schedule) printf '定时异盘备份' ;;
    network-status) printf '网络状态' ;;
    nmtui) printf 'NetworkManager' ;;
    bluetui|bluetuith|blueman-manager|blueberry) printf '蓝牙工具' ;;
    '') printf '无' ;;
    *) printf '%s' "$1" ;;
  esac
}

print_preview() {
  local act="${1:-}"
  # fzf preview 用字符级换行，会把 root/home 断成 roo↳t；先自行词感知换行。
  # 宽度取 fzf 提供的 preview 列数，回退到 60（58% preview ≈ 该量级）。
  local pw="${FZF_PREVIEW_COLUMNS:-60}"
  _print_preview_body "$act" | ui_wrap "$pw"
}

