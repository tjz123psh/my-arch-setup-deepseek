#!/usr/bin/env bash
set -euo pipefail
export MAINTENANCE_NO_NOTIFY=1

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
TESTS_RUN=0
TMP_DIR="$(mktemp -d)"
trap 'rm -rf -- "$TMP_DIR"' EXIT

pass() {
  TESTS_RUN=$((TESTS_RUN + 1))
  printf 'ok %d - %s\n' "$TESTS_RUN" "$1"
}

fail() {
  printf 'not ok %d - %s\n' "$((TESTS_RUN + 1))" "$1" >&2
  exit 1
}

assert_contains() {
  local text="$1" expected="$2" label="$3"
  [[ "$text" == *"$expected"* ]] || fail "$label"
}

test_syntax() {
  local file
  while IFS= read -r file; do
    bash -n "$file"
  done < <(find "$ROOT" -maxdepth 2 -type f \( -perm -u+x -o -name '*.sh' \) ! -path '*/.git/*' | sort)
  pass 'all shell files pass bash -n'
}

test_config_parser() {
  local home="$TMP_DIR/config-home"
  local file="$home/.config/maintenance/config"
  local marker="$TMP_DIR/config-command-ran"
  mkdir -p "$(dirname "$file")"
  printf 'BACKUP_TARGET=~/backup disk\nBACKUP_KEEP=4\n' > "$file"
  local values
  values="$(HOME="$home" ROOT="$ROOT" BACKUP_KEEP_ENV=7 bash -c '
    source "$ROOT/lib/config.sh"
    maintenance_config_load
    MAINTENANCE_BACKUP_KEEP="$BACKUP_KEEP_ENV"
    printf "%s|%s" \
      "$(maintenance_config_get BACKUP_TARGET)" \
      "$(maintenance_config_get BACKUP_KEEP 3 MAINTENANCE_BACKUP_KEEP)"
  ')"
  [[ "$values" == "$home/backup disk|7" ]] \
    || fail 'config parser expands HOME and preserves environment precedence'

  # shellcheck disable=SC2016 # 字面命令替换用于验证配置值绝不会被执行。
  printf 'BACKUP_TARGET=$(touch %s)\n' "$marker" > "$file"
  HOME="$home" ROOT="$ROOT" bash -c '
    source "$ROOT/lib/config.sh"
    maintenance_config_load
    maintenance_config_get BACKUP_TARGET >/dev/null
  '
  [[ ! -e "$marker" ]] || fail 'config parser must never execute value contents'

  printf 'UNKNOWN_SETTING=1\n' > "$file"
  local invalid_rc=0
  HOME="$home" ROOT="$ROOT" bash -c '
    source "$ROOT/lib/config.sh"
    maintenance_config_load
  ' >/dev/null 2>&1 || invalid_rc=$?
  [[ "$invalid_rc" -ne 0 ]] || fail 'config parser must reject unknown keys'
  pass 'central config is strict, non-executable and keeps explicit overrides'
}

test_update_query_failure() {
  source "$ROOT/checkallupdates"
  CACHE_DIR="$TMP_DIR/update-cache"
  CACHE_REPO="$CACHE_DIR/repo"
  CACHE_AUR="$CACHE_DIR/aur"
  CACHE_FLATPAK="$CACHE_DIR/flatpak"
  CACHE_STATUS="$CACHE_DIR/status"
  CACHE_STAMP="$CACHE_DIR/stamp"
  mkdir -p "$CACHE_DIR"

  check_cmd() { [[ "$1" == 'checkupdates' || "$1" == 'fakeroot' || "$1" == 'flock' ]]; }
  checkupdates() { printf 'network unavailable\n' >&2; return 1; }
  aur_helper() { return 0; }

  if refresh_update_cache; then
    fail 'failed update query must return nonzero'
  fi
  local status output
  status="$(< "$CACHE_STATUS")"
  output="$(print_cached_updates_or_empty)"
  assert_contains "$status" $'pacman\terror\tnetwork unavailable' 'Pacman query failure is cached as an error'
  assert_contains "$output" '[查询失败]' 'query failure is visible in the update list'
  [[ "$output" != *"$NO_UPDATES_TEXT"* ]] || fail 'query failure must not become no-updates'
  [[ ! -e "$CACHE_STAMP" ]] || fail 'failed update query must leave cache stale for the next retry'
  pass 'update query errors cannot become an empty update list'
}

test_update_dependency_failure() {
  CACHE_DIR="$TMP_DIR/update-dependency-cache"
  CACHE_REPO="$CACHE_DIR/repo"
  CACHE_AUR="$CACHE_DIR/aur"
  CACHE_FLATPAK="$CACHE_DIR/flatpak"
  CACHE_STATUS="$CACHE_DIR/status"
  CACHE_STAMP="$CACHE_DIR/stamp"
  mkdir -p "$CACHE_DIR"

  check_cmd() { [[ "$1" == 'checkupdates' || "$1" == 'flock' ]]; }
  aur_helper() { return 0; }

  if refresh_update_cache; then
    fail 'missing fakeroot must make the Pacman update query fail'
  fi
  assert_contains "$(< "$CACHE_STATUS")" '缺少 fakeroot' \
    'missing checkupdates optional dependency must have an actionable error'
  pass 'update checker explains its missing fakeroot dependency'
}

test_flatpak_online_query() {
  CACHE_DIR="$TMP_DIR/flatpak-cache"
  CACHE_REPO="$CACHE_DIR/repo"
  CACHE_AUR="$CACHE_DIR/aur"
  CACHE_FLATPAK="$CACHE_DIR/flatpak"
  CACHE_STATUS="$CACHE_DIR/status"
  CACHE_STAMP="$CACHE_DIR/stamp"
  local args_file="$TMP_DIR/flatpak.args"
  mkdir -p "$CACHE_DIR"

  check_cmd() { [[ "$1" == 'checkupdates' || "$1" == 'fakeroot' || "$1" == 'flatpak' || "$1" == 'flock' ]]; }
  checkupdates() { return 2; }
  aur_helper() { return 0; }
  flatpak() { printf '%s\n' "$*" > "$args_file"; return 0; }
  unset CHECKALLUPDATES_FLATPAK_CACHED

  refresh_update_cache
  local args
  args="$(< "$args_file")"
  [[ "$args" == *'remote-ls --updates'* ]] || fail 'Flatpak update query must call remote-ls --updates'
  [[ "$args" != *'--cached'* ]] || fail 'Flatpak update query must be online by default'
  pass 'Flatpak updates are queried online by default'
}

test_update_escape_contract() {
  local child standalone parent
  child="$(ROOT="$ROOT" bash -c '
    source "$ROOT/checkallupdates"
    fzf() { return 130; }
    cache_is_fresh() { return 0; }
    if TERM_MENU_CHILD=1 CHECKALLUPDATES_ALLOW_NONINTERACTIVE_UI=1 main; then printf 0; else printf %s "$?"; fi
  ')"
  standalone="$(ROOT="$ROOT" bash -c '
    source "$ROOT/checkallupdates"
    fzf() { return 130; }
    cache_is_fresh() { return 0; }
    if CHECKALLUPDATES_ALLOW_NONINTERACTIVE_UI=1 main; then printf 0; else printf %s "$?"; fi
  ')"
  parent="$(ROOT="$ROOT" bash -c '
    source "$ROOT/term-menu"
    LEAF_RC=130
    PAUSES=0
    run_leaf() { return "$LEAF_RC"; }
    pause_for_menu() { PAUSES=$((PAUSES + 1)); }
    run_leaf_and_pause test gpu-check
    LEAF_RC=10
    run_leaf_and_pause test backup-restore
    printf "%s" "$PAUSES"
  ')"
  [[ "$child" == 130 && "$standalone" == 0 && "$parent" == 0 ]] \
    || fail 'Esc/return status must bypass the parent result pause'

  local no_tty_rc=0 no_tty_output
  no_tty_output="$(CHECKALLUPDATES_ALLOW_NONINTERACTIVE_UI=0 "$ROOT/checkallupdates" </dev/null 2>&1)" \
    || no_tty_rc=$?
  [[ "$no_tty_rc" -eq 2 ]] \
    || fail 'checkallupdates must reject an interactive fzf UI without a terminal'
  assert_contains "$no_tty_output" '需要交互终端' \
    'checkallupdates must explain the noninteractive interface contract'
  [[ "$no_tty_output" != *'inappropriate ioctl'* ]] \
    || fail 'checkallupdates must not leak fzf ioctl errors in noninteractive mode'
  pass 'all leaf-tool Esc/return statuses redraw the parent menu directly'
}

test_menu_navigation_contract() {
  local menu_items=$'01\t第一项\tone\tfirst\n02\t第二项\ttwo\tsecond\n00\t返回\t__back\tback'
  local positions menu_bin menu_args menu_output child_log main_log

  positions="$(ROOT="$ROOT" MENU_ITEMS="$menu_items" bash -c '
    source "$ROOT/term-menu"
    printf "%s|%s|%s" \
      "$(menu_start_position "$MENU_ITEMS" 02)" \
      "$(menu_start_position "$MENU_ITEMS" 00)" \
      "$(menu_start_position "$MENU_ITEMS" missing)"
  ')"
  [[ "$positions" == '2|3|1' ]] \
    || fail 'menu start position must resolve keys and fall back to the first item'

  menu_bin="$TMP_DIR/menu-navigation-bin"
  menu_args="$TMP_DIR/menu-navigation-fzf-args"
  mkdir -p "$menu_bin"
  cat > "$menu_bin/fzf" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$MENU_FZF_ARGS"
cat >/dev/null
printf '%s\n' "$MENU_FZF_RESULT"
STUB
  chmod +x "$menu_bin/fzf"
  menu_output="$(PATH="$menu_bin:$PATH" MENU_FZF_ARGS="$menu_args" \
    MENU_FZF_RESULT=$'02\t第二项\ttwo\tsecond' ROOT="$ROOT" MENU_ITEMS="$menu_items" bash -c '
      source "$ROOT/term-menu"
      choose_menu "测试菜单" "$MENU_ITEMS" 02
    ')"
  [[ "$menu_output" == $'02\t第二项\ttwo\tsecond' ]] \
    || fail 'choose_menu must preserve the fzf selection result'
  assert_contains "$(< "$menu_args")" '--cycle' \
    'choose_menu must enable cyclic arrow navigation'
  assert_contains "$(< "$menu_args")" 'load:pos(2)' \
    'choose_menu must wait for its input list before restoring the previous position'

  child_log="$TMP_DIR/menu-child-keys"
  CALL_LOG="$child_log" ROOT="$ROOT" bash -c '
    source "$ROOT/term-menu"
    clear_screen() { :; }
    run_leaf_and_pause() { :; }
    choose_menu() {
      printf "%s\n" "${3:-}" >> "$CALL_LOG"
      if [[ "$(wc -l < "$CALL_LOG")" == 1 ]]; then
        printf "%s\n" "$2" | head -n 2 | tail -n 1
      else
        return 1
      fi
    }
    show_update_menu
  '
  [[ "$(< "$child_log")" == $'01\n02' ]] \
    || fail 'a child menu must return to its last executed item'

  main_log="$TMP_DIR/menu-main-keys"
  CALL_LOG="$main_log" ROOT="$ROOT" bash -c '
    source "$ROOT/term-menu"
    clear_screen() { :; }
    show_check_menu() { return 0; }
    exit_menu() { exit 0; }
    choose_menu() {
      printf "%s\n" "${3:-}" >> "$CALL_LOG"
      if [[ "$(wc -l < "$CALL_LOG")" == 1 ]]; then
        printf "%s\n" "$2" | head -n 4 | tail -n 1
      else
        return 1
      fi
    }
    show_main_menu
  '
  [[ "$(< "$main_log")" == $'01\n04' ]] \
    || fail 'the main menu must return to the submenu that was last entered'

  grep -Fq -- '--cycle' "$ROOT/checkallupdates" \
    || fail 'update selection must enable cyclic arrow navigation'
  grep -Fq -- '--cycle' "$ROOT/migration-pack" \
    || fail 'migration selection must enable cyclic arrow navigation'
  grep -Fq -- '--cycle' "$ROOT/lib/ui.sh" \
    || fail 'shared fzf selections must enable cyclic arrow navigation'
  pass 'menus cycle with arrows and retain the last selected item after returning'
}

test_all_fzf_selectors_cycle() {
  # 这些选择器不经过 term-menu 的 choose_menu；过去只给主菜单加了
  # --cycle，导致 Scrub / 异盘备份等子选择器在首尾处不能循环。
  local script section
  local -a selectors=(
    'btrfs-scrub:select_target'
    'btrfs-scrub:choose_action'
    'backup-restore:choose_candidate'
    'offsite-backup-schedule:choose_action'
    'quickload:select_menu_choice'
    'migration-pack:choose_action'
    'term-menu:delete_snapshot'
  )

  for selector in "${selectors[@]}"; do
    script="${selector%%:*}"
    section="${selector#*:}"
    if ! awk -v name="$section" '
      $0 ~ "^" name "\\(\\) \\{" { inside=1; depth=0 }
      inside {
        opens=gsub(/\{/, "{"); closes=gsub(/\}/, "}"); depth += opens - closes
        if ($0 ~ /fzf/) saw_fzf=1
        if ($0 ~ /--cycle/) saw_cycle=1
        if (depth == 0 && NR > 1) exit
      }
      END { exit(saw_fzf && saw_cycle ? 0 : 1) }
    ' "$ROOT/$script"; then
      fail "$script:$section must enable cyclic arrow navigation in its own fzf selector"
    fi
  done
  grep -Fq -- '--cycle' "$ROOT/checkallupdates" \
    || fail 'checkallupdates must enable cyclic arrow navigation'
  pass 'all standalone fzf selectors enable cyclic arrow navigation'
}

test_all_child_menus_retain_last_item() {
  local menu_name child_log expected
  local -a menus=(
    show_update_menu
    show_clean_menu
    show_snapshot_menu
    show_check_menu
    show_migration_menu
    show_network_menu
  )

  for menu_name in "${menus[@]}"; do
    child_log="$TMP_DIR/${menu_name}-keys"
    CALL_LOG="$child_log" ROOT="$ROOT" bash -c '
      source "$ROOT/term-menu"
      clear_screen() { :; }
      run_leaf_and_pause() { :; }
      NET_TOOL="network-test"
      BT_TOOL="bluetooth-test"
      choose_menu() {
        printf "%s\n" "${3:-}" >> "$CALL_LOG"
        if [[ "$(wc -l < "$CALL_LOG")" == 1 ]]; then
          # 每个子菜单的第二项都不是“返回”；模拟用户执行一个非首项。
          printf "%s\n" "$2" | head -n 2 | tail -n 1
        else
          return 1
        fi
      }
      '"$menu_name"'
    '
    expected=$'01\n02'
    [[ "$(< "$child_log")" == "$expected" ]] \
      || fail "$menu_name must reopen on its last executed item, not the first item"
  done
  pass 'every term-menu child menu retains its last executed item'
}

test_long_operations_report_progress() {
  local file text
  declare -A progress_expected=(
    [lib/ui.sh]='ui_working()'
    [migration-pack]='正在校验迁移包的 SHA256SUMS'
    [backup-restore]='正在生成 HOME 文件变更预览'
    [offsite-backup]='正在归档 HOME 数据'
    [log-check]='正在读取本次启动的系统和用户日志'
    [storage-health]='正在读取 SMART/NVMe 健康数据'
    [btrfs-scrub]='正在读取 Btrfs scrub 历史'
    [checkallupdates]='正在查询 Pacman、AUR 和 Flatpak 更新'
  )

  for file in "${!progress_expected[@]}"; do
    text="$(< "$ROOT/$file")"
    assert_contains "$text" "${progress_expected[$file]}" \
      "$file must tell the user which potentially slow operation is running"
  done
  pass 'potentially slow interactive operations report their current phase'
}

test_rich_new_feature_previews() {
  local action output line_count
  local actions=(
    gpu-check boot-check pacnew-check post-update-check storage-health btrfs-scrub terminal-tools
    quicksave quickload __migration_menu migration-pack-plan migration-pack-pack migration-pack-check
    migration-pack-offsite backup-restore backup-restore-apply offsite-backup-schedule
  )
  local expected=(
    prime-run grub-install 人工合并 运行内核 介质/数据完整性错误 不能替代异盘备份 zoxide
    写时复制 btrfs-assistant '三种东西' 配置档 pacman-explicit SHA256 home.tar.zst
    home-changes maintenance-restore-rollback '旧 latest'
  )
  local i
  for ((i = 0; i < ${#actions[@]}; i++)); do
    action="${actions[$i]}"
    output="$(FZF_PREVIEW_COLUMNS=88 "$ROOT/term-menu" --preview "$action")"
    line_count="$(awk 'END {print NR}' <<< "$output")"
    ((line_count >= 16)) \
      || fail "$action preview must use the available panel for beginner-oriented details"
    assert_contains "$output" "${expected[$i]}" \
      "$action preview must explain its key concept"
  done
  pass 'new feature previews explain purpose, concepts, safety and result interpretation'
}

test_migration_failure_status() {
  source "$ROOT/migration-pack"
  local dir="$TMP_DIR/migration"
  mkdir -p "$dir"
  printf 'bash\n' > "$dir/pkglist-explicit.txt"
  : > "$dir/pkglist-foreign.txt"
  : > "$dir/system-enabled-units.txt"
  : > "$dir/user-enabled-units.txt"
  : > "$dir/tar-manifest.txt"
  printf 'broken archive\n' > "$dir/pang-arch-configs.tar.gz"
  printf '00  missing\n' > "$dir/SHA256SUMS"

  if run_check "$dir" >/dev/null 2>&1; then
    fail 'corrupt migration package must return nonzero'
  fi
  pass 'corrupt migration package returns nonzero'
}

test_migration_valid_status() {
  local dir="$TMP_DIR/migration-valid" output
  local payload="$TMP_DIR/migration-payload"
  mkdir -p "$dir" "$payload"
  printf 'fixture\n' > "$payload/example.txt"
  tar -czf "$dir/pang-arch-configs.tar.gz" -C "$payload" example.txt
  printf 'bash\n' > "$dir/pkglist-explicit.txt"
  : > "$dir/pkglist-foreign.txt"
  : > "$dir/system-enabled-units.txt"
  : > "$dir/user-enabled-units.txt"
  printf 'example.txt\n' > "$dir/tar-manifest.txt"
  (
    cd "$dir"
    sha256sum pang-arch-configs.tar.gz tar-manifest.txt pkglist-explicit.txt \
      pkglist-foreign.txt system-enabled-units.txt user-enabled-units.txt > SHA256SUMS
  )
  mkdir -p "$dir/secrets"

  output="$(run_check "$dir" 2>&1)" || fail 'valid migration package must return zero'
  assert_contains "$output" '来源系统未配置时属正常' \
    'absent optional secret files must be explained as normal'
  [[ "$output" != *'缺失] secrets/'* ]] \
    || fail 'absent optional secret files must not be rendered as failures'
  pass 'valid migration package returns zero'
}

test_migration_manifest_completeness() {
  local dir="$TMP_DIR/migration-incomplete"
  local payload="$TMP_DIR/migration-incomplete-payload"
  mkdir -p "$dir" "$payload"
  printf 'fixture\n' > "$payload/present.txt"
  tar -czf "$dir/pang-arch-configs.tar.gz" -C "$payload" present.txt
  printf 'bash\n' > "$dir/pkglist-explicit.txt"
  : > "$dir/pkglist-foreign.txt"
  : > "$dir/system-enabled-units.txt"
  : > "$dir/user-enabled-units.txt"
  printf 'missing.txt\n' > "$dir/tar-manifest.txt"
  (
    cd "$dir"
    sha256sum pang-arch-configs.tar.gz tar-manifest.txt pkglist-explicit.txt \
      pkglist-foreign.txt system-enabled-units.txt user-enabled-units.txt > SHA256SUMS
  )
  if run_check "$dir" >/dev/null 2>&1; then
    fail 'manifest entry missing from archive must fail validation'
  fi
  pass 'migration manifest is checked against archive contents'
}

test_migration_v2_profile_plan_and_snapshot_source() {
  local live_home="$TMP_DIR/migration-v2-live-home"
  local snapshot_home="$TMP_DIR/migration-v2-snapshot-home"
  local dest="$TMP_DIR/migration-v2-output"
  local default_dest="$TMP_DIR/migration-v2-default-output"
  local home_dest="$snapshot_home/migration"
  local profile="$TMP_DIR/migration-v2-profile.conf"
  local invalid_profile="$TMP_DIR/migration-v2-invalid-profile.conf"
  local whole_home_profile="$TMP_DIR/migration-v2-whole-home-profile.conf"
  local bin="$TMP_DIR/migration-v2-bin"
  local output rc=0

  mkdir -p "$live_home/scripts" "$snapshot_home/scripts" "$snapshot_home/Projects" \
    "$snapshot_home/obsidian" "$snapshot_home/Pictures/背景图片" \
    "$snapshot_home/Pictures/archlinux头像" "$snapshot_home/.ssh" \
    "$snapshot_home/.config/fish" "$snapshot_home/.config/opencode/node_modules" \
    "$snapshot_home/.config/systemd/user" "$snapshot_home/.local/bin" "$bin"
  printf 'live\n' > "$live_home/scripts/source.txt"
  printf 'frozen\n' > "$snapshot_home/scripts/source.txt"
  printf 'project\n' > "$snapshot_home/Projects/project.txt"
  printf 'vault\n' > "$snapshot_home/obsidian/note.md"
  printf 'wallpaper\n' > "$snapshot_home/Pictures/背景图片/fixture.png"
  printf 'avatar\n' > "$snapshot_home/Pictures/archlinux头像/fixture.png"
  printf 'private fixture\n' > "$snapshot_home/.ssh/id_fixture"
  printf 'rebuild me\n' > "$snapshot_home/.config/opencode/node_modules/rebuildable.txt"
  printf 'set -gx LEGACY_SECRET [redacted]\n' > "$snapshot_home/.config/fish/secrets.fish"
  printf '[Service]\nExecStart=/usr/bin/true\n' > "$snapshot_home/.config/systemd/user/fixture.service"
  ln -s ../scripts/source.txt "$snapshot_home/.local/bin/fixture-command"
  cat > "$profile" <<'PROFILE'
include scripts
include .config/fish
include .config/opencode
include .config/systemd/user
include .local/bin
secret .config/fish/secrets.fish
exclude **/node_modules/**
PROFILE
  printf 'include ../outside\n' > "$invalid_profile"
  printf 'include .\n' > "$whole_home_profile"

  cat > "$bin/pacman" <<'STUB'
#!/usr/bin/env bash
case " $* " in
  *' -Qqe '*) printf 'bash\n' ;;
  *' -Qqm '*) exit 0 ;;
  *) exit 0 ;;
esac
STUB
  cat > "$bin/systemctl" <<'STUB'
#!/usr/bin/env bash
printf 'fixture.service enabled\n'
STUB
  cat > "$bin/systemd-delta" <<'STUB'
#!/usr/bin/env bash
printf '[EXTENDED] fixture.service\n'
STUB
  chmod +x "$bin"/*

  output="$(HOME="$live_home" PATH="$bin:$PATH" "$ROOT/migration-pack" --plan \
    --profile "$profile" --home-root "$snapshot_home")" \
    || fail 'v2 migration plan must accept a valid profile and frozen HOME source'
  assert_contains "$output" 'scripts' 'v2 migration plan lists profile inclusions'
  assert_contains "$output" '.config/systemd/user' 'v2 migration plan includes user unit definitions'
  assert_contains "$output" 'secrets.fish' 'v2 migration plan reports secret references without their values'

  HOME="$live_home" PATH="$bin:$PATH" MAINTENANCE_LOCK_FILE="$TMP_DIR/migration-v2.lock" \
    "$ROOT/migration-pack" --pack "$dest" --profile "$profile" --home-root "$snapshot_home" \
    >/dev/null || fail 'v2 migration pack must publish a valid package from the frozen HOME source'
  [[ -s "$dest/format.json" && -s "$dest/payload/home-config.tar.zst" \
      && -s "$dest/packages/pacman-explicit.txt" && -s "$dest/services/user-enabled.txt" ]] \
    || fail 'v2 migration package must use its structured artifact layout'
  HOME="$live_home" PATH="$bin:$PATH" "$ROOT/migration-pack" --verify "$dest" >/dev/null \
    || fail 'v2 migration package must pass verification'
  [[ "$(tar --zstd -xOf "$dest/payload/home-config.tar.zst" scripts/source.txt)" == 'frozen' ]] \
    || fail 'v2 migration payload must use --home-root instead of the live HOME'
  tar --zstd -tf "$dest/payload/home-config.tar.zst" | grep -Fxq '.config/systemd/user/fixture.service' \
    || fail 'v2 migration payload must include custom user unit definitions'
  if tar --zstd -tf "$dest/payload/home-config.tar.zst" | grep -Fqx '.config/fish/secrets.fish'; then
    fail 'v2 migration payload must exclude declared secret files'
  fi
  if tar --zstd -tf "$dest/payload/home-config.tar.zst" | grep -Fq 'node_modules/rebuildable.txt'; then
    fail 'v2 migration payload must exclude rebuildable node_modules content'
  fi
  grep -Fq $'.config/fish/secrets.fish\tpresent' "$dest/secrets/references.tsv" \
    || fail 'v2 migration package must record secret references without copying their contents'

  HOME="$live_home" PATH="$bin:$PATH" MAINTENANCE_LOCK_FILE="$TMP_DIR/migration-v2-default.lock" \
    "$ROOT/migration-pack" --pack "$default_dest" --home-root "$snapshot_home" >/dev/null \
    || fail 'default v2 migration profile must package the complete requested user content'
  tar --zstd -tf "$default_dest/payload/home-config.tar.zst" | grep -Fqx '.config/fish/secrets.fish' \
    || fail 'default v2 profile must retain complete ~/.config content'
  tar --zstd -tf "$default_dest/payload/home-config.tar.zst" | grep -Fqx '.config/opencode/node_modules/rebuildable.txt' \
    || fail 'default v2 profile must not silently omit configuration dependencies'
  tar --zstd -tf "$default_dest/payload/home-config.tar.zst" | grep -Fqx '.ssh/id_fixture' \
    || fail 'default v2 profile must include the approved SSH material'
  tar --zstd -tf "$default_dest/payload/home-config.tar.zst" | grep -Fqx 'Projects/project.txt' \
    || fail 'default v2 profile must include Projects'
  tar --zstd -tf "$default_dest/payload/home-config.tar.zst" | grep -Fqx 'Pictures/背景图片/fixture.png' \
    || fail 'default v2 profile must include requested background images'
  [[ ! -s "$default_dest/secrets/references.tsv" ]] \
    || fail 'default v2 profile must not demote approved content to secret references'

  HOME="$live_home" PATH="$bin:$PATH" MAINTENANCE_LOCK_FILE="$TMP_DIR/migration-v2-home-output.lock" \
    "$ROOT/migration-pack" --pack "$home_dest" --home-root "$snapshot_home" >/dev/null \
    || fail 'default migration output ~/migration must be allowed when no include path contains it'
  [[ -s "$home_dest/payload/home-config.tar.zst" ]] \
    || fail 'migration output under HOME must publish normally after validation'
  rc=0
  HOME="$live_home" PATH="$bin:$PATH" "$ROOT/migration-pack" --pack "$snapshot_home/not-allowed" \
    --profile "$whole_home_profile" --home-root "$snapshot_home" >/dev/null 2>&1 || rc=$?
  [[ "$rc" -ne 0 ]] \
    || fail 'migration output inside an explicitly included HOME root must be rejected'

  local restore_plan="$TMP_DIR/migration-v2-restore-plan"
  HOME="$live_home" PATH="$bin:$PATH" "$ROOT/backup-restore" \
    --source "$dest" --output "$restore_plan" >/dev/null \
    || fail 'backup restore must generate a plan for a standalone v2 migration package'
  [[ -s "$restore_plan/home-changes.txt" && -f "$restore_plan/packages-official.txt" \
      && -f "$restore_plan/services-user.txt" ]] \
    || fail 'v2 migration restore plan must retain package, service and HOME planning'

  HOME="$live_home" PATH="$bin:$PATH" "$ROOT/migration-pack" --plan \
    --profile "$invalid_profile" --home-root "$snapshot_home" >/dev/null 2>&1 || rc=$?
  [[ "$rc" -ne 0 ]] || fail 'v2 migration profile must reject traversal paths'
  pass 'migration v2 profile plans a frozen HOME source and excludes declared secrets'
}

test_migration_payload_terminal_sudo_fallback() {
  local home="$TMP_DIR/migration-permission-home"
  local dest="$TMP_DIR/migration-permission-output"
  local profile="$TMP_DIR/migration-permission-profile.conf"
  local bin="$TMP_DIR/migration-permission-bin"
  local log="$TMP_DIR/migration-permission-sudo.log"
  local output status=0

  mkdir -p "$home/Projects" "$bin"
  printf 'must be archived\n' > "$home/Projects/locked.txt"
  printf 'include Projects\n' > "$profile"
  cat > "$bin/tar" <<'STUB'
#!/usr/bin/env bash
if [[ "${MIGRATION_TEST_PRIVILEGED:-0}" != 1 && " $* " == *' -cf '* ]]; then
  printf 'tar: Projects/locked.txt: Cannot open: Permission denied\n' >&2
  exit 2
fi
exec /usr/bin/tar "$@"
STUB
  cat > "$bin/pacman" <<'STUB'
#!/usr/bin/env bash
case " $* " in
  *' -Qqe '*) printf 'bash\n' ;;
  *' -Qqm '*) exit 1 ;;
esac
STUB
  cat > "$bin/systemctl" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
  cat > "$bin/systemd-delta" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
  cat > "$bin/flatpak" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
  cat > "$bin/sudo" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$MIGRATION_SUDO_LOG"
MIGRATION_TEST_PRIVILEGED=1 "$@"
STUB
  chmod +x "$bin"/*

  output="$(HOME="$home" PATH="$bin:$PATH" \
    MIGRATION_SUDO_LOG="$log" MAINTENANCE_LOCK_FILE="$TMP_DIR/migration-permission.lock" \
    "$ROOT/migration-pack" --pack "$dest" --profile "$profile" 2>&1)" || status=$?
  [[ "$status" -eq 0 ]] \
    || fail 'migration pack must retry a permission-denied payload read through terminal sudo'
  [[ "$(< "$log")" == "env LC_ALL=C tar --zstd -cf "*"/payload/home-config.tar.zst -C $home -- Projects" ]] \
    || fail 'migration pack must elevate only the tar read through terminal sudo'
  tar --zstd -tf "$dest/payload/home-config.tar.zst" | grep -Fqx 'Projects/locked.txt' \
    || fail 'privileged payload retry must preserve the formerly unreadable file'
  assert_contains "$output" '读取权限不足' \
    'migration pack must explain the scoped terminal sudo retry'
  pass 'migration package retries protected payload reads through scoped terminal sudo'
}

test_log_query_failure() {
  source "$ROOT/log-check"
  systemctl() { printf 'dbus unavailable\n' >&2; return 5; }
  journalctl() { printf 'journal denied\n' >&2; return 4; }
  local report="$TMP_DIR/log-report.md"

  generate_report > "$report"
  local content
  content="$(< "$report")"
  assert_contains "$content" 'ERROR:' 'failed log query is marked as ERROR'
  assert_contains "$content" 'dbus unavailable' 'systemctl error is retained'
  assert_contains "$content" 'journal denied' 'journalctl error is retained'
  [[ "$REPORT_QUERY_FAILED" -eq 1 ]] || fail 'log report failure flag must be set'
  pass 'log query failures cannot become healthy results'
}

test_maintenance_lock() {
  source "$ROOT/lib/ui.sh"
  local lock_file="$TMP_DIR/maintenance.lock"
  export MAINTENANCE_LOCK_FILE="$lock_file"
  ui_maintenance_lock_acquire first

  local rc=0
  ROOT="$ROOT" MAINTENANCE_LOCK_FILE="$lock_file" bash -c '
    source "$ROOT/lib/ui.sh"
    unset MAINTENANCE_LOCK_HELD UI_MAINTENANCE_LOCK_FD
    ui_maintenance_lock_acquire second
  ' >/dev/null 2>&1 || rc=$?
  ui_maintenance_lock_release
  [[ "$rc" -eq 75 ]] || fail 'second maintenance operation must be rejected with 75'
  pass 'maintenance lock rejects concurrent mutation'
}

test_maintenance_lock_inheritance() {
  source "$ROOT/lib/ui.sh"
  local lock_file="$TMP_DIR/inherited-maintenance.lock"
  export MAINTENANCE_LOCK_FILE="$lock_file"
  ui_maintenance_lock_acquire parent

  ROOT="$ROOT" bash -c '
    source "$ROOT/lib/ui.sh"
    ui_maintenance_lock_acquire child
  ' >/dev/null 2>&1 || fail 'child maintenance script must inherit the parent lock'
  ui_maintenance_lock_release
  pass 'controlled child inherits maintenance lock'
}

test_maintenance_lock_spoof_rejected() {
  source "$ROOT/lib/ui.sh"
  local lock_file="$TMP_DIR/spoof-maintenance.lock"
  local rc=0
  export MAINTENANCE_LOCK_FILE="$lock_file"
  ui_maintenance_lock_acquire owner
  ROOT="$ROOT" MAINTENANCE_LOCK_FILE="$lock_file" bash -c '
    source "$ROOT/lib/ui.sh"
    export MAINTENANCE_LOCK_HELD=1 UI_MAINTENANCE_LOCK_FD=1
    ui_maintenance_lock_acquire spoof
  ' >/dev/null 2>&1 || rc=$?
  ui_maintenance_lock_release
  [[ "$rc" -eq 75 ]] || fail 'spoofed inherited lock descriptor must not bypass contention'
  pass 'spoofed maintenance lock descriptor is rejected'
}

test_quicksave_batch_transaction() {
  local bin="$TMP_DIR/quicksave-bin"
  local home="$TMP_DIR/quicksave-home"
  local log="$TMP_DIR/quicksave.log"
  mkdir -p "$bin" "$home"
  cat > "$bin/snapper" <<'STUB'
#!/usr/bin/env bash
conf=''
prev=''
for arg in "$@"; do
  [[ "$prev" == '-c' ]] && conf="$arg"
  prev="$arg"
done
case " $* " in
  *' list-configs '*) printf 'config\037subvolume\nroot\037/\nhome\037/home\n' ;;
  *' get-config '*)
    [[ "${SNAP_GET_CONFIG_FAIL:-0}" == '1' ]] \
      && { printf 'snapper daemon unavailable\n' >&2; exit 5; }
    exit 0
    ;;
  *' create '*)
    printf 'create %s %s\n' "$conf" "$*" >> "$SNAP_TEST_LOG"
    if [[ "${SNAP_FAIL_HOME:-0}" == '1' && "$conf" == 'home' ]]; then exit 1; fi
    [[ "$conf" == 'root' ]] && printf '101\n' || printf '202\n'
    ;;
  *' delete '*) printf 'delete %s %s\n' "$conf" "${*: -1}" >> "$SNAP_TEST_LOG" ;;
  *' cleanup '*) exit 0 ;;
esac
STUB
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$bin/btrfs"
  cat > "$bin/pkexec" <<'STUB'
#!/usr/bin/env bash
printf 'pkexec %s\n' "$*" >> "$SNAP_TEST_LOG"
exit 0
STUB
  chmod +x "$bin/snapper" "$bin/btrfs" "$bin/pkexec"

  SNAP_TEST_LOG="$log" HOME="$home" PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/quicksave.lock" "$ROOT/quicksave" >/dev/null
  local batch_count
  batch_count="$(sed -n 's/.*maintenance_batch=\([^ ]*\).*/\1/p' "$log" | sort -u | wc -l)"
  [[ "$batch_count" -eq 1 ]] || fail 'root and home snapshots must share one batch ID'

  : > "$log"
  if SNAP_TEST_LOG="$log" SNAP_FAIL_HOME=1 HOME="$home" PATH="$bin:$PATH" \
      MAINTENANCE_LOCK_FILE="$TMP_DIR/quicksave-fail.lock" "$ROOT/quicksave" >/dev/null 2>&1; then
    fail 'partial quicksave batch must fail'
  fi
  assert_contains "$(< "$log")" 'delete root 101' 'partial quicksave batch rolls back created root snapshot'
  : > "$log"
  local config_failure_rc=0 config_failure_output
  config_failure_output="$(SNAP_TEST_LOG="$log" SNAP_GET_CONFIG_FAIL=1 HOME="$home" \
    PATH="$bin:$PATH" MAINTENANCE_LOCK_FILE="$TMP_DIR/quicksave-config-fail.lock" \
    "$ROOT/quicksave" 2>&1)" || config_failure_rc=$?
  [[ "$config_failure_rc" -ne 0 ]] \
    || fail 'quicksave must fail when get-config fails for a non-permission reason'
  assert_contains "$config_failure_output" '错误并非权限不足' \
    'quicksave must distinguish Snapper failure from missing permission'
  [[ "$(< "$log")" != *'pkexec '* ]] \
    || fail 'quicksave must not offer or apply wheel access for unrelated Snapper failures'
  pass 'quicksave batches are paired and partial creation rolls back'
}

test_quicksave_delete_query_failure() {
  local bin="$TMP_DIR/quicksave-delete-bin"
  local log="$TMP_DIR/quicksave-delete.log"
  mkdir -p "$bin"
  cat > "$bin/snapper" <<'STUB'
#!/usr/bin/env bash
case " $* " in
  *' list-configs '*) printf 'config\037subvolume\nroot\037/\n' ;;
  *' get-config '*) exit 0 ;;
  *' list --columns number '*) exit 5 ;;
  *' -c root list '*) exit 6 ;;
  *' delete '*) printf 'delete\n' >> "$DELETE_TEST_LOG" ;;
esac
STUB
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$bin/btrfs"
  chmod +x "$bin"/*

  local status=0
  DELETE_TEST_LOG="$log" PATH="$bin:$PATH" MAINTENANCE_LOCK_FILE="$TMP_DIR/quicksave-delete.lock" \
    "$ROOT/quicksave" -c root --delete all --yes >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'quicksave delete-all must fail when snapshot listing fails'
  [[ ! -s "$log" ]] || fail 'quicksave delete-all must not delete after a failed listing'
  status=0
  PATH="$bin:$PATH" "$ROOT/quicksave" -c root --list >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'quicksave list must fail when snapshot listing fails'
  pass 'quicksave delete-all stops safely when snapshot listing fails'
}

test_quickload_resolution_and_failure() {
  local bin="$TMP_DIR/quickload-bin"
  local log="$TMP_DIR/quickload.log"
  mkdir -p "$bin"
  cat > "$bin/snapper" <<'STUB'
#!/usr/bin/env bash
conf=''
prev=''
for arg in "$@"; do
  [[ "$prev" == '-c' ]] && conf="$arg"
  prev="$arg"
done
if [[ " $* " == *' list-configs '* ]]; then
  printf 'config\037subvolume\nhome\037/home\nroot\037/\n'
elif [[ " $* " == *' list --columns number,date,description,userdata '* ]]; then
  printf 'number\037date\037description\037userdata\n'
  if [[ "$conf" == 'home' ]]; then
    printf '202\0372026-07-26 03:57:14\037quicksave\037maintenance_batch=batch1\n'
  else
    printf '101\0372026-07-26 03:57:15\037quicksave\037maintenance_batch=batch1\n'
  fi
fi
STUB
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *' FSTYPE '* ]]; then
  printf 'btrfs\n'
elif [[ "${*: -1}" == '/home' ]]; then
  printf '/dev/test[/@home]\n'
else
  printf '/dev/test[/@]\n'
fi
STUB
  cat > "$bin/btrfs-assistant" <<'STUB'
#!/usr/bin/env bash
if [[ "${1:-}" == '-l' ]]; then
  [[ "${BA_PREFLIGHT_FAIL:-0}" == '1' ]] && { printf 'backend crashed\n' >&2; exit 139; }
  [[ "${BA_PREFLIGHT_EMPTY:-0}" == '1' ]] && { printf 'no restore entries\n'; exit 0; }
  printf '1 @ 101\n2 @home 202\n'
elif [[ "${1:-}" == '-r' ]]; then
  printf 'restore %s\n' "$2" >> "$QUICKLOAD_TEST_LOG"
  [[ "${BA_FAIL_ID:-}" == "$2" ]] && exit 1
  exit 0
fi
STUB
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$bin/btrfs"
  cat > "$bin/reboot" <<'STUB'
#!/usr/bin/env bash
printf 'reboot\n' >> "$QUICKLOAD_TEST_LOG"
STUB
  chmod +x "$bin"/*

  QUICKLOAD_TEST_MODE=1 QUICKLOAD_TEST_LOG="$log" PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/quickload-batch.lock" \
    "$ROOT/quickload" -n -c all -d quicksave --snapshot-batch batch1 >/dev/null
  [[ "$(< "$log")" == $'restore 2\nrestore 1\nreboot' ]] || fail 'batch restore must run home then root and reboot after success'

  : > "$log"
  QUICKLOAD_TEST_MODE=1 QUICKLOAD_TEST_LOG="$log" PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/quickload-legacy.lock" \
    "$ROOT/quickload" -n -c all -d quicksave --snapshot-date '2026-07-26 03:57:15' >/dev/null
  [[ "$(< "$log")" == $'restore 2\nrestore 1\nreboot' ]] || fail 'legacy snapshots within tolerance must restore as one set'

  : > "$log"
  local output status=0
  output="$(QUICKLOAD_TEST_MODE=1 QUICKLOAD_TEST_LOG="$log" BA_FAIL_ID=1 PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/quickload-fail.lock" \
    "$ROOT/quickload" -n -c all -d quicksave --snapshot-batch batch1 2>&1)" || status=$?
  [[ "$status" -ne 0 ]] || fail 'quickload must fail when one restore operation fails'
  [[ "$(< "$log")" != *'reboot'* ]] || fail 'quickload must not reboot after partial restore failure'
  assert_contains "$output" '已完成的恢复 ID：2' 'quickload reports partial completion explicitly'

  : > "$log"
  status=0
  output="$(QUICKLOAD_TEST_MODE=1 QUICKLOAD_TEST_LOG="$log" BA_PREFLIGHT_FAIL=1 PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/quickload-preflight.lock" \
    "$ROOT/quickload" -n -c root -d quicksave 2>&1)" || status=$?
  [[ "$status" -ne 0 && ! -s "$log" ]] \
    || fail 'quickload must stop before restore when the backend preflight crashes'
  assert_contains "$output" '恢复后端不可用' \
    'quickload reports backend failure before snapshot restoration'

  status=0
  output="$(QUICKLOAD_TEST_MODE=1 QUICKLOAD_TEST_LOG="$log" BA_PREFLIGHT_EMPTY=1 PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/quickload-empty-preflight.lock" \
    "$ROOT/quickload" -n -c root -d quicksave 2>&1)" || status=$?
  [[ "$status" -ne 0 && ! -s "$log" ]] \
    || fail 'quickload must reject a successful but unusable backend listing'
  assert_contains "$output" '没有返回可解析的恢复条目' \
    'quickload identifies unusable backend output before selection'

  : > "$log"
  cat > "$bin/btrfs-assistant" <<'STUB'
#!/usr/bin/env bash
if [[ "${1:-}" == '-l' ]]; then
  printf '1 @ 101\n3 @ 101\n2 @home 202\n'
else
  printf 'restore %s\n' "$2" >> "$QUICKLOAD_TEST_LOG"
fi
STUB
  chmod +x "$bin/btrfs-assistant"
  status=0
  QUICKLOAD_TEST_MODE=1 QUICKLOAD_TEST_LOG="$log" PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/quickload-duplicate.lock" \
    "$ROOT/quickload" -n -c root -d quicksave --snapshot-batch batch1 >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 && ! -s "$log" ]] \
    || fail 'quickload must reject ambiguous btrfs-assistant restore IDs'
  pass 'quickload resolves batch/legacy sets and blocks reboot after partial failure'
}

test_native_root_fallback_rolls_back_publish_failure() {
  local bin="$TMP_DIR/native-quickload-bin"
  local top="$TMP_DIR/native-quickload-top"
  local log="$TMP_DIR/native-quickload.log"
  local output status=0
  mkdir -p "$bin" "$top/@/.snapshots/101/snapshot/etc"
  printf 'original-root\n' > "$top/@/root-marker"
  printf 'snapshot-root\n' > "$top/@/.snapshots/101/snapshot/root-marker"
  printf 'UUID=test / btrfs subvol=@ 0 0\n' > "$top/@/.snapshots/101/snapshot/etc/fstab"

  cat > "$bin/snapper" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *' list-configs '* ]]; then
  printf 'config\037subvolume\nroot\037/\n'
elif [[ " $* " == *' list --columns number,date,description,userdata '* ]]; then
  if [[ "${QUICKLOAD_SNAP_LIST_FAIL:-0}" == 1 ]]; then
    printf '%s\n' 'simulated Snapper list failure' >&2
    exit 47
  fi
  printf 'number\037date\037description\037userdata\n'
  printf '101\0372026-07-28 20:00:00\037quicksave\037maintenance_batch=native1\n'
fi
STUB
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *' FSTYPE '* ]]; then
  printf 'btrfs\n'
elif [[ " $* " == *' OPTIONS '* ]]; then
  if [[ "${QUICKLOAD_NATIVE_MISSING_SUBVOL:-0}" == 1 ]]; then
    printf 'rw,relatime,subvolid=256\n'
  else
    printf 'rw,relatime,subvol=/@\n'
  fi
else
  printf '/dev/test[/@]\n'
fi
STUB
  # 原生后端必须可在 btrfs-assistant 不存在时继续；这是它存在的原因。
  cat > "$bin/mktemp" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$QUICKLOAD_NATIVE_TEST_TOP"
STUB
  cat > "$bin/mount" <<'STUB'
#!/usr/bin/env bash
: > "$QUICKLOAD_TEST_LOG.mounted"
exit 0
STUB
  cat > "$bin/umount" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
  cat > "$bin/btrfs" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
  subvolume)
    case "${2:-}" in
      snapshot) cp -a -- "$3" "$4" ;;
      create) mkdir -p -- "${3:-}" ;;
      show) [[ -d "${3:-}" ]] ;;
      delete) rm -rf -- "${3:-}" ;;
      *) exit 2 ;;
    esac
    ;;
  *) exit 2 ;;
esac
STUB
  # 故障注入：发布恢复副本为 @ 时失败；旧 @ 的回滚 rename 必须仍然成功。
  cat > "$bin/mv" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
source="${@: -2:1}"
target="${@: -1}"
if [[ "$(basename -- "$source")" == @quickload-restore-* && "$(basename -- "$target")" == '@' \
    && "${QUICKLOAD_NATIVE_ALLOW_PUBLISH:-0}" != 1 ]]; then
  : > "$QUICKLOAD_TEST_LOG.publish-failed"
  exit 73
fi
exec /usr/bin/mv "$@"
STUB
  cat > "$bin/reboot" <<'STUB'
#!/usr/bin/env bash
: > "$QUICKLOAD_TEST_LOG.rebooted"
STUB
  chmod +x "$bin"/*

  output="$(QUICKLOAD_TEST_MODE=1 QUICKLOAD_NATIVE_TEST_TOP="$top" QUICKLOAD_TEST_LOG="$log" \
    PATH="$bin:$PATH" MAINTENANCE_LOCK_FILE="$TMP_DIR/native-quickload.lock" \
    "$ROOT/quickload" -n -c root -d quicksave --native-root-fallback 2>&1)" || status=$?
  [[ "$status" -ne 0 ]] || fail 'native root fallback must fail when publishing the new root fails'
  [[ -e "$log.publish-failed" ]] || fail 'native root fallback fixture must inject the publish failure'
  [[ ! -e "$log.rebooted" ]] || fail 'native root fallback must never reboot after a publish failure'
  [[ "$(< "$top/@/root-marker")" == 'original-root' ]] \
    || fail 'native root fallback must restore the old @ name after a publish failure'
  if compgen -G "$top/@quickload-pre-*" >/dev/null; then
    fail 'native root fallback must not leave the old root under the temporary pre-restore name'
  fi
  assert_contains "$output" '已尝试恢复原 root' \
    'native root fallback reports its immediate rollback after publish failure'

  # 下次启动目标只能由已验证的 subvol= 挂载选择来推断；缺少它时必须在
  # 挂载顶级子卷或修改任何子卷之前停止，不能只凭 subvolid 冒险交换名称。
  rm -f "$log.mounted"
  status=0
  output="$(QUICKLOAD_TEST_MODE=1 QUICKLOAD_NATIVE_TEST_TOP="$top" QUICKLOAD_TEST_LOG="$log" \
    QUICKLOAD_NATIVE_MISSING_SUBVOL=1 PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/native-quickload-layout.lock" \
    "$ROOT/quickload" -n -c root -d quicksave --native-root-fallback 2>&1)" || status=$?
  [[ "$status" -ne 0 ]] || fail 'native root fallback must reject an unverified root boot selection'
  [[ ! -e "$log.mounted" ]] || fail 'native root fallback must not mount or mutate after layout rejection'
  assert_contains "$output" '可验证的 subvol=' \
    'native root fallback explains why an unverified boot layout is rejected'

  # 成功发布后，reboot 桩正常返回时 CLI 也必须返回 0；此前无条件 exit 1
  # 会把已经安全发布且已经请求重启的恢复误报成失败。
  rm -f "$log.rebooted"
  status=0
  output="$(QUICKLOAD_TEST_MODE=1 QUICKLOAD_NATIVE_TEST_TOP="$top" QUICKLOAD_TEST_LOG="$log" \
    QUICKLOAD_NATIVE_ALLOW_PUBLISH=1 PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/native-quickload-success.lock" \
    "$ROOT/quickload" -n -c root -d quicksave --native-root-fallback 2>&1)" || status=$?
  [[ "$status" -eq 0 ]] || fail 'native root fallback must return success after a successful publish/reboot request'
  [[ -e "$log.rebooted" ]] || fail 'native root fallback must request reboot after successful publish'
  [[ "$(< "$top/@/root-marker")" == 'snapshot-root' ]] \
    || fail 'native root fallback must publish the snapshot clone as @'
  [[ -d "$top/@/.snapshots" ]] \
    || fail 'native root fallback must recreate the restored root Snapper storage'
  compgen -G "$top/@quickload-pre-*" >/dev/null \
    || fail 'native root fallback must preserve the old root after successful publish'

  # 回退不能依赖恢复后仍可工作的 Snapper 配置：原生 clone 可能使其 .snapshots
  # 布局暂不可用。直接移除 snapper 命令后仍须能只交换已验证的顶级子卷。
  mv "$bin/snapper" "$bin/snapper.unavailable"
  rm -f "$log.rebooted"
  status=0
  output="$(QUICKLOAD_TEST_MODE=1 QUICKLOAD_NATIVE_TEST_TOP="$top" QUICKLOAD_TEST_LOG="$log" \
    PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/native-quickload-rollback.lock" \
    "$ROOT/quickload" -n -c root --native-root-rollback latest 2>&1)" || status=$?
  [[ "$status" -eq 0 ]] || fail 'native root rollback must work even when Snapper is unavailable'
  [[ -e "$log.rebooted" ]] || fail 'native root rollback must request reboot after publishing the prior root'
  [[ "$(< "$top/@/root-marker")" == 'original-root' ]] \
    || fail 'native root rollback must restore the preserved old root as @'
  compgen -G "$top/@quickload-rejected-*" >/dev/null \
    || fail 'native root rollback must preserve the rejected restored root'
  assert_contains "$output" '原生 root 回退已准备完成' \
    'native root rollback reports that the boot-time swap was prepared'
  pass 'native root fallback validates layout, rolls back failure and supports Snapper-independent rollback'
}

test_quickload_snapshot_query_failure() {
  local bin="$TMP_DIR/quickload-query-bin"
  local log="$TMP_DIR/quickload-query.log"
  mkdir -p "$bin"
  cat > "$bin/snapper" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *' list-configs '* ]]; then
  printf 'config\037subvolume\nroot\037/\n'
elif [[ " $* " == *' list --columns number,date,description,userdata '* ]]; then
  exit 6
fi
STUB
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
[[ " $* " == *' FSTYPE '* ]] && printf 'btrfs\n' || printf '/dev/test[/@]\n'
STUB
  cat > "$bin/btrfs-assistant" <<'STUB'
#!/usr/bin/env bash
if [[ "${1:-}" == '-l' ]]; then
  printf '1 @ 101\n'
else
  printf '%s\n' "$*" >> "$QUICKLOAD_QUERY_LOG"
fi
STUB
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$bin/btrfs"
  cat > "$bin/reboot" <<'STUB'
#!/usr/bin/env bash
printf reboot >> "$QUICKLOAD_QUERY_LOG"
STUB
  chmod +x "$bin"/*

  local status=0
  QUICKLOAD_TEST_MODE=1 QUICKLOAD_QUERY_LOG="$log" PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/quickload-query.lock" \
    "$ROOT/quickload" -n -c root -d quicksave >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'quickload must fail when Snapper listing fails'
  [[ ! -s "$log" ]] || fail 'quickload must not restore or reboot after a failed Snapper listing'
  pass 'quickload stops before restore when Snapper listing fails'
}

test_strict_check_status() {
  source "$ROOT/lib/ui.sh"
  ui_tally_reset
  UI_N_WARN=1
  if ui_tally_status 1; then fail 'strict check must fail on warnings'; fi
  ui_tally_status 0 || fail 'interactive check status must stay successful'
  pass 'check scripts expose strict automation status'
}

test_diagnostic_query_failures() {
  local recommend_bin="$TMP_DIR/recommend-query-bin"
  local recommend_hw_bin="$TMP_DIR/recommend-hw-query-bin"
  local pacnew_bin="$TMP_DIR/pacnew-query-bin"
  local boot_bin="$TMP_DIR/boot-query-bin"
  local hw_bin="$TMP_DIR/hw-query-bin"
  mkdir -p "$recommend_bin" "$recommend_hw_bin" "$pacnew_bin" "$boot_bin" "$hw_bin"
  printf '%s\n' '#!/usr/bin/env bash' 'printf "database unavailable\n" >&2' 'exit 5' > "$recommend_bin/pacman"
  cat > "$recommend_hw_bin/pacman" <<'STUB'
#!/usr/bin/env bash
printf 'bash\n'
STUB
  cat > "$recommend_hw_bin/lscpu" <<'STUB'
#!/usr/bin/env bash
printf 'Vendor ID: AuthenticAMD\n'
STUB
  cat > "$recommend_hw_bin/lspci" <<'STUB'
#!/usr/bin/env bash
printf 'PCI query failed\n' >&2
exit 6
STUB
  cat > "$recommend_hw_bin/systemd-detect-virt" <<'STUB'
#!/usr/bin/env bash
printf 'none\n'
exit 1
STUB
  cat > "$pacnew_bin/pacdiff" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
  cat > "$pacnew_bin/find" <<'STUB'
#!/usr/bin/env bash
[[ "${PACNEW_PARTIAL_FIND:-0}" == '1' ]] && printf '/etc/fixture.pacnew\n'
exit 6
STUB
  chmod +x "$recommend_bin/pacman" "$recommend_hw_bin"/* "$pacnew_bin"/*

  cat > "$boot_bin/pacman" <<'STUB'
#!/usr/bin/env bash
printf 'package database unavailable\n' >&2
exit 5
STUB
  cat > "$boot_bin/systemctl" <<'STUB'
#!/usr/bin/env bash
printf 'localized systemctl failure\n' >&2
exit 5
STUB
  chmod +x "$boot_bin"/*

  cat > "$hw_bin/pacman" <<'STUB'
#!/usr/bin/env bash
printf 'amd-ucode\nmesa\nmesa-utils\nvulkan-tools\nsof-firmware\n'
STUB
  cat > "$hw_bin/lscpu" <<'STUB'
#!/usr/bin/env bash
printf 'Vendor ID: AuthenticAMD\nModel name: Fixture CPU\nCPU(s): 16\n'
STUB
  cat > "$hw_bin/lspci" <<'STUB'
#!/usr/bin/env bash
printf 'PCI configuration space unavailable\n' >&2
exit 5
STUB
  cat > "$hw_bin/lsmod" <<'STUB'
#!/usr/bin/env bash
printf 'Module Size Used by\namdgpu 100 1\n'
STUB
  cat > "$hw_bin/systemctl" <<'STUB'
#!/usr/bin/env bash
printf 'inactive\n'
exit 3
STUB
  cat > "$hw_bin/pgrep" <<'STUB'
#!/usr/bin/env bash
exit "${DMS_PROCESS_RUNNING:-1}"
STUB
  cat > "$hw_bin/timedatectl" <<'STUB'
#!/usr/bin/env bash
[[ " $* " == *' Timezone '* ]] && printf 'Asia/Shanghai\n' || printf 'yes\n'
STUB
  cat > "$hw_bin/lsblk" <<'STUB'
#!/usr/bin/env bash
printf 'NAME FSTYPE SIZE MOUNTPOINTS\nfixture btrfs 1T /\n'
STUB
  cat > "$hw_bin/findmnt" <<'STUB'
#!/usr/bin/env bash
printf '/ /dev/fixture btrfs 1T 10%%\n'
STUB
  cat > "$hw_bin/snapper" <<'STUB'
#!/usr/bin/env bash
printf 'Config | Subvolume\nroot | /\n'
STUB
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$hw_bin/nmcli"
  printf '%s\n' '#!/usr/bin/env bash' 'printf "PipeWire fixture\n"' > "$hw_bin/wpctl"
  chmod +x "$hw_bin"/*

  local recommend_status=0 recommend_hw_status=0 recommend_hw_output
  local pacnew_status=0 pacnew_partial_status=0
  local boot_status=0 boot_output hw_status=0 hw_output
  PATH="$recommend_bin:$PATH" "$ROOT/recommend-check" >/dev/null 2>&1 || recommend_status=$?
  PATH="$pacnew_bin:$PATH" "$ROOT/pacnew-check" --strict >/dev/null 2>&1 || pacnew_status=$?
  [[ "$recommend_status" -ne 0 ]] || fail 'recommend-check must fail when pacman package query fails'
  recommend_hw_output="$(PATH="$recommend_hw_bin:$PATH" "$ROOT/recommend-check" 2>&1)" \
    || recommend_hw_status=$?
  [[ "$recommend_hw_status" -ne 0 ]] \
    || fail 'recommend-check must fail when hardware recommendation inputs cannot be queried'
  assert_contains "$recommend_hw_output" 'GPU 查询失败（退出码 6）' \
    'recommend-check distinguishes a failed GPU query from absent hardware'
  [[ "$pacnew_status" -ne 0 ]] || fail 'pacnew-check must fail when filesystem scanning fails'
  PACNEW_PARTIAL_FIND=1 PATH="$pacnew_bin:$PATH" "$ROOT/pacnew-check" \
    >/dev/null 2>&1 || pacnew_partial_status=$?
  [[ "$pacnew_partial_status" -ne 0 ]] \
    || fail 'pacnew-check must fail when a scan returns partial results before an error'
  boot_output="$(PATH="$boot_bin:$PATH" "$ROOT/boot-check" 2>&1)" || boot_status=$?
  [[ "$boot_status" -ne 0 ]] || fail 'boot-check must fail when the package database query fails'
  assert_contains "$boot_output" 'pacman 已安装包查询失败' \
    'boot-check must report package database failure instead of missing packages'
  assert_contains "$boot_output" '状态查询失败' \
    'boot-check must reject unknown systemctl output as a failed query'
  hw_output="$(PATH="$hw_bin:$PATH" "$ROOT/hw-doctor" 2>&1)" || hw_status=$?
  [[ "$hw_status" -ne 0 ]] \
    || fail 'hw-doctor must return nonzero when a hardware query fails without strict mode'
  assert_contains "$hw_output" 'lspci 查询失败（退出码 5）' \
    'hw-doctor distinguishes a failed PCI query from a missing command'
  local dms_output
  dms_output="$(DMS_PROCESS_RUNNING=0 PATH="$hw_bin:$PATH" "$ROOT/hw-doctor" 2>&1)" || true
  assert_contains "$dms_output" 'DMS 正在运行（会话守护方式启动；dms.service inactive）' \
    'hw-doctor recognizes a DMS session daemon when its optional user unit is inactive'
  pass 'diagnostic command failures cannot become healthy package results'
}

test_privileged_read_prompts() {
  if [[ "$EUID" -eq 0 ]] || ! command -v script >/dev/null 2>&1; then
    pass 'privileged read prompt test skipped for root or missing util-linux script'
    return
  fi
  local bin="$TMP_DIR/read-sudo-bin"
  local log="$TMP_DIR/read-sudo.log"
  local command_line
  mkdir -p "$bin"
  cat > "$bin/sudo" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$READ_SUDO_LOG"
if [[ "${1:-}" == '-v' ]]; then exit 0; fi
if [[ "${1:-}" == '-n' ]]; then shift; fi
exec "$@"
STUB
  cat > "$bin/pacdiff" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
  cat > "$bin/find" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
  chmod +x "$bin"/*

  printf -v command_line 'env PATH=%q READ_SUDO_LOG=%q MAINTENANCE_NO_NOTIFY=1 %q' \
    "$bin:$PATH" "$log" "$ROOT/boot-check"
  script -q -e -c "$command_line" /dev/null >/dev/null 2>&1 || true
  printf -v command_line 'env PATH=%q READ_SUDO_LOG=%q MAINTENANCE_NO_NOTIFY=1 %q' \
    "$bin:$PATH" "$log" "$ROOT/pacnew-check"
  script -q -e -c "$command_line" /dev/null >/dev/null 2>&1 || true

  [[ "$(grep -c '^-v$' "$log" || true)" -eq 2 ]] \
    || fail 'boot and pacnew checks must each validate sudo once in a terminal'
  grep -q '^-n test -f /boot/grub/grub.cfg$' "$log" \
    || fail 'boot check must read protected GRUB files through cached sudo'
  grep -q '^-n pacdiff --output$' "$log" \
    || fail 'pacnew check must run pacdiff through cached sudo'
  grep -q '^-n find /etc ' "$log" \
    || fail 'pacnew check must scan /etc through cached sudo'
  grep -q '^-n find /boot ' "$log" \
    || fail 'pacnew check must scan /boot through cached sudo'
  pass 'interactive boot and pacnew checks request and reuse read-only sudo access'
}

test_gpu_compact_health_summary() {
  local bin="$TMP_DIR/gpu-bin"
  local output
  mkdir -p "$bin"
  cat > "$bin/lspci" <<'STUB'
#!/usr/bin/env bash
cat <<'EOF'
01:00.0 VGA compatible controller: NVIDIA Corporation GeForce RTX Fixture (rev a1)
	Kernel driver in use: nvidia
	Kernel modules: nouveau, nvidia
35:00.0 VGA compatible controller: Advanced Micro Devices, Inc. Fixture iGPU (rev 01)
	Kernel driver in use: amdgpu
	Kernel modules: amdgpu
EOF
STUB
  cat > "$bin/lsmod" <<'STUB'
#!/usr/bin/env bash
[[ "${GPU_LSMOD_FAIL:-0}" == '1' ]] && { printf 'lsmod fixture failed\n' >&2; exit 5; }
printf 'Module Size Used by\nnvidia 100 2\namdgpu 100 3\n'
STUB
  cat > "$bin/glxinfo" <<'STUB'
#!/usr/bin/env bash
if [[ "${GPU_PRIME:-0}" == '1' ]]; then
  vendor='NVIDIA Corporation'
  renderer='NVIDIA GeForce RTX Fixture/PCIe/SSE2'
  version='4.6.0 NVIDIA fixture'
else
  vendor='AMD'
  renderer='AMD Radeon Fixture (radeonsi)'
  version='4.6 Mesa fixture'
fi
cat <<EOF
direct rendering: Yes
    Accelerated: yes
OpenGL vendor string: $vendor
OpenGL renderer string: $renderer
OpenGL core profile version string: $version
EOF
STUB
  cat > "$bin/vulkaninfo" <<'STUB'
#!/usr/bin/env bash
cat <<'EOF'
Vulkan Instance Version: 1.4.350
Devices:
GPU0:
        deviceType         = PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU
        deviceName         = AMD Radeon Fixture
        driverName         = radv
GPU1:
        deviceType         = PHYSICAL_DEVICE_TYPE_DISCRETE_GPU
        deviceName         = NVIDIA GeForce RTX Fixture
        driverName         = NVIDIA
EOF
STUB
  cat > "$bin/nvidia-smi" <<'STUB'
#!/usr/bin/env bash
printf 'NVIDIA GeForce RTX Fixture, 610.00, 46, 18.5, 2, 6141, 2\n'
STUB
  cat > "$bin/prime-run" <<'STUB'
#!/usr/bin/env bash
GPU_PRIME=1 exec "$@"
STUB
  chmod +x "$bin"/*

  output="$(PATH="$bin:$PATH" "$ROOT/gpu-check" --strict 2>&1)" \
    || fail 'healthy hybrid-GPU fixture must pass strict mode'
  assert_contains "$output" '6 正常' 'GPU summary must count successful checks'
  assert_contains "$output" '默认 OpenGL 直接渲染正常' \
    'GPU summary identifies the default rendering path'
  assert_contains "$output" 'prime-run OpenGL 直接渲染正常' \
    'GPU summary validates the discrete rendering path'
  [[ "$output" != *'Processes:'* && "$output" != *'Instance Extensions:'* ]] \
    || fail 'GPU summary must not dump verbose nvidia-smi or Vulkan tables'
  local lsmod_rc=0 lsmod_output
  lsmod_output="$(GPU_LSMOD_FAIL=1 PATH="$bin:$PATH" "$ROOT/gpu-check" --strict 2>&1)" \
    || lsmod_rc=$?
  [[ "$lsmod_rc" -eq 1 ]] || fail 'GPU strict mode must convert lsmod failure into a health failure'
  assert_contains "$lsmod_output" 'lsmod 查询失败（退出码 5）' \
    'GPU check must explain lsmod query failure'
  assert_contains "$lsmod_output" '注意' \
    'GPU check must still print the final tally after lsmod failure'
  pass 'GPU check presents compact hybrid-graphics results with real success totals'
}

test_offsite_rejects_same_disk() {
  local output status=0
  output="$("$ROOT/offsite-backup" --target /var/tmp --check 2>&1)" || status=$?
  if [[ "$status" -eq 0 ]]; then
    fail 'offsite backup must reject a target on the system disk'
  fi
  assert_contains "$output" '同一物理磁盘' 'offsite backup rejection identifies the same-disk risk'
  pass 'offsite backup rejects same-disk targets'
}

test_offsite_full_cycle() {
  local bin="$TMP_DIR/offsite-bin"
  local home="$TMP_DIR/offsite-home"
  local target="$TMP_DIR/offsite-target"
  mkdir -p "$bin" "$home/scripts" "$target"
  printf 'fixture\n' > "$home/scripts/example.txt"
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
last="${*: -1}"
if [[ " $* " == *' FSTYPE '* ]]; then
  [[ "$last" == "$HOME" ]] && printf 'btrfs\n' || printf 'ext4\n'
elif [[ " $* " == *' TARGET '* && "$last" == "$HOME" ]]; then
  printf '%s\n' "$HOME"
elif [[ "$last" == '/' ]]; then
  printf '/dev/rootp1\n'
else
  printf '/dev/backupp1\n'
fi
STUB
  cat > "$bin/lsblk" <<'STUB'
#!/usr/bin/env bash
case "${*: -1}" in
  /dev/rootp1) printf 'rootp1 part\nrootdisk disk\n' ;;
  /dev/backupp1) printf 'backupp1 part\nbackupdisk disk\n' ;;
esac
STUB
  cat > "$bin/pacman" <<'STUB'
#!/usr/bin/env bash
case " $* " in
  *' -Qqe '*) printf 'bash\n' ;;
  *' -Qqm '*) exit 0 ;;
  *) exit 0 ;;
esac
STUB
  cat > "$bin/systemctl" <<'STUB'
#!/usr/bin/env bash
printf 'fixture.service enabled\n'
STUB
  cat > "$bin/snapper" <<'STUB'
#!/usr/bin/env bash
case " $* " in
  *' list-configs '*) printf 'config\037subvolume\nhome\037%s\n' "$HOME" ;;
  *' list --columns number,userdata '*)
    printf 'number\037userdata\n'
    if [[ "${OFFSITE_STALE:-0}" == '1' ]]; then
      printf '99\037maintenance_temporary=offsite-backup\n'
    fi
    ;;
  *' create '*)
    mkdir -p "$HOME/.snapshots/101/snapshot/scripts"
    cp -a -- "$HOME/scripts/." "$HOME/.snapshots/101/snapshot/scripts/"
    printf 'changed-after-snapshot\n' > "$HOME/scripts/example.txt"
    printf 'create %s\n' "$*" >> "$OFFSITE_SNAPSHOT_LOG"
    printf 'fixture warning on stderr\n' >&2
    printf '101\n'
    ;;
  *' delete '*)
    snapshot_id="${*: -1}"
    printf 'delete %s\n' "$snapshot_id" >> "$OFFSITE_SNAPSHOT_LOG"
    rm -rf -- "$HOME/.snapshots/$snapshot_id"
    ;;
esac
STUB
  cat > "$bin/mv" <<'STUB'
#!/usr/bin/env bash
/usr/bin/mv "$@"
if [[ "${OFFSITE_SIGNAL_TEST:-0}" == '1' && "${*: -1}" == */latest ]]; then
  kill -TERM "$PPID"
fi
STUB
  chmod +x "$bin"/*

  local snapshot_log="$TMP_DIR/offsite-snapshot.log" backup_output
  backup_output="$(HOME="$home" PATH="$bin:$PATH" OFFSITE_SNAPSHOT_LOG="$snapshot_log" \
    OFFSITE_SIGNAL_TEST=1 OFFSITE_STALE=1 \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/offsite-cycle.lock" \
    "$ROOT/offsite-backup" --target "$target" --keep 2 2>&1)" \
    || fail 'offsite backup must accept a Snapper warning emitted on stderr'
  assert_contains "$backup_output" 'fixture warning on stderr' \
    'offsite backup keeps Snapper warnings separate from the numeric snapshot ID'
  HOME="$home" PATH="$bin:$PATH" \
    "$ROOT/offsite-backup" --target "$target" --check >/dev/null

  local dest latest
  dest="$target/maintenance-backup-$(< /proc/sys/kernel/hostname)"
  latest="$dest/$(readlink "$dest/latest")"
  [[ -s "$latest/migration/payload/home-config.tar.zst" ]] \
    || fail 'offsite cycle must create a v2 migration archive'
  [[ "$(< "$latest/migration/payload/mode")" == 'metadata-only' ]] \
    || fail 'offsite migration metadata must avoid duplicating the full HOME payload'
  [[ -s "$latest/home.tar.zst" ]] || fail 'offsite cycle must create HOME archive'
  [[ "$(tar --zstd -xOf "$latest/home.tar.zst" ./scripts/example.txt)" == 'fixture' ]] \
    || fail 'offsite HOME archive must read from the frozen snapshot, not the changing live HOME'
  [[ -z "$(tar --zstd -tf "$latest/migration/payload/home-config.tar.zst")" ]] \
    || fail 'offsite migration metadata must not duplicate files already present in the HOME archive'
  [[ "$(grep -c '^create ' "$snapshot_log")" -eq 1 \
      && "$(grep -c '^delete 99$' "$snapshot_log")" -eq 1 \
      && "$(grep -c '^delete 101$' "$snapshot_log")" -eq 1 ]] \
    || fail 'offsite backup must create and remove one temporary HOME snapshot'
  assert_contains "$(< "$snapshot_log")" '--read-only' \
    'offsite temporary snapshots are explicitly read-only'
  [[ "$(< "$snapshot_log")" != *'--cleanup-algorithm'* ]] \
    || fail 'offsite temporary snapshots must not race snapper-cleanup.timer'

  local unowned_set="$dest/set-20000101-000000-1"
  mkdir -p "$unowned_set"
  printf 'unrelated\n' > "$unowned_set/user-data.txt"
  HOME="$home" PATH="$bin:$PATH" OFFSITE_SNAPSHOT_LOG="$snapshot_log" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/offsite-cycle-retention.lock" \
    "$ROOT/offsite-backup" --target "$target" --keep 1 >/dev/null 2>&1
  [[ -f "$unowned_set/user-data.txt" ]] \
    || fail 'offsite retention must not delete an unowned directory with a set-* name'
  [[ "$(find "$dest" -mindepth 2 -maxdepth 2 -name '.offsite-set-owned' | wc -l)" -eq 1 ]] \
    || fail 'offsite retention keeps only the requested number of owned backup sets'

  local old_latest status=0
  old_latest="$(readlink "$dest/latest")"
  latest="$dest/$old_latest"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 1' > "$bin/tar"
  chmod +x "$bin/tar"
  HOME="$home" PATH="$bin:$PATH" OFFSITE_SNAPSHOT_LOG="$snapshot_log" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/offsite-cycle-fail.lock" \
    "$ROOT/offsite-backup" --target "$target" --keep 2 >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'failed offsite generation must return nonzero'
  [[ "$(readlink "$dest/latest")" == "$old_latest" ]] || fail 'failed offsite generation must preserve previous latest set'
  [[ -z "$(find "$dest" -maxdepth 1 -type d -name '.*.tmp' -print -quit)" ]] || fail 'failed offsite generation must clean staging directory'
  rm -f -- "$bin/tar"

  local marker_failure_output
  chmod 500 "$dest"
  status=0
  marker_failure_output="$(HOME="$home" PATH="$bin:$PATH" OFFSITE_SNAPSHOT_LOG="$snapshot_log" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/offsite-marker-fail.lock" \
    "$ROOT/offsite-backup" --target "$target" --keep 2 2>&1)" || status=$?
  chmod 700 "$dest"
  [[ "$status" -ne 0 ]] || fail 'unwritable offsite destination must return nonzero'
  assert_contains "$marker_failure_output" '无法写入备份目标标记' \
    'unwritable offsite destination reports a controlled error'
  [[ "$marker_failure_output" != *'.offsite-backup-owned.'* ]] \
    || fail 'unwritable offsite destination must not leak a raw shell redirection error'

  # DEST 尚不存在且目标挂载点不可写时，mkdir -p 也必须输出受控错误；
  # 不能依靠 set -e 直接暴露内核的 Permission denied。
  local blocked_target="$TMP_DIR/offsite-parent-blocked" parent_failure_output
  mkdir -p "$blocked_target"
  chmod 500 "$blocked_target"
  status=0
  parent_failure_output="$(HOME="$home" PATH="$bin:$PATH" OFFSITE_SNAPSHOT_LOG="$snapshot_log" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/offsite-parent-fail.lock" \
    "$ROOT/offsite-backup" --target "$blocked_target" --keep 2 2>&1)" || status=$?
  chmod 700 "$blocked_target"
  [[ "$status" -ne 0 ]] || fail 'unwritable offsite target parent must return nonzero'
  assert_contains "$parent_failure_output" '无法创建备份目录（请检查目标是否可写）' \
    'unwritable offsite target parent reports a controlled creation error'
  [[ "$parent_failure_output" != *'Permission denied'* ]] \
    || fail 'unwritable offsite target parent must not leak raw mkdir errors'

  printf '%064d  ../outside\n' 0 > "$latest/home.tar.zst.sha256"
  status=0
  HOME="$home" PATH="$bin:$PATH" "$ROOT/offsite-backup" --target "$target" --check >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'offsite check must reject checksum paths outside the backup set'
  pass 'offsite backup completes and verifies an isolated full cycle'
}

test_offsite_check_is_read_only() {
  local bin="$TMP_DIR/offsite-check-bin"
  local home="$TMP_DIR/offsite-check-home"
  local target="$TMP_DIR/offsite-check-target"
  mkdir -p "$bin" "$home" "$target"
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *' FSTYPE '* ]]; then printf 'ext4\n'
elif [[ "${*: -1}" == '/' ]]; then printf '/dev/rootp1\n'
else printf '/dev/backupp1\n'; fi
STUB
  cat > "$bin/lsblk" <<'STUB'
#!/usr/bin/env bash
[[ "${*: -1}" == '/dev/rootp1' ]] && printf 'rootdisk disk\n' || printf 'backupdisk disk\n'
STUB
  chmod +x "$bin"/*
  local status=0
  HOME="$home" PATH="$bin:$PATH" "$ROOT/offsite-backup" --target "$target" --check >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'offsite check of an empty target must fail'
  [[ -z "$(find "$target" -mindepth 1 -print -quit)" ]] || fail 'offsite --check must not create ownership metadata'
  pass 'offsite check mode does not mutate an empty target'
}

test_offsite_schedule_units() {
  local bin="$TMP_DIR/schedule-bin"
  local home="$TMP_DIR/schedule-home"
  local target="$TMP_DIR/schedule target"
  local log="$TMP_DIR/schedule.log"
  local unit_dir="$home/.config/systemd/user"
  mkdir -p "$bin" "$home" "$target"
  cat > "$bin/offsite-validator" <<'STUB'
#!/usr/bin/env bash
printf 'validator %s\n' "$*" >> "$SCHEDULE_TEST_LOG"
[[ "${SCHEDULE_VALIDATE_FAIL:-0}" == '1' ]] && exit 1
exit 0
STUB
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
printf '/run/media/test/backup disk\n'
STUB
  cat > "$bin/systemctl" <<'STUB'
#!/usr/bin/env bash
printf 'systemctl %s\n' "$*" >> "$SCHEDULE_TEST_LOG"
case " $* " in
  *' status '*)
    [[ "${SCHEDULE_STATUS_FAIL:-0}" == '1' ]] \
      && { printf 'user bus unavailable\n' >&2; exit 5; }
    exit 0
    ;;
  *' show '*)
    [[ "${SCHEDULE_STATUS_FAIL:-0}" == '1' ]] \
      && { printf 'user bus unavailable\n' >&2; exit 5; }
    printf 'loaded\n'
    exit 0
    ;;
  *' is-enabled '*)
    [[ "${SCHEDULE_STATE_QUERY_FAIL:-0}" == '1' ]] \
      && { printf 'user bus unavailable\n' >&2; exit 5; }
    printf 'enabled\n'; exit 0
    ;;
  *' is-active '*)
    [[ "${SCHEDULE_STATE_QUERY_FAIL:-0}" == '1' ]] \
      && { printf 'user bus unavailable\n' >&2; exit 5; }
    printf 'active\n'; exit 0
    ;;
  *' disable --now maintenance-offsite-backup.timer '*)
    [[ "${SCHEDULE_DISABLE_FAIL:-0}" == '1' ]] \
      && { printf 'disable failed\n' >&2; exit 7; }
    ;;
  *' enable --now maintenance-offsite-backup.timer '*)
    [[ "${SCHEDULE_ENABLE_FAIL:-0}" == '1' ]] && exit 9
    ;;
esac
exit 0
STUB
  cat > "$bin/mv" <<'STUB'
#!/usr/bin/env bash
if [[ "${SCHEDULE_ROLLBACK_MV_FAIL:-0}" == '1' && "${1:-}" == '-Tf' \
      && "${3:-}" == *'.old.'* ]]; then
  printf 'fixture rollback mv failure\n' >&2
  exit 8
fi
exec /usr/bin/mv "$@"
STUB
  cat > "$bin/chmod" <<'STUB'
#!/usr/bin/env bash
if [[ "${SCHEDULE_CHMOD_FAIL:-0}" == '1' && " $* " == *'.offsite-backup-units.'* ]]; then
  exit 8
fi
exec /usr/bin/chmod "$@"
STUB
  chmod +x "$bin"/*

  HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" \
    OFFSITE_BACKUP_CMD="$bin/offsite-validator" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/schedule-install.lock" \
    "$ROOT/offsite-backup-schedule" --install --target "$target" --yes >/dev/null
  local service="$unit_dir/maintenance-offsite-backup.service"
  local timer="$unit_dir/maintenance-offsite-backup.timer"
  [[ -s "$service" && -s "$timer" ]] || fail 'schedule install must publish both user units'
  assert_contains "$(< "$service")" '# Managed by offsite-backup-schedule v1' \
    'scheduled backup service carries an ownership marker'
  assert_contains "$(< "$service")" 'ConditionPathIsMountPoint=/run/media/test/backup\x20disk' \
    'scheduled backup service is conditional on the recorded mountpoint'
  assert_contains "$(< "$service")" "--target \"$target\" --keep 3" \
    'scheduled backup service preserves the configured target and retention'
  assert_contains "$(< "$service")" 'TimeoutStartSec=infinity' \
    'scheduled backup is not killed by the default oneshot start timeout'
  assert_contains "$(< "$log")" 'enable --now maintenance-offsite-backup.timer' \
    'schedule install enables the user timer'

  local service_before timer_before
  service_before="$(sha256sum "$service")"
  timer_before="$(sha256sum "$timer")"
  local failed_rc=0
  HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" SCHEDULE_VALIDATE_FAIL=1 \
    OFFSITE_BACKUP_CMD="$bin/offsite-validator" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/schedule-invalid.lock" \
    "$ROOT/offsite-backup-schedule" --install --target "$target" --yes \
    >/dev/null 2>&1 || failed_rc=$?
  [[ "$failed_rc" -ne 0 && "$(sha256sum "$service")" == "$service_before" ]] \
    || fail 'failed target validation must preserve installed schedule units'

  local state_query_output
  failed_rc=0
  state_query_output="$(HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" \
    SCHEDULE_STATE_QUERY_FAIL=1 OFFSITE_BACKUP_CMD="$bin/offsite-validator" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/schedule-state-query.lock" \
    "$ROOT/offsite-backup-schedule" --install --target "$target" --keep 4 --yes 2>&1)" \
    || failed_rc=$?
  [[ "$failed_rc" -ne 0 && "$(sha256sum "$service")" == "$service_before" \
      && "$(sha256sum "$timer")" == "$timer_before" ]] \
    || fail 'schedule install must abort before publishing when old timer state cannot be read'
  assert_contains "$state_query_output" '无法读取现有 timer 启用状态' \
    'schedule install explains old timer state query failures'

  failed_rc=0
  HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" SCHEDULE_CHMOD_FAIL=1 \
    OFFSITE_BACKUP_CMD="$bin/offsite-validator" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/schedule-staging-fail.lock" \
    "$ROOT/offsite-backup-schedule" --install --target "$target" --keep 4 --yes \
    >/dev/null 2>&1 || failed_rc=$?
  [[ "$failed_rc" -ne 0 && "$(sha256sum "$service")" == "$service_before" \
      && "$(sha256sum "$timer")" == "$timer_before" ]] \
    || fail 'unexpected unit staging failure must preserve installed unit files'
  [[ -z "$(find "$unit_dir" -maxdepth 1 -type d -name '.offsite-backup-units.*' -print -quit)" ]] \
    || fail 'EXIT cleanup must remove unit staging directories after an unexpected failure'

  failed_rc=0
  HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" SCHEDULE_ENABLE_FAIL=1 \
    OFFSITE_BACKUP_CMD="$bin/offsite-validator" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/schedule-activation.lock" \
    "$ROOT/offsite-backup-schedule" --install --target "$target" --keep 4 --yes \
    >/dev/null 2>&1 || failed_rc=$?
  [[ "$failed_rc" -ne 0 && "$(sha256sum "$service")" == "$service_before" \
      && "$(sha256sum "$timer")" == "$timer_before" ]] \
    || fail 'failed systemd activation must restore the previous schedule unit files'

  local status_output status_rc=0
  status_output="$(HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" \
    SCHEDULE_STATUS_FAIL=1 "$ROOT/offsite-backup-schedule" --status 2>&1)" || status_rc=$?
  [[ "$status_rc" -ne 0 ]] \
    || fail 'scheduled backup status must expose systemd user bus query failures'
  assert_contains "$status_output" '无法查询 systemd user unit' \
    'scheduled backup status explains failed systemd queries'

  local rollback_output rollback_rc=0
  rollback_output="$(HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" \
    SCHEDULE_ENABLE_FAIL=1 SCHEDULE_ROLLBACK_MV_FAIL=1 \
    OFFSITE_BACKUP_CMD="$bin/offsite-validator" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/schedule-rollback-fail.lock" \
    "$ROOT/offsite-backup-schedule" --install --target "$target" --keep 5 --yes 2>&1)" \
    || rollback_rc=$?
  [[ "$rollback_rc" -ne 0 ]] || fail 'activation plus rollback failure must return nonzero'
  assert_contains "$rollback_output" '恢复旧 service unit 失败' \
    'unit rollback failures remain visible instead of aborting the cleanup trap'
  compgen -G "$unit_dir/.${SERVICE_NAME:-maintenance-offsite-backup.service}.old.*" >/dev/null \
    || fail 'failed unit rollback must retain the old service file for manual recovery'
  local retained_old
  retained_old="$(compgen -G "$unit_dir/.maintenance-offsite-backup.service.old.*" | head -n1)"
  /usr/bin/mv -Tf -- "$retained_old" "$service"
  retained_old="$(compgen -G "$unit_dir/.maintenance-offsite-backup.timer.old.*" | head -n1)"
  /usr/bin/mv -Tf -- "$retained_old" "$timer"

  local disable_output disable_rc=0
  disable_output="$(HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" \
    SCHEDULE_DISABLE_FAIL=1 OFFSITE_BACKUP_CMD="$bin/offsite-validator" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/schedule-disable-fail.lock" \
    "$ROOT/offsite-backup-schedule" --remove --yes 2>&1)" || disable_rc=$?
  [[ "$disable_rc" -ne 0 && -s "$service" && -s "$timer" ]] \
    || fail 'failed timer disable must preserve installed schedule unit files'
  assert_contains "$disable_output" 'unit 文件保持不变' \
    'schedule removal reports that failed disable preserved unit files'

  HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" \
    OFFSITE_BACKUP_CMD="$bin/offsite-validator" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/schedule-remove.lock" \
    "$ROOT/offsite-backup-schedule" --remove --yes >/dev/null
  [[ ! -e "$service" && ! -e "$timer" ]] \
    || fail 'schedule removal deletes only its owned units'

  mkdir -p "$unit_dir"
  printf 'custom service\n' > "$service"
  printf 'custom timer\n' > "$timer"
  local ownership_rc=0
  HOME="$home" PATH="$bin:$PATH" SCHEDULE_TEST_LOG="$log" \
    OFFSITE_BACKUP_CMD="$bin/offsite-validator" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/schedule-ownership.lock" \
    "$ROOT/offsite-backup-schedule" --install --target "$target" --yes \
    >/dev/null 2>&1 || ownership_rc=$?
  [[ "$ownership_rc" -ne 0 && "$(< "$service")" == 'custom service' \
      && "$(< "$timer")" == 'custom timer' ]] \
    || fail 'schedule install must never overwrite unowned unit files'
  pass 'offsite schedule validates mounts and publishes owned user units atomically'
}

test_migration_output_and_checksum_guards() {
  local output_path="$TMP_DIR/migration-existing-file"
  printf 'keep\n' > "$output_path"
  local status=0
  MAINTENANCE_LOCK_FILE="$TMP_DIR/migration-path.lock" \
    "$ROOT/migration-pack" --pack "$output_path" >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 && "$(< "$output_path")" == 'keep' ]] \
    || fail 'migration pack must preserve an existing non-directory output path'

  local dir="$TMP_DIR/migration-checksum-coverage"
  local payload="$TMP_DIR/migration-checksum-payload"
  mkdir -p "$dir" "$payload"
  printf 'fixture\n' > "$payload/example.txt"
  tar -czf "$dir/pang-arch-configs.tar.gz" -C "$payload" example.txt
  printf 'bash\n' > "$dir/pkglist-explicit.txt"
  : > "$dir/pkglist-foreign.txt"
  : > "$dir/system-enabled-units.txt"
  : > "$dir/user-enabled-units.txt"
  printf 'example.txt\n' > "$dir/tar-manifest.txt"
  (
    cd "$dir"
    sha256sum tar-manifest.txt pkglist-explicit.txt pkglist-foreign.txt \
      system-enabled-units.txt user-enabled-units.txt > SHA256SUMS
  )
  if "$ROOT/migration-pack" --check "$dir" >/dev/null 2>&1; then
    fail 'migration check must require the archive itself in SHA256SUMS'
  fi

  local atomic_home="$TMP_DIR/migration-atomic-home"
  local atomic_dir="$TMP_DIR/migration-atomic-output"
  local atomic_bin="$TMP_DIR/migration-atomic-bin"
  mkdir -p "$atomic_home/scripts" "$atomic_dir" "$atomic_bin"
  printf 'script fixture\n' > "$atomic_home/scripts/example"
  printf 'migration-pack v1\n' > "$atomic_dir/.migration-pack-owned"
  printf 'old data\n' > "$atomic_dir/sentinel"
  cat > "$atomic_bin/pacman" <<'STUB'
#!/usr/bin/env bash
case " $* " in
  *' -Qqe '*) printf 'bash\n' ;;
  *' -Qqm '*) exit 1 ;;
esac
STUB
  cat > "$atomic_bin/systemctl" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
  cat > "$atomic_bin/mv" <<'STUB'
#!/usr/bin/env bash
source_path="${3:-}"
if [[ "${MIGRATION_PUBLISH_FAIL:-0}" == '1' && "$source_path" == *'.new.'* ]]; then
  exit 9
fi
exec /usr/bin/mv "$@"
STUB
  chmod +x "$atomic_bin"/*
  local atomic_rc=0
  HOME="$atomic_home" PATH="$atomic_bin:$PATH" MIGRATION_PUBLISH_FAIL=1 \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/migration-atomic.lock" \
    "$ROOT/migration-pack" --pack "$atomic_dir" >/dev/null 2>&1 || atomic_rc=$?
  [[ "$atomic_rc" -ne 0 && "$(< "$atomic_dir/sentinel")" == 'old data' ]] \
    || fail 'failed migration package publication must restore the previous directory exactly'
  [[ -z "$(find "$TMP_DIR" -maxdepth 1 -type d -name '.migration-atomic-output.new.*' -print -quit)" ]] \
    || fail 'failed migration package publication must remove its staging directory'
  pass 'migration output ownership and checksum coverage are enforced'
}

test_mirror_backup_retention() {
  local mirror_home="$TMP_DIR/mirror-home"
  mkdir -p "$mirror_home"
  HOME="$mirror_home" MIRROR_BACKUP_KEEP=2 source "$ROOT/mirror-update"
  mkdir -p "$BACKUP_DIR"
  printf a > "$BACKUP_DIR/mirrorlist-20260101-000001-1.bak"
  printf b > "$BACKUP_DIR/mirrorlist-20260101-000002-2.bak"
  printf c > "$BACKUP_DIR/mirrorlist-20260101-000003-3.bak"
  printf keep > "$BACKUP_DIR/mirrorlist-personal.bak"
  touch -t 202601010001 "$BACKUP_DIR/mirrorlist-20260101-000001-1.bak"
  touch -t 202601010002 "$BACKUP_DIR/mirrorlist-20260101-000002-2.bak"
  touch -t 202601010003 "$BACKUP_DIR/mirrorlist-20260101-000003-3.bak"
  prune_backups
  local count
  count="$(find "$BACKUP_DIR" -type f -regextype posix-extended \
    -regex '.*/mirrorlist-[0-9]{8}-[0-9]{6}-[0-9]+\.bak' | wc -l)"
  [[ "$count" -eq 2 ]] || fail 'mirror backup retention must keep configured generations'
  [[ -f "$BACKUP_DIR/mirrorlist-20260101-000003-3.bak" ]] || fail 'newest mirror backup must be retained'
  [[ -f "$BACKUP_DIR/mirrorlist-personal.bak" ]] \
    || fail 'mirror retention must not delete unrelated files sharing a broad prefix'
  pass 'mirror backups retain multiple recent generations'
}

test_mirror_update_full_cycle() {
  local bin="$TMP_DIR/mirror-cycle-bin"
  local dir="$TMP_DIR/mirror-cycle"
  local mirror="$dir/mirrorlist"
  mkdir -p "$bin" "$dir/backups"
  cat > "$bin/sudo" <<'STUB'
#!/usr/bin/env bash
[[ "${1:-}" == '-v' ]] && exit 0
exec "$@"
STUB
  cat > "$bin/reflector" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *' --list-countries '* ]]; then
  printf 'Country Code Count\n------- ---- -----\nChina CN 1\n'
  exit 0
fi
save=''
prev=''
for arg in "$@"; do
  [[ "$prev" == '--save' ]] && save="$arg"
  prev="$arg"
done
[[ "${MIRROR_TEST_FAIL:-0}" == '1' ]] && exit 1
if [[ "${MIRROR_TEST_EMPTY:-0}" == '1' ]]; then
  printf '# no usable mirrors\n' > "$save"
  exit 0
fi
printf '# generated\nServer = https://new.example/$repo/os/$arch\n' > "$save"
STUB
  chmod +x "$bin"/*

  printf '%s\n' '# original' "Server = https://old.example/\$repo/os/\$arch" > "$mirror"
  HOME="$dir/home" PATH="$bin:$PATH" MIRRORLIST_PATH="$mirror" \
    MIRROR_BACKUP_DIR="$dir/backups" MAINTENANCE_LOCK_FILE="$dir/success.lock" \
    "$ROOT/mirror-update" -c China >/dev/null
  assert_contains "$(< "$mirror")" 'new.example' 'successful mirror cycle installs generated list'
  [[ "$(find "$dir/backups" -type f -name 'mirrorlist-*.bak' | wc -l)" -ge 1 ]] || fail 'successful mirror cycle creates timestamped backup'

  printf '%s\n' '# stable' "Server = https://stable.example/\$repo/os/\$arch" > "$mirror"
  local status=0
  HOME="$dir/home" PATH="$bin:$PATH" MIRROR_TEST_FAIL=1 MIRRORLIST_PATH="$mirror" \
    MIRROR_BACKUP_DIR="$dir/backups" MAINTENANCE_LOCK_FILE="$dir/failure.lock" \
    "$ROOT/mirror-update" -c China >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'failed mirror cycle must return nonzero'
  assert_contains "$(< "$mirror")" 'stable.example' 'failed mirror cycle restores pre-run list'

  status=0
  HOME="$dir/home" PATH="$bin:$PATH" MIRROR_TEST_EMPTY=1 MIRRORLIST_PATH="$mirror" \
    MIRROR_BACKUP_DIR="$dir/backups" MAINTENANCE_LOCK_FILE="$dir/empty.lock" \
    "$ROOT/mirror-update" -c China >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'mirror update must reject a nonempty list without Server lines'
  assert_contains "$(< "$mirror")" 'stable.example' 'invalid generated mirror output must preserve the current list'
  pass 'mirror update succeeds atomically and restores on failure'
}

test_sysup_full_cycle_and_abort() {
  local bin="$TMP_DIR/sysup-bin"
  local log="$TMP_DIR/sysup.log"
  mkdir -p "$bin"
  cat > "$bin/curl" <<'STUB'
#!/usr/bin/env bash
cat <<'XML'
<rss><channel><item><title>Fixture news</title><pubDate>Sun, 26 Jul 2026 00:00:00 +0000</pubDate><link>https://example.test/news</link></item></channel></rss>
XML
STUB
  cat > "$bin/sudo" <<'STUB'
#!/usr/bin/env bash
[[ "${1:-}" == '-v' ]] && exit 0
if [[ "${1:-}" == '-n' ]]; then shift; [[ "${1:-}" == 'true' ]] && exit 0; fi
exec "$@"
STUB
  cat > "$bin/pacman" <<'STUB'
#!/usr/bin/env bash
printf 'pacman %s\n' "$*" >> "$SYSUP_TEST_LOG"
[[ "${SYSUP_PACMAN_FAIL:-0}" == '1' ]] && exit 1
exit 0
STUB
  cat > "$bin/paru" <<'STUB'
#!/usr/bin/env bash
printf 'paru %s\n' "$*" >> "$SYSUP_TEST_LOG"
exit 0
STUB
  cp "$bin/paru" "$bin/yay"
  cat > "$bin/flatpak" <<'STUB'
#!/usr/bin/env bash
printf 'flatpak %s\n' "$*" >> "$SYSUP_TEST_LOG"
[[ "${SYSUP_FLATPAK_FAIL:-0}" == '1' ]] && exit 1
exit 0
STUB
  cat > "$bin/grub-mkconfig" <<'STUB'
#!/usr/bin/env bash
printf 'grub %s\n' "$*" >> "$SYSUP_TEST_LOG"
exit 0
STUB
  cat > "$bin/systemd-inhibit" <<'STUB'
#!/usr/bin/env bash
while [[ "${1:-}" == --* ]]; do shift; done
exec "$@"
STUB
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
printf 'ext4\n'
STUB
  cat > "$bin/df" <<'STUB'
#!/usr/bin/env bash
printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/fake 20000000 1 19000000 1%% /\n'
STUB
  printf '%s\n' '#!/usr/bin/env bash' 'exit 1' > "$bin/mountpoint"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$bin/clear"
  cat > "$bin/check-refresh" <<'STUB'
#!/usr/bin/env bash
printf 'refresh %s\n' "$*" >> "$SYSUP_TEST_LOG"
[[ "${SYSUP_REFRESH_FAIL:-0}" == '1' ]] && exit 7
exit 0
STUB
  cat > "$bin/post-check" <<'STUB'
#!/usr/bin/env bash
printf 'post-check %s\n' "$*" >> "$SYSUP_TEST_LOG"
[[ "${SYSUP_POST_FAIL:-0}" == '1' ]] && exit 1
exit 0
STUB
  chmod +x "$bin"/*
  local SYSUP_POST_CHECK_CMD="$bin/post-check"
  export SYSUP_POST_CHECK_CMD

  SYSUP_TEST_LOG="$log" PATH="$bin:$PATH" TERM=xterm \
    SYSUP_CHECKALLUPDATES_CMD="$bin/check-refresh" MAINTENANCE_LOCK_FILE="$TMP_DIR/sysup-success.lock" \
    timeout 20s "$ROOT/sysup" --yes </dev/null >/dev/null
  local success_log
  success_log="$(< "$log")"
  assert_contains "$success_log" 'pacman -Sy' 'sysup runs keyring transaction'
  assert_contains "$success_log" 'paru -Su' 'sysup runs full package upgrade'
  assert_contains "$success_log" 'flatpak update -y' 'sysup runs Flatpak update'
  assert_contains "$success_log" 'grub -o /boot/grub/grub.cfg' 'sysup regenerates GRUB config'
  assert_contains "$success_log" 'post-check --grub-status success' \
    'sysup runs the read-only post-update check with the GRUB result'
  if [[ "$success_log" != *'refresh --refresh'* ]]; then
    printf 'sysup fixture log:\n%s\n' "$success_log" >&2
    fail 'sysup refreshes update cache'
  fi

  : > "$log"
  local status=0
  SYSUP_TEST_LOG="$log" SYSUP_PACMAN_FAIL=1 PATH="$bin:$PATH" TERM=xterm \
    SYSUP_CHECKALLUPDATES_CMD="$bin/check-refresh" MAINTENANCE_LOCK_FILE="$TMP_DIR/sysup-fail.lock" \
    timeout 20s "$ROOT/sysup" --yes </dev/null >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'sysup must fail when keyring transaction fails'
  [[ "$(< "$log")" != *'paru -Su'* ]] || fail 'sysup must not continue after keyring failure'

  : > "$log"
  status=0
  SYSUP_TEST_LOG="$log" SYSUP_FLATPAK_FAIL=1 PATH="$bin:$PATH" TERM=xterm \
    SYSUP_CHECKALLUPDATES_CMD="$bin/check-refresh" MAINTENANCE_LOCK_FILE="$TMP_DIR/sysup-flatpak-fail.lock" \
    timeout 20s "$ROOT/sysup" --yes </dev/null >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'sysup must report a partial failure when Flatpak update fails'
  [[ "$(< "$log")" == *'paru -Su'* ]] || fail 'Flatpak failure test must complete the main package upgrade first'

  : > "$log"
  status=0
  SYSUP_TEST_LOG="$log" SYSUP_POST_FAIL=1 PATH="$bin:$PATH" TERM=xterm \
    SYSUP_CHECKALLUPDATES_CMD="$bin/check-refresh" MAINTENANCE_LOCK_FILE="$TMP_DIR/sysup-post-fail.lock" \
    timeout 20s "$ROOT/sysup" --yes </dev/null >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 && "$(< "$log")" == *'paru -Su'* ]] \
    || fail 'sysup must expose a failed post-update health query after the upgrade'

  : > "$log"
  status=0
  SYSUP_TEST_LOG="$log" SYSUP_REFRESH_FAIL=1 PATH="$bin:$PATH" TERM=xterm \
    SYSUP_CHECKALLUPDATES_CMD="$bin/check-refresh" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/sysup-refresh-fail.lock" \
    timeout 20s "$ROOT/sysup" --yes </dev/null >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 && "$(< "$log")" == *'paru -Su'* \
      && "$(< "$log")" == *'refresh --refresh'* ]] \
    || fail 'sysup must expose update-cache refresh failure after the main upgrade'

  : > "$log"
  status=0
  SYSUP_TEST_LOG="$log" PATH="$bin:$PATH" TERM=xterm \
    "$ROOT/sysup" --yes --count invalid </dev/null >/dev/null 2>&1 || status=$?
  [[ "$status" -eq 2 && ! -s "$log" ]] || fail 'sysup must reject invalid option values before any update command'

  : > "$log"
  status=0
  SYSUP_TEST_LOG="$log" PATH="$bin:$PATH" TERM=xterm \
    SYSUP_CHECKALLUPDATES_CMD="$bin/check-refresh" MAINTENANCE_LOCK_FILE="$TMP_DIR/sysup-noninteractive.lock" \
    timeout 20s "$ROOT/sysup" </dev/null >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'sysup without --yes must reject noninteractive execution'
  [[ "$(< "$log")" != *'pacman '* ]] || fail 'rejected noninteractive sysup must not start a package transaction'
  pass 'sysup completes the isolated update chain and aborts on keyring failure'
}

test_post_update_health_status() {
  local bin="$TMP_DIR/post-update-bin"
  local modules="$TMP_DIR/post-update-modules"
  local grub_cfg="$TMP_DIR/post-update-grub.cfg"
  mkdir -p "$bin" "$modules/1.0-test"
  printf 'menuentry fixture {}\n' > "$grub_cfg"
  cat > "$bin/uname" <<'STUB'
#!/usr/bin/env bash
[[ "${1:-}" == '-r' ]] && printf '%s\n' "${POST_RUNNING_KERNEL:-1.0-test}"
STUB
  cat > "$bin/pacdiff" <<'STUB'
#!/usr/bin/env bash
[[ "${POST_PACDIFF_FAIL:-0}" == '1' ]] && { printf 'pacdiff failed\n' >&2; exit 5; }
[[ "${POST_PACNEW:-0}" == '1' ]] && printf '/etc/fixture.pacnew\n'
exit 0
STUB
  cat > "$bin/systemctl" <<'STUB'
#!/usr/bin/env bash
[[ "${POST_SYSTEMCTL_FAIL:-0}" == '1' ]] && { printf 'dbus failed\n' >&2; exit 4; }
[[ "${POST_FAILED_UNITS:-0}" == '1' ]] && printf 'fixture.service loaded failed failed Fixture\n'
exit 0
STUB
  cat > "$bin/sudo" <<'STUB'
#!/usr/bin/env bash
if [[ "${1:-}" == '-n' ]]; then
  shift
  [[ "${POST_SUDO_UNAVAILABLE:-0}" == '1' && "${1:-}" == 'true' ]] && exit 1
  [[ "${1:-}" == 'true' ]] && exit 0
fi
exec "$@"
STUB
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$bin/grub-script-check"
  chmod +x "$bin"/*

  local healthy_output healthy_rc=0
  healthy_output="$(PATH="$bin:$PATH" POST_UPDATE_MODULES_DIR="$modules" POST_UPDATE_GRUB_CFG="$grub_cfg" \
    "$ROOT/post-update-check" --grub-status success --strict 2>&1)" || healthy_rc=$?
  if [[ "$healthy_rc" -ne 0 ]]; then
    printf 'post-update healthy fixture output:\n%s\n' "$healthy_output" >&2
    fail 'healthy post-update fixture must pass strict mode'
  fi

  local warning_rc=0
  PATH="$bin:$PATH" POST_UPDATE_MODULES_DIR="$modules" POST_UPDATE_GRUB_CFG="$grub_cfg" \
    POST_RUNNING_KERNEL=0.9-old POST_PACNEW=1 POST_FAILED_UNITS=1 \
    "$ROOT/post-update-check" --grub-status success --strict >/dev/null || warning_rc=$?
  [[ "$warning_rc" -ne 0 ]] \
    || fail 'post-update strict mode must expose pacnew, failed units and stale kernel'

  local query_rc=0
  PATH="$bin:$PATH" POST_UPDATE_MODULES_DIR="$modules" POST_UPDATE_GRUB_CFG="$grub_cfg" \
    POST_PACDIFF_FAIL=1 "$ROOT/post-update-check" --grub-status success \
    >/dev/null 2>&1 || query_rc=$?
  [[ "$query_rc" -ne 0 ]] \
    || fail 'post-update query failures must return nonzero without strict mode'
  local grub_failed_rc=0
  PATH="$bin:$PATH" POST_UPDATE_MODULES_DIR="$modules" POST_UPDATE_GRUB_CFG="$grub_cfg" \
    "$ROOT/post-update-check" --grub-status failed >/dev/null 2>&1 || grub_failed_rc=$?
  [[ "$grub_failed_rc" -ne 0 ]] \
    || fail 'an explicitly failed grub-mkconfig must fail post-update-check without strict mode'
  if [[ "$EUID" -ne 0 ]]; then
    local grub_unreadable_rc=0 grub_unreadable_output
    grub_unreadable_output="$(PATH="$bin:$PATH" POST_UPDATE_MODULES_DIR="$modules" \
      POST_UPDATE_GRUB_CFG=/root/maintenance-unreadable-grub.cfg POST_SUDO_UNAVAILABLE=1 \
      "$ROOT/post-update-check" 2>&1)" || grub_unreadable_rc=$?
    [[ "$grub_unreadable_rc" -ne 0 ]] \
      || fail 'post-update check must fail when GRUB cannot be read'
    assert_contains "$grub_unreadable_output" 'GRUB 状态未完成验证' \
      'post-update check must distinguish unreadable GRUB from an informational result'
  fi
  pass 'post-update check separates advisories from failed health queries'
}

test_clean_csv_and_failure_status() {
  local bin="$TMP_DIR/clean-bin"
  local home="$TMP_DIR/clean-home"
  local log="$TMP_DIR/clean.log"
  mkdir -p "$bin" "$home"
  cat > "$bin/pacman" <<'STUB'
#!/usr/bin/env bash
case " $* " in
  *' -Qtdq '*) exit 1 ;;
  *' -Qq '*) exit 0 ;;
  *' -Scc '*|*' -Sc '*) exit 1 ;;
  *) exit 0 ;;
esac
STUB
  cat > "$bin/paru" <<'STUB'
#!/usr/bin/env bash
case " $* " in
  *' -Sc '*|*' -Scc '*) exit 1 ;;
  *) exit 0 ;;
esac
STUB
  cp "$bin/paru" "$bin/yay"
  cat > "$bin/snapper" <<'STUB'
#!/usr/bin/env bash
case " $* " in
  *' list-configs '*) printf 'config\037subvolume\nroot\037/\nhome\037/home\n' ;;
  *' list --columns number,description '*) printf 'number\037description\n0\037current\n9\037quicksave\n' ;;
  *' delete '*) printf 'delete %s\n' "$*" >> "$CLEAN_TEST_LOG" ;;
  *' cleanup '*) exit 0 ;;
esac
STUB
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *' -rn -t btrfs -o SOURCE '* ]]; then
  printf '/dev/test[/@]\n/dev/test[/@home]\n'
elif [[ " $* " == *' FSTYPE '* ]]; then
  printf 'btrfs\n'
else
  printf '/dev/test[/@]\n'
fi
STUB
  cat > "$bin/find" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *'_backup_[0-9]{17}'* ]]; then
  printf '%s\0' "$CLEAN_CANDIDATE"
  exit 0
fi
for arg in "$@"; do
  [[ "$arg" == '-fprint0' ]] && { printf 'protected_regular simulation\n' >&2; exit 13; }
done
exec /usr/bin/find "$@"
STUB
  cat > "$bin/sudo" <<'STUB'
#!/usr/bin/env bash
[[ "${1:-}" == '-v' ]] && exit 0
[[ "${1:-}" == '-n' ]] && shift
case "${1:-}" in
  mount|umount) exit 0 ;;
esac
exec "$@"
STUB
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$bin/flatpak"
  cat > "$bin/btrfs" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *' subvolume show '* ]]; then exit 0; fi
if [[ " $* " == *' subvolume delete '* ]]; then
  printf 'btrfs-delete %s\n' "$*" >> "$CLEAN_TEST_LOG"
fi
exit 0
STUB
  chmod +x "$bin"/*

  local external_cache="$TMP_DIR/clean-external-cache"
  mkdir -p "$home/.cache/yay" "$home/.cache" "$external_cache/clone"
  printf 'hidden cache\n' > "$home/.cache/yay/.hidden"
  printf 'must survive\n' > "$external_cache/clone/sentinel"
  ln -s "$external_cache" "$home/.cache/paru"
  local output status=0 output_file="$TMP_DIR/clean.out"
  CLEAN_TEST_LOG="$log" CLEAN_CANDIDATE=/tmp/@_backup_20260728010203045 \
    HOME="$home" PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/clean.lock" \
    timeout 15s "$ROOT/clean" all --yes > "$output_file" 2>&1 || status=$?
  output="$(< "$output_file")"
  [[ "$status" -eq 1 ]] || fail 'clean must return nonzero when one or more steps fail'
  assert_contains "$output" '至少一个步骤失败' 'clean reports partial failure in final summary'
  assert_contains "$(< "$log")" 'delete' 'clean parses CSV snapshots and attempts selected deletion'
  assert_contains "$output" '已全部保留' \
    'clean must retain backup-like subvolumes without trusted provenance'
  [[ "$(< "$log")" != *'btrfs-delete '* ]] \
    || fail 'clean must not delete a subvolume based only on its backup-like name'
  [[ "$output" != *'无法枚举 Btrfs 顶级备份子卷'* ]] \
    || fail 'clean must not use root -fprint0 on a user-owned /tmp file'
  [[ ! -e "$home/.cache/yay/.hidden" ]] \
    || fail 'deep clean must remove hidden AUR cache entries as well as visible entries'
  [[ "$(< "$external_cache/clone/sentinel")" == 'must survive' ]] \
    || fail 'deep clean must not follow an AUR cache symlink outside the cache root'
  assert_contains "$output" '拒绝清理越界或符号链接缓存目录' \
    'deep clean explains why a symlinked AUR cache was retained'
  local lock_rc=0
  ROOT="$ROOT" MAINTENANCE_LOCK_FILE="$TMP_DIR/clean.lock" bash -c '
    source "$ROOT/lib/ui.sh"
    unset MAINTENANCE_LOCK_HELD UI_MAINTENANCE_LOCK_FD
    ui_maintenance_lock_acquire after-clean
  ' >/dev/null 2>&1 || lock_rc=$?
  [[ "$lock_rc" -eq 0 ]] || fail 'clean must release maintenance lock immediately on exit'
  pass 'clean uses CSV snapshots and propagates partial failure'
}

test_cache_clean_scope() {
  local home="$TMP_DIR/cache-home"
  mkdir -p \
    "$home/.cache/go-build" "$home/.cache/pip" "$home/.cache/opencode" \
    "$home/.cache/paru-ui" "$home/.cache/google-chrome" \
    "$home/.config/google-chrome/Default/Code Cache" \
    "$home/.local/share/opencode"
  printf delete > "$home/.cache/go-build/item"
  printf delete > "$home/.cache/pip/item"
  printf delete > "$home/.cache/opencode/item"
  printf delete > "$home/.cache/paru-ui/item"
  printf delete > "$home/.cache/google-chrome/item"
  printf delete > "$home/.config/google-chrome/Default/Code Cache/item"
  printf keep > "$home/.local/share/opencode/opencode.db"

  HOME="$home" MAINTENANCE_LOCK_FILE="$TMP_DIR/cache-clean.lock" \
    "$ROOT/cache-clean" --safe --chrome -y >/dev/null
  [[ ! -e "$home/.cache/go-build/item" && ! -e "$home/.cache/google-chrome/item" ]] \
    || fail 'cache clean must remove declared cache targets'
  [[ -f "$home/.local/share/opencode/opencode.db" ]] \
    || fail 'cache clean must preserve opencode state database'
  pass 'cache clean removes only declared cache scope'
}

test_cache_clean_partial_failure_status() {
  local bin="$TMP_DIR/cache-fail-bin"
  local home="$TMP_DIR/cache-fail-home"
  mkdir -p "$bin" "$home/.cache/go-build" "$home/.cache/pip"
  printf keep > "$home/.cache/go-build/item"
  printf delete > "$home/.cache/pip/item"
  cat > "$bin/find" <<'STUB'
#!/usr/bin/env bash
if [[ "${1:-}" == "$CACHE_FAIL_PATH" && " $* " == *' -exec rm '* ]]; then exit 1; fi
exec /usr/bin/find "$@"
STUB
  chmod +x "$bin/find"
  local status=0
  CACHE_FAIL_PATH="$home/.cache/go-build" HOME="$home" PATH="$bin:$PATH" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/cache-fail.lock" \
    "$ROOT/cache-clean" --safe -y >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 0 ]] || fail 'cache clean must return nonzero after a partial deletion failure'
  [[ ! -e "$home/.cache/pip/item" ]] || fail 'cache clean must continue with later targets after one failure'
  pass 'cache clean reports partial failures and continues independent targets'
}

test_snapper_csv_discovery() {
  local bin="$TMP_DIR/bin"
  mkdir -p "$bin"
  printf '%s\n' '#!/usr/bin/env bash' \
    'if [[ " $* " == *" list-configs "* ]]; then' \
    "  printf 'config\\037subvolume\\nroot\\037/\\nhome\\037/home\\n'" \
    'fi' > "$bin/snapper"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$bin/btrfs"
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$bin/btrfs-assistant"
  printf '%s\n' '#!/usr/bin/env bash' \
    'if [[ " $* " == *" FSTYPE "* ]]; then printf "btrfs\\n"; else printf "/dev/test[/@]\\n"; fi' > "$bin/findmnt"
  chmod +x "$bin"/*

  local save_out load_out
  save_out="$(PATH="$bin:$PATH" "$ROOT/quicksave" -lc | sort)"
  load_out="$(PATH="$bin:$PATH" "$ROOT/quickload" -lc)"
  [[ "$save_out" == $'home\nroot' ]] || fail 'quicksave must parse CSV configs'
  assert_contains "$load_out" 'root' 'quickload CSV discovery includes root'
  assert_contains "$load_out" 'home' 'quickload CSV discovery includes home'
  pass 'Snapper config discovery uses locale-independent CSV'
}

