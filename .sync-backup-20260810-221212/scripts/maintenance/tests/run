    snapper() { return 5; }
    quicksave() { return 0; }
    show_rc=0
    delete_rc=0
    show_snapshots >/dev/null 2>&1 || show_rc=$?
    delete_snapshot >/dev/null 2>&1 || delete_rc=$?
    [[ "$show_rc" -ne 0 && "$delete_rc" -ne 0 ]]
  ' || fail 'term-menu snapshot views must propagate Snapper query failures'
  pass 'term-menu snapshot query failures cannot become empty healthy lists'
}

test_backup_restore_plan_and_apply_guards() {
  local bin="$TMP_DIR/restore-bin"
  local home="$TMP_DIR/restore-home"
  local target="$TMP_DIR/restore-target"
  local dest="$target/maintenance-backup-fixture"
  local set_dir="$dest/set-20260727-010203-42"
  local migration="$set_dir/migration"
  local migration_payload="$TMP_DIR/restore-migration-payload"
  local home_payload="$TMP_DIR/restore-home-payload"
  local plan="$TMP_DIR/restore-plan"
  local plan_apply="$TMP_DIR/restore-plan-apply"
  local rsync_log="$TMP_DIR/restore-rsync.log"
  mkdir -p "$bin" "$home/.config" "$migration" "$migration_payload" \
    "$home_payload/.config" "$dest"
  printf 'current\n' > "$home/.config/app.conf"
  printf 'backup\n' > "$home_payload/.config/app.conf"
  printf 'new\n' > "$home_payload/new.txt"
  printf 'config\n' > "$migration_payload/config.txt"
  tar -czf "$migration/pang-arch-configs.tar.gz" -C "$migration_payload" config.txt
  printf 'bash\nnano\n' > "$migration/pkglist-explicit.txt"
  printf 'aur-fixture\n' > "$migration/pkglist-foreign.txt"
  printf 'fixture.service enabled disabled\n' > "$migration/system-enabled-units.txt"
  printf 'fixture-user.service enabled disabled\n' > "$migration/user-enabled-units.txt"
  printf 'config.txt\n' > "$migration/tar-manifest.txt"
  printf 'migration-pack v1\n' > "$migration/.migration-pack-owned"
  (
    cd "$migration"
    sha256sum pang-arch-configs.tar.gz pkglist-explicit.txt pkglist-foreign.txt \
      system-enabled-units.txt user-enabled-units.txt tar-manifest.txt > SHA256SUMS
  )
  tar --zstd -cf "$set_dir/home.tar.zst" -C "$home_payload" .
  (cd "$set_dir" && sha256sum home.tar.zst > home.tar.zst.sha256)
  printf 'offsite-backup v2\n' > "$dest/.offsite-backup-owned"
  ln -s "$(basename "$set_dir")" "$dest/latest"

  cat > "$bin/pacman" <<'STUB'
#!/usr/bin/env bash
[[ " $* " == *' -Qq '* ]] && { printf 'bash\n'; exit 0; }
exit 0
STUB
  cat > "$bin/systemctl" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
  chmod +x "$bin"/*

  HOME="$home" PATH="$bin:$PATH" "$ROOT/backup-restore" \
    --source "$target" --set latest --output "$plan" >/dev/null
  [[ "$(< "$home/.config/app.conf")" == 'current' ]] \
    || fail 'backup restore preview must not modify HOME'
  assert_contains "$(< "$plan/packages-official.txt")" 'nano' \
    'restore plan lists missing official packages'
  assert_contains "$(< "$plan/packages-foreign.txt")" 'aur-fixture' \
    'restore plan lists missing foreign packages'
  assert_contains "$(< "$plan/services-system.txt")" 'fixture.service' \
    'restore plan lists system services for manual review'

  local standalone_plan="$TMP_DIR/restore-standalone-plan"
  HOME="$home" PATH="$bin:$PATH" "$ROOT/backup-restore" \
    --source "$migration" --output "$standalone_plan" >/dev/null
  [[ ! -e "$home/config.txt" && -s "$standalone_plan/home-changes.txt" ]] \
    || fail 'standalone migration restore must preview without modifying HOME'

  printf 'damage\n' >> "$set_dir/home.tar.zst"
  local corrupt_rc=0
  HOME="$home" PATH="$bin:$PATH" "$ROOT/backup-restore" \
    --source "$target" --set latest --output "$TMP_DIR/corrupt-plan" \
    >/dev/null 2>&1 || corrupt_rc=$?
  [[ "$corrupt_rc" -ne 0 ]] || fail 'backup restore must reject a corrupt HOME archive'
  tar --zstd -cf "$set_dir/home.tar.zst" -C "$home_payload" .
  (cd "$set_dir" && sha256sum home.tar.zst > home.tar.zst.sha256)

  cat > "$bin/rsync" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$RESTORE_RSYNC_LOG"
if [[ " $* " == *' --dry-run '* ]]; then
  printf '>f+++++++++ .config/app.conf\n>f+++++++++ new.txt\n'
  exit 0
fi
src="${@: -2:1}"
dst="${@: -1}"
cp -a -- "$src/." "$dst/"
STUB
  chmod +x "$bin/rsync"
  HOME="$home" PATH="$bin:$PATH" RESTORE_RSYNC_LOG="$rsync_log" \
    MAINTENANCE_LOCK_FILE="$TMP_DIR/restore.lock" "$ROOT/backup-restore" \
    --source "$target" --set latest --output "$plan_apply" --apply-home --yes >/dev/null
  [[ "$(< "$home/.config/app.conf")" == 'backup' ]] \
    || fail 'explicit HOME restore applies the staged backup'
  assert_contains "$(< "$rsync_log")" '--backup-dir=' \
    'HOME restore asks rsync to retain overwritten files'
  pass 'backup restore verifies, previews and guards explicit HOME application'
}

test_btrfs_scrub_management() {
  local bin="$TMP_DIR/scrub-bin"
  local btrfs_log="$TMP_DIR/scrub-btrfs.log"
  local systemctl_log="$TMP_DIR/scrub-systemctl.log"
  mkdir -p "$bin"
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
[[ "${SCRUB_FINDMNT_FAIL:-0}" == '1' ]] && { printf 'findmnt fixture failed\n' >&2; exit 9; }
if [[ " $* " == *' -rn -t btrfs -o TARGET,SOURCE '* ]]; then
  printf '/ /dev/test[/@]\n/home /dev/test[/@home]\n'
elif [[ " $* " == *' FSTYPE '* ]]; then
  printf 'btrfs\n'
elif [[ " $* " == *' TARGET '* ]]; then
  printf '/\n'
fi
STUB
  cat > "$bin/btrfs" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$SCRUB_BTRFS_LOG"
if [[ "${SCRUB_REQUIRE_SUDO:-0}" == '1' && "${SCRUB_PRIVILEGED:-0}" != '1' \
      && " $* " == *' scrub status '* ]]; then
  printf 'WARNING: failed to open status file: Permission denied\n' >&2
  exit 1
fi
if [[ " $* " == *' device stats '* ]]; then
  printf '[/dev/test].write_io_errs 0\n'
else
  printf 'UUID: fixture\n\tno stats available\nread_errors: 0\ncsum_errors: 0\n'
fi
STUB
  cat > "$bin/systemctl" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$SCRUB_SYSTEMCTL_LOG"
case "${1:-}" in
  is-enabled)
    if [[ "${SCRUB_TIMER_STATE:-disabled}" == 'enabled' ]]; then
      printf 'enabled\n'; exit 0
    fi
    printf 'disabled\n'; exit 1
    ;;
  is-active)
    if [[ "${SCRUB_SERVICE_STATE:-inactive}" == 'failed' ]]; then
      printf 'failed\n'; exit 3
    fi
    printf 'inactive\n'; exit 3
    ;;
  show) printf 'success\n' ;;
esac
STUB
  cat > "$bin/systemd-escape" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' '-'
STUB
  cat > "$bin/sudo" <<'STUB'
#!/usr/bin/env bash
[[ -n "${SCRUB_SUDO_LOG:-}" ]] && printf '%s\n' "$*" >> "$SCRUB_SUDO_LOG"
[[ "${1:-}" == '-n' ]] && shift
SCRUB_PRIVILEGED=1 exec "$@"
STUB
  chmod +x "$bin"/*

  SCRUB_BTRFS_LOG="$btrfs_log" SCRUB_SYSTEMCTL_LOG="$systemctl_log" \
    PATH="$bin:$PATH" "$ROOT/btrfs-scrub" --status >/dev/null
  [[ "$(grep -c '^device stats ' "$btrfs_log")" -eq 1 ]] \
    || fail 'scrub status must deduplicate subvolumes on the same device'
  local strict_rc=0
  SCRUB_BTRFS_LOG="$btrfs_log" SCRUB_SYSTEMCTL_LOG="$systemctl_log" \
    PATH="$bin:$PATH" "$ROOT/btrfs-scrub" --status --strict >/dev/null || strict_rc=$?
  [[ "$strict_rc" -ne 0 ]] || fail 'scrub strict status must expose missing timer/results'

  local first_run_output
  first_run_output="$(SCRUB_TIMER_STATE=enabled SCRUB_BTRFS_LOG="$btrfs_log" \
    SCRUB_SYSTEMCTL_LOG="$systemctl_log" PATH="$bin:$PATH" \
    "$ROOT/btrfs-scrub" --status --strict 2>&1)" \
    || fail 'first scrub pending state must be healthy when the timer is enabled'
  assert_contains "$first_run_output" '当前不是故障' \
    'first scrub pending state must be explained as informational'

  local sudo_log="$TMP_DIR/scrub-sudo.log"
  : > "$sudo_log"
  SCRUB_REQUIRE_SUDO=1 SCRUB_TIMER_STATE=enabled SCRUB_BTRFS_LOG="$btrfs_log" \
    SCRUB_SYSTEMCTL_LOG="$systemctl_log" SCRUB_SUDO_LOG="$sudo_log" PATH="$bin:$PATH" \
    "$ROOT/btrfs-scrub" --status --strict >/dev/null \
    || fail 'scrub status must use cached read-only sudo when status files require it'
  assert_contains "$(< "$sudo_log")" 'btrfs scrub status' \
    'scrub status invokes btrfs through read-only sudo when needed'

  local failed_service_rc=0 findmnt_failure_rc=0 findmnt_failure_output
  SCRUB_TIMER_STATE=enabled SCRUB_SERVICE_STATE=failed SCRUB_BTRFS_LOG="$btrfs_log" \
    SCRUB_SYSTEMCTL_LOG="$systemctl_log" PATH="$bin:$PATH" \
    "$ROOT/btrfs-scrub" --status --strict >/dev/null || failed_service_rc=$?
  [[ "$failed_service_rc" -ne 0 ]] \
    || fail 'failed scrub service state must fail strict health status'
  findmnt_failure_output="$(SCRUB_FINDMNT_FAIL=1 SCRUB_BTRFS_LOG="$btrfs_log" \
    SCRUB_SYSTEMCTL_LOG="$systemctl_log" PATH="$bin:$PATH" \
    "$ROOT/btrfs-scrub" --status 2>&1)" || findmnt_failure_rc=$?
  [[ "$findmnt_failure_rc" -ne 0 ]] || fail 'scrub discovery must fail when findmnt fails'
  assert_contains "$findmnt_failure_output" 'Btrfs 挂载查询失败' \
    'scrub discovery must distinguish findmnt failure from no Btrfs mounts'

  local no_yes_rc=0
  SCRUB_BTRFS_LOG="$btrfs_log" SCRUB_SYSTEMCTL_LOG="$systemctl_log" \
    PATH="$bin:$PATH" MAINTENANCE_LOCK_FILE="$TMP_DIR/scrub-no-yes.lock" \
    "$ROOT/btrfs-scrub" --enable / >/dev/null 2>&1 || no_yes_rc=$?
  [[ "$no_yes_rc" -eq 2 ]] \
    || fail 'non-interactive scrub mutation must require explicit --yes'

  SCRUB_BTRFS_LOG="$btrfs_log" SCRUB_SYSTEMCTL_LOG="$systemctl_log" \
    PATH="$bin:$PATH" MAINTENANCE_LOCK_FILE="$TMP_DIR/scrub.lock" \
    "$ROOT/btrfs-scrub" --enable / --yes >/dev/null
  assert_contains "$(< "$systemctl_log")" 'enable --now btrfs-scrub@-.timer' \
    'scrub manager enables the escaped root timer unit'
  pass 'Btrfs scrub status deduplicates filesystems and guards timer changes'
}

test_storage_health_strict_status() {
  local bin="$TMP_DIR/storage-bin"
  mkdir -p "$bin"
  cat > "$bin/lsblk" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' '{"blockdevices":[{"path":"/dev/test","type":"disk","model":"Fixture SSD","size":536870912000}]}'
STUB
  cat > "$bin/smartctl" <<'STUB'
#!/usr/bin/env bash
printf '{"smartctl":{"exit_status":0},"model_name":"Fixture SSD","serial_number":"TEST1","smart_status":{"passed":true},"temperature":{"current":40},"power_on_time":{"hours":100},"nvme_smart_health_information_log":{"percentage_used":10,"media_errors":%s,"critical_warning":0}}\n' "${SMART_MEDIA_ERRORS:-0}"
STUB
  cat > "$bin/sudo" <<'STUB'
#!/usr/bin/env bash
[[ -n "${STORAGE_SUDO_LOG:-}" ]] && printf '%s\n' "$*" >> "$STORAGE_SUDO_LOG"
if [[ "${1:-}" == '-n' ]]; then
  shift
  [[ "${1:-}" == 'true' ]] && exit 0
fi
exec "$@"
STUB
  cat > "$bin/df" <<'STUB'
#!/usr/bin/env bash
printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/test 1000 500 500 50%% /\n'
STUB
  cat > "$bin/findmnt" <<'STUB'
#!/usr/bin/env bash
[[ "${STORAGE_FINDMNT_FAIL:-0}" == '1' ]] && { printf 'findmnt failed\n' >&2; exit 9; }
printf '/ /dev/testp1[/@]\n/home /dev/testp1[/@home]\n'
STUB
  cat > "$bin/btrfs" <<'STUB'
#!/usr/bin/env bash
if [[ " $* " == *' device stats '* ]]; then
  printf '[/dev/testp1].write_io_errs 0\n[/dev/testp1].corruption_errs 0\n'
else
  printf 'UUID: fixture\ndata_bytes_scrubbed: 1024\nread_errors: 0\ncsum_errors: 0\nverify_errors: 0\nuncorrectable_errors: 0\n'
fi
STUB
  cat > "$bin/systemd-escape" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' '-'
STUB
  cat > "$bin/systemctl" <<'STUB'
#!/usr/bin/env bash
[[ "${STORAGE_TIMER_FAIL:-0}" == '1' ]] \
  && { printf 'systemd query failed\n' >&2; exit 5; }
printf 'enabled\n'
STUB
  chmod +x "$bin"/*

  local sudo_log="$TMP_DIR/storage-sudo.log"
  : > "$sudo_log"
  SMART_MEDIA_ERRORS=0 STORAGE_SUDO_LOG="$sudo_log" PATH="$bin:$PATH" \
    "$ROOT/storage-health" --strict >/dev/null \
    || fail 'healthy storage fixture must pass strict mode'
  assert_contains "$(< "$sudo_log")" 'btrfs scrub status' \
    'storage health must use cached read-only sudo for scrub history status'
  local unhealthy_rc=0 output
  output="$(SMART_MEDIA_ERRORS=2 PATH="$bin:$PATH" "$ROOT/storage-health" --strict 2>&1)" \
    || unhealthy_rc=$?
  [[ "$unhealthy_rc" -ne 0 ]] || fail 'SMART media errors must fail storage strict mode'
  assert_contains "$output" '介质/数据完整性错误: 2' \
    'storage health reports the SMART media error count'
  local findmnt_rc=0
  SMART_MEDIA_ERRORS=0 STORAGE_FINDMNT_FAIL=1 PATH="$bin:$PATH" \
    "$ROOT/storage-health" --strict >/dev/null 2>&1 || findmnt_rc=$?
  [[ "$findmnt_rc" -ne 0 ]] \
    || fail 'storage strict mode must expose Btrfs mount query failures'
  local timer_rc=0 timer_output
  timer_output="$(SMART_MEDIA_ERRORS=0 STORAGE_TIMER_FAIL=1 PATH="$bin:$PATH" \
    "$ROOT/storage-health" --strict 2>&1)" || timer_rc=$?
  [[ "$timer_rc" -ne 0 ]] || fail 'storage strict mode must expose scrub timer query failures'
  assert_contains "$timer_output" 'scrub timer 状态查询失败（退出码 5）' \
    'storage health must not misreport a failed timer query as simply disabled'
  pass 'storage health distinguishes healthy disks from SMART media errors'
}

test_terminal_tools_lifecycle() {
  local home="$TMP_DIR/terminal-tools-home"
  local config_home="$TMP_DIR/terminal-tools-config"
  local state_home="$TMP_DIR/terminal-tools-state"
  local fish_config="$config_home/fish/config.fish"
  local git_config="$TMP_DIR/terminal-tools.gitconfig"
  local marker_count
  mkdir -p "$home" "$(dirname "$fish_config")" "$state_home"
  printf '# existing Fish configuration\nset -gx TERMINAL_TOOLS_TEST keep\n' > "$fish_config"

  HOME="$home" GIT_CONFIG_GLOBAL="$git_config" git config --global core.pager less
  HOME="$home" GIT_CONFIG_GLOBAL="$git_config" git config --global delta.navigate false

  HOME="$home" XDG_CONFIG_HOME="$config_home" XDG_STATE_HOME="$state_home" \
    GIT_CONFIG_GLOBAL="$git_config" "$ROOT/terminal-tools" --enable >/dev/null
  fish -n "$fish_config" || fail 'terminal-tools must keep Fish config syntactically valid'
  assert_contains "$(< "$fish_config")" 'set -gx TERMINAL_TOOLS_TEST keep' \
    'terminal-tools must preserve existing Fish configuration'
  assert_contains "$(< "$fish_config")" '# >>> maintenance terminal-tools >>>' \
    'terminal-tools enable must add a managed Fish block'
  [[ "$(HOME="$home" GIT_CONFIG_GLOBAL="$git_config" git config --global --get core.pager)" == delta ]] \
    || fail 'terminal-tools must enable delta as Git pager'
  [[ "$(HOME="$home" GIT_CONFIG_GLOBAL="$git_config" git config --global --get delta.navigate)" == true ]] \
    || fail 'terminal-tools must enable delta navigation'
  [[ -f "$state_home/maintenance/terminal-tools-git-before.tsv" ]] \
    || fail 'terminal-tools must preserve old Git settings before applying changes'

  HOME="$home" XDG_CONFIG_HOME="$config_home" XDG_STATE_HOME="$state_home" \
    GIT_CONFIG_GLOBAL="$git_config" "$ROOT/terminal-tools" --enable >/dev/null
  marker_count="$(grep -Fxc '# >>> maintenance terminal-tools >>>' "$fish_config")"
  [[ "$marker_count" == 1 ]] || fail 'terminal-tools enable must be idempotent'

  HOME="$home" XDG_CONFIG_HOME="$config_home" XDG_STATE_HOME="$state_home" \
    GIT_CONFIG_GLOBAL="$git_config" "$ROOT/terminal-tools" --disable >/dev/null
  fish -n "$fish_config" || fail 'terminal-tools disable must keep Fish config syntactically valid'
  [[ ! -e "$state_home/maintenance/terminal-tools-git-before.tsv" ]] \
    || fail 'terminal-tools must remove its state file after a successful restoration'
  ! grep -Fq '# >>> maintenance terminal-tools >>>' "$fish_config" \
    || fail 'terminal-tools disable must remove only its managed Fish block'
  assert_contains "$(< "$fish_config")" 'set -gx TERMINAL_TOOLS_TEST keep' \
    'terminal-tools disable must preserve user Fish configuration'
  [[ "$(HOME="$home" GIT_CONFIG_GLOBAL="$git_config" git config --global --get core.pager)" == less ]] \
    || fail 'terminal-tools disable must restore the old Git pager'
  [[ "$(HOME="$home" GIT_CONFIG_GLOBAL="$git_config" git config --global --get delta.navigate)" == false ]] \
    || fail 'terminal-tools disable must restore the old delta setting'
  local unset_rc=0
  HOME="$home" GIT_CONFIG_GLOBAL="$git_config" git config --global --get delta.side-by-side >/dev/null 2>&1 \
    || unset_rc=$?
  [[ "$unset_rc" -ne 0 ]] || fail 'terminal-tools disable must remove settings that did not exist before enable'
  pass 'terminal tools integration is idempotent and restores prior Fish/Git state'
}

test_cli_argument_contracts() {
  local scripts=(
    backup-restore boot-check btrfs-scrub cache-clean checkallupdates check-battery
    clean gpu-check hw-doctor log-check migration-pack mirror-update offsite-backup
    offsite-backup-schedule pacnew-check post-update-check quickload quicksave
    recommend-check storage-health sysup terminal-tools term-menu
  )
  local script rc
  for script in "${scripts[@]}"; do
    "$ROOT/$script" --help >/dev/null 2>&1 || fail "$script --help must return zero"
  done
  for script in "${scripts[@]}"; do
    rc=0
    "$ROOT/$script" --definitely-invalid >/dev/null 2>&1 || rc=$?
    [[ "$rc" -ne 0 ]] || fail "$script must reject unknown options"
  done
  local single_option_scripts=(
    boot-check checkallupdates check-battery gpu-check hw-doctor log-check
    pacnew-check recommend-check storage-health terminal-tools
  )
  for script in "${single_option_scripts[@]}"; do
    rc=0
    "$ROOT/$script" --help --definitely-invalid >/dev/null 2>&1 || rc=$?
    [[ "$rc" -ne 0 ]] || fail "$script must reject trailing arguments"
  done
  rc=0
  "$ROOT/migration-pack" --check "$TMP_DIR" extra >/dev/null 2>&1 || rc=$?
  [[ "$rc" -ne 0 ]] || fail 'migration-pack must reject extra paths'
  pass 'all CLI entrypoints have help and reject unknown options'
}

test_audit_mode_suppresses_notifications() {
  local bin="$TMP_DIR/notify-bin"
  local log="$TMP_DIR/notify.log"
  mkdir -p "$bin"
  cat > "$bin/notify-send" <<'STUB'
#!/usr/bin/env bash
printf 'notify\n' >> "$NOTIFY_TEST_LOG"
STUB
  chmod +x "$bin/notify-send"
  NOTIFY_TEST_LOG="$log" PATH="$bin:$PATH" MAINTENANCE_NO_NOTIFY=1 \
    "$ROOT/quicksave" --definitely-invalid >/dev/null 2>&1 || true
  NOTIFY_TEST_LOG="$log" PATH="$bin:$PATH" MAINTENANCE_NO_NOTIFY=1 \
    "$ROOT/quickload" --definitely-invalid >/dev/null 2>&1 || true
  [[ ! -s "$log" ]] || fail 'audit mode must not emit desktop notifications'
  pass 'audit mode suppresses quicksave/quickload desktop notifications'
}

