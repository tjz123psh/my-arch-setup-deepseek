    ui_maintenance_lock_acquire after-term-delete
  ' >/dev/null 2>&1 || rc=$?
  [[ "$rc" -eq 0 ]] || fail 'term-menu snapshot deletion must release its parent lock'
  pass 'term-menu snapshot deletion releases parent lock'
}

