#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SELF")"
# shellcheck source=lib/ui.sh
. "$SCRIPT_DIR/lib/ui.sh"
# shellcheck source=lib/config.sh
. "$SCRIPT_DIR/lib/config.sh"
maintenance_config_load || exit 2

ACTION=""
TARGET="$(maintenance_config_get BACKUP_TARGET "" MAINTENANCE_BACKUP_TARGET)"
KEEP="$(maintenance_config_get BACKUP_KEEP 3 MAINTENANCE_BACKUP_KEEP)"
CALENDAR="$(maintenance_config_get BACKUP_ON_CALENDAR weekly MAINTENANCE_BACKUP_ON_CALENDAR)"
RANDOM_DELAY="$(maintenance_config_get BACKUP_RANDOM_DELAY 1h MAINTENANCE_BACKUP_RANDOM_DELAY)"
ASSUME_YES=0
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
SERVICE_NAME="maintenance-offsite-backup.service"
TIMER_NAME="maintenance-offsite-backup.timer"
SERVICE_FILE="$UNIT_DIR/$SERVICE_NAME"
TIMER_FILE="$UNIT_DIR/$TIMER_NAME"
BACKUP_CMD="${OFFSITE_BACKUP_CMD:-$SCRIPT_DIR/offsite-backup}"
UNIT_MARKER="# Managed by offsite-backup-schedule v1"
UNIT_STAGE_DIR=""
UNIT_SERVICE_TMP=""
UNIT_TIMER_TMP=""
UNIT_SERVICE_OLD=""
UNIT_TIMER_OLD=""
UNIT_PUBLISH_STARTED=0
UNIT_ACTIVATION_COMPLETE=0
UNIT_PREV_ENABLED=""
UNIT_PREV_ACTIVE=""

cancel_status() {
  if [[ "${TERM_MENU_CHILD:-0}" == "1" ]]; then
    printf '130'
  else
    printf '0'
  fi
}

usage() {
  cat <<'EOF'
用法: offsite-backup-schedule [操作] [选项]

  --status               查看 user timer、服务和最近日志
  --install              校验目标并安装/更新 user service 与 timer
  --remove               禁用并删除本工具生成的 user units
  --run                  立即请求 systemd 运行一次服务
  --target DIR           覆盖配置中的异盘目标
  --keep N               覆盖备份保留代数
  --calendar SPEC        systemd OnCalendar，默认 weekly
  --random-delay SPAN    随机延迟，默认 1h
  --yes                  非交互 install/remove 跳过关键词确认

服务仅在安装时记录的目标挂载点当前仍是挂载点时运行，不会自动挂载磁盘。
EOF
}

set_action() {
  local requested="$1"
  [[ -z "$ACTION" || "$ACTION" == "$requested" ]] \
    || { ui_err "一次只能指定一个操作"; exit 2; }
  ACTION="$requested"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status) set_action status; shift ;;
    --install) set_action install; shift ;;
    --remove) set_action remove; shift ;;
    --run) set_action run; shift ;;
    --target) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; TARGET="$2"; shift 2 ;;
    --keep) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; KEEP="$2"; shift 2 ;;
    --calendar) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; CALENDAR="$2"; shift 2 ;;
    --random-delay) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; RANDOM_DELAY="$2"; shift 2 ;;
    --yes) ASSUME_YES=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) ui_err "未知参数: %s" "$1"; usage >&2; exit 2 ;;
  esac
done

[[ "$KEEP" =~ ^[1-9][0-9]*$ ]] || { ui_err "--keep 必须是正整数"; exit 2; }
[[ -n "$CALENDAR" && "$CALENDAR" != *$'\n'* && "$CALENDAR" != *$'\r'* ]] \
  || { ui_err "--calendar 不能为空或包含换行"; exit 2; }
[[ "$RANDOM_DELAY" =~ ^[0-9]+(s|min|h|d|w)$ ]] \
  || { ui_err "--random-delay 格式无效，例如 1h"; exit 2; }

systemd_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//%/%%}"
  printf '"%s"' "$value"
}

systemd_condition_path() {
  local value="$1"
  value="${value//\\/\\x5c}"
  value="${value//%/%%}"
  value="${value// /\\x20}"
  value="${value//$'\t'/\\x09}"
  value="${value//\"/\\x22}"
  printf '%s' "$value"
}

confirm_change() {
  local prompt="$1" word="$2"
  [[ "$ASSUME_YES" -eq 1 ]] && return 0
  [[ -t 0 ]] || { ui_err "非交互修改必须指定 --yes"; return 2; }
  ui_confirm_word "$prompt" "$word"
}

unit_owned() {
  local file="$1"
  [[ -f "$file" ]] && grep -Fxq "$UNIT_MARKER" "$file" 2>/dev/null
}

print_unit_status() {
  local unit="$1" output="" status_rc=0 probe="" probe_rc=0
  output="$(systemctl --user status "$unit" --no-pager 2>&1)" || status_rc=$?
  [[ -z "$output" ]] || printf '%s\n' "$output"
  if [[ "$status_rc" -eq 0 || "$status_rc" -eq 3 ]]; then
    return 0
  fi

  probe="$(systemctl --user show "$unit" --property=LoadState --value 2>&1)" \
    || probe_rc=$?
  if [[ "$probe_rc" -ne 0 || -z "$probe" ]]; then
    ui_err "无法查询 systemd user unit: %s（退出码 %s）" "$unit" "$status_rc"
    [[ -z "$probe" || "$probe" == "$output" ]] || printf '%s\n' "$probe" >&2
    return 1
  fi
  ui_warn "%s 当前 LoadState=%s（systemctl status 退出码 %s）" \
    "$unit" "$probe" "$status_rc"
}

guard_unit_ownership() {
  local file
  for file in "$SERVICE_FILE" "$TIMER_FILE"; do
    if [[ -e "$file" ]] && ! unit_owned "$file"; then
      ui_err "同名 unit 不是本工具创建，拒绝覆盖或删除: %s" "$file"
      return 1
    fi
  done
}

show_status() {
  local status_failed=0
  ui_banner "定时异盘备份" "offsite-backup-schedule · systemd user timer"
  ui_panel_open "这项功能做什么"
  ui_panel_line "由你的 systemd 用户定时器定期运行异盘 HOME 备份，不需要保持终端打开。"
  ui_panel_line "目标磁盘没有挂载时会安全跳过，不会在系统盘创建同名替代目录。"
  ui_panel_line "备份失败会保留旧的 latest；本工具只管理自己生成的两个 user unit。"
  ui_panel_close
  ui_panel_open "配置"
  ui_panel_kv "目标" "${TARGET:-未配置}"
  ui_panel_kv "保留" "$KEEP 份"
  ui_panel_kv "计划" "$CALENDAR"
  ui_panel_kv "随机延迟" "$RANDOM_DELAY"
  ui_panel_kv "服务文件" "$SERVICE_FILE"
  ui_panel_close
  if [[ ! -f "$SERVICE_FILE" || ! -f "$TIMER_FILE" ]]; then
    ui_warn "定时异盘备份尚未安装。"
    return 0
  fi
  if ! unit_owned "$SERVICE_FILE" || ! unit_owned "$TIMER_FILE"; then
    ui_warn "检测到同名 unit，但它们不是本工具创建；仅显示 systemd 状态。"
  fi
  print_unit_status "$TIMER_NAME" || status_failed=1
  printf '\n'
  print_unit_status "$SERVICE_NAME" || status_failed=1
  printf '\n'
  ui_info "最近日志: journalctl --user -u %s -n 80" "$SERVICE_NAME"
  return "$status_failed"
}

cleanup_unit_staging() {
  local rollback_failed=0
  trap - EXIT
  if [[ -n "$UNIT_SERVICE_TMP" ]] && ! rm -f -- "$UNIT_SERVICE_TMP"; then
    ui_warn "无法删除 service unit 暂存文件: %s" "$UNIT_SERVICE_TMP"
    rollback_failed=1
  fi
  if [[ -n "$UNIT_TIMER_TMP" ]] && ! rm -f -- "$UNIT_TIMER_TMP"; then
    ui_warn "无法删除 timer unit 暂存文件: %s" "$UNIT_TIMER_TMP"
    rollback_failed=1
  fi
  if [[ -n "$UNIT_STAGE_DIR" ]]; then
    rmdir "$UNIT_STAGE_DIR" 2>/dev/null \
      || { [[ ! -d "$UNIT_STAGE_DIR" ]] \
        || { ui_warn "无法删除 unit 暂存目录: %s" "$UNIT_STAGE_DIR"; rollback_failed=1; }; }
  fi
  if [[ "$UNIT_ACTIVATION_COMPLETE" -eq 0 && "$UNIT_PUBLISH_STARTED" -eq 1 ]]; then
    if ! systemctl --user disable --now "$TIMER_NAME" >/dev/null 2>&1; then
      ui_warn "停用未完成激活的新 timer 失败: %s" "$TIMER_NAME"
      rollback_failed=1
    fi
    if [[ -n "$UNIT_SERVICE_OLD" && -f "$UNIT_SERVICE_OLD" ]]; then
      mv -Tf -- "$UNIT_SERVICE_OLD" "$SERVICE_FILE" \
        || { ui_warn "恢复旧 service unit 失败，旧文件保留在: %s" "$UNIT_SERVICE_OLD"; rollback_failed=1; }
    else
      rm -f -- "$SERVICE_FILE" \
        || { ui_warn "删除未激活的 service unit 失败: %s" "$SERVICE_FILE"; rollback_failed=1; }
    fi
    if [[ -n "$UNIT_TIMER_OLD" && -f "$UNIT_TIMER_OLD" ]]; then
      mv -Tf -- "$UNIT_TIMER_OLD" "$TIMER_FILE" \
        || { ui_warn "恢复旧 timer unit 失败，旧文件保留在: %s" "$UNIT_TIMER_OLD"; rollback_failed=1; }
    else
      rm -f -- "$TIMER_FILE" \
        || { ui_warn "删除未激活的 timer unit 失败: %s" "$TIMER_FILE"; rollback_failed=1; }
    fi
    if ! systemctl --user daemon-reload >/dev/null 2>&1; then
      ui_warn "systemd 激活失败后的 unit 文件已回滚，但 daemon-reload 复原失败。"
      rollback_failed=1
    fi
    case "$UNIT_PREV_ENABLED" in
      enabled)
        systemctl --user enable "$TIMER_NAME" >/dev/null 2>&1 \
          || { ui_warn "恢复 timer 的 enabled 状态失败"; rollback_failed=1; }
        ;;
      enabled-runtime)
        systemctl --user enable --runtime "$TIMER_NAME" >/dev/null 2>&1 \
          || { ui_warn "恢复 timer 的 runtime enabled 状态失败"; rollback_failed=1; }
        ;;
    esac
    case "$UNIT_PREV_ACTIVE" in
      active|activating)
        systemctl --user start "$TIMER_NAME" >/dev/null 2>&1 \
          || { ui_warn "恢复 timer 的 active 状态失败"; rollback_failed=1; }
        ;;
    esac
  else
    rm -f -- "$UNIT_SERVICE_OLD" "$UNIT_TIMER_OLD" \
      || { ui_warn "无法删除 unit 旧版本暂存文件"; rollback_failed=1; }
  fi
  [[ "$rollback_failed" -eq 0 ]] \
    || ui_warn "定时备份 unit 未能完整回滚；请按上方保留路径人工复核。"
  UNIT_STAGE_DIR=""
  UNIT_SERVICE_TMP=""
  UNIT_TIMER_TMP=""
  UNIT_SERVICE_OLD=""
  UNIT_TIMER_OLD=""
  UNIT_PUBLISH_STARTED=0
  UNIT_ACTIVATION_COMPLETE=0
  UNIT_PREV_ENABLED=""
  UNIT_PREV_ACTIVE=""
  return 0
}

install_units() {
  local mount_target confirm_rc=0 enabled_rc=0 active_rc=0 verify_output="" verify_status=0
  UNIT_STAGE_DIR=""
  UNIT_SERVICE_TMP=""
  UNIT_TIMER_TMP=""
  UNIT_SERVICE_OLD=""
  UNIT_TIMER_OLD=""
  UNIT_PUBLISH_STARTED=0
  UNIT_ACTIVATION_COMPLETE=0
  UNIT_PREV_ENABLED=""
  UNIT_PREV_ACTIVE=""
  [[ -n "$TARGET" ]] || { ui_err "未配置异盘备份目标"; return 2; }
  [[ "$TARGET" != *$'\n'* && "$TARGET" != *$'\r'* ]] \
    || { ui_err "备份目标不能包含换行"; return 2; }
  [[ -x "$BACKUP_CMD" ]] || { ui_err "offsite-backup 不可执行: %s" "$BACKUP_CMD"; return 127; }
  "$BACKUP_CMD" --target "$TARGET" --validate-target >/dev/null
  mount_target="$(findmnt -no TARGET -T "$TARGET" 2>/dev/null || true)"
  [[ -n "$mount_target" ]] || { ui_err "无法确定备份目标所在挂载点"; return 1; }
  [[ "$mount_target" != "/" ]] \
    || { ui_err "备份目标解析到根文件系统，拒绝安装定时异盘备份"; return 1; }
  guard_unit_ownership || return 1
  UNIT_PREV_ENABLED="$(systemctl --user is-enabled "$TIMER_NAME" 2>&1)" || enabled_rc=$?
  case "$UNIT_PREV_ENABLED" in
    enabled|enabled-runtime|disabled|not-found) ;;
    *)
      ui_err "无法读取现有 timer 启用状态（退出码 %s）: %s" \
        "$enabled_rc" "${UNIT_PREV_ENABLED:-无输出}"
      return 1
      ;;
  esac
  UNIT_PREV_ACTIVE="$(systemctl --user is-active "$TIMER_NAME" 2>&1)" || active_rc=$?
  case "$UNIT_PREV_ACTIVE" in
    active|activating|inactive|failed|deactivating|not-found) ;;
    *)
      ui_err "无法读取现有 timer 运行状态（退出码 %s）: %s" \
        "$active_rc" "${UNIT_PREV_ACTIVE:-无输出}"
      return 1
      ;;
  esac

  confirm_change "将安装每周异盘备份 timer（目标: $TARGET）" "enable backup" \
    || confirm_rc=$?
  if [[ "$confirm_rc" -ne 0 ]]; then
    [[ "$confirm_rc" -eq 1 ]] && { ui_warn "已取消安装"; return "$(cancel_status)"; }
    return "$confirm_rc"
  fi
  ui_maintenance_lock_acquire "安装定时异盘备份" || return $?
  mkdir -p "$UNIT_DIR"
  trap cleanup_unit_staging EXIT
  UNIT_STAGE_DIR="$(mktemp -d "$UNIT_DIR/.offsite-backup-units.XXXXXX")"
  UNIT_SERVICE_TMP="$UNIT_STAGE_DIR/$SERVICE_NAME"
  UNIT_TIMER_TMP="$UNIT_STAGE_DIR/$TIMER_NAME"

  {
    printf '%s\n' "$UNIT_MARKER"
    printf '[Unit]\n'
    printf 'Description=Maintenance offsite HOME backup\n'
    printf 'ConditionPathIsMountPoint=%s\n' "$(systemd_condition_path "$mount_target")"
    printf 'After=local-fs.target\n\n'
    printf '[Service]\n'
    printf 'Type=oneshot\n'
    printf 'TimeoutStartSec=infinity\n'
    printf 'UMask=0077\n'
    printf 'ExecCondition=/usr/bin/mountpoint -q -- %s\n' "$(systemd_quote "$mount_target")"
    printf 'ExecStart=%s --target %s --keep %s\n' \
      "$(systemd_quote "$BACKUP_CMD")" "$(systemd_quote "$TARGET")" "$KEEP"
  } > "$UNIT_SERVICE_TMP"
  {
    printf '%s\n' "$UNIT_MARKER"
    printf '[Unit]\n'
    printf 'Description=Scheduled maintenance offsite backup\n\n'
    printf '[Timer]\n'
    printf 'OnCalendar=%s\n' "$CALENDAR"
    printf 'RandomizedDelaySec=%s\n' "$RANDOM_DELAY"
    printf 'Persistent=true\n'
    printf 'Unit=%s\n\n' "$SERVICE_NAME"
    printf '[Install]\n'
    printf 'WantedBy=timers.target\n'
  } > "$UNIT_TIMER_TMP"
  chmod 600 "$UNIT_SERVICE_TMP" "$UNIT_TIMER_TMP"
  if command -v systemd-analyze >/dev/null 2>&1; then
    verify_output="$(systemd-analyze --user verify "$UNIT_SERVICE_TMP" "$UNIT_TIMER_TMP" 2>&1)" \
      || verify_status=$?
    if [[ "$verify_status" -ne 0 || -n "$verify_output" ]]; then
      ui_err "systemd unit 校验失败或产生警告："
      [[ -z "$verify_output" ]] || printf '%s\n' "$verify_output" >&2
      cleanup_unit_staging
      trap - EXIT
      return 1
    fi
  fi
  if [[ -f "$SERVICE_FILE" ]]; then
    UNIT_SERVICE_OLD="$UNIT_DIR/.${SERVICE_NAME}.old.$$"
    cp -a -- "$SERVICE_FILE" "$UNIT_SERVICE_OLD"
  fi
  if [[ -f "$TIMER_FILE" ]]; then
    UNIT_TIMER_OLD="$UNIT_DIR/.${TIMER_NAME}.old.$$"
    cp -a -- "$TIMER_FILE" "$UNIT_TIMER_OLD"
  fi
  UNIT_PUBLISH_STARTED=1
  if ! mv -Tf -- "$UNIT_SERVICE_TMP" "$SERVICE_FILE" \
      || ! mv -Tf -- "$UNIT_TIMER_TMP" "$TIMER_FILE"; then
    ui_err "发布定时备份 unit 文件失败，正在恢复旧配置。"
    cleanup_unit_staging
    trap - EXIT
    return 1
  fi
  if ! systemctl --user daemon-reload; then
    ui_err "systemd user daemon-reload 失败，正在恢复旧定时任务。"
    cleanup_unit_staging
    trap - EXIT
    return 1
  fi
  if ! systemctl --user enable --now "$TIMER_NAME"; then
    ui_err "启用定时异盘备份失败，正在恢复旧定时任务。"
    cleanup_unit_staging
    trap - EXIT
    return 1
  fi
  UNIT_ACTIVATION_COMPLETE=1
  rm -f -- "$UNIT_SERVICE_OLD" "$UNIT_TIMER_OLD"
  UNIT_SERVICE_OLD=""
  UNIT_TIMER_OLD=""
  rmdir "$UNIT_STAGE_DIR"
  UNIT_STAGE_DIR=""
  UNIT_SERVICE_TMP=""
  UNIT_TIMER_TMP=""
  trap - EXIT
  ui_ok "定时异盘备份已安装: %s" "$TIMER_NAME"
  ui_info "目标未挂载时服务会被跳过；不会创建同盘替代目录。"
}

remove_units() {
  local confirm_rc=0 disable_output=""
  guard_unit_ownership || return 1
  confirm_change "将禁用并删除定时异盘备份 units" "disable backup" || confirm_rc=$?
  if [[ "$confirm_rc" -ne 0 ]]; then
    [[ "$confirm_rc" -eq 1 ]] && { ui_warn "已取消删除"; return "$(cancel_status)"; }
    return "$confirm_rc"
  fi
  ui_maintenance_lock_acquire "删除定时异盘备份" || return $?
  if ! disable_output="$(systemctl --user disable --now "$TIMER_NAME" 2>&1)"; then
    ui_err "无法禁用定时异盘备份；unit 文件保持不变"
    [[ -z "$disable_output" ]] || printf '%s\n' "$disable_output" >&2
    return 1
  fi
  rm -f -- "$SERVICE_FILE" "$TIMER_FILE"
  systemctl --user daemon-reload
  systemctl --user reset-failed "$SERVICE_NAME" >/dev/null 2>&1 || true
  ui_ok "定时异盘备份已删除。"
}

run_now() {
  [[ -f "$SERVICE_FILE" ]] || { ui_err "定时备份服务尚未安装"; return 1; }
  guard_unit_ownership || return 1
  systemctl --user start "$SERVICE_NAME"
  ui_ok "备份服务已完成。"
}

choose_action() {
  local options selected
  options=$'1\t查看状态\tstatus\t显示目标、计划、timer/service 状态，不写文件\n2\t安装/更新\tinstall\t校验异盘目标并启用用户 timer，需要关键词确认\n3\t立即运行\trun\t通过已安装的 service 立即做一次异盘备份\n4\t删除定时器\tremove\t只删除本工具创建的 user units，不删除已有备份\n0\t返回\texit\t不执行任何操作，直接回到上一级菜单'
  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
    selected="$(printf '%s\n' "$options" | fzf --delimiter=$'\t' --with-nth=1,2,4 \
      --height=100% --layout=reverse --border=rounded --border-label=' 定时异盘备份 ' \
      --list-border=rounded --list-label=' 可用操作 ' --preview-border=rounded \
      --preview-label=' 功能说明 ' --preview-window='right,48%,wrap' \
      --preview='printf "\033[1;36m%s\033[0m\n\n%s\n\n\033[2m目标未挂载时安全跳过；已有备份不会因失败被替换。\033[0m\n" {2} {4}' \
      --cycle --header='Enter 执行   ↑↓ 循环移动   Esc 返回' --color="$(ui_fzf_colors)")" || return 130
  else
    printf '%s\n' "$options" | awk -F '\t' '{printf "%s. %s\n", $1, $2}'
    printf '选择操作: '
    read -r selected
    selected="$(awk -F '\t' -v key="$selected" '$1 == key {print; exit}' <<< "$options")"
  fi
  ACTION="$(awk -F '\t' '{print $3}' <<< "$selected")"
  [[ "$ACTION" != "exit" && -n "$ACTION" ]] || return 130
}

if [[ -z "$ACTION" ]]; then
  if [[ -t 0 ]]; then
    choose_rc=0
    choose_action || choose_rc=$?
    if [[ "$choose_rc" -ne 0 ]]; then
      [[ "$choose_rc" -eq 130 ]] && exit "$(cancel_status)"
      exit "$choose_rc"
    fi
  else
    ACTION=status
  fi
fi
case "$ACTION" in
  status) show_status ;;
  install) install_units ;;
  remove) remove_units ;;
  run) run_now ;;
esac
