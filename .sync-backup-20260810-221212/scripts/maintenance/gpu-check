#!/usr/bin/env bash
set -euo pipefail

UI_LIB="$(dirname "$(readlink -f "$0")")/lib/ui.sh"
# shellcheck source=lib/ui.sh
. "$UI_LIB"

have() { command -v "$1" >/dev/null 2>&1; }

_PANEL_OPEN=false
panel() {
  [[ "$_PANEL_OPEN" == true ]] && ui_panel_close
  ui_panel_open "$1" "${2:-}"
  _PANEL_OPEN=true
}
panel_end() {
  [[ "$_PANEL_OPEN" == true ]] && ui_panel_close
  _PANEL_OPEN=false
}

trim_text() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

gl_field() {
  local output="$1" key="$2"
  awk -v key="$key" '
    {
      line=$0
      sub(/^[[:space:]]*/, "", line)
      if (index(line, key ":") == 1) {
        sub(/^[^:]*:[[:space:]]*/, "", line)
        print line
        exit
      }
    }
  ' <<< "$output"
}

show_opengl() {
  local command_label="$1"
  shift
  local output="" rc=0 direct vendor renderer version accelerated

  output="$("$@" 2>&1)" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    ui_panel_stat warn "$command_label 查询失败（退出码 $rc）"
    [[ -z "$output" ]] || printf '%s\n' "$output" | sed -n '1,4p' | ui_panel_raw
    return
  fi
  direct="$(gl_field "$output" "direct rendering")"
  vendor="$(gl_field "$output" "OpenGL vendor string")"
  renderer="$(gl_field "$output" "OpenGL renderer string")"
  version="$(gl_field "$output" "OpenGL core profile version string")"
  [[ -n "$version" ]] || version="$(gl_field "$output" "OpenGL version string")"
  accelerated="$(gl_field "$output" "Accelerated")"

  ui_panel_kv "渲染器" "${renderer:-未报告}"
  [[ -z "$vendor" ]] || ui_panel_kv "驱动供应方" "$vendor"
  [[ -z "$version" ]] || ui_panel_kv "OpenGL" "$version"
  [[ -z "$accelerated" ]] || ui_panel_kv "硬件加速" "$accelerated"
  if [[ "$direct" == "Yes" && -n "$renderer" ]]; then
    ui_panel_stat ok "$command_label 直接渲染正常"
  elif [[ -n "$renderer" ]]; then
    ui_panel_stat warn "$command_label 已识别渲染器，但 direct rendering=${direct:-unknown}"
  else
    ui_panel_stat warn "$command_label 没有识别到 OpenGL 渲染器"
  fi
}

show_vulkan() {
  local output="" rc=0 instance devices summary
  if ! have vulkaninfo; then
    ui_panel_stat miss "缺少 vulkaninfo（vulkan-tools），无法验证 Vulkan"
    return
  fi
  output="$(vulkaninfo --summary 2>&1)" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    ui_panel_stat warn "Vulkan 查询失败（退出码 $rc）"
    [[ -z "$output" ]] || printf '%s\n' "$output" | sed -n '1,5p' | ui_panel_raw
    return
  fi
  instance="$(awk -F ': ' '/^Vulkan Instance Version:/ {print $2; exit}' <<< "$output")"
  summary="$(awk '
    /^[[:space:]]*GPU[0-9]+:/ {
      gpu=$0
      sub(/^[[:space:]]*/, "", gpu)
      next
    }
    /^[[:space:]]*deviceName[[:space:]]*=/ {
      name=$0; sub(/^.*=[[:space:]]*/, "", name)
      next
    }
    /^[[:space:]]*deviceType[[:space:]]*=/ {
      type=$0; sub(/^.*=[[:space:]]*/, "", type)
      next
    }
    /^[[:space:]]*driverName[[:space:]]*=/ {
      driver=$0; sub(/^.*=[[:space:]]*/, "", driver)
      if (name != "") {
        printf "%s\034%s\034%s\034%s\n", gpu, name, type, driver
        gpu=name=type=driver=""
      }
    }
  ' <<< "$output")"
  devices="$(awk 'NF {n++} END {print n + 0}' <<< "$summary")"
  [[ -z "$instance" ]] || ui_panel_kv "Vulkan API" "$instance"
  if ((devices == 0)); then
    ui_panel_stat warn "Vulkan 命令成功，但没有枚举到物理设备"
    return
  fi
  while IFS=$'\034' read -r gpu name type driver; do
    [[ -n "$name" ]] || continue
    ui_panel_line "${UI_C_SKY}${gpu:-GPU}${UI_RESET}  $name"
    ui_panel_kv "类型 / 驱动" "${type:-未知} / ${driver:-未知}"
  done <<< "$summary"
  ui_panel_stat ok "Vulkan 已枚举 $devices 块 GPU"
}

main() {
  local strict=0
  if (( $# > 1 )); then
    ui_err "参数过多；用法: gpu-check [--strict]"
    return 2
  fi
  case "${1:-}" in
    --strict) strict=1 ;;
    -h|--help) printf '用法: gpu-check [--strict]\n'; return 0 ;;
    "") ;;
    *) ui_err "未知参数: %s" "$1"; return 2 ;;
  esac
  ui_tally_reset
  ui_banner "GPU 检查" "gpu-check · 只读显卡 / 渲染诊断"
  panel "怎么看这份结果" ""
  ui_panel_line "PCI/内核模块确认驱动是否接管显卡；OpenGL/Vulkan 验证实际渲染链路。"
  ui_panel_line "混合显卡中默认使用 AMD 核显是正常且省电的，prime-run 应切到 NVIDIA 独显。"
  ui_panel_line "温度、显存和利用率只显示检查当下的瞬时值，不是压力测试结果。"

  local pci_output="" pci_rows="" pci_rc=0 gpu_count=0 index=0 has_nvidia=0
  panel "PCI 显卡" ""
  if have lspci; then
    pci_output="$(LC_ALL=C lspci -k 2>&1)" || pci_rc=$?
    if [[ "$pci_rc" -ne 0 ]]; then
      ui_panel_stat warn "lspci 查询失败（退出码 $pci_rc）"
    else
      pci_rows="$(awk '
        function emit() {
          if (model != "") {
            printf "%s\034%s\n", model, driver
            model=driver=""
          }
        }
        /VGA compatible controller:|3D controller:|Display controller:/ {
          emit()
          bus=$1
          line=$0
          sub(/^[^[:space:]]+[[:space:]]+/, "", line)
          sub(/^(VGA compatible controller|3D controller|Display controller):[[:space:]]*/, "", line)
          model=bus "  " line
          driver="未报告"
          next
        }
        model != "" && /^[[:space:]]*Kernel driver in use:/ {
          driver=$0
          sub(/^.*Kernel driver in use:[[:space:]]*/, "", driver)
          emit()
        }
        END { emit() }
      ' <<< "$pci_output")"
      gpu_count="$(awk 'NF {n++} END {print n + 0}' <<< "$pci_rows")"
      while IFS=$'\034' read -r model driver; do
        [[ -n "$model" ]] || continue
        index=$((index + 1))
        ui_panel_line "${UI_C_SKY}GPU $index${UI_RESET}  $model"
        ui_panel_kv "内核驱动" "$driver"
        [[ "$model" == *NVIDIA* ]] && has_nvidia=1
      done <<< "$pci_rows"
      if ((gpu_count > 0)); then
        ui_panel_stat ok "PCI 已识别 $gpu_count 块显卡并读取驱动绑定"
      else
        ui_panel_stat warn "PCI 没有识别到 VGA / 3D / Display 控制器"
      fi
    fi
  else
    ui_panel_stat miss "缺少 lspci，建议安装 pciutils"
  fi

  local module_output="" module_rows="" module_count=0 module_rc=0
  panel "内核模块" ""
  if have lsmod; then
    module_output="$(lsmod 2>&1)" || module_rc=$?
    if [[ "$module_rc" -ne 0 ]]; then
      ui_panel_stat warn "lsmod 查询失败（退出码 $module_rc）"
      [[ -z "$module_output" ]] || printf '%s\n' "$module_output" | sed -n '1,4p' | ui_panel_raw
    else
      module_rows="$(awk '$1 ~ /^(amdgpu|nvidia|nouveau)$/ {print $1 "\034" $3}' \
        <<< "$module_output")"
      module_count="$(awk 'NF {n++} END {print n + 0}' <<< "$module_rows")"
    fi
    if [[ "$module_rc" -eq 0 && "$module_count" -eq 0 ]]; then
      ui_panel_stat warn "未发现 amdgpu / nvidia / nouveau 模块"
    elif [[ "$module_rc" -eq 0 ]]; then
      while IFS=$'\034' read -r module used; do
        [[ -n "$module" ]] || continue
        ui_panel_kv "$module" "已加载" "引用计数 ${used:-0}"
        [[ "$module" == "nvidia" ]] && has_nvidia=1
      done <<< "$module_rows"
      if grep -q '^nouveau' <<< "$module_rows" && grep -q '^nvidia' <<< "$module_rows"; then
        ui_panel_stat warn "nouveau 与 nvidia 主模块同时加载，请检查驱动冲突"
      else
        ui_panel_stat ok "显卡内核模块已加载"
      fi
    fi
  else
    ui_panel_stat miss "缺少 lsmod，建议安装 kmod"
  fi

  panel "默认图形栈" ""
  if have glxinfo; then
    show_opengl "默认 OpenGL" glxinfo -B
  else
    ui_panel_stat miss "缺少 glxinfo（mesa-utils），无法验证 OpenGL"
  fi

  panel "Vulkan" ""
  show_vulkan

  panel "NVIDIA" ""
  if ((has_nvidia == 0)); then
    ui_panel_stat info "未检测到 NVIDIA 显卡，本节不适用"
  elif ! have nvidia-smi; then
    ui_panel_stat miss "检测到 NVIDIA 显卡，但缺少 nvidia-smi"
  else
    local nvidia_output="" nvidia_rc=0
    local name driver temp power mem_used mem_total util
    nvidia_output="$(nvidia-smi \
      --query-gpu=name,driver_version,temperature.gpu,power.draw,memory.used,memory.total,utilization.gpu \
      --format=csv,noheader,nounits 2>&1)" || nvidia_rc=$?
    if [[ "$nvidia_rc" -ne 0 || -z "$nvidia_output" ]]; then
      ui_panel_stat warn "nvidia-smi 查询失败（退出码 $nvidia_rc）"
      [[ -z "$nvidia_output" ]] || printf '%s\n' "$nvidia_output" | sed -n '1,4p' | ui_panel_raw
    else
      while IFS=',' read -r name driver temp power mem_used mem_total util; do
        name="$(trim_text "$name")"
        driver="$(trim_text "$driver")"
        temp="$(trim_text "$temp")"
        power="$(trim_text "$power")"
        mem_used="$(trim_text "$mem_used")"
        mem_total="$(trim_text "$mem_total")"
        util="$(trim_text "$util")"
        ui_panel_kv "显卡" "$name"
        ui_panel_kv "驱动" "$driver"
        ui_panel_kv "温度 / 功耗" "${temp:-N/A} C / ${power:-N/A} W"
        ui_panel_kv "显存 / 利用率" "${mem_used:-N/A} / ${mem_total:-N/A} MiB · ${util:-N/A}%"
      done <<< "$nvidia_output"
      ui_panel_stat ok "NVIDIA 驱动与管理接口正常"
    fi

    ui_panel_blank
    ui_panel_line "${UI_C_SKY}独显渲染验证${UI_RESET}"
    if ! have prime-run; then
      ui_panel_stat miss "缺少 prime-run（nvidia-prime），无法验证独显渲染"
    elif ! have glxinfo; then
      ui_panel_stat miss "缺少 glxinfo（mesa-utils），无法执行 prime-run OpenGL"
    else
      show_opengl "prime-run OpenGL" prime-run glxinfo -B
    fi
  fi

  panel_end
  ui_tally_summary
  ui_tally_status "$strict"
}

main "$@"
