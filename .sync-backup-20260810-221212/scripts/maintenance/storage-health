#!/usr/bin/env bash
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SELF")"
# shellcheck source=lib/ui.sh
. "$SCRIPT_DIR/lib/ui.sh"

STRICT=0
if (( $# > 1 )); then
  ui_err "参数过多；用法: storage-health [--strict]"
  exit 2
fi
case "${1:-}" in
  --strict) STRICT=1 ;;
  -h|--help)
    printf '用法: storage-health [--strict]\n'
    printf '只读检查 SMART/NVMe、Btrfs device stats、scrub 和文件系统空间。\n'
    exit 0
    ;;
  "") ;;
  *) ui_err "未知参数: %s" "$1"; exit 2 ;;
esac

ui_tally_reset
ui_banner "存储健康" "storage-health · SMART / NVMe / Btrfs"
ui_panel_open "怎么看这份结果"
ui_panel_line "SMART/NVMe：磁盘固件提供的健康、温度、寿命和介质错误记录。"
ui_panel_line "device stats：Btrfs 自挂载以来累计的读写、校验和与损坏错误计数。"
ui_panel_line "scrub：读取全盘数据并核对校验和；不删除文件，也不等于创建快照。"
ui_panel_line "首次尚无 scrub 结果是正常状态，等每月定时任务完成一次后即可看到结果。"
ui_panel_close

SUDO=()
if [[ "$EUID" -eq 0 ]]; then
  :
elif command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
  SUDO=(sudo -n)
elif [[ -t 0 ]] && command -v sudo >/dev/null 2>&1; then
  ui_info "SMART 详细信息需要管理员权限。"
  if sudo -v; then SUDO=(sudo); fi
fi

smart_value() {
  local json="$1" filter="$2"
  jq -r "$filter // empty" <<< "$json" 2>/dev/null || true
}

check_smart_device() {
  local dev="$1" fallback_model="$2" fallback_size="$3"
  local json="" rc=0 model serial health temp used media critical hours exit_status
  local ata_errors smart_query_failed=0 smart_messages

  ui_panel_open "$dev" "${fallback_model:-物理磁盘} · ${fallback_size:-大小未知}"
  if ! command -v smartctl >/dev/null 2>&1; then
    ui_panel_stat miss "缺少 smartctl（smartmontools），无法读取 SMART"
    ui_panel_close
    return
  fi
  json="$("${SUDO[@]}" smartctl -a -j "$dev" 2>&1)" || rc=$?
  if ! jq -e . >/dev/null 2>&1 <<< "$json"; then
    ui_panel_stat warn "SMART 查询失败（退出码 $rc）"
    printf '%s\n' "$json" | sed -n '1,4p' | ui_panel_raw
    ui_panel_close
    return
  fi

  model="$(smart_value "$json" '.model_name // .model_family // .scsi_model_name')"
  serial="$(smart_value "$json" '.serial_number')"
  health="$(smart_value "$json" '.smart_status.passed')"
  temp="$(smart_value "$json" '.temperature.current')"
  used="$(smart_value "$json" '.nvme_smart_health_information_log.percentage_used')"
  media="$(smart_value "$json" '.nvme_smart_health_information_log.media_errors')"
  critical="$(smart_value "$json" '.nvme_smart_health_information_log.critical_warning')"
  hours="$(smart_value "$json" '.power_on_time.hours')"
  exit_status="$(smart_value "$json" '.smartctl.exit_status')"
  [[ -n "$model" ]] && ui_panel_kv "型号" "$model"
  [[ -n "$serial" ]] && ui_panel_kv "序列号" "$serial"
  [[ -n "$hours" ]] && ui_panel_kv "通电时间" "${hours} 小时"

  if [[ "$exit_status" =~ ^[0-9]+$ ]] && ((exit_status & 7)); then
    smart_query_failed=1
    ui_panel_stat warn "SMART 数据读取失败，需要管理员权限或设备不支持 SMART"
    smart_messages="$(jq -r '.smartctl.messages[]?.string // empty' <<< "$json" 2>/dev/null || true)"
    [[ -z "$smart_messages" ]] || printf '%s\n' "$smart_messages" | ui_panel_raw
  else
    case "$health" in
      true) ui_panel_stat ok "SMART 总体健康检查通过" ;;
      false) ui_panel_stat err "SMART 总体健康检查失败" ;;
      *) ui_panel_stat warn "设备没有提供 SMART 总体结论" ;;
    esac
  fi
  if [[ "$temp" =~ ^[0-9]+$ ]]; then
    if ((temp >= 70)); then ui_panel_stat err "温度过高: ${temp} C"
    elif ((temp >= 60)); then ui_panel_stat warn "温度偏高: ${temp} C"
    else ui_panel_stat ok "温度: ${temp} C"; fi
  fi
  if [[ "$used" =~ ^[0-9]+$ ]]; then
    if ((used >= 90)); then ui_panel_stat err "NVMe 寿命已使用 ${used}%"
    elif ((used >= 70)); then ui_panel_stat warn "NVMe 寿命已使用 ${used}%"
    else ui_panel_stat ok "NVMe 寿命已使用 ${used}%"; fi
  fi
  if [[ "$media" =~ ^[0-9]+$ ]]; then
    if ((media > 0)); then ui_panel_stat warn "NVMe 介质/数据完整性错误: $media"
    else ui_panel_stat ok "NVMe 介质错误为 0"; fi
  fi
  if [[ "$critical" =~ ^[0-9]+$ && "$critical" -ne 0 ]]; then
    ui_panel_stat err "NVMe critical_warning 非零: $critical"
  fi

  ata_errors="$(jq -r '
    [.ata_smart_attributes.table[]?
      | select(.id == 5 or .id == 187 or .id == 188 or .id == 197 or .id == 198)
      | select((.raw.value // 0) > 0)
      | "\(.name)=\(.raw.value)"] | .[]' <<< "$json" 2>/dev/null || true)"
  if [[ -n "$ata_errors" ]]; then
    ui_panel_stat warn "ATA 关键错误属性存在非零值"
    printf '%s\n' "$ata_errors" | ui_panel_raw
  elif jq -e '.ata_smart_attributes.table? != null' >/dev/null 2>&1 <<< "$json"; then
    ui_panel_stat ok "ATA 重映射/待处理/不可校正等关键属性为 0"
  fi

  if [[ "$exit_status" =~ ^[0-9]+$ ]]; then
    if ((exit_status & 8)); then ui_panel_stat err "smartctl 报告磁盘正在失效"; fi
    if ((exit_status & 16)); then ui_panel_stat err "SMART 预失效属性低于阈值"; fi
    if ((exit_status & 32)); then ui_panel_stat warn "历史预失效属性曾低于阈值"; fi
    if ((exit_status & 64)); then ui_panel_stat warn "SMART 错误日志包含记录"; fi
    if ((exit_status & 128)); then ui_panel_stat warn "SMART 自检日志包含失败记录"; fi
    if ((smart_query_failed == 0 && (exit_status & 6))); then
      ui_panel_stat warn "smartctl 无法完整读取设备数据"
    fi
  fi
  ui_panel_close
}

ui_section "物理磁盘 SMART"
ui_working "正在读取 SMART/NVMe 健康数据"
if ! command -v lsblk >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  ui_panel_open "SMART 枚举"
  command -v lsblk >/dev/null 2>&1 || ui_panel_stat miss "缺少 lsblk（util-linux）"
  command -v jq >/dev/null 2>&1 || ui_panel_stat miss "缺少 jq，无法解析 lsblk/smartctl JSON"
  ui_panel_close
else
  LSBLK_JSON="$(lsblk -J -b -d -o PATH,TYPE,MODEL,SIZE 2>/dev/null || true)"
  if ! jq -e . >/dev/null 2>&1 <<< "$LSBLK_JSON"; then
    ui_panel_open "SMART 枚举"
    ui_panel_stat warn "lsblk JSON 查询失败"
    ui_panel_close
  else
    mapfile -t DISK_ROWS < <(jq -r '.blockdevices[]?
      | select(.type == "disk")
      | select((.path | test("^/dev/(zram|loop|ram)[0-9]*$")) | not)
      | [.path, (.model // ""), ((.size // 0) | tostring)]
      | join("\u001f")' <<< "$LSBLK_JSON")
    if ((${#DISK_ROWS[@]} == 0)); then
      ui_panel_open "SMART 枚举"
      ui_panel_stat warn "没有枚举到物理磁盘"
      ui_panel_close
    else
      for row in "${DISK_ROWS[@]}"; do
        IFS=$'\037' read -r dev model size_bytes <<< "$row"
        if [[ "$size_bytes" =~ ^[0-9]+$ ]]; then
          size_text="$(awk -v bytes="$size_bytes" 'BEGIN {printf "%.1f GiB", bytes / 1073741824}')"
        else
          size_text="大小未知"
        fi
        check_smart_device "$dev" "$model" "$size_text"
      done
    fi
  fi
fi

ui_section "文件系统空间"
ui_panel_open "已挂载持久文件系统"
if DF_OUT="$(df -P -x tmpfs -x devtmpfs 2>&1)"; then
  while read -r percent mountpoint; do
    [[ "$percent" =~ ^[0-9]+$ ]] || continue
    if ((percent >= 95)); then ui_panel_stat err "$mountpoint 已使用 ${percent}%"
    elif ((percent >= 85)); then ui_panel_stat warn "$mountpoint 已使用 ${percent}%"
    else ui_panel_stat ok "$mountpoint 已使用 ${percent}%"; fi
  done < <(awk 'NR > 1 {gsub(/%/, "", $5); print $5, $6}' <<< "$DF_OUT")
else
  ui_panel_stat warn "df 查询失败"
  printf '%s\n' "$DF_OUT" | ui_panel_raw
fi
ui_panel_close

ui_section "Btrfs"
ui_working "正在读取 Btrfs 错误计数、scrub 历史和定时器状态"
if ! command -v btrfs >/dev/null 2>&1 || ! command -v findmnt >/dev/null 2>&1; then
  ui_panel_open "Btrfs 检查"
  command -v btrfs >/dev/null 2>&1 || ui_panel_stat miss "缺少 btrfs 命令"
  command -v findmnt >/dev/null 2>&1 || ui_panel_stat miss "缺少 findmnt"
  ui_panel_close
else
  declare -A SEEN_BTRFS=()
  BTRFS_COUNT=0
  BTRFS_MOUNTS=""
  if ! BTRFS_MOUNTS="$(findmnt -rn -t btrfs -o TARGET,SOURCE 2>&1)"; then
    ui_panel_open "Btrfs 检查"
    ui_panel_stat warn "Btrfs 挂载查询失败"
    [[ -z "$BTRFS_MOUNTS" ]] || printf '%s\n' "$BTRFS_MOUNTS" | ui_panel_raw
    ui_panel_close
  else
    while read -r target source; do
      [[ -n "$target" && -n "$source" ]] || continue
      device="${source%%\[*}"
      [[ -z "${SEEN_BTRFS[$device]:-}" ]] || continue
      SEEN_BTRFS[$device]=1
      BTRFS_COUNT=$((BTRFS_COUNT + 1))
      ui_panel_open "$target" "$device"
      stats_rc=0
      stats="$(LC_ALL=C btrfs device stats -c "$target" 2>&1)" || stats_rc=$?
      nonzero_stats="$(awk '$NF ~ /^[0-9]+$/ && $NF != 0 {print}' <<< "$stats")"
      if [[ -n "$nonzero_stats" ]]; then
        ui_panel_stat warn "Btrfs device stats 存在非零错误"
        printf '%s\n' "$nonzero_stats" | ui_panel_raw
      elif [[ "$stats_rc" -eq 0 ]]; then
        ui_panel_stat ok "Btrfs device stats 全部为 0"
      else
        ui_panel_stat warn "Btrfs device stats 查询失败"
        [[ -z "$stats" ]] || printf '%s\n' "$stats" | ui_panel_raw
      fi

      scrub_rc=0
      # scrub 的历史结果通常位于 /var/lib/btrfs；普通用户可以读取 device
      # stats，却可能没有读取历史状态文件的权限。沿用上方 SMART 已取得的
      # 只读 sudo，避免把权限不足误报成“scrub 查询失败”。
      scrub="$(LC_ALL=C "${SUDO[@]}" btrfs scrub status -R "$target" 2>&1)" || scrub_rc=$?
      if [[ "$scrub_rc" -ne 0 ]]; then
        ui_panel_stat warn "scrub 状态查询失败"
        [[ -z "$scrub" ]] || printf '%s\n' "$scrub" | ui_panel_raw
      elif grep -q 'no stats available' <<< "$scrub"; then
        ui_panel_stat info "尚未完成过 scrub；首次定时执行后会显示结果（当前不是故障）"
      elif grep -Eq 'uncorrectable_errors:[[:space:]]*[1-9]|read_errors:[[:space:]]*[1-9]|csum_errors:[[:space:]]*[1-9]|verify_errors:[[:space:]]*[1-9]' <<< "$scrub"; then
        ui_panel_stat warn "上次 scrub 检出了错误"
      else
        ui_panel_stat ok "上次 scrub 未报告关键错误"
      fi
      if command -v systemd-escape >/dev/null 2>&1; then
        instance="$(systemd-escape --path "$target")"
        timer_rc=0
        timer_state="$(systemctl is-enabled "btrfs-scrub@${instance}.timer" 2>&1)" || timer_rc=$?
        case "$timer_state" in
          enabled) ui_panel_stat ok "每月 scrub timer 已启用" ;;
          disabled) ui_panel_stat warn "每月 scrub timer 未启用" ;;
          *)
            ui_panel_stat warn "每月 scrub timer 状态查询失败（退出码 $timer_rc）"
            [[ -z "$timer_state" ]] || printf '%s\n' "$timer_state" | ui_panel_raw
            ;;
        esac
      fi
      ui_panel_close
    done <<< "$BTRFS_MOUNTS"
    if [[ "$BTRFS_COUNT" -eq 0 ]]; then
      ui_panel_open "Btrfs 检查"
      ui_panel_stat info "当前没有已挂载的 Btrfs 文件系统"
      ui_panel_close
    fi
  fi
fi

ui_tally_summary
ui_tally_status "$STRICT"
