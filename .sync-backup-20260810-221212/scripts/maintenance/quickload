#!/usr/bin/env bash
# shellcheck disable=SC2031,SC2059
# 描述： 快速读档，快照恢复
# Description: Quickload btrfs snapshots
# quickload - Btrfs Snapshot Quick Restore Script
#

set -euo pipefail

UI_LIB="$(dirname "$(readlink -f "$0")")/lib/ui.sh"
# shellcheck source=lib/ui.sh
. "$UI_LIB"

# ==========================================
# 文案（纯中文）
# ==========================================
MSG_HELP_DESC="快速恢复 Btrfs 快照。支持在快照启动项和常规系统中运行。"
  MSG_HELP_OPT="选项:"
  MSG_HELP_C="  -c, --config <配置名>     跳过菜单，仅操作指定的快照配置 (例如: root)"
  MSG_HELP_N="  -n, --noconfirm           跳过菜单，直接恢复。如果不配合 -c，则全系统恢复"
  MSG_HELP_D="  -d, --description <描述>  手动指定快照描述 (默认按 quicksave -> timeline 顺序回退)"
  MSG_HELP_DATE="  --snapshot-date <时间>    同名快照消歧（通常由交互选择自动传递）"
  MSG_HELP_BATCH="  --snapshot-batch <批次>  精确匹配 quicksave 同批次快照（内部参数）"
  MSG_HELP_NATIVE="  --native-root-fallback    btrfs-assistant 不可用时，以原生 Btrfs 安全恢复 root（仅 -c root）"
  MSG_HELP_NATIVE_ROLLBACK="  --native-root-rollback <名称|latest>  把保留的 @quickload-pre-* root 换回 @（仅 -c root）"
  MSG_HELP_LC="  -lc, --list-configs       列出所有可用的快照配置名 (用于 -c 选项)"
  MSG_HELP_L="  -l, --list                列出可用的自定义快照描述 (未指定 -c 时默认仅显示 root 配置)"
  MSG_HELP_LA="  -la, --list-all           列出所有可用的快照描述 (未指定 -c 时默认仅显示 root 配置)"
  MSG_HELP_X="  -x, --debug               开启调试模式，输出日志到 /tmp/quickload_debug_EUID_PID.log"
  MSG_HELP_H="  -h, --help                显示此帮助信息"

  MSG_ERR_ROOT="错误: 核心回档/挂载操作需要 root 权限，且未找到提权工具 (sudo/pkexec)。"
  MSG_ERR_DEP="错误: 未找到依赖命令 '%s'，请确保已安装。\n"
  MSG_ERR_BTRFS="错误: 根文件系统不是 btrfs。"
  MSG_ERR_NOCONF="错误: 未检测到任何 snapper 配置或普通用户权限不足，尝试提取失败。"
  MSG_ERR_MATCH="错误: 在配置 [%s] 中未找到匹配的快照 (描述: %s)。\n"
  MSG_ERR_BA="错误: 未在 btrfs-assistant 中匹配到对应的回档序号。\n"
  MSG_ERR_NATIVE_LAYOUT="错误: 当前 root 没有以可验证的 subvol= 挂载选项运行；为避免下次启动到错误子卷，已拒绝原生恢复。\n"

  MSG_CANCEL="操作已取消。"
  MSG_UNKNOWN_OPT="未知选项: %s\n"
  MSG_NEEDS_ARG="错误: %s 需要参数\n"
  MSG_TITLE="系统还原"

  # 选项格式：图标+标签 <TAB> 一句话说明。说明里的换行用字面 \n，
  # 由 fzf 预览命令 printf %b 展开；条目本身必须是单行，否则会被 fzf 拆成多条。
  MSG_OPT_BOTH=$'\uf0e2  全部还原\t把「系统文件」和「个人文件」一起退回到所选的备份时间点。\\n系统整体出问题、想彻底回到过去某个正常状态时用。'
  MSG_OPT_ROOT=$'\uf013  只还原系统\t只把系统文件（/）退回到备份时间点。\\n你的个人文件（home 里的文档、下载、配置）保持现在的样子不变。'
  MSG_OPT_HOME=$'\uf015  只还原个人文件\t只把个人文件（home）退回到备份时间点。\\n系统本身不动，适合个人文件误删或改乱了想找回。'
  MSG_OPT_ONLY=$'\uf07b  只还原 %s\t只把「%s」这一部分退回到备份时间点，其他部分不动。'
  MSG_OPT_SELECT=$'\uf002  先选备份时间点\t列出所有可用的备份，自己挑一个要退回到的时间点。\\n挑好后再回来选还原范围。'
  MSG_OPT_CANCEL=$'\uf00d  取消\t什么都不做，直接退出。'
  MSG_SELECT_TITLE="选择要退回的备份时间点"
  MSG_SELECT_BACK=$'\uf053  返回上一层'
  MSG_SELECT_EMPTY="没有找到可用的备份。"
  # 快照列表项：图标 + 时间 + 备份类型 \t 说明（右侧预览展开）
  MSG_SELECT_FMT=$'\uf017  %s · %s\t备份类型：%s\\\\n快照编号：%s\\\\n选它就把系统退回到 %s 这个时间点。'
  MSG_SELECTED_SNAPSHOT="已锁定备份时间点：%s\n接下来选还原范围（全部 / 只系统 / 只个人文件）才会真正开始还原。\n"

  MSG_LIST_CONF="可用的快照配置"
  MSG_LIST_CUSTOM="可用的自定义快照描述"
  MSG_LIST_ALL="所有可用的快照描述"
  MSG_LIST_EMPTY="未找到符合条件的快照描述。"
  # 青色高亮，描述列用 ui_pad 按显示列（非字节）对齐，避免中文描述错位
  MSG_LIST_FMT="  - ${UI_CYAN}%s${UI_RESET} [配置: %s | ID: %s | 时间: %s]\n"

  MSG_PROMPT="请输入序号: "
  MSG_INVALID="无效的选择，请重新输入。"
  MSG_UNKNOWN_CHOICE="无法识别的配置或选择: %s\n"
  MSG_RESTORE_DOING=">>> 正在静默执行回档项 ID: %s ...\n"
  MSG_ERR_BA_LIST="错误: btrfs-assistant -l 执行失败，无法继续回档。\n输出:\n%s\n请先运行 sudo env -u DISPLAY -u WAYLAND_DISPLAY -u XDG_RUNTIME_DIR btrfs-assistant -l 验证 btrfs-assistant 是否可用。\n"
  MSG_ERR_BA_PREFLIGHT="错误: 恢复后端不可用，尚未进入快照选择。\n%s\n退出码: %s\n输出:\n%s\n"

  MSG_NOTIFY_SUCC_TITLE="回档设定成功"
  MSG_NOTIFY_SUCC_BODY="快照恢复任务已下发。\n系统即将自动重启..."
  MSG_NOTIFY_ERR_TITLE="回档操作失败"

print_help() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

${MSG_HELP_DESC}

${MSG_HELP_OPT}
${MSG_HELP_C}
${MSG_HELP_N}
${MSG_HELP_D}
${MSG_HELP_DATE}
${MSG_HELP_BATCH}
${MSG_HELP_NATIVE}
${MSG_HELP_NATIVE_ROLLBACK}
${MSG_HELP_LC}
${MSG_HELP_L}
${MSG_HELP_LA}
${MSG_HELP_X}
${MSG_HELP_H}
EOF
}

# ==========================================
# 初始化与提权管理引擎
# ==========================================
OPT_DEBUG=0
if [[ $# -eq 1 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
  print_help
  exit 0
fi
for arg in "$@"; do
  case "$arg" in
  -x | --debug) OPT_DEBUG=1 ;;
  esac
done

if [[ $OPT_DEBUG -eq 1 ]]; then
  # 通过 EUID 区分日志，彻底解决 root 和 user 日志权限冲突
  LOG_FILE="/tmp/quickload_debug_${EUID}_$$.log"
  exec 2>"$LOG_FILE"
  set -x
  echo "=== 调试模式启动 (PID: $$, EUID: $EUID) ===" >&2
fi

ORIG_USER="${SUDO_USER:-}"
if [[ -z "$ORIG_USER" && -n "${PKEXEC_UID:-}" ]]; then
  ORIG_USER=$(id -nu "$PKEXEC_UID" 2>/dev/null || true)
fi

run_as_user() {
  if [[ -n "$ORIG_USER" ]] && command -v sudo >/dev/null 2>&1; then
    sudo -H -u "$ORIG_USER" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" DISPLAY="${DISPLAY:-}" "$@"
  else
    "$@"
  fi
}

notify_err() {
  local msg
  msg=$(printf "$@")
  echo -e "$msg" >&2
  if [[ "${MAINTENANCE_NO_NOTIFY:-0}" != "1" ]] \
      && [[ ! -t 0 || ! -t 1 ]] && command -v notify-send >/dev/null 2>&1; then
    run_as_user notify-send -u critical -a "Quickload" "$MSG_NOTIFY_ERR_TITLE" "$msg" 2>/dev/null || true
  fi
}

notify_ok() {
  local msg="$1"
  echo -e "$msg"
  if [[ "${MAINTENANCE_NO_NOTIFY:-0}" != "1" ]] \
      && [[ ! -t 0 || ! -t 1 ]] && command -v notify-send >/dev/null 2>&1; then
    run_as_user notify-send -u normal -a "Quickload" "$MSG_NOTIFY_SUCC_TITLE" "$MSG_NOTIFY_SUCC_BODY" 2>/dev/null || true
  fi
}

# 延迟提权函数：仅在必要时(回档/挂载快照根)调用
require_root() {
  if [[ $EUID -ne 0 && "${QUICKLOAD_TEST_MODE:-0}" != "1" ]]; then
    local SCRIPT_PATH
    SCRIPT_PATH="$(realpath "$0")"
    if [[ -t 0 && -t 1 ]]; then
      if command -v sudo >/dev/null 2>&1; then
        exec sudo "$SCRIPT_PATH" "$@"
      else
        notify_err "$MSG_ERR_ROOT"
        exit 1
      fi
    else
      if command -v pkexec >/dev/null 2>&1; then
        exec pkexec /usr/bin/env \
          XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
          WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
          DISPLAY="${DISPLAY:-}" \
          LC_ALL="${LC_ALL:-}" LC_MESSAGES="${LC_MESSAGES:-}" LANG="${LANG:-}" \
          "$SCRIPT_PATH" "$@"
      else
        notify_err "$MSG_ERR_ROOT"
        exit 1
      fi
    fi
  fi
}

# ==========================================
# 参数解析
# ==========================================
ORIGINAL_ARGS=("$@")
OPT_CONFIG=""
OPT_DESC=""
TARGET_SNAPSHOT_DATE=""
TARGET_SNAPSHOT_BATCH=""
TARGET_SNAPSHOT_LABEL=""
OPT_NOCONFIRM=0
OPT_LIST=0
OPT_LIST_ALL=0
OPT_LIST_CONFIGS=0
OPT_NATIVE_ROOT_FALLBACK=0
OPT_NATIVE_ROOT_ROLLBACK=""

while [[ $# -gt 0 ]]; do
  case "${1:-}" in
  -c | --config)
    if [[ $# -lt 2 ]]; then
      notify_err "$MSG_NEEDS_ARG" "$1"
      exit 1
    fi
    OPT_CONFIG="$2"
    shift 2
    ;;
  -n | --noconfirm)
    OPT_NOCONFIRM=1
    shift 1
    ;;
  -lc | --list-configs)
    OPT_LIST_CONFIGS=1
    shift 1
    ;;
  -l | --list)
    OPT_LIST=1
    shift 1
    ;;
  -la | --list-all)
    OPT_LIST_ALL=1
    shift 1
    ;;
  -d | --description)
    if [[ $# -lt 2 ]]; then
      notify_err "$MSG_NEEDS_ARG" "$1"
      exit 1
    fi
    OPT_DESC="$2"
    shift 2
    ;;
  --snapshot-date)
    if [[ $# -lt 2 ]]; then
      notify_err "$MSG_NEEDS_ARG" "$1"
      exit 1
    fi
    TARGET_SNAPSHOT_DATE="$2"
    shift 2
    ;;
  --snapshot-batch)
    if [[ $# -lt 2 ]]; then
      notify_err "$MSG_NEEDS_ARG" "$1"
      exit 1
    fi
    TARGET_SNAPSHOT_BATCH="$2"
    shift 2
    ;;
  --native-root-fallback)
    OPT_NATIVE_ROOT_FALLBACK=1
    shift 1
    ;;
  --native-root-rollback)
    if [[ $# -lt 2 ]]; then
      notify_err "$MSG_NEEDS_ARG" "$1"
      exit 1
    fi
    OPT_NATIVE_ROOT_ROLLBACK="$2"
    shift 2
    ;;
  -x | --debug) shift 1 ;;
  -h | --help) shift 1 ;;
  *)
    notify_err "$MSG_UNKNOWN_OPT" "${1:-}"
    exit 1
    ;;
  esac
done

if [[ "$OPT_NATIVE_ROOT_FALLBACK" -eq 1 && "$OPT_CONFIG" != "root" ]]; then
  notify_err "错误: --native-root-fallback 只能与 -c root 一起使用；它不会自动恢复 HOME 或其它子卷。"
  exit 2
fi
if [[ -n "$OPT_NATIVE_ROOT_ROLLBACK" && "$OPT_CONFIG" != "root" ]]; then
  notify_err "错误: --native-root-rollback 只能与 -c root 一起使用；它只交换原生恢复保留的 root 子卷。"
  exit 2
fi
if [[ "$OPT_NATIVE_ROOT_FALLBACK" -eq 1 && -n "$OPT_NATIVE_ROOT_ROLLBACK" ]]; then
  notify_err "错误: 不能同时指定 --native-root-fallback 和 --native-root-rollback。"
  exit 2
fi

# ==========================================
# 核心依赖与环境感知
# ==========================================
MOUNT_DIR=""
IS_SNAPSHOT_BOOT=0
declare -A CONFIG_MAP
CONFIG_COUNT=0
SNAP_SEP=$'\037'
FALLBACK_DESCS=("quicksave" "timeline" "Manual Snapshot")

cleanup() {
  if [[ -n "${MOUNT_DIR:-}" && -d "${MOUNT_DIR:-}" ]]; then
    umount "$MOUNT_DIR" 2>/dev/null || true
    rmdir "$MOUNT_DIR" 2>/dev/null || true
  fi
}
trap cleanup EXIT

# 原生 root 后端刻意不依赖 btrfs-assistant：它正是 btrfs-assistant
# 崩溃、被卸载或无法执行时的受控兜底路径。回退甚至不依赖 Snapper，
# 因为恢复 root 中的 Snapper 配置可能还未能工作；默认后端仍必须有它。
if [[ -n "$OPT_NATIVE_ROOT_ROLLBACK" ]]; then
  required_cmds=(btrfs findmnt find sort tail)
else
  required_cmds=(btrfs snapper findmnt awk grep)
  [[ "$OPT_NATIVE_ROOT_FALLBACK" -eq 0 ]] && required_cmds+=(btrfs-assistant)
fi
for cmd in "${required_cmds[@]}"; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    notify_err "$MSG_ERR_DEP" "$cmd"
    exit 1
  fi
done

if [[ "$(findmnt -f -n -o FSTYPE / || true)" != "btrfs" ]]; then
  notify_err "$MSG_ERR_BTRFS"
  exit 1
fi

# 回退只交换两个已验证的顶级子卷，故意跳过 Snapper 发现和配置读取；这
# 使“新 root 已能启动、但 Snapper 尚未修好”的情况下仍有可用的安全出口。
if [[ -z "$OPT_NATIVE_ROOT_ROLLBACK" ]]; then
  # 如果普通用户甚至没有权限读取 configs，强制提权以保证可用性
  CONFIG_ROWS=""
  if ! CONFIG_ROWS="$(snapper --csvout --separator "$SNAP_SEP" list-configs 2>/dev/null)"; then
    require_root "${ORIGINAL_ARGS[@]}"
    if ! CONFIG_ROWS="$(snapper --csvout --separator "$SNAP_SEP" list-configs 2>/dev/null)"; then
      notify_err "$MSG_ERR_NOCONF"
      exit 1
    fi
  fi

  while IFS="$SNAP_SEP" read -r conf subvol; do
    [[ "$conf" == "config" || -z "$conf" ]] && continue
    CONFIG_MAP["$conf"]="$subvol"
    CONFIG_COUNT=$((CONFIG_COUNT + 1))
  done <<< "$CONFIG_ROWS"

  if [[ $CONFIG_COUNT -eq 0 ]]; then
    notify_err "$MSG_ERR_NOCONF"
    exit 1
  fi

  if [[ $OPT_LIST_CONFIGS -eq 1 ]]; then
    ui_section "$MSG_LIST_CONF"
    for conf in "${!CONFIG_MAP[@]}"; do
      printf "  - ${UI_CYAN}%s${UI_RESET}\n" "$conf"
    done
    exit 0
  fi
fi

# 探测快照启动环境：挂载顶级子卷需要 Root，立即拦截提权
SOURCE_LINE=$(findmnt -n -o SOURCE / || true)
if [[ "$SOURCE_LINE" == *".snapshots"* ]]; then
  IS_SNAPSHOT_BOOT=1
  require_root "${ORIGINAL_ARGS[@]}"

  DEVICE=$(echo "$SOURCE_LINE" | cut -d'[' -f1)
  SUBVOL_PATH=$(echo "$SOURCE_LINE" | cut -d'[' -f2 | cut -d']' -f1)
  BASE_SUBVOL="${SUBVOL_PATH%%/.snapshots*}"
  [[ -z "$BASE_SUBVOL" ]] && BASE_SUBVOL="/"

  MOUNT_DIR=$(mktemp -d /tmp/quickload_root_XXXX)
  mount -t btrfs -o subvol="$BASE_SUBVOL" "$DEVICE" "$MOUNT_DIR"
fi

# ==========================================
# 工具函数
# ==========================================
get_snapper_list_output() {
  local conf="$1"
  local subvol="${CONFIG_MAP[$conf]:-}"
  if [[ "$IS_SNAPSHOT_BOOT" == 1 && "$subvol" == "/" ]]; then
    if ! snapper --no-dbus --root "$MOUNT_DIR" --csvout --separator "$SNAP_SEP" --iso \
        list --columns number,date,description,userdata; then
      notify_err "错误: 配置 [%s] 的快照列表查询失败。" "$conf"
      return 1
    fi
  else
    if ! snapper --csvout --separator "$SNAP_SEP" --iso -c "$conf" \
        list --columns number,date,description,userdata; then
      notify_err "错误: 配置 [%s] 的快照列表查询失败。" "$conf"
      return 1
    fi
  fi
}

list_snapshot_descriptions() {
  local show_all="$1"
  local descs_raw=()
  local configs_to_list=()

  if [[ -n "$OPT_CONFIG" ]]; then
    if [[ -n "${CONFIG_MAP[$OPT_CONFIG]:-}" ]]; then
      configs_to_list=("$OPT_CONFIG")
    else
      notify_err "$MSG_UNKNOWN_CHOICE" "$OPT_CONFIG"
      exit 1
    fi
  elif [[ "$show_all" == 1 ]]; then
    configs_to_list=("${!CONFIG_MAP[@]}")
  else
    # 限定未指定 -c 时，默认只显示 root (若存在)
    if [[ -n "${CONFIG_MAP["root"]:-}" ]]; then
      configs_to_list=("root")
    else
      configs_to_list=("${!CONFIG_MAP[@]}")
    fi
  fi

  if [[ "$show_all" == 1 ]]; then
    ui_section "$MSG_LIST_ALL"
  else
    ui_section "$MSG_LIST_CUSTOM"
  fi

  for conf in "${configs_to_list[@]}"; do
    local list_out
    list_out=$(get_snapper_list_output "$conf")

    while IFS="$SNAP_SEP" read -r sid date desc _userdata; do
      if [[ "$sid" == "number" || "$sid" == "0" || -z "$desc" || "$desc" == "current" ]]; then
        continue
      fi
      if [[ "$show_all" == 0 ]]; then
        if [[ "$desc" == "quicksave" || "$desc" == "timeline" || "$desc" == "Manual Snapshot" ]]; then
          continue
        fi
      fi
      descs_raw+=("$desc|$conf|$sid|$date")
    done <<< "$list_out"
  done

  if [[ ${#descs_raw[@]} -gt 0 ]]; then
    # 【核心修复项】: 移除 -k1,1 按描述排序，改为按配置名分组，然后严格按时间线(ID)递增排序
    readarray -t sorted_descs < <(printf "%s\n" "${descs_raw[@]}" | sort -t'|' -k2,2 -k3,3n)
    for entry in "${sorted_descs[@]}"; do
      IFS='|' read -r desc conf sid date <<<"$entry"
      printf "$MSG_LIST_FMT" "$(ui_pad "$desc" 25)" "$(ui_pad "$conf" 5)" "$(ui_pad "$sid" 3)" "$date"
    done
  else
    echo "  $MSG_LIST_EMPTY"
  fi
}

if [[ $OPT_LIST -eq 1 ]]; then
  list_snapshot_descriptions 0
  exit 0
fi
if [[ $OPT_LIST_ALL -eq 1 ]]; then
  list_snapshot_descriptions 1
  exit 0
fi

BA_PREFLIGHT_DONE=0
BA_PREFLIGHT_OUTPUT=""
probe_btrfs_assistant() {
  local status=0 reason="btrfs-assistant -l 探测失败"
  local -a probe_cmd=(env -u DISPLAY -u WAYLAND_DISPLAY -u XDG_RUNTIME_DIR LC_ALL=C btrfs-assistant -l)

  if [[ $EUID -ne 0 && "${QUICKLOAD_TEST_MODE:-0}" != "1" ]]; then
    if command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
      probe_cmd=(sudo -n env -u DISPLAY -u WAYLAND_DISPLAY -u XDG_RUNTIME_DIR LC_ALL=C btrfs-assistant -l)
    elif [[ -t 0 && -t 1 ]] && command -v sudo >/dev/null 2>&1; then
      ui_info "恢复前先验证 btrfs-assistant 后端，需要管理员权限。"
      if ! sudo -v; then
        notify_err "$MSG_ERR_BA_PREFLIGHT" "管理员权限验证失败" "1" "sudo -v 失败"
        return 1
      fi
      probe_cmd=(sudo -n env -u DISPLAY -u WAYLAND_DISPLAY -u XDG_RUNTIME_DIR LC_ALL=C btrfs-assistant -l)
    elif command -v pkexec >/dev/null 2>&1; then
      probe_cmd=(pkexec /usr/bin/env -u DISPLAY -u WAYLAND_DISPLAY -u XDG_RUNTIME_DIR LC_ALL=C btrfs-assistant -l)
    fi
  fi

  if command -v timeout >/dev/null 2>&1; then
    BA_PREFLIGHT_OUTPUT="$(timeout --signal=TERM 15s "${probe_cmd[@]}" 2>&1)" || status=$?
  else
    BA_PREFLIGHT_OUTPUT="$("${probe_cmd[@]}" 2>&1)" || status=$?
  fi
  if [[ "$status" -ne 0 ]]; then
    case "$status" in
      124) reason="btrfs-assistant 探测超时（15 秒）" ;;
      139) reason="btrfs-assistant 发生段错误" ;;
      126|127) reason="btrfs-assistant 无法执行" ;;
    esac
    notify_err "$MSG_ERR_BA_PREFLIGHT" "$reason" "$status" "${BA_PREFLIGHT_OUTPUT:-无输出}"
    return 1
  fi
  if ! awk '$1 ~ /^[0-9]+$/ {found=1} END {exit !found}' <<< "$BA_PREFLIGHT_OUTPUT"; then
    notify_err "$MSG_ERR_BA_PREFLIGHT" \
      "btrfs-assistant 没有返回可解析的恢复条目" "1" "${BA_PREFLIGHT_OUTPUT:-无输出}"
    return 1
  fi
  BA_PREFLIGHT_DONE=1
  return 0
}

if [[ "$OPT_NATIVE_ROOT_FALLBACK" -eq 0 && -z "$OPT_NATIVE_ROOT_ROLLBACK" ]]; then
  probe_btrfs_assistant || exit 1
elif [[ "$OPT_NATIVE_ROOT_FALLBACK" -eq 1 ]]; then
  ui_warn "已显式选择原生 root 恢复后端：会保留当前 root 子卷，随后重启。"
else
  ui_warn "已显式选择原生 root 回退：会保留当前恢复 root，并换回此前保留的 root。"
fi

TARGET_DESC=""
# 回退只交换两个已存在的顶级子卷；恢复后的 Snapper 配置可能暂时不可用，
# 因此绝不能为了推导一个快照描述而查询 .snapshots。
if [[ -n "$OPT_NATIVE_ROOT_ROLLBACK" ]]; then
  TARGET_DESC="原生 root 回退"
elif [[ -n "$OPT_DESC" ]]; then
  TARGET_DESC="$OPT_DESC"
else
  for test_desc in "${FALLBACK_DESCS[@]}"; do
    if [[ -n "${CONFIG_MAP["root"]:-}" ]]; then
      test_conf="root"
    else
      for test_conf in "${!CONFIG_MAP[@]}"; do break; done
    fi
    test_out=$(get_snapper_list_output "$test_conf")
    if echo "$test_out" | awk -F "$SNAP_SEP" -v d="$test_desc" '$1 ~ /^[0-9]+$/ && $3 == d {found=1} END {exit !found}'; then
      TARGET_DESC="$test_desc"
      break
    fi
  done
fi
[[ -z "$TARGET_DESC" ]] && TARGET_DESC="quicksave"

get_snap_id_by_desc() {
  local conf="$1"
  local desc="$2"
  local list_out
  list_out=$(get_snapper_list_output "$conf")
  echo "$list_out" | awk -F "$SNAP_SEP" -v d="$desc" '
    $1 ~ /^[0-9]+$/ && $3 == d { print $1 }
  ' | tail -n 1
}

get_snap_id_by_desc_date() {
  local conf="$1"
  local desc="$2"
  local date="$3"
  local list_out
  list_out=$(get_snapper_list_output "$conf")
  echo "$list_out" | awk -F "$SNAP_SEP" -v d="$desc" -v wanted_date="$date" '
    $1 ~ /^[0-9]+$/ && $3 == d && $2 == wanted_date { print $1 }
  ' | tail -n 1
}

get_snap_id_by_batch() {
  local conf="$1"
  local batch="$2"
  local list_out
  list_out=$(get_snapper_list_output "$conf")
  echo "$list_out" | awk -F "$SNAP_SEP" -v wanted="maintenance_batch=$batch" '
    $1 ~ /^[0-9]+$/ {
      n=split($4, pairs, ",")
      for (i=1; i<=n; i++) if (pairs[i] == wanted) print $1
    }
  ' | tail -n 1
}

get_snap_id_by_desc_near_date() {
  local conf="$1"
  local desc="$2"
  local wanted_date="$3"
  local tolerance="${4:-120}"
  local wanted_epoch sid date _desc _userdata epoch diff
  local best_id="" best_diff=$((tolerance + 1))
  local list_out

  wanted_epoch="$(date -d "$wanted_date" +%s 2>/dev/null || true)"
  [[ "$wanted_epoch" =~ ^[0-9]+$ ]] || return 1
  list_out="$(get_snapper_list_output "$conf")" || return 1
  while IFS="$SNAP_SEP" read -r sid date _desc _userdata; do
    [[ "$sid" =~ ^[1-9][0-9]*$ && "$_desc" == "$desc" ]] || continue
    epoch="$(date -d "$date" +%s 2>/dev/null || true)"
    [[ "$epoch" =~ ^[0-9]+$ ]] || continue
    diff=$((epoch - wanted_epoch))
    (( diff < 0 )) && diff=$((-diff))
    if (( diff < best_diff )); then
      best_id="$sid"
      best_diff="$diff"
    fi
  done <<< "$list_out"
  if (( best_diff <= tolerance )); then
    printf '%s\n' "$best_id"
  fi
  return 0
}

get_snap_date_by_id() {
  local conf="$1" wanted_id="$2"
  get_snapper_list_output "$conf" | awk -F "$SNAP_SEP" -v id="$wanted_id" '$1 == id {print $2; exit}'
}

snapshot_batch_from_userdata() {
  local userdata="$1" pair
  local -a pairs=()
  IFS=',' read -r -a pairs <<< "$userdata"
  for pair in "${pairs[@]}"; do
    if [[ "$pair" == maintenance_batch=* ]]; then
      printf '%s' "${pair#maintenance_batch=}"
      return 0
    fi
  done
  return 0
}

select_menu_choice() {
  local result_var="$1"
  local menu_title="$2"
  local menu_wide="$3"
  shift 3
  local menu_opts=("$@")
  local choice=""
  local user_input=""

  if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
    # TTY 下优先用 fzf，与 term-menu 整体风格统一（rounded 边框 + Catppuccin 配色）。
    # 选项按 <TAB> 拆为「标签 \t 说明」：列表只显示标签，右侧预览展开说明。
    local fzf_opts=()
    mapfile -t fzf_opts < <(ui_fzf_base "╢  $menu_title ╟")
    local height="60%"
    [[ "$menu_wide" == 1 ]] && height="100%"
    choice=$(printf '%s\n' "${menu_opts[@]}" |
      fzf "${fzf_opts[@]}" \
        --height="$height" \
        --min-height=14 \
        --cycle \
        --delimiter='\t' \
        --with-nth=1 \
        --border-label-pos=3 \
        --preview-window='right,52%,border-rounded,wrap' \
        --preview-label=' 说明 ' \
        --preview='printf "%b" {2}' \
        --pointer='▶' 2>/dev/null || true)
    # fzf 返回整行（含说明），只取第一列（标签）供调用方映射
    choice="${choice%%$'\t'*}"
    # Esc/取消返回空串，由调用方按“取消”处理
  elif [[ -t 0 && -t 1 ]]; then
    # 无 fzf 时回退到数字序号输入：只显示标签列
    echo "=== $menu_title ==="
    for i in "${!menu_opts[@]}"; do
      printf "  %d) %s\n" "$((i + 1))" "${menu_opts[$i]%%$'\t'*}"
    done
    while true; do
      read -r -p "$MSG_PROMPT" user_input
      if [[ "$user_input" =~ ^[0-9]+$ ]] && ((user_input > 0 && user_input <= ${#menu_opts[@]})); then
        choice="${menu_opts[$((user_input - 1))]%%$'\t'*}"
        break
      else
        echo "$MSG_INVALID"
      fi
    done
  else
    local opts_str
    local fuzzel_args=(--dmenu --prompt="$menu_title > ")
    local wofi_args=(--dmenu --prompt="$menu_title")
    local rofi_args=(-dmenu -p "$menu_title")
    local zenity_args=(--list --title="$menu_title" --column="选项" --hide-header)

    if [[ "$menu_wide" == 1 ]]; then
      fuzzel_args+=(--width=60)
      wofi_args+=(--width=900)
      rofi_args+=(-width 90)
      zenity_args+=(--width=900)
    fi

    # 图形 dmenu 无预览，只喂标签列
    local opt
    local labels_only=()
    for opt in "${menu_opts[@]}"; do
      labels_only+=("${opt%%$'\t'*}")
    done
    opts_str=$(printf "%s\n" "${labels_only[@]}")
    if command -v fuzzel >/dev/null 2>&1; then
      choice=$(printf "%s\n" "$opts_str" | run_as_user fuzzel "${fuzzel_args[@]}" 2>/dev/null || true)
    elif command -v wofi >/dev/null 2>&1; then
      choice=$(printf "%s\n" "$opts_str" | run_as_user wofi "${wofi_args[@]}" 2>/dev/null || true)
    elif command -v rofi >/dev/null 2>&1; then
      choice=$(printf "%s\n" "$opts_str" | run_as_user rofi "${rofi_args[@]}" 2>/dev/null || true)
    elif command -v zenity >/dev/null 2>&1; then
      choice=$(printf "%s\n" "$opts_str" | run_as_user zenity "${zenity_args[@]}" 2>/dev/null || true)
    fi
  fi

  printf -v "$result_var" '%s' "$choice"
}

choose_restore_snapshot() {
  local descs_raw=()
  local snapshot_menu_opts=()
  local snapshot_choice=""
  local entry desc conf sid date userdata batch label list_out
  local sorted_descs=()
  local -A snapshot_choice_map

  if [[ -n "${CONFIG_MAP["root"]:-}" ]]; then
    conf="root"
  else
    for conf in "${!CONFIG_MAP[@]}"; do break; done
  fi

  list_out=$(get_snapper_list_output "$conf")
  while IFS="$SNAP_SEP" read -r sid date desc userdata; do
    if [[ "$sid" == "number" || "$sid" == "0" || -z "$desc" || "$desc" == "current" ]]; then
      continue
    fi
    batch="$(snapshot_batch_from_userdata "$userdata")"
    descs_raw+=("$desc|$sid|$date|$batch")
  done <<< "$list_out"

  if [[ ${#descs_raw[@]} -eq 0 ]]; then
    notify_err "$MSG_SELECT_EMPTY"
    return 1
  fi

  readarray -t sorted_descs < <(printf "%s\n" "${descs_raw[@]}" | sort -t'|' -k2,2nr)
  local lbl_only
  for entry in "${sorted_descs[@]}"; do
    IFS='|' read -r desc sid date batch <<<"$entry"
    # label：图标+时间·类型 \t 说明；map 的 key 用标签列（第一列），与 fzf 返回一致
    label=$(printf "$MSG_SELECT_FMT" "$date" "$desc" "$desc" "$sid" "$date")
    lbl_only="${label%%$'\t'*}"
    snapshot_menu_opts+=("$label")
    snapshot_choice_map["$lbl_only"]="$desc|$date|$batch"
  done
  snapshot_menu_opts+=("$MSG_SELECT_BACK")

  select_menu_choice snapshot_choice "$MSG_SELECT_TITLE" 1 "${snapshot_menu_opts[@]}"
  if [[ -z "$snapshot_choice" || "$snapshot_choice" == "$MSG_SELECT_BACK" ]]; then
    return 1
  fi

  if [[ -n "${snapshot_choice_map[$snapshot_choice]:-}" ]]; then
    IFS='|' read -r OPT_DESC TARGET_SNAPSHOT_DATE TARGET_SNAPSHOT_BATCH <<< "${snapshot_choice_map[$snapshot_choice]}"
    TARGET_DESC="$OPT_DESC"
    TARGET_SNAPSHOT_LABEL="$snapshot_choice"
  else
    notify_err "$MSG_UNKNOWN_CHOICE" "$snapshot_choice"
    return 1
  fi
}

get_btrfs_subvol_name() {
  local mount_point="$1"
  local source_line
  source_line=$(findmnt -n -o SOURCE "$mount_point" || true)

  if [[ "$source_line" == *"["* ]]; then
    local subvol_path
    subvol_path=$(echo "$source_line" | cut -d'[' -f2 | cut -d']' -f1)
    local base_subvol="${subvol_path%%/.snapshots*}"
    base_subvol="${base_subvol%%_backup_*}"
    echo "${base_subvol#/}"
  else
    local cleaned_line="${source_line#/}"
    cleaned_line="${cleaned_line%%_backup_*}"
    echo "$cleaned_line" | awk -F'/' '{print $NF}' || true
  fi
}

delete_native_restore_clone() {
  local clone_root="$1"
  # 嵌套 /.snapshots 已创建时，Btrfs 要求先删子卷再删父 clone；无论清理
  # 是否成功都保留原始错误路径，绝不触碰当前 @。
  if btrfs subvolume show "$clone_root/.snapshots" >/dev/null 2>&1; then
    btrfs subvolume delete "$clone_root/.snapshots" >/dev/null 2>&1 || true
  fi
  btrfs subvolume delete "$clone_root" >/dev/null 2>&1 || true
}

prepare_native_snapper_storage() {
  local clone_root="$1"
  local snapshots_dir="$clone_root/.snapshots"

  # Btrfs 不会把嵌套子卷包含进父快照。因此从 root Snapper 快照克隆出的
  # 新 root 往往只有一个普通的空 /.snapshots 目录；若不重建为子卷，下一次
  # snapper list/create 会报“不是 Btrfs 子卷”。只接受缺失或空目录，绝不删除
  # 任何未知快照数据。
  if [[ -e "$snapshots_dir" ]]; then
    if btrfs subvolume show "$snapshots_dir" >/dev/null 2>&1; then
      return 0
    fi
    if [[ ! -d "$snapshots_dir" || -n "$(find "$snapshots_dir" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
      notify_err "错误: 恢复 root 中的 /.snapshots 不是空目录，拒绝替换它。"
      return 1
    fi
    rmdir "$snapshots_dir" || {
      notify_err "错误: 无法移除恢复 root 中的空 /.snapshots 目录。"
      return 1
    }
  fi
  if ! btrfs subvolume create "$snapshots_dir" >/dev/null; then
    notify_err "错误: 无法为恢复 root 重建 /.snapshots 子卷。"
    return 1
  fi
  chmod 750 "$snapshots_dir" || {
    notify_err "错误: 无法设置恢复 root /.snapshots 的权限。"
    return 1
  }
  if ! btrfs subvolume show "$snapshots_dir" >/dev/null 2>&1; then
    notify_err "错误: 新建的恢复 root /.snapshots 不是可验证的 Btrfs 子卷。"
    return 1
  fi
  return 0
}

native_root_restore() {
  local snap_id="$1"
  local source_line root_mount_options device active_subvol top source clone previous stamp

  [[ "$snap_id" =~ ^[1-9][0-9]*$ ]] || {
    notify_err "错误: 原生 root 恢复拿到了无效快照 ID: %s" "$snap_id"
    return 1
  }
  source_line="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  root_mount_options="$(findmnt -n -o OPTIONS / 2>/dev/null || true)"
  device="${source_line%%[*}"
  active_subvol="${source_line#*[}"
  active_subvol="${active_subvol%]}"
  active_subvol="${active_subvol#/}"
  # 原生交换会重命名顶级 root 子卷；仅支持 Arch 常见的顶级 @ 布局，拒绝
  # 嵌套/未知布局，不能为了“尽量恢复”而猜路径。还必须确认当前挂载确实
  # 通过 subvol=@（而非只有 subvolid）选择它；否则重命名不能证明下一次
  # GRUB/内核启动会选择新副本。
  if [[ "$device" != /dev/* || ! "$active_subvol" =~ ^@[A-Za-z0-9._-]*$ ]]; then
    notify_err "错误: 当前 root 子卷布局不受原生恢复后端支持: %s" "$source_line"
    return 1
  fi
  case ",$root_mount_options," in
    *,subvol="$active_subvol",*|*,subvol=/$active_subvol,*) ;;
    *)
      notify_err "$MSG_ERR_NATIVE_LAYOUT"
      ui_info "当前挂载选项：%s" "${root_mount_options:-无}"
      return 1
      ;;
  esac

  top="$(mktemp -d /run/quickload-native-root.XXXXXX)" || {
    notify_err "错误: 无法创建原生 root 恢复临时挂载目录。"
    return 1
  }
  local mounted=0
  # shellcheck disable=SC2329 # 由下方 RETURN trap 调用。
  native_cleanup() {
    if [[ "$mounted" -eq 1 ]]; then umount "$top" 2>/dev/null || true; fi
    rmdir "$top" 2>/dev/null || true
  }
  trap native_cleanup RETURN

  mount -o subvolid=5 "$device" "$top" || {
    notify_err "错误: 无法挂载 Btrfs 顶级子卷: %s" "$device"
    return 1
  }
  mounted=1
  source="$top/$active_subvol/.snapshots/$snap_id/snapshot"
  if [[ ! -d "$source" || ! -f "$source/etc/fstab" ]]; then
    notify_err "错误: root 快照路径不完整，拒绝原生恢复: %s" "$source"
    return 1
  fi
  # 不把普通目录或被错误挂载的路径当成子卷。两次 show 都成功后，下面的
  # rename 才只会交换同一顶级 Btrfs 文件系统中的两个根子卷。
  if ! btrfs subvolume show "$top/$active_subvol" >/dev/null 2>&1       || ! btrfs subvolume show "$source" >/dev/null 2>&1; then
    notify_err "错误: 活动 root 或目标快照不是可验证的 Btrfs 子卷，拒绝恢复。"
    return 1
  fi

  stamp="$(date '+%Y%m%dT%H%M%S')-$$"
  clone="@quickload-restore-$stamp"
  previous="@quickload-pre-$stamp"
  if [[ -e "$top/$clone" || -e "$top/$previous" ]]; then
    notify_err "错误: 原生恢复保留路径已存在，拒绝覆盖: %s / %s" "$clone" "$previous"
    return 1
  fi
  ui_info "正在从 root 快照 #%s 创建可写恢复子卷…" "$snap_id"
  btrfs subvolume snapshot "$source" "$top/$clone" || return 1
  if ! btrfs subvolume show "$top/$clone" >/dev/null 2>&1; then
    notify_err "错误: 新 root 恢复子卷校验失败，未切换当前 root。"
    delete_native_restore_clone "$top/$clone"
    return 1
  fi
  if ! prepare_native_snapper_storage "$top/$clone"; then
    delete_native_restore_clone "$top/$clone"
    return 1
  fi

  # 当前 root 即使已被挂载，也会继续使用同一 subvolume ID；重命名只影响下次
  # 按 fstab/GRUB 的 subvol=@ 启动。先保留旧 root，再发布恢复副本；第二步失败
  # 时立即把旧 root 改回，绝不留下没有 @ 的不可启动布局。
  sync
  if ! mv "$top/$active_subvol" "$top/$previous"; then
    notify_err "错误: 无法保留当前 root 子卷，未执行恢复。"
    btrfs subvolume delete "$top/$clone" >/dev/null 2>&1 || true
    return 1
  fi
  if ! mv "$top/$clone" "$top/$active_subvol"; then
    mv "$top/$previous" "$top/$active_subvol" || notify_err "严重错误: 自动恢复旧 root 名称失败: %s" "$previous"
    notify_err "错误: 发布恢复 root 失败；已尝试恢复原 root，系统不会自动重启。"
    return 1
  fi
  # 发布已经完成后，不能再把 sync/reboot 的失败静默成“操作失败”。此时
  # 新 @ 已经是下一次启动目标，必须明确保留现场、禁止盲目重启并让用户从
  # 救援环境检查，而不是继续自动改名造成更多风险。
  if ! sync; then
    notify_err "严重错误: 新 root 已发布为 /%s，但同步失败；不要重启，请从救援环境检查 Btrfs 后再决定。" "$active_subvol"
    return 1
  fi
  notify_ok "原生 root 恢复已准备完成。\n旧 root 保留为 /$previous；系统即将重启。"
  umount "$top"
  mounted=0
  rmdir "$top"
  trap - RETURN
  sleep 3
  if ! reboot; then
    notify_err "严重错误: 新 root 已发布，但自动重启请求失败。请确认磁盘健康后手动重启；旧 root 仍在 /%s。" "$previous"
    return 1
  fi
}

native_root_rollback() {
  local requested="$1"
  local source_line root_mount_options device active_subvol top previous rejected stamp

  source_line="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  root_mount_options="$(findmnt -n -o OPTIONS / 2>/dev/null || true)"
  device="${source_line%%[*}"
  active_subvol="${source_line#*[}"
  active_subvol="${active_subvol%]}"
  active_subvol="${active_subvol#/}"
  if [[ "$device" != /dev/* || ! "$active_subvol" =~ ^@[A-Za-z0-9._-]*$ ]]; then
    notify_err "错误: 当前 root 子卷布局不受原生回退支持: %s" "$source_line"
    return 1
  fi
  case ",$root_mount_options," in
    *,subvol="$active_subvol",*|*,subvol=/$active_subvol,*) ;;
    *)
      notify_err "$MSG_ERR_NATIVE_LAYOUT"
      ui_info "当前挂载选项：%s" "${root_mount_options:-无}"
      return 1
      ;;
  esac

  top="$(mktemp -d /run/quickload-native-root.XXXXXX)" || {
    notify_err "错误: 无法创建原生 root 回退临时挂载目录。"
    return 1
  }
  local mounted=0
  # shellcheck disable=SC2329 # 由下方 RETURN trap 调用。
  native_rollback_cleanup() {
    if [[ "$mounted" -eq 1 ]]; then umount "$top" 2>/dev/null || true; fi
    rmdir "$top" 2>/dev/null || true
  }
  trap native_rollback_cleanup RETURN
  mount -o subvolid=5 "$device" "$top" || {
    notify_err "错误: 无法挂载 Btrfs 顶级子卷: %s" "$device"
    return 1
  }
  mounted=1

  if [[ "$requested" == "latest" ]]; then
    previous="$(find "$top" -maxdepth 1 -mindepth 1 -type d -name '@quickload-pre-*' -printf '%f\n' | LC_ALL=C sort | tail -n 1)"
  else
    previous="$requested"
  fi
  if [[ ! "$previous" =~ ^@quickload-pre-[0-9TZ-]+$ || ! -d "$top/$previous" ]]; then
    notify_err "错误: 找不到可安全回退的保留 root: %s" "$requested"
    return 1
  fi
  if ! btrfs subvolume show "$top/$active_subvol" >/dev/null 2>&1 \
      || ! btrfs subvolume show "$top/$previous" >/dev/null 2>&1; then
    notify_err "错误: 当前 root 或保留 root 不是可验证的 Btrfs 子卷，拒绝回退。"
    return 1
  fi

  stamp="$(date '+%Y%m%dT%H%M%S')-$$"
  rejected="@quickload-rejected-$stamp"
  [[ ! -e "$top/$rejected" ]] || {
    notify_err "错误: 回退保留路径已存在，拒绝覆盖: %s" "$rejected"
    return 1
  }
  ui_info "正在换回保留 root /%s；当前恢复 root 会保留为 /%s…" "$previous" "$rejected"
  sync
  if ! mv "$top/$active_subvol" "$top/$rejected"; then
    notify_err "错误: 无法保留当前恢复 root，未执行回退。"
    return 1
  fi
  if ! mv "$top/$previous" "$top/$active_subvol"; then
    mv "$top/$rejected" "$top/$active_subvol" || notify_err "严重错误: 自动恢复当前 root 名称失败: %s" "$rejected"
    notify_err "错误: 发布回退 root 失败；已尝试恢复当前 root，系统不会自动重启。"
    return 1
  fi
  if ! sync; then
    notify_err "严重错误: 回退 root 已发布为 /%s，但同步失败；不要重启，请从救援环境检查 Btrfs 后再决定。" "$active_subvol"
    return 1
  fi
  notify_ok "原生 root 回退已准备完成。\n此前的恢复 root 保留为 /$rejected；系统即将重启。"
  umount "$top"
  mounted=0
  rmdir "$top"
  trap - RETURN
  sleep 3
  if ! reboot; then
    notify_err "严重错误: 回退 root 已发布，但自动重启请求失败。请确认磁盘健康后手动重启；此前恢复 root 仍在 /%s。" "$rejected"
    return 1
  fi
}

# ==========================================
# 核心执行引擎 (需要高权限)
# ==========================================
cancel_to_parent() {
  if [[ "${TERM_MENU_CHILD:-0}" == "1" ]]; then
    exit 130
  fi
  exit 0
}

execute_restore() {
  local selected_action="$1"

  if [[ "$selected_action" == "cancel" ]]; then
    echo "$MSG_CANCEL"
    cancel_to_parent
  fi

  if [[ $OPT_NOCONFIRM -ne 1 ]]; then
    local target_summary
    if [[ -n "$OPT_NATIVE_ROOT_ROLLBACK" ]]; then
      target_summary="原生 root 回退：把 /@quickload-pre-* 换回 /@；当前恢复 root 会保留为 /@quickload-rejected-*"
      if ! ui_confirm_word "$target_summary。此操作会在完成后重启。" "rollback"; then
        echo "$MSG_CANCEL"
        cancel_to_parent
      fi
    else
      target_summary="范围：$selected_action；快照：${TARGET_DESC:-自动选择最新可用项}"
      [[ -n "$TARGET_SNAPSHOT_DATE" ]] && target_summary+="；时间：$TARGET_SNAPSHOT_DATE"
      [[ -n "$TARGET_SNAPSHOT_BATCH" ]] && target_summary+="；批次：$TARGET_SNAPSHOT_BATCH"
      if ! ui_confirm_word "$target_summary。恢复会覆盖对应文件并在完成后重启。" "restore"; then
        echo "$MSG_CANCEL"
        cancel_to_parent
      fi
    fi
  fi

  # 拦截提权点：如果仍是普通用户，携带决定好的目标参数重新唤醒自身 (此时触发密码)
  if [[ $EUID -ne 0 && "${QUICKLOAD_TEST_MODE:-0}" != "1" ]]; then
    local new_args=("-n" "-c" "$selected_action")
    [[ -n "$TARGET_DESC" ]] && new_args+=("-d" "$TARGET_DESC")
    [[ -n "$TARGET_SNAPSHOT_DATE" ]] && new_args+=("--snapshot-date" "$TARGET_SNAPSHOT_DATE")
    [[ -n "$TARGET_SNAPSHOT_BATCH" ]] && new_args+=("--snapshot-batch" "$TARGET_SNAPSHOT_BATCH")
    [[ "$OPT_NATIVE_ROOT_FALLBACK" -eq 1 ]] && new_args+=("--native-root-fallback")
    [[ -n "$OPT_NATIVE_ROOT_ROLLBACK" ]] && new_args+=("--native-root-rollback" "$OPT_NATIVE_ROOT_ROLLBACK")
    [[ $OPT_DEBUG -eq 1 ]] && new_args+=("-x")
    require_root "${new_args[@]}"
  fi

  ui_maintenance_lock_acquire "快照恢复" || exit $?

  if [[ -n "$OPT_NATIVE_ROOT_ROLLBACK" ]]; then
    if [[ "$selected_action" != "root" ]]; then
      notify_err "错误: 原生 root 回退仅支持 root 配置。"
      exit 2
    fi
    if native_root_rollback "$OPT_NATIVE_ROOT_ROLLBACK"; then
      exit 0
    else
      exit $?
    fi
  fi

  if [[ "$OPT_NATIVE_ROOT_FALLBACK" -eq 1 ]]; then
    if [[ "$selected_action" != "root" ]]; then
      notify_err "错误: 原生恢复后端仅支持 root 配置。"
      exit 2
    fi
    local native_snap_id=""
    if [[ -n "$TARGET_SNAPSHOT_BATCH" ]]; then
      native_snap_id=$(get_snap_id_by_batch root "$TARGET_SNAPSHOT_BATCH")
    elif [[ -n "$OPT_DESC" && -n "$TARGET_SNAPSHOT_DATE" ]]; then
      native_snap_id=$(get_snap_id_by_desc_date root "$OPT_DESC" "$TARGET_SNAPSHOT_DATE")
    elif [[ -n "$OPT_DESC" ]]; then
      native_snap_id=$(get_snap_id_by_desc root "$OPT_DESC")
    else
      for d in "${FALLBACK_DESCS[@]}"; do
        native_snap_id=$(get_snap_id_by_desc root "$d")
        [[ -n "$native_snap_id" ]] && break
      done
    fi
    [[ -n "$native_snap_id" ]] || {
      notify_err "$MSG_ERR_MATCH" "root" "${OPT_DESC:-Fallback序列}"
      exit 1
    }
    if native_root_restore "$native_snap_id"; then
      exit 0
    else
      exit $?
    fi
  fi

  local configs_to_restore=()
  if [[ "$selected_action" == "all" ]]; then
    [[ -n "${CONFIG_MAP[home]:-}" ]] && configs_to_restore+=("home")
    while IFS= read -r conf; do
      [[ "$conf" == "home" || "$conf" == "root" ]] && continue
      configs_to_restore+=("$conf")
    done < <(printf '%s\n' "${!CONFIG_MAP[@]}" | sort)
    [[ -n "${CONFIG_MAP[root]:-}" ]] && configs_to_restore+=("root")
  else
    if [[ -z "${CONFIG_MAP[$selected_action]:-}" ]]; then
      notify_err "$MSG_UNKNOWN_CHOICE" "$selected_action"
      exit 1
    fi
    configs_to_restore=("$selected_action")
  fi

  # 预加载列表以减少进程呼叫开销。不要吞掉失败，否则 btrfs-assistant 崩溃会伪装成“匹配不到 ID”。
  local ba_list_output="$BA_PREFLIGHT_OUTPUT"
  if [[ "$BA_PREFLIGHT_DONE" -ne 1 ]]; then
    notify_err "$MSG_ERR_BA_LIST" "恢复后端没有通过预检"
    exit 1
  fi
  local restore_ba_ids=()
  local min_epoch=0 max_epoch=0 snap_date snap_epoch common_desc="" resolved_desc=""

  for conf in "${configs_to_restore[@]}"; do
    local snap_id=""
    resolved_desc="${OPT_DESC:-}"
    if [[ -n "$TARGET_SNAPSHOT_BATCH" ]]; then
      snap_id=$(get_snap_id_by_batch "$conf" "$TARGET_SNAPSHOT_BATCH")
    elif [[ -n "$OPT_DESC" && -n "$TARGET_SNAPSHOT_DATE" ]]; then
      if [[ "$selected_action" == "all" ]]; then
        snap_id=$(get_snap_id_by_desc_near_date "$conf" "$OPT_DESC" "$TARGET_SNAPSHOT_DATE")
      else
        snap_id=$(get_snap_id_by_desc_date "$conf" "$OPT_DESC" "$TARGET_SNAPSHOT_DATE")
      fi
    elif [[ -n "$OPT_DESC" ]]; then
      snap_id=$(get_snap_id_by_desc "$conf" "$OPT_DESC")
    else
      for d in "${FALLBACK_DESCS[@]}"; do
        snap_id=$(get_snap_id_by_desc "$conf" "$d")
        if [[ -n "$snap_id" ]]; then
          resolved_desc="$d"
          break
        fi
      done
    fi

    if [[ -z "$snap_id" ]]; then
      notify_err "$MSG_ERR_MATCH" "$conf" "${OPT_DESC:-Fallback序列}"
      exit 1
    fi

    local mnt="${CONFIG_MAP[$conf]}"
    local base_subvol
    base_subvol=$(get_btrfs_subvol_name "$mnt")

    local ba_id
    local ba_matches=()
    mapfile -t ba_matches < <(
      awk -v subv="$base_subvol" -v sid="$snap_id" \
        '$1 ~ /^[0-9]+$/ && $2 == subv && $3 == sid {print $1}' <<< "$ba_list_output"
    )
    if [[ "${#ba_matches[@]}" -ne 1 ]]; then
      notify_err "${MSG_ERR_BA}配置 [%s] 快照 #%s 匹配到 %s 个恢复 ID，要求恰好 1 个。\n" \
        "$conf" "$snap_id" "${#ba_matches[@]}"
      exit 1
    fi
    ba_id="${ba_matches[0]}"
    restore_ba_ids+=("$ba_id")

    if [[ "$selected_action" == "all" && -z "$TARGET_SNAPSHOT_BATCH" ]]; then
      if [[ -z "$common_desc" ]]; then
        common_desc="$resolved_desc"
      elif [[ "$resolved_desc" != "$common_desc" ]]; then
        notify_err "错误: 旧快照描述不一致（%s / %s），已拒绝全部还原。" "$common_desc" "$resolved_desc"
        exit 1
      fi
      snap_date="$(get_snap_date_by_id "$conf" "$snap_id")"
      snap_epoch="$(date -d "$snap_date" +%s 2>/dev/null || true)"
      if [[ ! "$snap_epoch" =~ ^[0-9]+$ ]]; then
        notify_err "错误: 无法解析配置 [%s] 快照 #%s 的时间。" "$conf" "$snap_id"
        exit 1
      fi
      (( min_epoch == 0 || snap_epoch < min_epoch )) && min_epoch=$snap_epoch
      (( snap_epoch > max_epoch )) && max_epoch=$snap_epoch
    fi
  done

  if [[ "$selected_action" == "all" && -z "$TARGET_SNAPSHOT_BATCH" ]] \
      && (( max_epoch - min_epoch > 120 )); then
    notify_err "错误: 旧快照无法组成可靠批次（时间跨度超过 120 秒），已拒绝全部还原。"
    exit 1
  fi

  local completed_ba_ids=()
  for ba_id in "${restore_ba_ids[@]}"; do
    printf "$MSG_RESTORE_DOING" "$ba_id"
    if env -u DISPLAY -u WAYLAND_DISPLAY -u XDG_RUNTIME_DIR LC_ALL=C btrfs-assistant -r "$ba_id"; then
      completed_ba_ids+=("$ba_id")
    else
      notify_err "恢复 ID %s 失败。已完成的恢复 ID：%s。系统不会自动重启，请先检查 btrfs-assistant 备份子卷。" \
        "$ba_id" "${completed_ba_ids[*]:-无}"
      exit 1
    fi
  done

  notify_ok "======================================\n$MSG_NOTIFY_SUCC_BODY\n======================================"
  sleep 3
  reboot
}

if [[ $OPT_NOCONFIRM -eq 1 || -n "$OPT_CONFIG" ]]; then
  if [[ -n "$OPT_CONFIG" ]]; then
    execute_restore "$OPT_CONFIG"
  else
    execute_restore "all"
  fi
  exit 0
fi

# ==========================================
# 交互式 UI 菜单生成 (普通用户侧执行)
# ==========================================
ui_banner "恢复快照" "quickload · Btrfs 快照回档"

declare -A CHOICE_MAP

while true; do
  MENU_TITLE="$MSG_TITLE"
  [[ -n "$TARGET_DESC" ]] && MENU_TITLE="$MSG_TITLE [$TARGET_DESC]"

  CHOICE_MAP=()
  # 选项含「标签 \t 说明」；fzf 只返回标签列，故 CHOICE_MAP 用标签列做 key。
  add_opt() {  # $1=完整选项串(含\t说明)  $2=动作值
    local full="$1" action="$2"
    MENU_OPTS+=("$full")
    CHOICE_MAP["${full%%$'\t'*}"]="$action"
  }

  MENU_OPTS=()
  add_opt "$MSG_OPT_BOTH" "all"

  # 固定顺序：root 优先、home 次之、其余按字母序。
  # 关联数组遍历顺序不确定，直接遍历会导致每次菜单项顺序乱跳。
  ordered_confs=()
  [[ -n "${CONFIG_MAP["root"]:-}" ]] && ordered_confs+=("root")
  [[ -n "${CONFIG_MAP["home"]:-}" ]] && ordered_confs+=("home")
  while IFS= read -r conf; do
    [[ "$conf" == "root" || "$conf" == "home" ]] && continue
    ordered_confs+=("$conf")
  done < <(printf '%s\n' "${!CONFIG_MAP[@]}" | sort)

  for conf in "${ordered_confs[@]}"; do
    if [[ "$conf" == "root" ]]; then
      add_opt "$MSG_OPT_ROOT" "root"
    elif [[ "$conf" == "home" ]]; then
      add_opt "$MSG_OPT_HOME" "home"
    else
      add_opt "$(printf "$MSG_OPT_ONLY" "$conf" "$conf")" "$conf"
    fi
  done

  add_opt "$MSG_OPT_SELECT" "select_snapshot"
  add_opt "$MSG_OPT_CANCEL" "cancel"
  CHOICE=""

  select_menu_choice CHOICE "$MENU_TITLE" 0 "${MENU_OPTS[@]}"
  [[ -z "$CHOICE" ]] && cancel_to_parent
  SELECTION="${CHOICE_MAP["$CHOICE"]:-}"

  if [[ "$SELECTION" == "select_snapshot" ]]; then
    if choose_restore_snapshot; then
      printf "$MSG_SELECTED_SNAPSHOT" "${TARGET_SNAPSHOT_LABEL:-$TARGET_DESC}"
    fi
    continue
  elif [[ -n "$SELECTION" ]]; then
    execute_restore "$SELECTION"
  else
    notify_err "$MSG_UNKNOWN_CHOICE" "$CHOICE"
    exit 1
  fi
done
