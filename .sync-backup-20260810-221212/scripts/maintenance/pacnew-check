#!/usr/bin/env bash
set -euo pipefail

UI_LIB="$(dirname "$(readlink -f "$0")")/lib/ui.sh"
# shellcheck source=lib/ui.sh
. "$UI_LIB"

have() { command -v "$1" >/dev/null 2>&1; }

SUDO_READ=()

request_read_access() {
  [[ "$EUID" -eq 0 ]] && return 0
  [[ -t 0 && -t 1 ]] || return 0
  if ! have sudo; then
    ui_err "完整 pacnew 检查需要 sudo，但当前没有 sudo 命令"
    return 1
  fi
  ui_info "将请求管理员密码，仅用于完整扫描系统配置，不会合并或覆盖文件。"
  if ! sudo -v; then
    ui_err "管理员权限验证失败，已取消 pacnew 检查"
    return 1
  fi
  SUDO_READ=(sudo -n)
}

_PANEL_OPEN=false
panel() {
  [[ "$_PANEL_OPEN" == true ]] && ui_panel_close
  ui_panel_open "$1" "${2:-}"
  _PANEL_OPEN=true
}
panel_end() {
  [[ "$_PANEL_OPEN" == true ]] && ui_panel_close
  _PANEL_OPEN=false
}

main() {
  local strict=0 query_failed=0
  if (( $# > 1 )); then
    ui_err "参数过多；用法: pacnew-check [--strict]"
    return 2
  fi
  case "${1:-}" in
    --strict) strict=1 ;;
    -h|--help) printf '用法: pacnew-check [--strict]\n'; return 0 ;;
    "") ;;
    *) ui_err "未知参数: %s" "$1"; return 2 ;;
  esac
  ui_tally_reset
  ui_banner "pacnew 检查" "pacnew-check · 只读列出，不覆盖配置"
  request_read_access || return $?

  panel "这项检查做什么" ""
  ui_panel_line ".pacnew 是软件包提供的新配置，更新后需要你和现有配置人工合并。"
  ui_panel_line ".pacsave 是包管理器保存的旧配置；本工具只列出它们，不会自动处理。"
  ui_panel_line "sudo 仅用于完整扫描 /etc 与 /boot，避免把权限不足误报成没有残留。"

  panel "pacnew / pacsave" ""
  if ! have pacdiff; then
    ui_panel_stat miss "缺少 pacdiff；请安装 pacman-contrib"
    panel_end
    exit 1
  fi

  local pacdiff_output pacdiff_error_file pacdiff_error pacdiff_status=0
  pacdiff_error_file="$(mktemp)"
  pacdiff_output="$("${SUDO_READ[@]}" pacdiff --output 2> "$pacdiff_error_file")" \
    || pacdiff_status=$?
  pacdiff_error="$(< "$pacdiff_error_file")"
  rm -f -- "$pacdiff_error_file"

  if [[ "$pacdiff_status" -ne 0 ]]; then
    ui_panel_stat err "pacdiff 查询失败（退出码 $pacdiff_status）"
    [[ -n "$pacdiff_error" ]] && printf '%s\n' "$pacdiff_error" | ui_panel_raw
    query_failed=1
  elif [[ -z "$pacdiff_output" ]]; then
    ui_panel_stat ok "未发现需要处理的 .pacnew / .pacsave"
  else
    ui_panel_stat warn "发现需要人工合并或处理的配置文件："
    printf '%s\n' "$pacdiff_output" | ui_panel_raw
    ui_panel_blank
    ui_panel_line "${UI_BOLD}建议${UI_RESET}"
    ui_panel_line "${UI_DIM}1. 更新系统后优先处理这些文件，避免新配置没有生效。${UI_RESET}"
    ui_panel_line "${UI_DIM}2. 手动交互处理: sudo DIFFPROG='nvim -d' pacdiff${UI_RESET}"
    ui_panel_line "${UI_DIM}3. 只想再次列出: pacdiff --output${UI_RESET}"
  fi

  panel "常见位置" ""
  local path count find_output find_error_file find_status
  for path in /etc /boot /usr/lib/sysusers.d /usr/lib/tmpfiles.d; do
    if [[ -d "$path" ]]; then
      find_error_file="$(mktemp)"
      find_status=0
      find_output="$("${SUDO_READ[@]}" find "$path" \
        \( -name '*.pacnew' -o -name '*.pacsave' -o -name '*.pacorig' \) \
        2> "$find_error_file")" || find_status=$?
      count="$(awk 'NF {count++} END {print count + 0}' <<< "$find_output")"
      if [[ "$count" -gt 0 ]]; then
        ui_panel_stat warn "$path 有 $count 个 pacman 配置残留"
      fi
      if [[ "$find_status" -ne 0 ]]; then
        ui_panel_stat warn "$path 扫描未完成（退出码 $find_status），不能判定为无残留"
        if [[ -s "$find_error_file" ]]; then
          sed -n '1,4p' "$find_error_file" | ui_panel_raw
        fi
        query_failed=1
      elif [[ "$count" -eq 0 ]]; then
        ui_panel_stat ok "$path 无 pacman 配置残留"
      fi
      rm -f -- "$find_error_file"
    fi
  done

  panel_end
  ui_tally_summary
  [[ "$query_failed" -eq 0 ]] || return 1
  ui_tally_status "$strict"
}

main "$@"
