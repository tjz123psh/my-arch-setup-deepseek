#!/bin/bash
# shellcheck disable=SC1091,SC2059
# 描述： 更新系统根
# Description: Update system

# 开启严格模式：遇到错误、未定义变量、管道错误即停止运行
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || printf '%s\n' "$0")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"

# ===============================================================
# Arch Linux 系统更新助手 (KISS 终极联动版 - 防部分升级 + 强制刷新)
# ===============================================================

# ------------------------------
# 1. 默认参数
# ------------------------------
COUNT_LIMIT=15
NEWS_SOURCE="official"
SHOW_LIST=0
ASSUME_YES=0

# ------------------------------
# 2. 接入统一 UI 库
# ------------------------------
# shellcheck source=lib/ui.sh
. "$SCRIPT_DIR/lib/ui.sh"
# shellcheck source=lib/config.sh
. "$SCRIPT_DIR/lib/config.sh"
maintenance_config_load || exit 2
SYSUP_ROOT_MIN_MIB="$(maintenance_config_get ROOT_MIN_FREE_MIB 5120)"
SYSUP_BOOT_MIN_MIB="$(maintenance_config_get BOOT_MIN_FREE_MIB 200)"
SYSUP_MIRROR_MAX_AGE_DAYS="$(maintenance_config_get MIRROR_MAX_AGE_DAYS 30 SYSUP_MIRROR_MAX_AGE_DAYS)"

# 兼容脚本内既有 H_* / TAG_* 引用
H_YELLOW="$UI_YELLOW"; H_BLUE="$UI_BLUE"; H_CYAN="$UI_CYAN"
TAG_INFO="[消息]"; TAG_WARN="[注意]"

# ------------------------------
# 3. 参数解析
# ------------------------------
usage() {
  cat <<EOF
用法: $(basename "$0") [选项]

选项:
  -l, --list                 更新前先打开待更新列表 (checkallupdates)
  -y, --yes                  非交互环境下明确确认执行更新
  --news-source official|cn  新闻源 (默认: official)
  --count N                  新闻条数上限 (默认: 15)
  --help, -h                 显示帮助并退出
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -l | --list) SHOW_LIST=1; shift 1 ;;
  -y | --yes) ASSUME_YES=1; shift 1 ;;
  --news-source) [[ -n "${2:-}" ]] && NEWS_SOURCE="$2" && shift 2 || exit 1 ;;
  --count) [[ -n "${2:-}" ]] && COUNT_LIMIT="$2" && shift 2 || exit 1 ;;
  --help | -h)
    usage
    exit 0
    ;;
  *)
    printf "未知参数: %s\n" "$1"
    usage
    exit 1
    ;;
  esac
done

case "$NEWS_SOURCE" in
  official|cn) ;;
  *)
    printf '错误: --news-source 仅支持 official 或 cn。\n' >&2
    exit 2
    ;;
esac
if [[ ! "$COUNT_LIMIT" =~ ^[1-9][0-9]*$ ]] || (( COUNT_LIMIT > 100 )); then
  printf '错误: --count 必须是 1 到 100 的整数。\n' >&2
  exit 2
fi

# ------------------------------
# 4. 文案（纯中文）
# ------------------------------
declare -A MSG
MSG[SYNCING_DATA]="⏳ 正在同步最新软件库数据，请稍候..."

MSG[INTRO_HEADER]="Arch Linux 系统更新助手"
MSG[INTRO_DESC]="本脚本将执行以下操作："
MSG[INTRO_1]="1. 获取最新 Arch Linux 新闻"
MSG[INTRO_2]="2. 检查镜像源时效并按需更新"
MSG[INTRO_3]="3. 同步软件数据库并更新 GPG 密钥环"
MSG[INTRO_4]="4. 升级系统软件包 (交互模式防冲突)"
MSG[INTRO_5]="5. 更新 Flatpak 应用"
MSG[INTRO_6]="6. 重新生成 GRUB 配置文件"

MSG[REQ_SUDO]="正在请求管理员权限以更新系统..."
MSG[SUDO_FAIL]="需要管理员权限才能更新系统。已退出。"
MSG[NO_HELPER]="未找到 AUR 助手 (paru 或 yay)"
MSG[NO_UI]="未找到前端列表脚本 (checkallupdates)"

MSG[PREPARING]="准备使用 %s 更新系统..."
MSG[FETCHING]="正在获取 Arch Linux 新闻..."
MSG[NEWS_HEADER]="最近 {0} 条 Arch Linux 新闻："
MSG[CONFIRM]="请阅读上述新闻。确认使用 %s 开始更新吗？[Y/n] "
MSG[CANCEL]="更新已取消。"
MSG[ERR_FETCH]="获取新闻失败（网络或源错误）"
MSG[FORCE_ASK]="是否忽略新闻强制更新？[y/N] "
MSG[FORCING]="正在强制更新..."
MSG[EXIT]="安全退出。"

MSG[SNAP]="[0/6] 正在创建 Btrfs 快照..."
MSG[STEP_MIRROR]="[1/6] 检查镜像源时效性..."
MSG[STEP_1]="[2/6] 同步数据库并更新密钥环..."
MSG[KEYRING_OK]="数据库与密钥环已同步。"
MSG[KEYRING_WARN]="数据库或密钥环更新失败；为避免不完整事务，已停止系统更新。"
MSG[STEP_2]="[3/6] 正在升级系统..."
MSG[STEP_3]="[4/6] 检查 Flatpak 更新..."
MSG[FLATPAK_OK]="Flatpak 更新完成。"
MSG[FLATPAK_WARN]="Flatpak 更新失败；主系统升级不受影响，可稍后单独重试。"
MSG[STEP_4]="[5/6] 更新 GRUB 配置..."
MSG[GRUB_OK]="GRUB 更新成功。"
MSG[GRUB_FAIL]="GRUB 更新失败。"
MSG[STEP_POST]="[6/6] 正在执行更新后只读检查..."
MSG[DONE]="系统更新流程已完成。请检查上方是否有警告；内核或驱动更新后建议重启。"

MSG[MIR_OLD]="镜像源已 %s 天未更新 (>30天)。是否更新？[Y/n]"
MSG[MIR_FRESH]="镜像源很新鲜 (生成于 %s 天前)。"
MSG[MIR_UPDATING]="正在运行镜像更新脚本..."
MSG[MIR_SKIP]="跳过镜像源更新。"
MSG[MIR_NO_FILE]="未找到 Reflector 时间标记，跳过检查。"
MSG[MIR_NO_SCRIPT]="错误：未在 %s 找到更新脚本。"

MSG[WARN_PARTIAL_TITLE]="[致命警告] 系统更新被中断或发生冲突失败！"
MSG[WARN_PARTIAL_1]="您的本地软件库数据库已被更新，但软件包尚未成功升级。"
MSG[WARN_PARTIAL_2]="【绝对禁止】在此状态下运行 pacman -S 安装新软件，这会导致部分升级进而损坏系统！"
MSG[WARN_PARTIAL_3]="请尽快排查冲突原因，并重新运行 sysup 完成系统升级。"

# ------------------------------
# 5. 日志函数（接入 ui.sh）
# ------------------------------
_log()     { ui_info "$@"; }
_success() { ui_ok   "$@"; }
_warn()    { ui_warn "$@"; }
_error()   { ui_die  "$@"; }

# ===============================================================
# 【完美联动防线】：处理 -l 选项，强制刷新缓存后优雅交接给前端 UI
# ===============================================================
if [[ $SHOW_LIST == 1 ]]; then
  printf "\n${H_CYAN}%s${NC}\n" "${MSG[SYNCING_DATA]}"

  # 确保缓存新鲜后移交控制权给列表界面
  if [[ -x "$SCRIPT_DIR/checkallupdates" ]]; then
    exec "$SCRIPT_DIR/checkallupdates"
  fi
  exec checkallupdates
fi

# ------------------------------
# 6. Intro & Request Privileges
# ------------------------------
clear
ui_banner "系统升级" "sysup · 官方仓库 / AUR / Flatpak / GRUB"
printf "%s\n" "${MSG[INTRO_DESC]}"
printf "  %s\n" "${MSG[INTRO_1]}"
printf "  %s\n" "${MSG[INTRO_2]}"
printf "  %s\n" "${MSG[INTRO_3]}"
printf "  %s\n" "${MSG[INTRO_4]}"
printf "  %s\n" "${MSG[INTRO_5]}"
printf "  %s\n\n" "${MSG[INTRO_6]}"

_log "${MSG[REQ_SUDO]}"
if ! sudo -v; then
  _error "${MSG[SUDO_FAIL]}"
fi

while true; do
  sudo -n true
  sleep 60
done </dev/null >/dev/null 2>&1 &
SUDO_PID=$!
stop_sudo_keepalive() {
  pkill -TERM -P "$SUDO_PID" 2>/dev/null || true
  kill "$SUDO_PID" 2>/dev/null || true
  wait "$SUDO_PID" 2>/dev/null || true
}
trap stop_sudo_keepalive EXIT

# ------------------------------
# 7. Check AUR Helper
# ------------------------------
UPDATE_CMD=""
if command -v paru >/dev/null 2>&1; then
  UPDATE_CMD="paru"
elif command -v yay >/dev/null 2>&1; then
  UPDATE_CMD="yay"
else
  _error "${MSG[NO_HELPER]}"
fi

# ------------------------------
# Mirror Check Function
# ------------------------------
check_mirror_age() {
  _log "${MSG[STEP_MIRROR]}"
  local MIRROR_LIST="/etc/pacman.d/mirrorlist"
  local THRESHOLD=$((SYSUP_MIRROR_MAX_AGE_DAYS * 24 * 60 * 60))
  local UPDATE_SCRIPT="$SCRIPT_DIR/mirror-update"
  if [[ ! -x "$UPDATE_SCRIPT" ]]; then
    UPDATE_SCRIPT="mirror-update"
  fi

  if [[ -f /etc/os-release ]]; then . /etc/os-release; fi
  if [[ "${ID:-}" != "arch" ]] && [[ ! "${ID_LIKE:-}" =~ arch ]]; then return; fi

  if [[ -f "$MIRROR_LIST" ]] && grep -q "^# When:" "$MIRROR_LIST"; then
    local when_str
    when_str=$(grep "^# When:" "$MIRROR_LIST" | cut -d':' -f2- | sed 's/ UTC//g' | xargs || true)

    local file_ts current_ts
    file_ts=$(date -u -d "$when_str" +%s 2>/dev/null || echo 0)
    current_ts=$(date +%s)

    if [[ "$file_ts" -gt 0 ]]; then
      local diff=$((current_ts - file_ts))
      local days_old=$((diff / 86400))

      if [[ "$diff" -gt "$THRESHOLD" ]]; then
        printf "${H_YELLOW}${TAG_WARN}${NC} "
        printf "${MSG[MIR_OLD]} " "$days_old"
        local choice; read -r choice || true
        choice=${choice:-Y}

        if [[ "$choice" =~ ^[Yy]$ ]]; then
          if command -v "$UPDATE_SCRIPT" >/dev/null 2>&1; then
            _log "${MSG[MIR_UPDATING]}"
            run_inhibited "$UPDATE_SCRIPT"
          else
            _error "${MSG[MIR_NO_SCRIPT]}" "$UPDATE_SCRIPT"
          fi
        else
          _log "${MSG[MIR_SKIP]}"
        fi
      else
        printf "${H_BLUE}${TAG_INFO}${NC} "
        printf "${MSG[MIR_FRESH]}\n" "$days_old"
      fi
    else
      _warn "${MSG[MIR_NO_FILE]}"
    fi
  else
    _log "${MSG[MIR_NO_FILE]}"
  fi
}

# ------------------------------
# 8. Update Function (防部分升级核心)
# ------------------------------
run_inhibited() {
  if command -v systemd-inhibit >/dev/null 2>&1; then
    systemd-inhibit \
      --what=sleep:shutdown \
      --who=sysup \
      --why="Arch Linux 系统维护正在写入系统状态" \
      --mode=block \
      "$@"
  else
    "$@"
  fi
}

check_free_space() {
  local path="$1"
  local required_kib="$2"
  local label="$3"
  local available_kib

  available_kib="$(df -Pk -- "$path" 2>/dev/null | awk 'NR == 2 {print $4}')"
  if [[ ! "$available_kib" =~ ^[0-9]+$ ]]; then
    _error "无法读取 %s 的剩余空间。" "$path"
  fi
  if (( available_kib < required_kib )); then
    _error "%s 剩余空间不足：至少需要 %s MiB，当前约 %s MiB。" \
      "$label" "$((required_kib / 1024))" "$((available_kib / 1024))"
  fi
  _log "%s 可用空间约 %s MiB。" "$label" "$((available_kib / 1024))"
}

preflight_update() {
  _log "正在执行更新前检查..."
  if [[ -e /var/lib/pacman/db.lck ]]; then
    _error "检测到 /var/lib/pacman/db.lck；另一个 Pacman 事务可能正在运行。"
  fi
  check_free_space / "${SYSUP_ROOT_MIN_KIB:-$((SYSUP_ROOT_MIN_MIB * 1024))}" "根分区"
  if mountpoint -q /boot 2>/dev/null; then
    check_free_space /boot "${SYSUP_BOOT_MIN_KIB:-$((SYSUP_BOOT_MIN_MIB * 1024))}" "/boot"
  fi
}

perform_update() {
  local quicksave_cmd=""
  local post_update_failed=0
  local grub_status="skipped"
  local post_check_cmd=""
  local refresh_cmd=""

  ui_maintenance_lock_acquire "系统更新" || return $?
  preflight_update
  if [[ -x "$SCRIPT_DIR/quicksave" ]]; then
    quicksave_cmd="$SCRIPT_DIR/quicksave"
  elif command -v quicksave >/dev/null 2>&1; then
    quicksave_cmd="quicksave"
  fi

  if [[ -n "$quicksave_cmd" ]] && [[ "$(findmnt -no FSTYPE /)" == "btrfs" ]]; then
      _log "${MSG[SNAP]}"
      "$quicksave_cmd" -d quicksave-sysup
  fi

  check_mirror_age

  _log "${MSG[STEP_1]}"
  local KEYRING_TARGETS=("archlinux-keyring")
  if grep -q "^\[archlinuxcn\]" /etc/pacman.conf; then
    KEYRING_TARGETS+=("archlinuxcn-keyring")
  fi

  if run_inhibited sudo pacman -Sy --needed --noconfirm "${KEYRING_TARGETS[@]}"; then
    _success "${MSG[KEYRING_OK]}"
  else
    _error "${MSG[KEYRING_WARN]}"
  fi

  _log "${MSG[STEP_2]}"

  # ===============================================================
  # 【致命警告防线】：强制交互模式并捕获错误
  # ===============================================================
  if ! run_inhibited "$UPDATE_CMD" -Su; then
    # 部分升级会损坏系统，用红框警示卡片突出，替代裸 ==== 分隔线
    printf '\n'
    ui_panel_open "${MSG[WARN_PARTIAL_TITLE]}" "$UI_ICON_ERR"
    ui_panel_stat err "${MSG[WARN_PARTIAL_1]}"
    ui_panel_stat err "${MSG[WARN_PARTIAL_2]}"
    ui_panel_stat err "${MSG[WARN_PARTIAL_3]}"
    ui_panel_close
    printf '\n'
    exit 1
  fi

  if command -v flatpak >/dev/null 2>&1; then
    _log "${MSG[STEP_3]}"
    if run_inhibited flatpak update -y; then
      _success "${MSG[FLATPAK_OK]}"
    else
      _warn "${MSG[FLATPAK_WARN]}"
      post_update_failed=1
    fi
  fi

  _log "${MSG[STEP_4]}"
  if command -v grub-mkconfig >/dev/null 2>&1; then
    if run_inhibited sudo env LANG=en_US.UTF-8 grub-mkconfig -o /boot/grub/grub.cfg; then
      grub_status="success"
      _success "${MSG[GRUB_OK]}"
    else
      grub_status="failed"
      _warn "${MSG[GRUB_FAIL]}"
      post_update_failed=1
    fi
  else
    _warn "未找到 grub-mkconfig，跳过 GRUB 更新。"
    post_update_failed=1
  fi

  if [[ -n "${SYSUP_CHECKALLUPDATES_CMD:-}" ]]; then
    refresh_cmd="$SYSUP_CHECKALLUPDATES_CMD"
  elif [[ -x "$SCRIPT_DIR/checkallupdates" ]]; then
    refresh_cmd="$SCRIPT_DIR/checkallupdates"
  elif command -v checkallupdates >/dev/null 2>&1; then
    refresh_cmd="checkallupdates"
  fi
  if [[ -z "$refresh_cmd" ]]; then
    _warn "未找到 checkallupdates，待更新包缓存未刷新。"
    post_update_failed=1
  elif ! "$refresh_cmd" --refresh >/dev/null 2>&1; then
    _warn "待更新包缓存刷新失败；返回菜单后请手动重新检查。"
    post_update_failed=1
  fi

  if [[ -n "${SYSUP_POST_CHECK_CMD:-}" ]]; then
    post_check_cmd="$SYSUP_POST_CHECK_CMD"
  elif [[ -x "$SCRIPT_DIR/post-update-check" ]]; then
    post_check_cmd="$SCRIPT_DIR/post-update-check"
  elif command -v post-update-check >/dev/null 2>&1; then
    post_check_cmd="post-update-check"
  fi
  _log "${MSG[STEP_POST]}"
  if [[ -z "$post_check_cmd" ]]; then
    _warn "未找到 post-update-check，更新后检查未执行。"
    post_update_failed=1
  elif ! "$post_check_cmd" --grub-status "$grub_status"; then
    _warn "更新后检查未完整执行；请单独运行 post-update-check。"
    post_update_failed=1
  fi

  if [[ "$post_update_failed" -ne 0 ]]; then
    _warn "主系统软件包已升级，但至少一个后续步骤失败；请按上方提示单独重试。"
    return 1
  fi
  _success "${MSG[DONE]}"
}

# ------------------------------
# 9. Main Execution
# ------------------------------
_log "${MSG[PREPARING]}" "$UPDATE_CMD"
_log "${MSG[FETCHING]}"

PYTHON_SCRIPT=$(
  cat <<'EOF'
import sys
import xml.etree.ElementTree as ET
try:
    def clean_text(value):
        value = value or ''
        return ''.join(
            ch for ch in value.strip()
            if ord(ch) >= 32 and not 127 <= ord(ch) <= 159
        )

    def item_text(item, tag):
        element = item.find(tag)
        return clean_text(element.text if element is not None else '')

    def terminal_link(text, url):
        url = clean_text(url)
        if not url:
            return text
        return f'\033]8;;{url}\033\\{text}\033]8;;\033\\'

    limit = int(sys.argv[1])
    header_template = sys.argv[2]
    sys.stdin.reconfigure(encoding='utf-8')
    raw_data = sys.stdin.read()
    if not raw_data.strip(): sys.exit(1)
    root = ET.fromstring(raw_data)
    items = root.findall('./channel/item')[:limit]
    print(f'\n\033[1;33m{header_template.format(len(items))}\033[0m\n')
    for item in items:
        title = item_text(item, 'title') or '(无标题)'
        pub_date = item_text(item, 'pubDate')
        link = item_text(item, 'link')
        date_str = pub_date[:16] if pub_date else '无日期'
        check_text = title.lower()
        if any(x in check_text for x in ['intervention', 'manual', '手动', '干预']):
            color = '\033[1;31m'; prefix = '!!! '
        else:
            color = '\033[1;32m'; prefix = ''
        line = f'[{date_str}] {prefix}{title}'
        print(f'{color}{terminal_link(line, link)}\033[0m')
except Exception as e:
    sys.stderr.write(f'\n解析新闻失败: {e}\n')
    sys.exit(1)
EOF
)

if [[ "$NEWS_SOURCE" == "cn" ]]; then
  NEWS_URL="https://www.archlinuxcn.org/category/news/feed/"
else
  NEWS_URL="https://archlinux.org/feeds/news/"
fi

if curl -sS -L --connect-timeout 15 -A "Mozilla/5.0" "$NEWS_URL" |
  python -c "$PYTHON_SCRIPT" "$COUNT_LIMIT" "${MSG[NEWS_HEADER]}"; then

  if [[ "$ASSUME_YES" -eq 1 ]]; then
    perform_update
  elif [[ ! -t 0 ]]; then
    _error "非交互环境不会默认确认更新；请在终端运行，或明确传入 --yes。"
  else
    printf "\n"
    printf "${MSG[CONFIRM]}" "$UPDATE_CMD"
    read -r confirm || true
    case "$confirm" in
    [Yy]* | "") perform_update ;;
    *)
      _warn "${MSG[CANCEL]}"
      exit 0
      ;;
    esac
  fi
else
  printf "\n"
  _warn "${MSG[ERR_FETCH]}"
  if [[ "$ASSUME_YES" -eq 1 ]]; then
    _warn "${MSG[FORCING]}"
    perform_update
  elif [[ ! -t 0 ]]; then
    _error "新闻获取失败，且当前为非交互环境；未执行更新。"
  else
    printf "${MSG[FORCE_ASK]}"
    read -r force_confirm || true
    case "$force_confirm" in
    [Yy]*)
      _warn "${MSG[FORCING]}"
      perform_update
      ;;
    *)
      _log "${MSG[EXIT]}"
      exit 1
      ;;
    esac
  fi
fi
