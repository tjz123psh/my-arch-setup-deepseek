#!/bin/bash
#
# screenshot-sound — 截图快门音效服务（合成器无关，niri / hyprland 通用）
#
# 用法：
#   screenshot-sound            启动守护进程（监听剪贴板，命中即播放快门声）
#   screenshot-sound run        同上
#   screenshot-sound arm        “上膛”：直接创建触发文件（截图键在捕获前调用）
#   screenshot-sound -h|--help  显示帮助
#
# 工作原理：
#   截图键按下时先调用 `screenshot-sound arm`，直接 touch 触发文件；随后截图
#   工具把图片写入剪贴板，守护进程的 wl-paste --watch 回调发现「已上膛 + 未过期
#   + 剪贴板是图片」三条件同时满足，就播放快门声并销毁触发文件（防连响）。
#
#   历史设计用 SIGUSR1 通知守护进程上膛，依赖 pkill 精确匹配进程且信号按时送达，
#   多次出现漏触发；改为由截图键直接 touch 文件，去掉信号与 pkill 匹配这两层不
#   确定性——arm 是否成功不再依赖守护进程存活或进程名匹配。

set -uo pipefail

# =================配置区域=================
# 音效文件：可用 SCREENSHOT_SOUND 环境变量覆盖；未设置时按候选列表自动探测。
SOUND="${SCREENSHOT_SOUND:-}"
# 触发文件，存于内存中 (/dev/shm)，读写极快。合成器无关，niri/hyprland 通用。
TRIGGER_FILE="${SCREENSHOT_SOUND_TRIGGER:-/dev/shm/screenshot_sound_armed}"
# 有效期：按下截图键后，多少秒内产生了图片才响？(防止取消截图后，下次复制图片误响)
TIMEOUT_SEC="${SCREENSHOT_SOUND_TIMEOUT:-15}"
# 单实例锁，防止自启触发两次导致多个守护进程争抢剪贴板。
LOCK_FILE="${SCREENSHOT_SOUND_LOCK:-/dev/shm/screenshot_sound.lock}"
# =========================================

usage() {
    sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
}

# =========================================
# arm 子命令：直接创建触发文件（截图键在捕获前调用）
# =========================================
if [ "${1:-run}" = "arm" ]; then
    : >"$TRIGGER_FILE" || {
        # 极少数情况下 /dev/shm 不可写，退回临时目录并提示。
        notify-send "screenshot-sound" "无法写入触发文件: $TRIGGER_FILE" 2>/dev/null
        exit 1
    }
    exit 0
fi

case "${1:-run}" in
    -h | --help)
        usage
        exit 0
        ;;
    run | "") ;;
    *)
        echo "未知子命令: $1" >&2
        usage >&2
        exit 2
        ;;
esac

# =========================================
# 守护进程模式
# =========================================

# 环境检查
if ! command -v wl-paste >/dev/null; then
    notify-send "screenshot-sound" "错误: 未找到 wl-paste (wl-clipboard)" 2>/dev/null
    exit 1
fi
if ! command -v pw-play >/dev/null; then
    notify-send "screenshot-sound" "错误: 未找到 pw-play" 2>/dev/null
    exit 1
fi

# 未显式指定音效时，探测系统上常见的快门/提示音
if [ -z "$SOUND" ]; then
    for candidate in \
        /usr/share/sounds/freedesktop/stereo/camera-shutter.oga \
        /usr/share/sounds/freedesktop/stereo/screen-capture.oga \
        /usr/share/sounds/freedesktop/stereo/camera-shutter.wav \
        /usr/share/sounds/freedesktop/stereo/complete.oga \
        /usr/share/sounds/freedesktop/stereo/bell.oga; do
        if [ -f "$candidate" ]; then
            SOUND="$candidate"
            break
        fi
    done
fi

if [ -z "$SOUND" ] || [ ! -f "$SOUND" ]; then
    notify-send "screenshot-sound" "未找到可用音效文件，请安装 sound-theme-freedesktop 或用 SCREENSHOT_SOUND 指定" 2>/dev/null
    exit 1
fi

# 单实例锁：已有守护进程在跑就安静退出（自启可能触发两次）。
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "screenshot-sound: 已有实例在运行，退出。"
    exit 0
fi

# =========================================
# 启动剪贴板监听
# =========================================
# wl-paste --watch 在剪贴板每次变化时执行回调。回调用 wl-paste --list-types 查
# 当前剪贴板的 MIME 类型判断是否图片——这是不依赖 stdin 的方式。
# （早期尝试从回调 stdin 读内容判断 magic number：当守护进程的 stdin 非 tty
# 时 wl-paste 不会把内容喂到回调 stdin，回调读到 0 字节而漏判；niri
# spawn-at-startup / hypr exec_cmd 启动时 stdin 都不是 tty，故彻底弃用 stdin。）
# 变量用 export 传给回调，回调体用单引号，避免转义地狱。
export _SS_SOUND="$SOUND"
export _SS_TRIGGER="$TRIGGER_FILE"
export _SS_TIMEOUT="$TIMEOUT_SEC"

# 回调体故意用单引号：配置经 _SS_* 环境变量在回调运行时展开，而非启动时。
# shellcheck disable=SC2016
wl-paste --watch bash -c '
    # B 先行（最省事）：未上膛的剪贴板变化直接忽略，不做任何查询。
    [ -f "$_SS_TRIGGER" ] || exit 0

    # C. 上膛是否过期（防止取消截图后，下次复制图片误响）
    now=$(date +%s)
    ft=$(stat -c %Y "$_SS_TRIGGER" 2>/dev/null || echo 0)
    [ $((now - ft)) -lt "$_SS_TIMEOUT" ] || exit 0

    # A. 当前剪贴板是否为图片（按 MIME 类型判断，不依赖 stdin）。
    # wl-paste --watch 在选区变化瞬间触发回调时，wl-paste --list-types 偶尔
    # 会先返回空（compositor 尚未就绪），故短暂重试几次，避免漏判。
    is_image=0
    for _ in 1 2 3 4 5; do
        if wl-paste --list-types 2>/dev/null | grep -q "^image/"; then
            is_image=1
            break
        fi
        sleep 0.1
    done
    [ "$is_image" -eq 1 ] || exit 0

    # D. 条件满足：播放快门声并销毁扳机（防连响）
    pw-play "$_SS_SOUND" &
    rm -f "$_SS_TRIGGER"
' &
WATCHER_PID=$!

# 退出时清理监听子进程
trap 'kill "$WATCHER_PID" 2>/dev/null; exit' INT TERM EXIT

echo "截图音效服务已启动（arm 子命令上膛，监听剪贴板图片）..."

# 阻塞等待监听子进程；它被杀掉时脚本随之退出。
wait "$WATCHER_PID"
