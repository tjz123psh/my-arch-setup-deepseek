# Local audit, raw model sessions, and installer state must never enter the public repository.
.audit/
*.audit-private.md
/session-ses_*.md

# Installer runtime state (resume markers, build dirs).
.install_progress
.aur-build*/

# Offline AUR source cache (1GB): never part of git clone, distributed via
# GitHub Releases; extract into the repo dir on the target machine only.
.aur-sources/

# Release and build outputs.
dist/
*.pkg.tar.*
*.sig

# Python bytecode.
__pycache__/
*.pyc

# Editor and OS noise.
.DS_Store

# nightly validation artifacts (review 12.5): never committed
artifacts/

# download-mode-lab experiment: keep docs/scripts/results, never the
# generated mock fixtures or bytecode (30M+ of throwaway pacman roots).
download-mode-lab/fixtures/
download-mode-lab/**/__pycache__/
# archived lab (2026-08-10): same fixture/bytecode rules apply after the move
docs/archive/download-mode-lab-20260808/fixtures/
docs/archive/download-mode-lab-20260808/**/__pycache__/

# sync-scripts.sh 的 rollback 备份（2026-08-10 起忽略，防误提交）
.sync-backup-*/
